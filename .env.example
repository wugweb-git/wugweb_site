# .env.example: every environment variable name this repo reads, with
# placeholder values. The real values never live in this file. See
# docs/skills/SECRETS.md for the standard; owner's rule 2026-11-19: no
# key rotation, never. For runtime on Cloudflare Pages, set each secret
# with `wrangler pages secret put <NAME>` or the dashboard. For local
# dev, copy this file to `.env` (which is gitignored) and fill in the
# real values.

# Database
DATABASE_URL=postgres://REPLACE_ME@REPLACE_ME/neondb?sslmode=require

# Sanity: editor token for /api/contact mirrors and preview reads
SANITY_SYNC_TOKEN=REPLACE_ME

# /api/sync own secret, 32+ random chars, used as X-Sync-Token
NEON_SYNC_SECRET=REPLACE_ME

# /api/preview own secret, 32+ random chars
PREVIEW_SECRET=REPLACE_ME

# Notion: local sync scripts only (not a Cloudflare secret)
NOTION_API_TOKEN=REPLACE_ME

# OpenRouter: free-tier model routing for skill helper scripts.
# OPENROUTER_MODEL must end in :free. OpenRouter must never be billed.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# R2 public base for assets
PUBLIC_R2_ASSETS_BASE=https://pub-REPLACE_ME.r2.dev
PUBLIC_USE_R2_ASSETS=1
