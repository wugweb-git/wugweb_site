# Cloudflare Pages response headers.
#
# The site shipped without this file, which meant two things: zero security
# headers on every response, and `cache-control: public, max-age=0,
# must-revalidate` on every static asset — so the homepage re-fetched its video
# on every single visit.
#
# Rules are matched most-specific-first by Pages. HTML is deliberately left
# alone: these pages are server-rendered per request and must not be cached at
# the edge as if they were static.

/*
  # Stops a browser second-guessing a declared Content-Type. No downside.
  X-Content-Type-Options: nosniff
  # Send the full URL to ourselves, only the origin cross-site, nothing over
  # plain HTTP. The modern default, and it keeps paths out of third-party logs.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing on this site is meant to be framed. SAMEORIGIN rather than DENY so
  # a future preview/embed of our own does not break.
  X-Frame-Options: SAMEORIGIN
  # Powerful features this site never uses. Denying them means a compromised
  # third-party script cannot quietly turn them on.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # One year, no includeSubDomains and no preload — deliberately conservative
  # until wugweb.com actually serves this build. includeSubDomains is a
  # commitment on behalf of every subdomain, and preload is very hard to undo.
  Strict-Transport-Security: max-age=31536000

# Astro's build output is content-hashed, so a changed file gets a new URL.
# Immutable is exactly right here and is the single biggest win in this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media and brand assets are NOT content-hashed — replacing an image reuses its
# path. A week with revalidation, rather than a year, so a swapped asset is not
# stuck in caches until someone renames it.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts are version-pinned by filename (Inter Tight v9, Fragment Mono v6) and
# a new version would arrive under a new name, so immutable is honest here.
# Self-hosted as of audit finding 9 — these used to come from fonts.gstatic.com.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be cached, or a released update cannot reach
# clients that already installed the old one.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Well-known files change rarely but must not go stale for a day when they do.
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/ai-context.txt
  Cache-Control: public, max-age=3600
/security.txt
  Cache-Control: public, max-age=3600

# Deliberately NOT set here: Content-Security-Policy. This site loads Google
# Fonts, Sanity's CDN, framerusercontent.com images and several inline scripts
# (consent, PWA registration, GSAP setup). A CSP written without testing every
# one of those would silently break the page for real visitors, which is worse
# than not having one. It needs its own pass with the browser open.
