{
  "name": "wugweb-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev ./dist",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "sanity:dev": "cd sanity && npm run dev",
    "sanity:build": "cd sanity && npm run build",
    "sanity:deploy": "cd sanity && npm run deploy",
    "sanity:health": "node sanity/test_sanity.mjs",
    "test:sanity": "node --test sanity/lib/health.test.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "posters": "node scripts/generate-video-posters.mjs",
    "test:redirects": "node --test src/lib/redirects.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/react": "^4.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sanity/client": "^6.0.0",
    "@sanity/image-url": "^1.0.2",
    "astro": "^5.0.0",
    "gsap": "^3.15.0",
    "pg": "^8.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@storybook-astro/framework": "^1.12.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "csv-parse": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "storybook": "^10.6.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {}
}
