// wrangler.jsonc
{
  "name": "wugweb-site",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Created via: wrangler hyperdrive create wugweb-neon --connection-string="<neon uri>"
      // No tool available to me creates this — you'll need to run that command
      // yourself once you have the Neon URI, then paste the returned id here.
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "vars": {
    "SANITY_PROJECT_ID": "splvhmk1",
    "SANITY_DATASET": "production"
  }
}
