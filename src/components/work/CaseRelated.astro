---
import type { RelatedBlock, NextBlock } from '../../lib/case-layout';
import { assetUrl } from '../../lib/assets';

interface Props { block: RelatedBlock | NextBlock }
const { block } = Astro.props;

const isNext = block.type === 'next';
const items = isNext ? [block.item] : block.items;
const heading = isNext ? 'Up next' : 'Related case studies';

function thumb(p?: string) {
  if (!p) return '';
  return p.startsWith('http') ? p : assetUrl(p);
}
---
<section class={isNext ? 'case-related case-related--next' : 'case-related'} aria-labelledby={`${block.type}-head`} data-reveal>
  <h2 class="case-related-head" id={`${block.type}-head`}>{heading}</h2>
  <ul class="case-related-list">
    {items.map(item => (
      <li class="case-related-item">
        <a class="case-related-link" href={`/work/${item.slug}`}>
          {(item.thumbnailPath || item.coverPath) && (
            <img
              class="case-related-media"
              src={thumb(item.thumbnailPath ?? item.coverPath)}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="case-related-text">
            <h3 class="case-related-title">{item.shortTitle ?? item.title}</h3>
            {item.industry && <p class="case-related-industry">{item.industry}</p>}
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .case-related {
    margin: var(--space-section-md) 0;
    display: grid;
    gap: var(--space-page-md);
  }
  .case-related-head {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .case-related-list {
    display: grid;
    gap: var(--space-page-md);
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: 1fr;
  }
  .case-related-item { margin: 0; }
  .case-related-link {
    display: grid;
    gap: var(--space-page-sm);
    color: inherit;
    text-decoration: none;
    padding: var(--space-page-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-3, 16px);
    background: var(--color-surface-elevated);
    transition: border-color 0.2s;
  }
  .case-related-link:hover { border-color: var(--color-text-secondary); }
  .case-related-link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }
  .case-related-media {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-2, 12px);
    background: var(--color-surface-page);
  }
  .case-related-title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .case-related-industry {
    margin: var(--space-page-xs) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs, 0.75rem);
  }
  @media (min-width: 720px) {
    .case-related-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .case-related:not(.case-related--next) .case-related-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .case-related--next .case-related-list { grid-template-columns: 1fr; }
</style>
