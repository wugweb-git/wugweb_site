---
import type { PointsBlock } from '../../lib/case-layout';
import { inline } from '../../lib/case-body';

interface Props { block: PointsBlock }
const { block } = Astro.props;
---
<ul class="case-points" data-reveal>
  {block.items.map(tile => (
    <li class="case-point">
      {tile.title && <h3 class="case-point-title" set:html={inline(tile.title)} />}
      <p class="case-point-text" set:html={inline(tile.text)} />
      {tile.group && <p class="case-point-group">{tile.group}</p>}
    </li>
  ))}
</ul>
<style>
  .case-points {
    display: grid;
    gap: var(--space-page-md);
    list-style: none;
    padding: 0;
    margin: var(--space-page-lg) 0 0;
  }
  .case-point {
    padding: var(--space-page-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-3, 16px);
    background: var(--color-surface-elevated);
  }
  .case-point-title {
    margin: 0 0 var(--space-page-xs);
    color: var(--color-text-primary);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .case-point-text {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .case-point-group {
    margin: var(--space-page-sm) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  @media (min-width: 720px) {
    .case-points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .case-points { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
