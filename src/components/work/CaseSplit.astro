---
import type { SplitBlock } from '../../lib/case-layout';
import { assetUrl } from '../../lib/assets';

interface Props { block: SplitBlock }
const { block } = Astro.props;

function src(url: string) { return url.startsWith('http') ? url : assetUrl(url); }
---
<div class="case-split" data-reveal>
  <figure class="case-split-item">
    {block.left.video ? (
      <video class="case-split-media" src={src(block.left.url)} muted playsinline autoplay loop preload="metadata" aria-hidden="true" />
    ) : (
      <img class="case-split-media" src={src(block.left.url)} alt={block.left.caption ?? block.left.label ?? ''} loading="lazy" decoding="async" />
    )}
    {block.left.caption && <figcaption class="case-split-caption">{block.left.caption}</figcaption>}
  </figure>
  <figure class="case-split-item">
    {block.right.video ? (
      <video class="case-split-media" src={src(block.right.url)} muted playsinline autoplay loop preload="metadata" aria-hidden="true" />
    ) : (
      <img class="case-split-media" src={src(block.right.url)} alt={block.right.caption ?? block.right.label ?? ''} loading="lazy" decoding="async" />
    )}
    {block.right.caption && <figcaption class="case-split-caption">{block.right.caption}</figcaption>}
  </figure>
</div>
<style>
  .case-split {
    display: grid;
    gap: var(--space-page-md);
    margin: var(--space-page-lg) 0;
  }
  .case-split-item {
    margin: 0;
    display: grid;
    gap: var(--space-page-sm);
  }
  .case-split-media {
    inline-size: 100%;
    display: block;
    border-radius: var(--radius-3, 16px);
    background: var(--color-surface-elevated);
  }
  .case-split-caption {
    color: var(--color-text-secondary);
    font-size: var(--text-sm, 0.875rem);
    line-height: 1.5;
  }
  @media (min-width: 720px) {
    .case-split { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
