---
import type { MosaicBlock } from '../../lib/case-layout';
import { assetUrl } from '../../lib/assets';

interface Props { block: MosaicBlock }
const { block } = Astro.props;

function src(url: string) { return url.startsWith('http') ? url : assetUrl(url); }
---
<div class="case-mosaic" data-reveal>
  {block.items.map(media => (
    <figure class="case-mosaic-item">
      {media.video ? (
        <video class="case-mosaic-media" src={src(media.url)} muted playsinline autoplay loop preload="metadata" aria-hidden="true" />
      ) : (
        <img class="case-mosaic-media" src={src(media.url)} alt={media.caption ?? media.label ?? ''} loading="lazy" decoding="async" />
      )}
      {media.caption && <figcaption class="case-mosaic-caption">{media.caption}</figcaption>}
    </figure>
  ))}
</div>
<style>
  .case-mosaic {
    display: grid;
    gap: var(--space-page-md);
    margin: var(--space-page-lg) 0;
    grid-template-columns: 1fr;
  }
  .case-mosaic-item { margin: 0; display: grid; gap: var(--space-page-xs); }
  .case-mosaic-media {
    inline-size: 100%;
    display: block;
    border-radius: var(--radius-3, 16px);
    background: var(--color-surface-elevated);
  }
  .case-mosaic-caption {
    color: var(--color-text-secondary);
    font-size: var(--text-xs, 0.75rem);
    line-height: 1.4;
  }
  @media (min-width: 720px) {
    .case-mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .case-mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
