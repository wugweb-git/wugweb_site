---
import type { HeroBlock } from '../../lib/case-layout';
import { assetUrl } from '../../lib/assets';
import { inline } from '../../lib/case-body';

interface Props { block: HeroBlock }
const { block } = Astro.props;

const coverUrl = block.cover?.url ? (block.cover.url.startsWith('http') ? block.cover.url : assetUrl(block.cover.url)) : '';
const isVideo = block.cover?.video === true;
---
<header class="case-hero" data-reveal>
  <div class="case-hero-text">
    {block.clientName && <p class="case-hero-client">{block.clientName}</p>}
    <h1 class="case-hero-title">{block.title}</h1>
    {block.subtitle && <p class="case-hero-subtitle" set:html={inline(block.subtitle)} />}
    {block.tags.length > 0 && (
      <ul class="case-hero-tags" aria-label="Tags">
        {block.tags.map(t => <li class="case-hero-tag">{t}</li>)}
      </ul>
    )}
    {block.meta.length > 0 && (
      <dl class="case-hero-meta">
        {block.meta.map(item => (
          <>
            <dt>{item.key}</dt>
            <dd set:html={inline(item.value)} />
          </>
        ))}
      </dl>
    )}
  </div>
  {coverUrl && (
    <div class="case-hero-cover" id="work-cover">
      {isVideo ? (
        <video class="case-hero-media" src={coverUrl} muted playsinline autoplay loop preload="metadata" aria-hidden="true" />
      ) : (
        <img class="case-hero-media" src={coverUrl} alt="" loading="eager" decoding="async" />
      )}
    </div>
  )}
</header>
<style>
  .case-hero {
    display: grid;
    gap: var(--space-page-lg);
    padding-block-end: var(--space-section-md);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .case-hero-client {
    margin: 0 0 var(--space-page-xs);
    color: var(--color-text-secondary);
    font-size: var(--text-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .case-hero-title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display, inherit);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-weight: 600;
  }
  .case-hero-subtitle {
    margin-block-start: var(--space-page-md);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    max-inline-size: 60ch;
  }
  .case-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-page-xs);
    list-style: none;
    padding: 0;
    margin: var(--space-page-md) 0 0;
  }
  .case-hero-tag {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full, 999px);
    color: var(--color-text-secondary);
    font-size: var(--text-xs, 0.75rem);
  }
  .case-hero-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-page-md);
    row-gap: var(--space-page-xs);
    margin: var(--space-page-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm, 0.875rem);
  }
  .case-hero-meta dt {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .case-hero-meta dd {
    margin: 0;
    color: var(--color-text-primary);
  }
  /* The cover keeps its own ratio: the box takes the file's shape, nothing is cropped. */
  .case-hero-cover {
    position: relative;
    border-radius: var(--radius-3, 16px);
    overflow: hidden;
    background: var(--color-surface-elevated);
  }
  .case-hero-media {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }
  @media (min-width: 900px) {
    .case-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
      gap: var(--space-page-xl);
    }
  }
</style>
