---
import type { PostCardData } from '../lib/post-card';
/**
 * PostCard — the one blog card. 4:3 cover, topic, title, two-line excerpt,
 * byline. Shape comes from `toPostCard()` (src/lib/post-card.ts), i.e. the
 * `postsListQuery` schema, so /blog and every teaser render identical cards.
 *
 * `row` is the stacked state: below 768px the card collapses to a compact row
 * (square thumb, topic chip, title; excerpt and byline dropped). Without `row`
 * it stays the normal (sm) card at every width. From 768px up a `row` card is
 * the normal card too — the grid that holds it sets 2 columns at md (768) and
 * 3 at lg (1200).
 */
interface Props {
  card: PostCardData;
  row?: boolean;
  eager?: boolean;
}
const { card: p, row = false, eager = false } = Astro.props;
---

<a href={`/blog/${p.slug}`} class:list={['post-card', { 'post-card--row': row }]} style={`--card-accent: ${p.accent}`}>
  <div class="pc-thumb-wrap">
    {p.coverUrl ? (
      <img src={p.coverUrl} alt={p.coverAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" class="pc-thumb" />
    ) : (
      <div class="pc-thumb pc-thumb-fallback" aria-hidden="true">
        <span class="pc-grid"></span>
        <span class="pc-initials">{p.initials}</span>
      </div>
    )}
    <span class="pc-dot" aria-hidden="true"></span>
    <span class="pc-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="9 5 19 5 19 15"></polyline></svg>
    </span>
  </div>
  <div class="pc-content">
    <div class="pc-cat-row">
      <span class="pc-category">{p.topic || p.pillar}</span>
      {row && (
        <span class="u-chip pc-launch" aria-hidden="true">
          <svg viewBox="0 0 16 16" focusable="false"><path d="M8 1.5v13M1.5 8h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </span>
      )}
    </div>
    <h3>{p.title}</h3>
    {p.excerpt && <p class="pc-excerpt">{p.excerpt}</p>}
    <div class="pc-meta">
      {p.author?.name && <span>{p.author.name}</span>}
      {p.readingTime && <span>{p.readingTime} min read</span>}
    </div>
  </div>
</a>

<style>
  .post-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--fg);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .post-card:hover { transform: translateY(-3px); }
  .pc-thumb-wrap { position: relative; overflow: hidden; aspect-ratio: 4/3; flex-shrink: 0; border-radius: var(--radius-lg); }
  .pc-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .post-card:hover .pc-thumb { transform: scale(1.06); }
  .pc-dot {
    position: absolute; top: var(--gap-3); left: var(--gap-3); width: 9px; height: 9px; border-radius: 50%;
    background: var(--card-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-surface-page) 55%, transparent);
  }
  .pc-arrow {
    position: absolute; top: var(--gap-3); right: var(--gap-3); width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; color: var(--color-surface-page);
    background: var(--fg); opacity: 0; transform: scale(0.7) translateY(4px);
    transition: opacity var(--duration-normal) ease, transform var(--duration-normal) cubic-bezier(0.16, 1, 0.3, 1);
  }
  .post-card:hover .pc-arrow { opacity: 1; transform: scale(1) translateY(0); }

  .pc-content { padding: var(--gap-5) var(--gap-1) 0; display: flex; flex-direction: column; flex: 1; gap: var(--gap-2); }
  .pc-cat-row { display: flex; align-items: center; justify-content: space-between; gap: var(--gap-3); }
  .pc-category { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: 0.04em; text-transform: uppercase; color: var(--card-accent); }
  .pc-launch { display: none; width: 1.5rem; height: 1.5rem; }
  .pc-launch svg { width: 0.75rem; height: 0.75rem; }
  .post-card h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); line-height: var(--lh-h5); color: var(--fg); }
  .pc-excerpt { font-size: var(--t-sm); color: var(--fg-muted); line-height: var(--lh-s); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-3); margin-top: var(--gap-1); font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .pc-meta span:not(:last-child)::after {
    content: ''; display: inline-block; width: 1px; height: 0.85em; background: var(--line-strong); margin-left: var(--gap-3); vertical-align: -0.1em;
  }

  /* No-cover state: its own visual, not a broken image */
  .pc-thumb-fallback {
    position: relative; display: flex; align-items: flex-end; padding: var(--gap-4); width: 100%; height: 100%;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--card-accent) 32%, transparent), transparent 55%),
      linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%);
  }
  .pc-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--card-accent) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--card-accent) 8%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .pc-initials {
    position: relative; font-family: var(--font-display); font-size: var(--fluid-h1); font-weight: var(--font-weight-extrabold);
    line-height: 1; color: var(--fg); opacity: var(--opacity-strong);
  }

  /* ── Stacked (sm): compact row. Same look the homepage teaser shipped on
     mobile — only moved here so it is one card, not two. ── */
  @media (max-width: 767.98px) {
    .post-card--row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--gap-4);
      padding: var(--gap-2);
      background: var(--color-surface-elevated);
      /* 480 is a comfortable single-column reading cap; centres itself on
         anything wider (phones up through small portrait tablets). */
      max-width: 480px;
      width: 100%;
      margin-inline: auto;
    }
    .post-card--row:hover { transform: none; }
    .post-card--row:active { background: var(--surface-2); transform: scale(0.98); }
    .post-card--row:active .pc-thumb { transform: scale(1.06); }
    .post-card--row:active h3 { color: var(--accent-warm); }
    .post-card--row .pc-thumb-wrap { width: 5.5rem; aspect-ratio: 1; flex: 0 0 auto; border-radius: var(--radius-md); }
    .post-card--row .pc-dot,
    .post-card--row .pc-arrow,
    .post-card--row .pc-excerpt,
    .post-card--row .pc-meta { display: none; }
    .post-card--row .pc-content { padding: 0; min-width: 0; gap: 0; }
    .post-card--row .pc-cat-row { margin-bottom: var(--gap-2); }
    .post-card--row .pc-category {
      display: inline-flex;
      font-family: var(--font-body);
      font-size: var(--fluid-body-sm);
      text-transform: none;
      letter-spacing: 0;
      color: var(--fg-muted);
      background: color-mix(in srgb, var(--neutral-0) 8%, transparent);
      padding: 0.1875rem 0.375rem;
      border-radius: var(--radius-sm);
    }
    .post-card--row .pc-launch { display: grid; }
    .post-card--row:active .pc-launch { background: color-mix(in srgb, var(--neutral-0) 18%, transparent); }
    .post-card--row h3 {
      font-size: var(--fluid-body-lg);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
