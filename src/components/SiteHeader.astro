---
interface Props { companyEmail?: string; }
const { companyEmail } = Astro.props;
const email = companyEmail || 'hello@wugweb.com';
const phone = '+91 88021 39220';
// Labels match the real nav exactly — note "Works", plural. The route stays
// /work; only the label was wrong. See design.md C-15.
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Works' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="site-header">
  <nav class="wrap site-header-inner">
    <a href="/" class="site-logo" aria-label="wugweb — home">
      <span class="site-logo-wug">wug</span><span class="site-logo-web">web</span>
    </a>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="site-links" id="nav-menu">
      {navLinks.map((l) => (
        <a href={l.href} class="nav-link">{l.label}</a>
      ))}
      <a href="/contact-us" class="btn btn-solid mobile-cta">Let's Talk</a>

      <!-- Contact + legal block, mobile panel only. Matches the real
           expanded nav — see design.md §2.3. -->
      <div class="menu-meta">
        <a class="menu-contact" href={`mailto:${email}`}>
          <span class="menu-contact-label">Get in touch</span>
          <span class="menu-contact-value">{email}</span>
        </a>
        <a class="menu-contact" href={`tel:${phone.replace(/\s/g, '')}`}>
          <span class="menu-contact-label">Call us at</span>
          <span class="menu-contact-value">{phone}</span>
        </a>
        <div class="menu-legal">
          <a href="/termsofuse">Terms of Service</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="menu-copyright">Copyright 2020-2025 © Wugweb®</p>
      </div>
    </div>
    <a href="/contact-us" class="btn btn-solid desktop-cta">Let's Talk</a>
  </nav>
</header>

<style>
  /* The real nav is a floating bar inset from the viewport edges — not a
     full-bleed header. Measured off the live site: 12px radius, #2b2b2b,
     blur(40px), 78px tall, 16px side inset on mobile / container gutter
     on desktop, sitting 16–20px below the top. Mobile-first. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 1rem 1rem 0;
    background: transparent;
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1280px;
    margin-inline: auto;
    min-height: 78px;
    padding-inline: 1rem;
    border-radius: var(--r-md);
    background: var(--surface-2);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    /* Present on every nav variant in the Framer export — design.md §2.1 */
    box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.25);
  }
  /* Two-tone wordmark: "wug" white, "web" in /Primary/Grey #c9c9c9.
     This is the real lockup — not the W icon, which is a separate 54×54
     asset used where only a mark fits. See design.md §2.5. */
  .site-logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-size: 1.375rem;
    line-height: 1;
  }
  .site-logo-wug { color: #ffffff; }
  .site-logo-web { color: #c9c9c9; }
  /* Nav links are the same 8px/#444 buttons the live site uses. */
  .site-links { display: none; gap: 0.5rem; font-size: var(--t-micro); }
  .site-links .nav-link {
    text-decoration: none;
    color: var(--fg);
    padding: 0.625rem 1rem;
    border-radius: var(--r);
    background: #444;
    transition: background 0.2s ease;
  }
  .site-links .nav-link:hover { background: #555; }
  .desktop-cta { display: none; }
  .mobile-cta { display: none; }

  .hamburger { display: flex; flex-direction: column; gap: 4px; background: none; border: none; cursor: pointer; padding: 4px; z-index: 20; }
  .hamburger span { display: block; width: 22px; height: 2px; background: var(--fg); border-radius: 2px; transition: transform 0.3s, opacity 0.3s; }
  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .site-links.open {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    background: var(--bg);
    padding: 6rem 2rem 2rem;
    gap: 0.75rem;
    font-size: var(--t-lead);
    align-items: stretch;
    justify-content: center;
    z-index: 15;
  }
  .site-links.open .nav-link { text-align: center; padding: 1rem; }
  .site-links.open .mobile-cta { display: inline-flex; justify-content: center; margin-top: 0.5rem; }
  .site-links.open .menu-meta { display: flex; }

  .menu-meta { display: none; flex-direction: column; gap: 0.5rem; margin-top: 1.5rem; }
  .menu-contact {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding: 0.85rem 1rem;
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: var(--fg);
  }
  .menu-contact:hover { background: rgba(255, 255, 255, 0.09); }
  .menu-contact-label { font-size: var(--t-micro); color: var(--fg-subtle); }
  .menu-contact-value { font-size: var(--t-body); }
  .menu-legal { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.75rem; }
  .menu-legal a { font-size: var(--t-sm); color: var(--fg-muted); text-decoration: none; }
  .menu-legal a:hover { color: var(--fg); }
  .menu-copyright { margin-top: 0.75rem; text-align: center; font-size: var(--t-micro); color: var(--fg-subtle); }

  /* 768px and 1200px are the live site's own breakpoints. */
  @media (min-width: 768px) {
    .site-header { padding: 1.25rem 1.5rem 0; }
    .site-header-inner { padding-inline: 1.25rem; }
    .hamburger { display: none; }
    .site-links { display: flex; }
    .desktop-cta { display: inline-flex; }
    .site-links.open {
      position: static; flex-direction: row; padding: 0; gap: 0.5rem;
      font-size: var(--t-micro); background: none; align-items: center;
    }
    .site-links.open .nav-link { padding: 0.625rem 1rem; }
    .site-links.open .mobile-cta { display: none; }
    .site-links.open .menu-meta { display: none; }
  }
  @media (min-width: 1200px) {
    .site-header { padding-inline: 3rem; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const menu = document.getElementById('nav-menu');
  if (hamburger && menu) {
    hamburger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', open);
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('open');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
