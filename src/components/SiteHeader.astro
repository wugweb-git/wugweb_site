---
interface Props { companyEmail?: string; }
const { companyEmail } = Astro.props;
const email = companyEmail || 'hello@wugweb.com';
const phone = '+91 88021 39220';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// Matches component/Nav Bar screenshots + design.md §2.3 — Works plural; FAQ lives in footer.
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Works' },
  { href: '/blog', label: 'Blog' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <nav class="site-header-inner" id="site-nav" data-open="false" aria-label="Primary">
    <div class="nav-top">
      <a href="/" class="site-logo" aria-label="wugweb — home">
        <img src="/brand/logo-large.svg" alt="wugweb" width="149" height="54" class="site-logo-img" />
      </a>

      <div class="site-links" id="nav-menu">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', { 'is-active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >{l.label}</a>
        ))}
        <a href="https://wa.me/919205996219" class="nav-cta mobile-cta" aria-label="Chat with Wugweb on WhatsApp">
          <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Let's Talk
        </a>
      </div>

      <a href="https://wa.me/919205996219" class="nav-cta desktop-cta" aria-label="Chat with Wugweb on WhatsApp">
        <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Let's Talk
      </a>

      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="nav-toggle-close" aria-hidden="true">×</span>
      </button>
    </div>

    <!-- Mobile-only contact / legal (design.md §2.3 + Nav Bar 04X Expanded) -->
    <div class="menu-meta" id="nav-meta">
      <a class="menu-contact" href={`mailto:${email}`}>
        <span class="menu-contact-label">Get in touch</span>
        <span class="menu-contact-value">
          <span class="menu-icon" aria-hidden="true">✉</span>
          {email}
        </span>
      </a>
      <a class="menu-contact" href={`tel:${phone.replace(/\s/g, '')}`}>
        <span class="menu-contact-label">Call us at</span>
        <span class="menu-contact-value">
          <span class="menu-icon" aria-hidden="true">☎</span>
          {phone}
        </span>
      </a>
      <div class="menu-legal">
        <a href="/termsofuse">Terms of Service</a>
        <a href="/privacy-policy">Privacy Policy</a>
      </div>
      <p class="menu-copyright">Copyright 2020-2025 © Wugweb®</p>
    </div>
  </nav>
</header>

<style>
  /* Floating inset bar — design.md §2.1 / component Nav Bar *X.png */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: var(--gap-4) var(--gap-4) 0;
    background: transparent;
  }

  .site-header-inner {
    max-width: 1280px;
    margin-inline: auto;
    border-radius: var(--radius-md);
    background: var(--neutral-7);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    box-shadow: var(--shadow-nav);
    overflow: hidden;
    transition: min-height var(--duration-normal) var(--easing-out);
  }

  .nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-4);
    min-height: var(--nav-height);
    padding-inline: var(--gap-4);
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    line-height: var(--core-line-height-none);
  }
  .site-logo-img {
    display: block;
    height: 34px;
    width: auto;
    max-width: 160px;
  }
  @media (min-width: 768px) {
    .site-logo-img { height: 40px; }
  }

  .site-links {
    display: none;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--fluid-label);
    font-weight: var(--font-weight-medium);
  }

  .nav-link {
    text-decoration: none;
    color: var(--fg);
    padding: var(--gap-2) var(--gap-4);
    border-radius: var(--radius-sm);
    background: var(--neutral-6);
    transition: background var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out);
  }
  .nav-link:hover { background: var(--color-surface-hover); }
  .nav-link.is-active {
    font-weight: var(--font-weight-semibold);
    background: var(--color-surface-hover);
  }

  /* Yellow CTA — only yellow in the bar (design.md §2.3) */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2);
    text-decoration: none;
    font-family: var(--core-font-family-base);
    font-size: var(--fluid-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--core-line-height-normal);
    padding: var(--gap-2) var(--gap-5);
    border-radius: var(--radius-sm);
    background: var(--color-yellow);
    color: var(--color-ash);
    border: 0;
    cursor: pointer;
    transition: filter var(--duration-fast) var(--easing-out), transform var(--duration-instant) var(--easing-out);
  }
  .wa-icon { width: 16px; height: 16px; flex-shrink: 0; }
  .nav-cta:hover { filter: brightness(1.05); }
  .nav-cta:active { transform: scale(0.97); }

  .desktop-cta { display: none; }
  .mobile-cta { display: none; }

  /* Light chip toggle — staggered bars (Nav Bar 04X.png) */
  .nav-toggle {
    position: relative;
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--neutral-3);
    cursor: pointer;
    padding: 0;
  }
  .nav-toggle-bars {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--gap-1);
    width: 18px;
  }
  .nav-toggle-bars span {
    display: block;
    height: 2px;
    background: var(--neutral-10);
    border-radius: 2px;
  }
  .nav-toggle-bars span:nth-child(1) { width: 18px; }
  .nav-toggle-bars span:nth-child(2) { width: 14px; }
  .nav-toggle-bars span:nth-child(3) { width: 10px; }
  .nav-toggle-close {
    display: none;
    font-size: var(--ts-h2-size);
    line-height: 1;
    color: var(--neutral-10);
    font-weight: var(--font-weight-regular);
  }

  .menu-meta { display: none; }

  /* Mobile expanded = same bar grows to fit the viewport (~698px on a
     375×812 phone), never taller. One scroll container, no nested scroll. */
  .site-header-inner[data-open='true'] {
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--gap-6);
    overflow-y: auto;
  }
  .site-header-inner[data-open='true'] .nav-toggle-bars { display: none; }
  .site-header-inner[data-open='true'] .nav-toggle-close { display: block; }
  .site-header-inner[data-open='true'] .nav-toggle { background: var(--neutral-2); }

  .site-header-inner[data-open='true'] .site-links {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    padding: 0 var(--gap-4);
    gap: var(--gap-2);
    margin-top: var(--gap-2);
    font-size: var(--fluid-body-lg);
  }
  .site-header-inner[data-open='true'] .nav-top {
    flex-wrap: wrap;
  }
  .site-header-inner[data-open='true'] .site-links {
    order: 3;
    flex-basis: 100%;
  }
  .site-header-inner[data-open='true'] .nav-link {
    text-align: center;
    padding: var(--gap-4);
    font-weight: var(--font-weight-bold);
  }
  .site-header-inner[data-open='true'] .mobile-cta {
    display: inline-flex;
    width: 100%;
    padding: var(--gap-4);
    font-weight: var(--font-weight-bold);
  }
  .site-header-inner[data-open='true'] .menu-meta {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
    margin-top: auto;
    padding: var(--gap-6) var(--gap-4) 0;
  }

  .menu-contact {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
    padding: var(--gap-3) var(--gap-4);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--neutral-0) 5%, transparent);
    text-decoration: none;
    color: var(--fg);
  }
  .menu-contact:hover { background: color-mix(in srgb, var(--neutral-0) 9%, transparent); }
  .menu-contact-label {
    font-size: var(--fluid-caption);
    font-weight: var(--font-weight-medium);
    color: var(--fg-subtle);
  }
  .menu-contact-value {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--fluid-body-md);
    font-weight: var(--font-weight-medium);
  }
  .menu-icon { opacity: var(--opacity-soft); }
  .menu-legal {
    display: flex;
    justify-content: space-between;
    gap: var(--gap-4);
    margin-top: var(--gap-3);
  }
  .menu-legal a {
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .menu-legal a:hover { color: var(--fg); }
  .menu-copyright {
    margin-top: var(--gap-3);
    text-align: center;
    font-size: var(--fluid-caption);
    color: var(--fg-subtle);
  }

  @media (min-width: 768px) {
    .site-header { padding: var(--gap-5) var(--gap-6) 0; }
    .nav-top { padding-inline: var(--gap-5); }
    .nav-toggle { display: none; }
    .menu-meta { display: none !important; }

    .site-links {
      display: flex;
      margin-left: auto;
    }
    .desktop-cta { display: inline-flex; }
    .mobile-cta { display: none !important; }

    .site-header-inner[data-open='true'] {
      min-height: var(--nav-height);
      max-height: none;
      overflow: visible;
      padding-bottom: 0;
    }
    .site-header-inner[data-open='true'] .site-links {
      flex-direction: row;
      flex-basis: auto;
      width: auto;
      order: 0;
      margin-top: 0;
      padding: 0;
      font-size: var(--fluid-label);
    }
    .site-header-inner[data-open='true'] .nav-link {
      padding: var(--gap-2) var(--gap-4);
      font-weight: var(--font-weight-medium);
      text-align: left;
    }
    .site-header-inner[data-open='true'] .nav-link.is-active {
      font-weight: var(--font-weight-semibold);
    }
  }

  @media (min-width: 1200px) {
    .site-header { padding-inline: var(--gap-12); }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  if (nav && toggle) {
    const setOpen = (open) => {
      nav.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open && window.matchMedia('(max-width: 767px)').matches ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(nav.dataset.open !== 'true');
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
    });
  }
</script>
