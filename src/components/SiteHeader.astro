---
interface Props { companyEmail?: string; }
const { companyEmail } = Astro.props;
const email = companyEmail || 'hello@wugweb.com';
const phone = '+91 92059 96219';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// Matches component/Nav Bar screenshots + design.md §2.3 — Works plural; FAQ lives in footer.
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Works' },
  { href: '/blog', label: 'Blog' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <nav class="site-header-inner" id="site-nav" data-open="false" aria-label="Primary">
    <div class="nav-top">
      <a href="/" class="site-logo" aria-label="wugweb — home">
        <img src="/brand/logo-large.svg" alt="wugweb" width="149" height="54" class="site-logo-img" />
      </a>

      <div class="site-links" id="nav-menu">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', { 'is-active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >{l.label}</a>
        ))}
        <a href="/contact-us" class="nav-cta mobile-cta" aria-label="Contact Wugweb" data-gtag-event="cta_click" data-gtag-location="nav_mobile" data-gtag-label="lets_talk">
          Let's Talk
        </a>
      </div>

      <a href="/contact-us" class="nav-cta desktop-cta" aria-label="Contact Wugweb" data-gtag-event="cta_click" data-gtag-location="nav_desktop" data-gtag-label="lets_talk">
        Let's Talk
      </a>

      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>

    <!-- Mobile-only contact / legal (design.md §2.3 + Nav Bar 04X Expanded) -->
    <div class="menu-meta" id="nav-meta">
      <div class="menu-contact-group">
        <a class="menu-contact" href={`mailto:${email}`} data-gtag-event="contact_click" data-gtag-method="email" data-gtag-location="menu">
          <span class="menu-contact-label">Get in touch</span>
          <span class="menu-contact-value">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            {email}
          </span>
        </a>
        <a class="menu-contact" href={`tel:${phone.replace(/\s/g, '')}`} data-gtag-event="contact_click" data-gtag-method="phone" data-gtag-location="menu">
          <span class="menu-contact-label">Call us at</span>
          <span class="menu-contact-value">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {phone}
          </span>
        </a>
      </div>
      <div class="menu-legal">
        <a href="/termsofuse">Terms of Service</a>
        <a href="/privacy-policy">Privacy Policy</a>
      </div>
      <p class="menu-copyright">Copyright 2020-2025 © Wugweb®</p>
    </div>
  </nav>
</header>

<style>
  /* Floating inset bar — design.md §2.1 / component Nav Bar *X.png */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-nav);   /* 10 — layout-shell.md */
    /* The bar floats inset from the screen edge; under viewport-fit=cover
       that edge is behind the notch, so the insets are added to the gutter. */
    /* layout-shell.md, 2026-10-03: 16px mobile / 20px 32px tablet / 20px
       desktop. SUPERSEDES the earlier audit §3 decision here, which had chosen
       a single fluid 16→32 inset over exactly these stepped values as
       "non-monotonic". The spec was supplied explicitly and wins. Safe-area
       insets are still added so the bar clears the notch. */
    padding: calc(var(--safe-top) + 16px)
             calc(var(--safe-right) + 16px)
             16px
             calc(var(--safe-left) + 16px);
    background: transparent;
  }

  /* The bar is grabbable — layout-shell.md. Links and buttons keep the pointer. */
  .site-header-inner { cursor: grab; }
  .site-header-inner :is(a, button) { cursor: pointer; }
  .site-header-inner {
    /* rem, not px, so the bar grows with the root scale above 1440px along
       with .wrap - a hard px cap here pinned it at 1280 while the content
       inside it scaled, which is the one thing that must not drift apart. */
    max-width: 80rem;
    margin-inline: auto;
    border-radius: var(--radius-md);
    background: var(--neutral-7);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    box-shadow: var(--shadow-nav);
    overflow: hidden;
    /* Audit §7.1: this used to read `min-height`, but the open state changes
       `height` - so the transition could never fire and the menu simply
       appeared. Both ends are definite values now, so it animates. */
    transition: height var(--duration-spring) var(--ease-spring);
  }

  .nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-4);
    min-height: var(--nav-height);
    padding-inline: var(--gap-4);
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    line-height: var(--core-line-height-none);
  }
  .site-logo-img {
    display: block;
    /* Measured against the old site at 390px: its wordmark is ~125 wide, ours
       was 94 - noticeably smaller in the same bar. At this aspect (2.76:1),
       45px of height puts it back at ~124. */
    height: 45px;
    width: auto;
    max-width: 160px;
  }
  @media (min-width: 768px) {
    .site-logo-img { height: var(--nav-logo-height); max-width: none; }
  }

  .site-links {
    display: none;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--fluid-label);
    font-weight: var(--font-weight-medium);
  }

  .nav-link {
    text-decoration: none;
    color: var(--fg);
    padding: var(--gap-2) var(--gap-4);
    border-radius: var(--radius-sm);
    background: var(--neutral-6);
    transition: background var(--duration-spring) var(--ease-spring), color var(--duration-spring) var(--ease-spring);
  }
  .nav-link:hover { background: var(--color-surface-hover); }
  .nav-link.is-active {
    font-weight: var(--font-weight-semibold);
    background: var(--color-surface-hover);
  }

  /* Yellow CTA — only yellow in the bar (design.md §2.3) */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2);
    text-decoration: none;
    font-family: var(--core-font-family-base);
    font-size: var(--fluid-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--core-line-height-normal);
    padding: var(--gap-2) var(--gap-5);
    border-radius: var(--radius-sm);
    background: var(--color-yellow);
    color: var(--color-ash);
    border: 0;
    cursor: pointer;
    transition: filter var(--duration-spring) var(--ease-spring), transform var(--duration-spring) var(--ease-spring);
  }
  .wa-icon { width: 16px; height: 16px; flex-shrink: 0; }
  .nav-cta:hover { filter: brightness(1.05); }
  .nav-cta:active { transform: scale(0.97); }

  .desktop-cta { display: none; }
  .mobile-cta { display: none; }

  /* Light chip toggle — staggered bars (Nav Bar 04X.png) */
  .nav-toggle {
    position: relative;
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--neutral-3);
    cursor: pointer;
    padding: 0;
  }
  .nav-toggle-bars {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--gap-1);
    width: 18px;
  }
  .nav-toggle-bars span {
    display: block;
    height: 2px;
    background: var(--neutral-10);
    border-radius: 2px;
    transform-origin: center;
    /* Audit §7.2 wanted a morph rather than two icons toggled with `display`.
       The stack is 2+4+2+4+2 = 14px tall, so the outer bars travel 6px to meet
       on the centre line before rotating. */
    transition: transform var(--duration-spring) var(--ease-spring),
                opacity var(--duration-spring) var(--ease-spring),
                width var(--duration-spring) var(--ease-spring);
  }
  .nav-toggle-bars span:nth-child(1) { width: 18px; }
  .nav-toggle-bars span:nth-child(2) { width: 14px; }
  .nav-toggle-bars span:nth-child(3) { width: 10px; }
  .menu-meta { display: none; }

  /* The closed end of that transition. Mobile only - the desktop bar still
     sizes to its content (see the min-width: 768px block below). */
  @media (max-width: 767.98px) {
    .site-header-inner { height: var(--nav-height); }
  }

  /* Mobile expanded = same bar grows to fit the viewport (~698px on a
     375×812 phone), never taller. One scroll container, no nested scroll. */
  .site-header-inner[data-open='true'] {
    /* Full-height sheet rather than a card that hugs its content. The old
       Framer menu stopped at ~80% of the viewport (measured 677px of 844px);
       this fills the screen instead, per audit §7's "open menu covers the
       full screen".
       Insets are mirrored top and bottom so it still reads as the same
       floating card the closed bar is, and both safe-area insets are
       subtracted - .site-header supplies the top one, so failing to subtract
       it is what made the card overflow before (audit §7.3).
       svh first as the fallback: browsers without dvh take it, and it is the
       stable小 viewport so the sheet never grows past the screen when the
       address bar retracts. */
    height: calc(100svh - var(--safe-top) - var(--safe-bottom) - var(--gap-4) * 2);
    height: calc(100dvh - var(--safe-top) - var(--safe-bottom) - var(--gap-4) * 2);
    max-height: none;
    display: flex;
    flex-direction: column;
    padding-bottom: calc(var(--safe-bottom) + var(--gap-6));
    overflow-y: auto;
    /* Audit §7: the card scrolls internally on short screens without handing
       the overscroll to the page behind it. */
    overscroll-behavior: contain;
  }
  /* The three bars stay and become the cross: the staggered widths even up,
     the middle rule collapses, and the outer two meet and rotate. */
  .site-header-inner[data-open='true'] .nav-toggle-bars span { width: 18px; }
  .site-header-inner[data-open='true'] .nav-toggle-bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header-inner[data-open='true'] .nav-toggle-bars span:nth-child(2) {
    opacity: var(--opacity-0);
    transform: scaleX(0);
  }
  .site-header-inner[data-open='true'] .nav-toggle-bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .site-header-inner[data-open='true'] .nav-toggle { background: var(--neutral-2); }

  .site-header-inner[data-open='true'] .site-links {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: clamp(var(--gap-2), 2.4vw, var(--gap-3));
    /* No gutter of its own: .nav-top already applies padding-inline, and adding
       a second one here put the links and CTA 32px from the card edge while the
       logo, contact rows and legal sat at 16px (audit §7, "3 distinct left
       edges"). Measured 2 on the current build; this makes it 1. */
    padding: 0;
    gap: var(--gap-2);
    margin-top: var(--gap-2);
    font-size: var(--fluid-body-lg);
  }
  .site-header-inner[data-open='true'] .nav-top {
    flex-wrap: wrap;
    /* Lines stack from the top instead of sharing the grown container height. */
    align-content: flex-start;
  }
  /* Holds the first flex line at the closed bar's height, so the toggle centres
     in the same 78px band whether the menu is open or shut - measured jump was
     -17px before this. */
  .site-header-inner[data-open='true'] .site-logo {
    min-height: var(--nav-height);
    display: flex;
    align-items: center;
  }
  .site-header-inner[data-open='true'] .site-links {
    order: 3;
    flex-basis: 100%;
  }
  .site-header-inner[data-open='true'] .nav-link {
    text-align: left;
    padding: var(--gap-4);
    font-weight: var(--font-weight-bold);
    /* Audit §7 "Fluid nav values", with the old site's measurements as the
       caps: it renders these at ~26px and 58px tall, we were at 16px in a
       56px row - a full reading size smaller in a full-screen sheet. */
    font-size: clamp(18px, 5vw, 22px);
    min-height: clamp(48px, 12.5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    line-height: var(--core-line-height-tight);
  }
  .site-header-inner[data-open='true'] .mobile-cta {
    display: inline-flex;
    width: 100%;
    padding: var(--gap-4);
    font-weight: var(--font-weight-bold);
    /* .nav-cta sets --fluid-label (12px) for the compact desktop bar. In the
       open sheet it sits in the same stack as the nav links, which render at
       16px - so it read a size smaller than everything above it. Match them.
       The old site goes further and styles this identically to the other
       links; the yellow fill is a deliberate departure (CLAUDE.md), the size
       difference was not. */
    font-size: clamp(18px, 5vw, 22px);
    min-height: clamp(48px, 12.5vw, 56px);
    align-items: center;
    justify-content: flex-start;
    line-height: var(--core-line-height-tight);
  }
  .site-header-inner[data-open='true'] .menu-meta {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
    margin-top: auto;
    padding: var(--gap-6) var(--gap-4) 0;
  }
  /* One grouped block, rows recessed INTO it. The sheet is the lighter
     surface and the rows sit below it, which is the inverse of the two
     lighter cards these used to be - they read as raised chips on a dark
     sheet, where the reference recesses them. Rounding and the divider live
     on the group so the two rows read as one control. */
  .site-header-inner[data-open='true'] .menu-contact-group {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-elevated);
  }

  .menu-contact {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
    padding: var(--gap-3) var(--gap-4);
    /* Recessed rather than raised: darker than the sheet behind it. The
       radius and the divider belong to .menu-contact-group, so the pair reads
       as a single block instead of two chips. */
    background: color-mix(in srgb, var(--neutral-10) 38%, transparent);
    text-decoration: none;
    color: var(--fg);
  }
  .menu-contact + .menu-contact {
    border-top: var(--stroke-thin) solid var(--line);
  }
  .menu-contact:hover { background: color-mix(in srgb, var(--neutral-10) 22%, transparent); }
  .menu-contact-label {
    font-size: var(--fluid-caption);
    font-weight: var(--font-weight-medium);
    color: var(--fg-subtle);
  }
  .menu-contact-value {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--fluid-body-md);
    font-weight: var(--font-weight-medium);
  }
  .menu-icon { opacity: var(--opacity-soft); }
  .menu-legal {
    display: flex;
    justify-content: space-between;
    gap: var(--gap-4);
    margin-top: var(--gap-3);
  }
  .menu-legal a {
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .menu-legal a:hover { color: var(--fg); }
  .menu-copyright {
    margin-top: var(--gap-3);
    text-align: center;
    font-size: var(--fluid-caption);
    color: var(--fg-subtle);
  }

  @media (min-width: 768px) {
    .site-header {
      padding: calc(var(--safe-top) + 20px) calc(var(--safe-right) + 32px)
               20px calc(var(--safe-left) + 32px);
    }
    .nav-top { padding-inline: var(--nav-bar-pad); gap: var(--nav-item-gap); }
    /* Original wugweb.com bar: heavier 40px blur, no extra saturation. */
    .site-header-inner {
      backdrop-filter: blur(var(--blur-xl));
      -webkit-backdrop-filter: blur(var(--blur-xl));
    }
    .nav-toggle { display: none; }
    .menu-meta { display: none !important; }

    .site-links {
      display: flex;
      margin-left: auto;
      gap: var(--nav-item-gap);
    }
    /* The header is 100px on every breakpoint (layout-shell.md), so this bar
       is 60px at tablet and desktop. Link sizes follow the original wugweb.com
       bar's proportions scaled into it (see the --nav-* tokens). */
    .nav-link,
    .nav-cta {
      font-size: var(--nav-link-size);
      font-weight: var(--font-weight-regular);
      line-height: var(--nav-link-line);
      padding-block: var(--nav-link-pad-block);
      padding-inline: var(--nav-link-pad-inline);
      display: inline-flex;
      align-items: center;
    }
    .nav-link.is-active { font-weight: var(--font-weight-medium); }
    .desktop-cta { display: inline-flex; }
    .mobile-cta { display: none !important; }

    .site-header-inner[data-open='true'] {
      min-height: var(--nav-height);
      height: auto;
      max-height: none;
      overflow: visible;
      padding-bottom: 0;
    }
    .site-header-inner[data-open='true'] .site-links {
      flex-direction: row;
      flex-basis: auto;
      width: auto;
      order: 0;
      margin-top: 0;
      padding: 0;
      font-size: var(--fluid-label);
    }
    .site-header-inner[data-open='true'] .nav-link {
      padding: var(--gap-2) var(--gap-4);
      font-weight: var(--font-weight-medium);
      text-align: left;
    }
    .site-header-inner[data-open='true'] .nav-link.is-active {
      font-weight: var(--font-weight-semibold);
    }
  }

  @media (min-width: 1200px) {
    .site-header {
      padding: calc(var(--safe-top) + 20px) calc(var(--safe-right) + 20px)
               20px calc(var(--safe-left) + 20px);
    }
  }
</style>

<script>
  // Behaviour lives in src/lib/site-header.ts so Storybook can run it too.
  import { initSiteHeader } from '../lib/site-header';
  initSiteHeader();
  document.addEventListener('astro:page-load', initSiteHeader);
</script>
