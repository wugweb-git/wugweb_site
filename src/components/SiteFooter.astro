---
interface Props { copyright?: string; companyEmail?: string; }
const { copyright, companyEmail } = Astro.props;
const footerLinks = [
  { href: '/faq', label: 'FAQs' },
  { href: '/footer/impact', label: 'Impact' },
  { href: '/footer/industries', label: 'Industries' },
  { href: '/footer/subscription', label: 'Subscription' },
  { href: '/footer/sitemap', label: 'Sitemap' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/footer/cookie-policy', label: 'Cookie Policy' },
  { href: '/termsofuse', label: 'Terms of Use' },
  { href: '/footer/refund-policy', label: 'Refund Policy' },
  { href: '#', label: 'Cookie Settings', isAction: true },
];
---

<footer class="site-footer">
  <div class="wrap site-footer-inner">
    <div class="footer-brand">
      <p class="footer-tagline">Let's Build Great Experiences Together</p>
      <p class="footer-email">
        <a href={`mailto:${companyEmail || 'hello@wugweb.com'}`}>{companyEmail || 'hello@wugweb.com'}</a>
      </p>
    </div>
    <p class="footer-copy">{copyright || '© 2020–2026 Wugweb. All rights reserved.'}</p>
    <div class="footer-links">
      {footerLinks.map((l) => (
        l.isAction ? (
          <button class="footer-action-btn" id="btn-footer-cookie-settings">{l.label}</button>
        ) : (
          <a href={l.href}>{l.label}</a>
        )
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--stroke-thin) solid var(--line);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-6);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-section-md);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
  }

  .footer-tagline {
    color: var(--fg);
    font-size: var(--t-sm);
  }

  .footer-email a {
    color: var(--accent);
    text-decoration: none;
  }

  .footer-email a:hover {
    text-decoration: underline;
  }

  .footer-copy {
    color: var(--fg-muted);
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-4) var(--gap-6);
  }

  .footer-links a, .footer-action-btn {
    text-decoration: none;
    color: var(--fg-muted);
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .footer-links a:hover, .footer-action-btn:hover {
    color: var(--fg);
  }
</style>
