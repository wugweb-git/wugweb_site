---
const footerLinks = [
  { href: '/faq', label: 'FAQs' },
  { href: '/footer/impact', label: 'Impact' },
  { href: '/footer/subscription', label: 'Subscription' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/termsofuse', label: 'Terms of Use' },
  { href: '/refund-policy', label: 'Refund Policy' },
];
---

<footer class="site-footer">
  <div class="wrap site-footer-inner">
    <div class="footer-brand">
      <p class="footer-tagline">Let's Build Great Experiences Together</p>
      <p class="footer-email">
        <a href="mailto:hello@wugweb.com">hello@wugweb.com</a>
      </p>
    </div>
    <p class="footer-copy">© 2020–2026 Wugweb. All rights reserved.</p>
    <div class="footer-links">
      {footerLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-tagline {
    color: var(--fg);
    font-size: 0.85rem;
  }

  .footer-email a {
    color: var(--accent);
    text-decoration: none;
  }

  .footer-email a:hover {
    text-decoration: underline;
  }

  .footer-copy {
    color: var(--fg-muted);
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--fg-muted);
  }

  .footer-links a:hover {
    color: var(--fg);
  }
</style>
