---
interface Props {
  tags: string[];
  activeClass?: string;
}

const { tags } = Astro.props;
---

<div class="filter-chips">
  {tags.map((c) => (
    <button class="filter-chip" data-category={c}>{c}</button>
  ))}
</div>

<style>
  .filter-chips { display: flex; gap: var(--gap-2); flex-wrap: wrap; padding-block: var(--gap-8); border-top: 1px solid var(--line); }
  .filter-chip { font-family: var(--font-mono); font-size: var(--t-micro); padding: var(--gap-2) var(--gap-4); border-radius: var(--r-pill); border: 1px solid var(--line); background: transparent; color: var(--fg-muted); cursor: pointer; transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .filter-chip:hover { border-color: var(--fg); color: var(--fg); }
  .filter-chip.active { border-color: var(--accent); color: var(--accent); background: rgba(255,190,26,.1); }
</style>

<script>
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('[data-filter]').forEach(item => {
        const cats = (item.dataset.filter || '').split(',');
        if (cat === 'All' || cats.includes(cat) || cats.length === 0) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
