---
import { urlFor } from '../lib/sanity';
import { assetUrl } from '../lib/assets';

export interface Props {
  value?: any[] | null;
  class?: string;
}

const { value = [], class: className = '' } = Astro.props;
const blocks = Array.isArray(value) ? value : [];

function slugify(text: string = '') {
  return text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function escapeHtml(str: string = '') {
  return str
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
}

function renderChildren(children: any[] = [], markDefs: any[] = []): string {
  if (!Array.isArray(children)) return '';
  return children
    .map((child) => {
      if (!child) return '';
      let text = escapeHtml(child.text || '');
      if (!child.marks || !Array.isArray(child.marks) || child.marks.length === 0) {
        return text;
      }

      for (const mark of child.marks) {
        if (mark === 'strong') text = `<strong>${text}</strong>`;
        else if (mark === 'em') text = `<em>${text}</em>`;
        else if (mark === 'code') text = `<code class="pt-inline-code">${text}</code>`;
        else if (mark === 'underline') text = `<u>${text}</u>`;
        else if (mark === 'strike-through') text = `<s>${text}</s>`;
        else if (mark === 'highlight') text = `<mark class="pt-highlight">${text}</mark>`;
        else {
          const def = markDefs.find((d: any) => d?._key === mark);
          if (def && def._type === 'link') {
            const href = escapeHtml(def.href || '#');
            const target = def.blank ? ' target="_blank" rel="noopener noreferrer"' : '';
            text = `<a href="${href}" class="pt-link"${target}>${text}</a>`;
          } else if (def && def._type === 'internalLink') {
            const ref = def.reference;
            let href = '#';
            if (ref?.slug?.current) {
              if (ref._type === 'post') href = `/blog/${ref.slug.current}`;
              else if (ref._type === 'caseStudy') href = `/work/${ref.slug.current}`;
              else if (ref._type === 'service') href = `/services/${ref.slug.current}`;
            } else if (ref?.pageId) {
              href = ref.pageId === 'home' ? '/' : `/${ref.pageId}`;
            }
            text = `<a href="${escapeHtml(href)}" class="pt-link pt-internal-link">${text}</a>`;
          }
        }
      }
      return text;
    })
    .join('');
}

function resolveMediaSrc(urlOrPath?: string | any): string {
  if (!urlOrPath) return '';
  if (typeof urlOrPath === 'string') {
    return /^https?:\/\//.test(urlOrPath) ? urlOrPath : assetUrl(urlOrPath);
  }
  if (urlOrPath.asset || urlOrPath._ref) {
    try {
      return urlFor(urlOrPath).url();
    } catch {
      return '';
    }
  }
  return '';
}

// Group contiguous list items into single <ul> or <ol> containers
interface GroupedBlock {
  type: 'single' | 'list';
  listItem?: 'bullet' | 'number';
  items?: any[];
  block?: any;
}

const groupedBlocks: GroupedBlock[] = [];
let currentList: { type: 'bullet' | 'number'; items: any[] } | null = null;

for (const b of blocks) {
  if (!b) continue;
  if (b._type === 'block' && b.listItem) {
    const listType = b.listItem === 'number' ? 'number' : 'bullet';
    if (currentList && currentList.type === listType) {
      currentList.items.push(b);
    } else {
      if (currentList) {
        groupedBlocks.push({ type: 'list', listItem: currentList.type, items: currentList.items });
      }
      currentList = { type: listType, items: [b] };
    }
  } else {
    if (currentList) {
      groupedBlocks.push({ type: 'list', listItem: currentList.type, items: currentList.items });
      currentList = null;
    }
    groupedBlocks.push({ type: 'single', block: b });
  }
}
if (currentList) {
  groupedBlocks.push({ type: 'list', listItem: currentList.type, items: currentList.items });
}
---

<div class:list={['portable-text-content', className]}>
  {groupedBlocks.map((group) => {
    if (group.type === 'list') {
      const ListTag = group.listItem === 'number' ? 'ol' : 'ul';
      return (
        <ListTag class="pt-list" data-reveal>
          {group.items?.map((item) => (
            <li class="pt-list-item" set:html={renderChildren(item.children, item.markDefs)} />
          ))}
        </ListTag>
      );
    }

    const b = group.block;
    if (!b || !b._type) return null;

    // ── 1. Standard text block ──
    if (b._type === 'block') {
      const plainText = b.children?.map((c: any) => c.text || '').join('') || '';
      const html = renderChildren(b.children, b.markDefs);
      if (!html.trim()) return null;

      const headingId = slugify(plainText);

      switch (b.style) {
        case 'h1':
          return <h1 id={headingId} class="pt-heading pt-h1" data-reveal set:html={html} />;
        case 'h2':
          return <h2 id={headingId} class="pt-heading pt-h2" data-reveal set:html={html} />;
        case 'h3':
          return <h3 id={headingId} class="pt-heading pt-h3" data-reveal set:html={html} />;
        case 'h4':
          return <h4 id={headingId} class="pt-heading pt-h4" data-reveal set:html={html} />;
        case 'blockquote':
          return <blockquote class="pt-blockquote" data-reveal set:html={html} />;
        default:
          return <p class="pt-paragraph" data-reveal set:html={html} />;
      }
    }

    // ── 2. Image block ──
    if (b._type === 'image') {
      const src = resolveMediaSrc(b);
      if (!src) return null;
      return (
        <figure class="pt-media pt-image-figure" data-reveal>
          <div class="pt-media-inner">
            <img src={src} alt={b.alt || ''} loading="lazy" decoding="async" class="pt-image" />
          </div>
          {b.caption && <figcaption class="pt-caption">{b.caption}</figcaption>}
        </figure>
      );
    }

    // ── 3. Video block ──
    if (b._type === 'video') {
      const src = resolveMediaSrc(b.url);
      const poster = b.poster ? resolveMediaSrc(b.poster) : undefined;
      if (!src) return null;
      return (
        <figure class="pt-media pt-video-figure" data-reveal>
          <div class="pt-media-inner pt-video-wrapper">
            <video
              src={src}
              poster={poster}
              autoplay={Boolean(b.autoplay)}
              muted={b.muted !== false}
              loop={Boolean(b.loop)}
              playsinline
              controls
              preload="metadata"
              class="pt-video"
            />
          </div>
          {b.caption && <figcaption class="pt-caption">{b.caption}</figcaption>}
        </figure>
      );
    }

    // ── 4. Media URL block ──
    if (b._type === 'mediaUrl') {
      const src = resolveMediaSrc(b.url);
      if (!src) return null;
      const isVideo = src.endsWith('.mp4') || src.endsWith('.webm') || src.endsWith('.mov');
      return (
        <figure class="pt-media" data-reveal>
          <div class="pt-media-inner">
            {isVideo ? (
              <video src={src} muted loop playsinline controls preload="metadata" class="pt-video" />
            ) : (
              <img src={src} alt={b.alt || b.caption || ''} loading="lazy" decoding="async" class="pt-image" />
            )}
          </div>
          {b.caption && <figcaption class="pt-caption">{b.caption}</figcaption>}
        </figure>
      );
    }

    // ── 5. Call To Action (CTA) ──
    if (b._type === 'cta') {
      return (
        <div class="pt-cta glass-panel" data-reveal>
          <div class="card-glow"></div>
          {b.heading && <h3 class="pt-cta-heading">{b.heading}</h3>}
          {b.body && <p class="pt-cta-body">{b.body}</p>}
          {b.buttonText && (
            <a href={b.buttonUrl || '/contact-us'} class="btn btn-solid pt-cta-btn">
              {b.buttonText}
            </a>
          )}
        </div>
      );
    }

    // ── 6. Stats Row ──
    if (b._type === 'stats' && Array.isArray(b.items)) {
      return (
        <div class="pt-stats-grid" data-reveal>
          {b.items.map((stat: any) => (
            <div class="pt-stat-item glass-panel">
              <div class="card-glow"></div>
              <span class="pt-stat-number">{stat.number}</span>
              {stat.label && <span class="pt-stat-label">{stat.label}</span>}
              {stat.description && <p class="pt-stat-desc">{stat.description}</p>}
            </div>
          ))}
        </div>
      );
    }

    // ── 7. Accordion / FAQ ──
    if (b._type === 'accordion') {
      return (
        <div class="pt-accordion" data-reveal>
          {b.title && <h3 class="pt-accordion-title">{b.title}</h3>}
          {Array.isArray(b.items) && b.items.map((item: any) => (
            <details class="pt-accordion-item glass-panel">
              <summary class="pt-accordion-question">
                <span>{item.question}</span>
                <span class="pt-accordion-icon" aria-hidden="true">+</span>
              </summary>
              <div class="pt-accordion-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      );
    }

    // ── 8. Logo Cloud ──
    if (b._type === 'logoCloud') {
      return (
        <div class="pt-logo-cloud" data-reveal>
          {b.title && <p class="pt-logo-cloud-title">{b.title}</p>}
          <div class="pt-logo-grid">
            {Array.isArray(b.logos) && b.logos.map((logo: any) => {
              const src = resolveMediaSrc(logo);
              if (!src) return null;
              const img = <img src={src} alt={logo.alt || 'Client logo'} loading="lazy" class="pt-logo-img" />;
              return logo.link ? (
                <a href={logo.link} target="_blank" rel="noopener noreferrer" class="pt-logo-item">
                  {img}
                </a>
              ) : (
                <div class="pt-logo-item">{img}</div>
              );
            })}
          </div>
        </div>
      );
    }

    // ── 9. Code Block ──
    if (b._type === 'code') {
      return (
        <div class="pt-code-wrapper glass-panel" data-reveal>
          <div class="pt-code-header">
            {b.language && <span class="pt-code-lang">{b.language}</span>}
            <button class="pt-code-copy-btn" type="button" aria-label="Copy code to clipboard">
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <pre class="pt-code-block"><code>{b.code || ''}</code></pre>
        </div>
      );
    }

    // ── 10. Two Columns ──
    if (b._type === 'twoColumns') {
      return (
        <div class:list={['pt-two-cols', `layout-${(b.layout || '50-50').replace('/', '-')}`]} data-reveal>
          <div class="pt-col-left">
            <Astro.self value={b.left} />
          </div>
          <div class="pt-col-right">
            <Astro.self value={b.right} />
          </div>
        </div>
      );
    }

    // ── 11. Callout / Alert Box ──
    if (b._type === 'callout') {
      const type = b.type || 'info';
      return (
        <div class:list={['pt-callout', `callout-${type}`, 'glass-panel']} data-reveal>
          <div class="card-glow"></div>
          <div class="pt-callout-header">
            <span class="pt-callout-badge">{type.toUpperCase()}</span>
            {b.title && <strong class="pt-callout-title">{b.title}</strong>}
          </div>
          {b.text && <p class="pt-callout-body">{b.text}</p>}
        </div>
      );
    }

    // ── 12. Quote / Testimonial Block ──
    if (b._type === 'quoteBlock') {
      const avatarSrc = resolveMediaSrc(b.avatar);
      return (
        <figure class="pt-quote-block glass-panel" data-reveal>
          <div class="card-glow"></div>
          <blockquote class="pt-quote-text">
            <p>"{b.quote || ''}"</p>
          </blockquote>
          {(b.author || b.role || b.company || avatarSrc) && (
            <figcaption class="pt-quote-author">
              {avatarSrc && <img src={avatarSrc} alt={b.author || ''} class="pt-quote-avatar" loading="lazy" />}
              <div class="pt-quote-meta">
                {b.author && <strong class="pt-quote-name">{b.author}</strong>}
                {(b.role || b.company) && (
                  <span class="pt-quote-role">
                    {b.role}{b.role && b.company ? ' @ ' : ''}{b.company}
                  </span>
                )}
              </div>
            </figcaption>
          )}
        </figure>
      );
    }

    // ── 13. Comparison / Key-Value Table ──
    if (b._type === 'comparisonTable') {
      const columns: string[] = Array.isArray(b.columns) ? b.columns : [];
      const rows: any[] = Array.isArray(b.rows) ? b.rows : [];
      return (
        <div class="pt-comparison-wrapper glass-panel" data-reveal>
          {b.title && <h4 class="pt-comparison-title">{b.title}</h4>}
          <div class="pt-table-scroll">
            <table class="pt-comparison-table">
              {columns.length > 0 && (
                <thead>
                  <tr>
                    {columns.map((col: string) => (
                      <th>{col}</th>
                    ))}
                  </tr>
                </thead>
              )}
              <tbody>
                {rows.map((row: any) => (
                  <tr>
                    <td><strong>{row.feature || '—'}</strong></td>
                    {columns.length > 1 && <td>{row.col1 || '—'}</td>}
                    {columns.length > 2 && <td>{row.col2 || '—'}</td>}
                    {columns.length > 3 && <td>{row.col3 || '—'}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    }

    // ── 14. Standard Table (@sanity/table) ──
    if (b._type === 'table' && Array.isArray(b.rows) && b.rows.length > 0) {
      const headerRow = b.rows[0];
      const bodyRows = b.rows.slice(1);
      return (
        <div class="pt-comparison-wrapper glass-panel" data-reveal>
          <div class="pt-table-scroll">
            <table class="pt-comparison-table">
              {headerRow && Array.isArray(headerRow.cells) && (
                <thead>
                  <tr>
                    {headerRow.cells.map((cell: string) => (
                      <th>{cell}</th>
                    ))}
                  </tr>
                </thead>
              )}
              <tbody>
                {bodyRows.map((row: any) => (
                  <tr>
                    {Array.isArray(row.cells) && row.cells.map((cell: string) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    }

    return null;
  })}
</div>

<style>
  .portable-text-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1.5rem);
    color: var(--color-text-secondary, #bababa);
    line-height: var(--core-line-height-relaxed, 1.7);
    font-size: var(--fluid-body-md, 1rem);
    width: 100%;
    max-width: 100%;
  }

  .portable-text-content :global(p.pt-paragraph) {
    margin: 0;
    color: var(--color-text-primary, #f4f4f4);
    font-size: var(--fluid-body-md, 1rem);
    line-height: var(--core-line-height-relaxed, 1.7);
    max-width: 72ch;
  }

  .portable-text-content :global(.pt-heading) {
    color: var(--color-text-primary, #f4f4f4);
    font-weight: var(--font-weight-semibold, 600);
    letter-spacing: -0.015em;
    margin-top: var(--space-5, 2rem);
    margin-bottom: 0;
    scroll-margin-top: 6rem;
    max-width: 72ch;
  }

  .portable-text-content :global(.pt-h1) {
    font-size: var(--fluid-h1, 2.25rem);
    line-height: 1.15;
    font-weight: var(--font-weight-bold, 700);
  }

  .portable-text-content :global(.pt-h2) {
    font-size: var(--fluid-h2, 1.75rem);
    line-height: 1.25;
    border-top: var(--stroke-thin) solid var(--color-border-subtle, rgba(255, 255, 255, 0.08));
    padding-top: var(--space-5, 2rem);
  }

  .portable-text-content :global(.pt-h3) {
    font-size: var(--fluid-h3, 1.375rem);
    line-height: 1.3;
  }

  .portable-text-content :global(.pt-h4) {
    font-size: var(--fluid-h4, 1.125rem);
    line-height: 1.4;
  }

  .portable-text-content :global(.pt-blockquote) {
    margin: var(--space-4, 1.5rem) 0;
    padding: var(--space-3, 1rem) var(--space-4, 1.5rem);
    border-left: var(--stroke-medium) solid var(--color-accent-primary, #FFBE1A);
    background: color-mix(in srgb, var(--color-accent-primary) 3%, transparent);
    border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;
    font-style: italic;
    color: var(--color-text-primary, #f4f4f4);
    font-size: var(--fluid-body-lg, 1.125rem);
    line-height: 1.6;
    max-width: 72ch;
  }

  .portable-text-content :global(.pt-list) {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    color: var(--color-text-primary, #f4f4f4);
    max-width: 72ch;
  }

  .portable-text-content :global(.pt-list-item) {
    line-height: 1.6;
  }

  .portable-text-content :global(a.pt-link),
  .portable-text-content :global(a) {
    color: var(--color-accent-primary, #FFBE1A);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .portable-text-content :global(a:hover) {
    opacity: 0.85;
    text-decoration-thickness: 2px;
  }

  .portable-text-content :global(code.pt-inline-code),
  .portable-text-content :global(code) {
    font-family: var(--core-font-family-mono, monospace);
    background: rgba(255, 255, 255, 0.07);
    color: var(--color-accent-primary, #FFBE1A);
    padding: 0.15em 0.45em;
    border-radius: var(--radius-xs, 4px);
    font-size: 0.875em;
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.08);
  }

  /* Adaptive Media (Images & Videos) */
  .pt-media {
    margin: var(--space-5, 2rem) 0;
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    width: 100%;
  }

  .pt-media-inner {
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    border: var(--stroke-thin) solid var(--color-border-subtle, rgba(255, 255, 255, 0.08));
    background: var(--neutral-8, #1A1A1A);
  }

  .pt-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--neutral-10, #000000);
  }

  .pt-image {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: cover;
    display: block;
  }

  .pt-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pt-caption {
    font-size: var(--fluid-caption, 0.75rem);
    color: var(--color-text-muted, #888888);
    margin-top: 0.625rem;
    text-align: center;
    font-family: var(--core-font-family-mono, monospace);
  }

  /* CTA Block */
  .pt-cta {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg, 14px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 1rem);
    margin: var(--space-5, 2rem) 0;
    background: radial-gradient(circle at top center, color-mix(in srgb, var(--color-accent-primary) 8%, transparent) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: var(--stroke-thin) solid var(--color-border-subtle, rgba(255, 255, 255, 0.1));
  }

  .pt-cta-heading {
    color: var(--color-text-primary, #f4f4f4);
    font-size: var(--fluid-h3, 1.5rem);
    margin: 0;
    font-weight: var(--font-weight-bold, 700);
  }

  .pt-cta-body {
    margin: 0;
    max-width: 540px;
    color: var(--color-text-secondary, #bababa);
    font-size: var(--fluid-body-md, 1rem);
  }

  .pt-cta-btn {
    margin-top: 0.5rem;
  }

  /* Stats Grid */
  .pt-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3, 1rem);
    margin: var(--space-4, 1.5rem) 0;
    width: 100%;
  }

  .pt-stat-item {
    position: relative;
    padding: var(--space-4, 1.25rem);
    border-radius: var(--radius-md, 10px);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: var(--stroke-thin) solid var(--color-border-subtle, rgba(255, 255, 255, 0.08));
    background: rgba(255, 255, 255, 0.02);
  }

  .pt-stat-number {
    font-size: var(--fluid-h2, 2.25rem);
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-accent-primary, #FFBE1A);
    line-height: 1.1;
  }

  .pt-stat-label {
    font-size: var(--fluid-body-sm, 0.875rem);
    color: var(--color-text-primary, #f4f4f4);
    font-weight: var(--font-weight-medium, 500);
  }

  .pt-stat-desc {
    margin: 0;
    font-size: var(--fluid-caption, 0.75rem);
    color: var(--color-text-muted, #bababa);
  }

  /* Accordions */
  .pt-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: var(--space-4, 1.5rem) 0;
    width: 100%;
  }

  .pt-accordion-title {
    color: var(--color-text-primary, #f4f4f4);
    font-size: var(--fluid-h3, 1.375rem);
    margin-bottom: 0.5rem;
  }

  .pt-accordion-item {
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    padding: var(--space-3, 1rem) var(--space-4, 1.25rem);
    border: var(--stroke-thin) solid var(--color-border-subtle, rgba(255, 255, 255, 0.08));
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .pt-accordion-item[open] {
    background: rgba(255, 255, 255, 0.04);
    border-color: color-mix(in srgb, var(--color-accent-primary) 20%, transparent);
  }

  .pt-accordion-question {
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-primary, #f4f4f4);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
