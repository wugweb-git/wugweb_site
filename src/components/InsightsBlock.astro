---
import { loadAssetAlts } from '../lib/asset-alt';
import PostCard from './PostCard.astro';
import { toPostCard } from '../lib/post-card';
/**
 * InsightsBlock — the one blog teaser.
 *
 * There were three implementations of this: the homepage's card grid, the
 * global teaser in BaseLayout, and `.svc-insights` on the service pages, which
 * meant a service page rendered two different blog blocks one after the other.
 * This is the homepage's design, extracted so every surface uses it.
 *
 * Filtering is the caller's job — the homepage passes the latest posts, a
 * service page passes the ones matched to its pillar.
 *
 * Cards are PostCard — the same card, from the same `postsListQuery` schema,
 * as /blog. By card size: lg (1200+) 3 across, md (768 – 1199) 2 across,
 * below 768 the first post is a full sm card and the rest are stacked rows.
 */
export interface InsightPost {
  slug?: string;
  title?: string;
  excerpt?: string;
  category?: string;
  topic?: string;
  topicSlug?: string;
  coverPath?: string;
  coverImage?: any;
  publishedAt?: string;
  readingTime?: number | string;
  author?: { name?: string } | null;
}

interface Props {
  posts: InsightPost[];
  eyebrow?: string;
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** How many to fetch. lg (3 across) shows the first 3; md and sm show all. */
  limit?: number;
}

const {
  posts,
  eyebrow = 'Insights',
  heading = 'Thoughts on design, product, and strategy',
  ctaLabel = 'View all articles',
  ctaHref = '/blog',
  /* 4, not 3: md (2 x 2) and the stacked sm list use all four; lg is 3 across
     and hides the 4th (see .blog-teaser-grid below). */
  limit = 4,
} = Astro.props;

const items = (posts || []).slice(0, limit);
const altMap = await loadAssetAlts();
const cards = items.map((p) => toPostCard(p, altMap));
---

{items.length > 0 && (
  <section class="wrap blog-teaser" data-scroll="rise" id="blog-teaser" aria-labelledby="blog-teaser-title">
    <div class="blog-teaser-head">
      <div class="btc-head-text">
        
        <h2 data-reveal id="blog-teaser-title">{heading}</h2>
      </div>
      {/* Bare .btn (the "Primary" tier — solid --neutral-6 fill), not
          .btn-solid (Brand/yellow, reserved for the page's one conversion
          action) and not .btn-ghost — a transparent/tinted button next to
          solid dark card content read as the same "background matches
          background" complaint already fixed elsewhere on the page.
          See kits_design_system/docs/components.md "Buttons" for the tier
          split: Brand is a color reservation, Primary/Ghost is emphasis —
          this is this section's main action, just not the brand-yellow one.
          No data-reveal: on the mobile full-height layout this button
          pins to the bottom of a single 100svh screen, low enough that its
          scroll-linked entrance trigger ('top 88%') can sit past the
          reachable scroll range of a short viewport and never fire —
          verified in Storybook, opacity stuck at 0 even scrolled to the
          bottom. It's persistent UI chrome, not revealing content, so it
          doesn't need an entrance animation. */}
      <a href={ctaHref} class="btn btn-block-mobile btc-cta">{ctaLabel}</a>
    </div>
    <ul class="blog-teaser-grid">
      {cards.map((c, i) => (
        <li data-reveal data-reveal-delay={String(i * 0.12)}>
          <PostCard card={c} row={i > 0} />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .blog-teaser {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }

  .blog-teaser-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-6);
    flex-wrap: wrap;
    margin-bottom: var(--gap-10);
  }

  .blog-teaser-head h2 { font-size: var(--t-h3); max-width: 22ch; margin-top: var(--gap-4); }

  /* Grid by card size. sm (< 768) is the stacked list; md (768 – 1199) 2 across
     so the cards stay readable (3 across at 768 is ~220px each); lg (1200+) 3
     across. The 4th post only fits md and sm, so lg hides it. */
  .blog-teaser-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .blog-teaser-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .blog-teaser-grid { grid-template-columns: repeat(3, 1fr); }
    .blog-teaser-grid > li:nth-child(n + 4) { display: none; }
  }

  /* ── sm + stacked (< 768): the first post is a full sm card, the rest are
     stacked rows (PostCard `row`). The section is one app screen; this places
     the head, list and CTA, and caps the list at 480px like the rows. ── */
  @media (max-width: 767.98px) {
    /* svh (not vh) so mobile browser chrome collapsing doesn't yank the
       layout. Head pins to the top, cards fill the middle, the CTA pins to the
       bottom — .blog-teaser-head goes `display: contents` so its two children
       become direct flex items and can be ordered independently. */
    .blog-teaser {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--gap-8) var(--gap-12);
    }
    .blog-teaser-head { display: contents; }
    .btc-head-text { order: 0; }
    .blog-teaser-grid { order: 1; gap: var(--gap-3); margin-block: auto; }
    .blog-teaser-grid > li { max-width: 480px; width: 100%; margin-inline: auto; }
    .blog-teaser-grid > li:first-child { margin-bottom: var(--gap-3); }
    .btc-cta { order: 2; margin-top: var(--gap-6); }
  }
</style>
