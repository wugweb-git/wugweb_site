---
interface Props {
  items: { n: string; title: string; body: string }[];
}

const { items } = Astro.props;
---

<div class="approach-steps">
  {items.map((a) => (
    <div class="approach-step">
      <span class="step-n">{a.n}</span>
      <h3>{a.title}</h3>
      <p>{a.body}</p>
    </div>
  ))}
</div>

<style>
  .approach-steps { display: grid; gap: var(--gap-8); }
  .approach-step { border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .step-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: var(--t-sm); }
  .approach-step h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-2); }
  .approach-step p { margin-top: var(--gap-2); max-width: 50ch; color: var(--fg-muted); }
</style>
