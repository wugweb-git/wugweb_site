    .bento-caption,
    .bento-media img,
    .bento-media video { transition: none; }
    .bento-tile.is-link:hover { transform: none; }
    .bento-tile:hover .bento-media img,
    .bento-tile:hover .bento-media video { transform: scale(1.015); }
