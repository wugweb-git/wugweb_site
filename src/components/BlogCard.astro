---
interface Props {
  title: string;
  slug: string;
  category?: string;
  excerpt?: string;
}

const { title, slug, category, excerpt } = Astro.props;
---

<a href={`/blog/${slug}`} class="blog-card">
  <div class="blog-card-body">
    {category && <span class="blog-card-category">{category}</span>}
    <h3 class="blog-card-title">{title}</h3>
    {excerpt && <p class="blog-card-excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .blog-card { text-decoration: none; display: block; border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .blog-card-category { font-family: var(--font-mono); font-size: .7rem; color: var(--accent); text-transform: uppercase; display: block; margin-bottom: var(--gap-1); }
  .blog-card-title { font-size: 1.1rem; font-weight: 400; line-height: 1.4; color: var(--fg); }
  .blog-card-excerpt { margin-top: var(--gap-2); font-size: .85rem; color: var(--fg-muted); line-height: 1.5; }
  .blog-card:hover .blog-card-title { color: var(--accent); }
</style>
