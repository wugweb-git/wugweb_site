---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((f) => (
    <details class="faq-item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); padding-block: var(--gap-5); }
  .faq-item summary { font-family: var(--font-display); font-size: var(--t-body); cursor: pointer; font-weight: var(--font-weight-semibold); }
  .faq-item summary:hover { color: var(--accent); }
  .faq-item p { margin-top: var(--gap-3); max-width: 55ch; color: var(--fg-muted); }
</style>
