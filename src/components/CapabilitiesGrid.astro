---
interface Props {
  sections: { n?: string; title: string; body?: string; items?: string[] }[];
}

const { sections } = Astro.props;
---

<div class="caps-grid">
  {sections.map((s) => (
    <div class="cap-card">
      {s.n && <span class="cap-n">{s.n}</span>}
      <h3>{s.title}</h3>
      {s.body && <p>{s.body}</p>}
      {s.items && s.items.length > 0 && (
        <ul class="cap-items">{s.items.map((i: string) => <li>{i}</li>)}</ul>
      )}
    </div>
  ))}
</div>

<style>
  .caps-grid { display: grid; gap: var(--gap-8); }
  @media (min-width: 768px) { .caps-grid { grid-template-columns: repeat(3, 1fr); } }
  .cap-card { border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .cap-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: var(--t-sm); }
  .cap-card h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); }
  .cap-card p { margin-top: var(--gap-2); color: var(--fg-muted); }
  .cap-items { list-style: none; margin: var(--gap-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-1); }
  .cap-items li { font-family: var(--font-mono); font-size: var(--t-micro); padding: var(--gap-1) var(--gap-2); background: var(--surface); border-radius: var(--r-1); }
</style>
