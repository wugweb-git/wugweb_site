---
interface Props {
  client?: string;
  category?: string;
  title: string;
  slug: string;
  media?: string;
}

const { client, category, title, slug, media } = Astro.props;
---

<a href={`/work/${slug}`} class="work-card">
  {media ? (
    <video autoplay muted loop playsinline src={media} class="work-card-video"></video>
  ) : (
    <div class="work-card-placeholder">{client || ''}</div>
  )}
  {client && <p class="work-card-client">{client}{category ? ` — ${category}` : ''}</p>}
  <h3 class="work-card-title">{title}</h3>
</a>

<style>
  .work-card { text-decoration: none; display: block; }
  .work-card-video { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--r-2); display: block; }
  .work-card-placeholder { width: 100%; aspect-ratio: 16/10; background: var(--surface-2); border-radius: var(--r-2); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .work-card-client { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); margin-top: var(--gap-4); }
  .work-card-title { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); color: var(--fg); }
  .work-card:hover .work-card-title { color: var(--accent); }
</style>
