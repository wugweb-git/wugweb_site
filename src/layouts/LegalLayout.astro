---
/**
 * LegalLayout — shared two-column chrome for the "Legal & Policies" pages.
 *
 * Deliberately does NOT move any of the four pages' own content or data
 * fetching (Sanity singletonPage + hardcoded fallback, unchanged) — that
 * content is substantial, legally significant text, and copying it into a
 * new route risked transcription drift for zero benefit. This is a pure
 * wrapper: each page keeps its own URL (no redirects, no risk to the SEO
 * work already done on /privacy-policy and /termsofuse), swaps
 * `BaseLayout` for this layout, and renders its existing content into the
 * slot. The pages read as one hub because they share this nav, not because
 * they share a URL prefix.
 *
 * The masthead H1 is the active page's own title (not a fixed "Legal &
 * Policies" heading) — each page no longer renders its own duplicate
 * eyebrow/h1/date header, this layout owns that once, centrally.
 *
 * `/footer/refund-policy` (a confirmed byte-identical duplicate of
 * `/refund-policy` — see pending.md §1f) is
 * NOT one of the four nav links below; it now redirects to `/refund-policy`
 * instead of rendering a second time.
 */
import BaseLayout from './BaseLayout.astro';

export type LegalSlug = 'privacy-policy' | 'terms-of-use' | 'refund-policy' | 'cookie-policy';

interface Props {
  title: string;
  description?: string;
  active: LegalSlug;
  /** e.g. "November 04, 2025" — omit if the page has no reliable date. */
  updated?: string;
  /** Forwarded to BaseLayout. Without these the four legal routes could be
   *  dropped from sitemap.xml while still emitting a canonical and no robots
   *  meta — the sitemap and the page would disagree. */
  noIndex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, active, updated, noIndex, ogTitle, ogDescription } = Astro.props;

const NAV: { slug: LegalSlug; label: string; href: string }[] = [
  { slug: 'privacy-policy', label: 'Privacy Policy', href: '/privacy-policy' },
  { slug: 'terms-of-use', label: 'Terms of Use', href: '/termsofuse' },
  { slug: 'refund-policy', label: 'Refund Policy', href: '/refund-policy' },
  { slug: 'cookie-policy', label: 'Cookie Policy', href: '/footer/cookie-policy' },
];
---

<BaseLayout title={title} description={description} hideGlobalSections={true} noIndex={noIndex} ogTitle={ogTitle} ogDescription={ogDescription}>
  <section class="wrap legal-hub" id="legal-hub" aria-labelledby="legal-hub-title">
    <header class="legal-hub-head">
      <a href="/privacy-policy" class="legal-hub-crumb" data-reveal>Legal &amp; Policies</a>
      <h1 class="page-title" id="legal-hub-title" data-reveal>{title}</h1>
      {updated && (
        <p class="legal-hub-updated meta-row" data-reveal>
          <span class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Updated {updated}
          </span>
        </p>
      )}
    </header>

    <div class="legal-hub-grid">
      <nav class="legal-hub-nav" aria-label="Legal pages">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.slug === active ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            {/* Not a page — opens the same cookie-preferences modal the
                footer link does (BaseLayout's cookie-consent script exposes
                this globally). No content pane for it: there's nothing to
                read, only a choice to make. */}
            <button type="button" id="legal-cookie-settings-btn" class="legal-hub-action">
              Cookie Settings
            </button>
          </li>
        </ul>
      </nav>

      <div class="legal-hub-content">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('legal-cookie-settings-btn')?.addEventListener('click', () => {
    (window as any).openWugwebCookieSettings?.();
  });
</script>

<style>
  .legal-hub { padding-block: var(--space-page-head) var(--space-section-xl); }

  .legal-hub-head { margin-bottom: var(--space-section-md); }
  .legal-hub-crumb {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fluid-label);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .legal-hub-crumb:hover { color: var(--fg); }
  .legal-hub-head .page-title { margin-top: var(--gap-3); }

  /* A real container, not a plain muted line — the date is information
     someone scans for specifically (did this change since I last read
     it?), so it gets its own visual weight instead of blending into body
     copy. */
  /* .meta-row/.meta-item/.meta-icon (global.css) supply the icon + text
     pairing — this just wraps it in the pill container a date deserves
     over blending into body copy. */
  .legal-hub-updated {
    margin-top: var(--gap-4);
  }
  .legal-hub-updated .meta-item {
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--neutral-0) 8%, transparent);
    font-size: var(--fluid-label);
  }

  .legal-hub-grid {
    display: grid;
    gap: var(--space-section-md);
  }
  @media (min-width: 1024px) {
    /* Nav column sized to its longest label ("Cookie Settings") plus
       breathing room, not a guessed fraction — content column takes the
       rest, up to whatever max-width the page's own .legal/.static-page
       content sets. */
    .legal-hub-grid { grid-template-columns: 14rem 1fr; align-items: start; gap: var(--space-section-lg); }
  }

  .legal-hub-nav {
    position: sticky;
    top: calc(var(--nav-height, 4.875rem) + var(--space-page-md));
  }
  .legal-hub-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
  }
  @media (max-width: 1023.98px) {
    .legal-hub-nav ul { flex-direction: row; flex-wrap: wrap; gap: var(--gap-2); }
  }

  .legal-hub-nav a,
  .legal-hub-action {
    display: flex;
    align-items: center;
    width: 100%;
    text-align: left;
    padding: var(--gap-2) var(--gap-3);
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    color: var(--fg-muted);
    font-size: var(--fluid-body-sm);
    text-decoration: none;
    background: none;
    border-block: 0;
    border-right: 0;
    font-family: inherit;
    cursor: pointer;
    transition: background var(--duration-fast) var(--easing-out),
                color var(--duration-fast) var(--easing-out),
                border-color var(--duration-fast) var(--easing-out);
  }
  @media (max-width: 1023.98px) {
    .legal-hub-nav a,
    .legal-hub-action {
      width: auto;
      background: color-mix(in srgb, var(--neutral-0) 6%, transparent);
      border-radius: var(--radius-full);
      /* The left accent bar is a desktop-rail affordance — in a wrapped
         pill row there's no consistent "left edge" to read it against. */
      border-left-color: transparent !important;
    }
  }

  .legal-hub-nav a:hover,
  .legal-hub-action:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--neutral-0) 8%, transparent);
  }
  /* Selected state — three signals together (fill, left rail, weight), not
     just a faint background shift: the fill reads at a glance, the rail
     gives it a fixed anchor point scanning down the list, the weight
     confirms it on closer look. */
  .legal-hub-nav a[aria-current='page'] {
    color: var(--fg);
    background: color-mix(in srgb, var(--neutral-0) 12%, transparent);
    border-left-color: var(--accent-warm);
    font-weight: var(--font-weight-semibold);
  }
  .legal-hub-nav a:focus-visible,
  .legal-hub-action:focus-visible {
    outline: var(--focus-primary);
    outline-offset: 2px;
  }

  .legal-hub-content { min-width: 0; }
  /* The four pages each still set their own padding-block on .legal /
     .static-page for their standalone route — cancel that here so the hub
     controls vertical rhythm once, not twice. */
  .legal-hub-content :global(.legal),
  .legal-hub-content :global(.static-page) {
    padding-block: 0;
  }
</style>
