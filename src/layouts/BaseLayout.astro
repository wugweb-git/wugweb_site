---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
// TrustBadges import removed with its render call below — see that comment.
import InsightsBlock from '../components/InsightsBlock.astro';
import FooterCTA from '../components/FooterCTA.astro';
import JsonLd from '../components/JsonLd.astro';
import { urlFor, cachedFetch } from '../lib/sanity';
import { siteSettingsQuery, postsListQuery } from '../lib/queries';
import { assetUrl } from '../lib/assets';
import { SITE_MEDIA } from '../lib/site-media';
import { isCanonicalHost } from '../lib/hosts';
import { resolveIds, verificationTags, clientConfig } from '../lib/integrations';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  ogImage?: string;
  /** R2/local path from singletonPage.ogImagePath; resolved and made absolute below. */
  ogImagePath?: string;
  /** Keeps the page out of search results. Also excludes it from sitemap.xml
   *  when that lands — the two must agree or the signals contradict. */
  noIndex?: boolean;
  /** Social copy, independent of SERP copy. A share card and a search result
   *  are different surfaces with different lengths; empty falls back to the
   *  SEO title/description rather than forcing editors to fill both. */
  ogTitle?: string;
  ogDescription?: string;
  /** Per-document canonical override, for legacy or syndicated duplicates.
   *  Site-relative; resolved against the canonical origin. */
  canonicalPath?: string;
  /** Extra schema.org nodes for this page (Article, CreativeWork, FAQPage…).
   *  Merged into the sitewide @graph. No @context on the nodes. */
  jsonLd?: Record<string, unknown>[];
  language?: string;
  hideGlobalSections?: boolean;
  /** Suppress only the global blog teaser — for pages that already carry their
   *  own insights block, so the two do not appear on the same page. */
  hideGlobalBlog?: boolean;
  /** Same idea for the global industries block. */
  hideGlobalIndustries?: boolean;
}
const { title, description, seoTitle, ogImage, ogImagePath, noIndex, ogTitle, ogDescription, canonicalPath, jsonLd, language } = Astro.props;
const hideGlobalSections = Boolean(Astro.props.hideGlobalSections);
const hideGlobalBlog = hideGlobalSections || Boolean(Astro.props.hideGlobalBlog);
const hideGlobalIndustries = hideGlobalSections || Boolean(Astro.props.hideGlobalIndustries);

/**
 * The five sitewide Sanity queries, in parallel and cached.
 *
 * These used to be five separate awaits scattered down this file, each
 * blocking the next. Astro runs layout frontmatter after the page's, so a
 * homepage request serialised nine round trips to Sanity before a byte of
 * HTML was written — audit finding 5's 1.31 s TTFB.
 *
 * They are independent of one another, so nothing was being waited FOR; the
 * ordering was incidental. Promise.all removes four round trips outright, and
 * cachedFetch removes all five on a warm isolate. Every query returns the same
 * bytes on every page, which is exactly the shape a cache wants.
 *
 * Each still resolves to its own fallback, so one failing query degrades one
 * region of the page rather than the whole render, as before.
 *
 * Deliberately NOT cached anywhere: per-page content. A post or case study is
 * fetched fresh, because its staleness would be visible and specific.
 */
const [settings, livePlatformProfiles, teaserPosts, sanityIndustries, globalSections] = await Promise.all([
  cachedFetch(siteSettingsQuery).catch(() => null),
  // One query, two consumers: the CTA banner's drifting discs (Social Media
  // only) and JSON-LD sameAs (every live profile — 31 of them, versus 5
  // social). Widened rather than run twice.
  cachedFetch(
    `*[_type == "platformProfile" && profileStatus == "Live" && defined(profileUrl)]
      | order(platform asc){ platform, profileUrl, category }`
  ).catch(() => []),
  // Global blog teaser — latest 3 posts.
  hideGlobalBlog ? Promise.resolve([]) : cachedFetch(postsListQuery).catch(() => []),
  // Industries strip, from the Sanity industry master.
  hideGlobalIndustries
    ? Promise.resolve([])
    : cachedFetch('*[_type == "industry"] | order(order asc) { name }[0..23]').catch(() => []),
  // Global sections (pageSection). One query for every section on the page —
  // the cookie fields are selected here rather than in a second query. See the
  // block further down for what this tier is and why it starts with
  // `industries`.
  cachedFetch(`*[_type == "pageSection" && !(_id in path("drafts.**"))]{
    sectionId, enabled, eyebrow, title, subtitle, ctaLabel, ctaHref,
    excludeRoutes, includeOnlyRoutes,
    items, modalTitle, modalIntro, acceptLabel, rejectLabel, manageLabel,
    saveLabel, alwaysActiveLabel, closeLabel
  }`).catch(() => []),
]);

/**
 * Live social profiles for the CTA banner's drifting discs. Real URLs only —
 * `platformProfile` holds twenty platforms but only these five carry a
 * `profileUrl`, so the banner shows exactly the accounts that exist.
 */
const socialDiscs = (livePlatformProfiles as any[]).filter((p) => p.category === 'Social Media');

const defaultLang = language || settings?.language || 'en-GB';
const siteName = settings?.siteTitle || 'wugweb — Digital Experience Agency';
const defaultDesc = settings?.seoDescription || 'Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.';
const defaultOgImage = settings?.ogImage
  ? urlFor(settings.ogImage).width(1200).height(630).url()
  // Salvaged from Framer 2026-09-24: a real 1200x630 image. The previous
  // fallback, /brand/og-default.png, was 965x306 and cropped wrong everywhere.
  : settings?.ogImagePath
    ? assetUrl(settings.ogImagePath)
    : SITE_MEDIA.seo.ogDefault;
// `/brand/favicon.svg` is `logo-small.svg`'s mark on a black rounded-square
// backdrop — logo-small.svg itself stays transparent-background since it's
// also used as a plain inline mark (services/[slug].astro's Approach CTA),
// where a badge background would be wrong.
const defaultFavicon = settings?.favicon
  ? urlFor(settings.favicon).width(32).url()
  : '/brand/favicon.svg';
const defaultAppleTouch = settings?.favicon
  ? urlFor(settings.favicon).width(180).url()
  : '/brand/favicon.svg';
const copyrightText = settings?.copyright || '© 2020–2026 Wugweb. All rights reserved.';
const siteEmail = settings?.contactEmail || 'hello@wugweb.com';

// The site suffix is added here, never stored: SEO titles in Notion/Sanity are
// shared with vedanshusrivastava.com, which appends its own. A trailing
// "| Wugweb" left in older data is stripped first so it can't double up, and
// the suffix is dropped when it would push the title past 60 characters.
const TITLE_SUFFIX = ' | Wugweb';
const pageTitle = (seoTitle || title).replace(/\s*[|·–—-]\s*wugweb(\s+(work|insights))?\s*$/i, '').trim();
const fullTitle = pageTitle.length + TITLE_SUFFIX.length <= 60 ? pageTitle + TITLE_SUFFIX : pageTitle;
const metaDesc = description || defaultDesc;
// og:image must be an ABSOLUTE URL — a relative path is invalid per the Open
// Graph spec and most scrapers drop it.
// The .jpg, not the .webp: LinkedIn and several other scrapers still handle
// WebP inconsistently. WebP copies live alongside for on-page use.
//
// The base is the CONFIGURED origin, never Astro.url.origin. This site answers
// on both wugweb.com and wugweb.pages.dev, so deriving the origin from the
// request emits a pages.dev canonical to anything crawling pages.dev — the
// exact split-signal problem canonicals exist to prevent. siteSettings.siteUrl
// is the source of truth; the literal is the floor until that field is filled.
//
// www, not the apex: wugweb.com 308-redirects to www.wugweb.com, and a
// canonical that names a redirect is a weak signal. Verified 2026-09-24.
/**
 * Staging hosts must never be indexed.
 *
 * One build answers on several hostnames — uat.wugweb.com, wugweb.pages.dev,
 * per-branch aliases, localhost — each a byte-identical copy of the site under
 * a different name. The canonical tag below points them all at www, but a
 * canonical is a HINT: it does not stop a crawler fetching the page, and
 * Google is free to ignore it. uat.wugweb.com went live on 2026-09-24 as a
 * fully public copy, so this is not hypothetical.
 *
 * `noindex, follow` rather than `noindex, nofollow`: the links are the same
 * links, and there is no reason to poison link discovery on the real site.
 *
 * Paired with a host-aware robots.txt (src/pages/robots.txt.ts). Both are
 * needed — robots.txt stops the crawl, the meta tag stops indexing of anything
 * already fetched or reached from an external link.
 */
const onCanonicalHost = isCanonicalHost(Astro.url.hostname);
const robotsNoIndex = noIndex || !onCanonicalHost;

// Integrations (siteSettings → Integrations). resolveIds() validates every ID
// and falls back to the long-standing GA4 ID if settings are empty or failed
// to load. Both blocks render on the canonical host only: verification tags so
// a staging copy can never verify itself, and the provider config so a
// non-canonical host ships no third-party IDs at all. Providers then load
// client-side only after analytics consent (src/lib/analytics.ts).
const integrationIds = resolveIds(settings);
const verifyTags = verificationTags(integrationIds, Astro.url.hostname);
const integrationsConfig = onCanonicalHost ? clientConfig(integrationIds) : null;

const canonicalOrigin = (settings?.siteUrl || 'https://www.wugweb.com').replace(/\/+$/, '');
const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, canonicalOrigin).href;

// og:image resolves against the origin that actually serves the file, which is not
// necessarily the canonical origin (before the DNS cutover www.wugweb.com is still the
// old Framer build). Canonical declares the preferred URL; og:image has to be fetchable now.
const rawOgImage = ogImage || (ogImagePath ? assetUrl(ogImagePath) : defaultOgImage);
const metaOgImage = rawOgImage.startsWith('http')
  ? rawOgImage
  : new URL(rawOgImage, Astro.url.origin).href;

// ── JSON-LD ──────────────────────────────────────────────────────────────
// Built only from fields that are actually populated. siteSettings.legalName,
// foundingDate, address, telephone, logoPath and organizationType are all empty
// today, so those properties are simply absent rather than asserted blank —
// JsonLd prunes undefined values for the same reason.
// sameAs comes from the live platformProfile documents, which is what the
// siteSettings.sameAs field description says to do when that field is unset.
const orgId = `${canonicalOrigin}/#organization`;
const organizationNode = {
  '@type': settings?.organizationType || 'Organization',
  '@id': orgId,
  name: settings?.companyName || 'Wugweb',
  legalName: settings?.legalName,
  url: canonicalOrigin,
  description: settings?.seoDescription || defaultDesc,
  email: settings?.contactEmail,
  telephone: settings?.telephone,
  foundingDate: settings?.foundingDate,
  // siteSettings.logoPath is empty, which left Organization (the publisher of every post) without
  // the logo Google requires for Article rich results. Fall back to the W mark (648px square).
  logo: new URL(settings?.logoPath ? assetUrl(settings.logoPath) : '/brand/logo-square.png', canonicalOrigin).href,
  sameAs: (settings?.sameAs?.length ? settings.sameAs : (livePlatformProfiles as any[]).map((p) => p.profileUrl)),
  founder: { '@id': `${canonicalOrigin}/#founder` },
};
// The personal site goes on the Person, not the Organization: sameAs asserts
// "the same entity", and vedanshusrivastava.com is Vedanshu, not Wugweb.
const founderNode = {
  '@type': 'Person',
  '@id': `${canonicalOrigin}/#founder`,
  name: 'Vedanshu Srivastava',
  jobTitle: 'Founder',
  worksFor: { '@id': orgId },
  sameAs: ['https://www.vedanshusrivastava.com/', 'https://www.linkedin.com/in/vedanshu/'],
};
const webSiteNode = {
  '@type': 'WebSite',
  '@id': `${canonicalOrigin}/#website`,
  url: canonicalOrigin,
  name: settings?.siteTitle || siteName,
  description: settings?.seoDescription || defaultDesc,
  publisher: { '@id': orgId },
};
// A noindexed page should not be advertising itself in structured data either.
const graphNodes = robotsNoIndex ? [] : [organizationNode, founderNode, webSiteNode, ...(jsonLd || [])];

// Cover thumbnails for the teaser. The fetch itself is in the Promise.all above.
const teaserCovers = (teaserPosts as any[]).slice(0, 3).map((p: any) => {
  const cover = p.coverPath
    ? assetUrl(p.coverPath)
    : (p.coverImage ? urlFor(p.coverImage).width(640).height(400).url() : '');
  return cover;
});

// ── Global sections (pageSection) ─────────────────────────────────────────
// The section tier's first consumer. pageSection shipped with thirteen fields
// and nothing reading them; this is what makes it real.
//
// Starting with `industries` rather than `cookie-consent`, which the plan
// originally named: the industries strip maps 1:1 onto the existing schema
// (title, subtitle, ctaLabel, ctaHref) and needs no schema change, whereas the
// cookie UI needs six button labels, a modal title and intro, an "always
// active" badge and a close aria-label against a schema offering a single
// ctaLabel/ctaHref pair. Proving the tier on the section that fits beats
// bending the schema around the one that doesn't.
//
// Additive by design: every value falls back to the copy that was hardcoded
// here, so a missing or unpublished document changes nothing on the page.
// The fetch itself is the fifth entry in the Promise.all near the top.

const currentPath = Astro.url.pathname;
/**
 * Resolve a global section for this route. Returns null when the section is
 * disabled or excluded here, in which case the caller renders nothing.
 * `includeOnlyRoutes` wins over `excludeRoutes`, matching the field description.
 */
function resolveSection(id: string) {
  const doc = (globalSections as any[]).find((d) => d.sectionId === id);
  if (!doc) return undefined;               // no document yet → hardcoded fallback
  if (doc.enabled === false) return null;   // explicitly off → render nothing
  if (doc.includeOnlyRoutes?.length) {
    return doc.includeOnlyRoutes.includes(currentPath) ? doc : null;
  }
  if (doc.excludeRoutes?.includes(currentPath)) return null;
  return doc;
}

const industriesSection = resolveSection('industries');
const cookieSection = resolveSection('cookie-consent');
// Every value falls back to the copy that was hardcoded below, so an absent or
// half-filled document changes nothing on screen. `items` carries the three
// consent categories; anything short of three falls back to the built-in set,
// because the toggles are wired to fixed ids and a partial list would render a
// category with no control.
const CK = {
  title: cookieSection?.title || 'We use cookies',
  subtitle: cookieSection?.subtitle || 'We use necessary cookies to operate Wugweb and optional cookies to understand how our website is used and improve your experience.',
  accept: cookieSection?.acceptLabel || 'Accept all',
  reject: cookieSection?.rejectLabel || 'Reject optional',
  manage: cookieSection?.manageLabel || 'Manage preferences',
  save: cookieSection?.saveLabel || 'Save preferences',
  modalTitle: cookieSection?.modalTitle || 'Cookie Settings',
  modalIntro: cookieSection?.modalIntro || 'Choose which optional cookies and similar technologies you allow. Necessary technologies remain active because they are required for the website to function.',
  alwaysActive: cookieSection?.alwaysActiveLabel || 'Always active',
  close: cookieSection?.closeLabel || 'Close preferences',
};
const CK_DEFAULT_CATEGORIES = [
  { title: 'Strictly Necessary', text: 'Required for core website functionality, security, consent management and other essential functions.' },
  { title: 'Functional', text: 'Helps remember preferences and provide enhanced functionality.' },
  { title: 'Analytics', text: 'Helps us understand how visitors use Wugweb and improve website performance and experience.' },
];
const CK_CATS = (cookieSection?.items?.length === 3 ? cookieSection.items : CK_DEFAULT_CATEGORIES) as { title: string; text: string }[];
const insightsSection = resolveSection('insights');
const finalCtaSection = resolveSection('final-cta');
// undefined = no doc, fall back to the hardcoded copy. null = deliberately off.
const showIndustries = industriesSection !== null;
const industriesTitle = industriesSection?.title || 'Industries We Empower';
const industriesSubtitle = industriesSection?.subtitle
  || 'From local businesses to international corporations, our clients all share one common understanding when it comes to building authentic brands: the power of research, strategy, creativity, and design.';
const industriesCtaLabel = industriesSection?.ctaLabel || 'More about us';
const industriesCtaHref = industriesSection?.ctaHref || '/about';

// Both components already accept eyebrow/heading/ctaLabel/ctaHref with their
// own defaults, so an absent document means undefined props and the component's
// own copy — no duplicated fallback strings here.
const showInsights = insightsSection !== null;
const showFinalCta = finalCtaSection !== null;

// Industries section — sourced from the Sanity industry master.
const curatedIndustries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
const industryNames = (sanityIndustries as any[]).map((i: any) => i.name);
const globalIndustries = industryNames.length ? industryNames : curatedIndustries;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle || fullTitle} />
    <meta property="og:description" content={ogDescription || metaDesc} />
    <meta property="og:image" content={metaOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    {/* A noindex page should not also assert a canonical: the two are
        contradictory signals, and a canonical on an excluded URL is the classic
        way to get the *target* dropped along with it. */}
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    {robotsNoIndex && <meta name="robots" content="noindex, follow" />}
    {verifyTags.map((t) => <meta name={t.name} content={t.content} />)}
    {integrationsConfig && <script id="wugweb-integrations" type="application/json" set:html={JSON.stringify(integrationsConfig)} />}
    <JsonLd graph={graphNodes} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaOgImage} />

    <!-- Favicon -->
    <link href={defaultFavicon} rel="icon" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={defaultAppleTouch} />

    <!-- PWA -->
    <meta name="theme-color" content="#050505" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="wugweb" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <script is:inline>
      if ('serviceWorker' in navigator && !location.hostname.startsWith('localhost')) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
      // Standalone-mode hook: installed PWA (and later, Capacitor's
      // webview) runs with no browser chrome. Nothing consumes this yet —
      // it's the detection mechanism Phase 7 flagged as groundwork, ready
      // for CSS (html[data-standalone] .foo {}) or JS to key off of when
      // there's a real chrome difference to make (e.g. hiding a
      // browser-only affordance).
      if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
        document.documentElement.dataset.standalone = 'true';
      }

      // Scroll-entrance gate. Runs synchronously in <head> so [data-reveal]
      // elements are hidden before first paint — no flash of visible content.
      // The watchdog is the important half: if the animation module never
      // runs (failed to load, threw, blocked), the class comes off and the
      // CSS default of opacity:1 takes over, so content is never permanently
      // invisible. initScrollAnimations() clears it on success.
      // 5s, not 2s: a cold load on a slow connection is not a failure, and
      // tripping early means the reveal animation never gets to run.
      document.documentElement.classList.add('js-reveal');
      window.__revealWatchdog = setTimeout(function () {
        document.documentElement.classList.remove('js-reveal');
      }, 5000);
    </script>

    {/* Self-hosted fonts.

        These were two <link>s to fonts.googleapis.com. That stylesheet is
        render-blocking and sits behind a DNS lookup, a TLS handshake and a
        redirect to fonts.gstatic.com before the first glyph can even be
        requested — the browser cannot paint text until it resolves. Audit
        finding 9.

        The faces below are the exact woff2 files Google was serving, fetched
        once and committed. Same fonts, same rendering, no third party: one
        fewer origin in the critical path, and one fewer origin to allow when
        the CSP in public/_headers finally gets written.

        Only latin and latin-ext are kept of the seven subsets Google offers.
        The unicode-range on each face is what makes that safe AND lazy: the
        browser downloads a file only if the page actually contains a glyph in
        its range, so an English page never touches latin-ext or the italics.
        First paint needs inter-tight latin (45 KB) and, where used, fragment-
        mono latin (15 KB) — against 300 KB on disk.

        Declared inline rather than in a stylesheet, because a linked
        fonts.css would reintroduce exactly the blocking request this removes.

        Regenerating: these are variable fonts pinned to Google versions
        (Inter Tight v9, Fragment Mono v6). Refetch the css2 URL from git
        history with a browser UA if they ever need updating. */}
    <link
      rel="preload"
      href="/fonts/inter-tight-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      @font-face {
        font-family: "Inter Tight";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-tight-normal-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Inter Tight";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-tight-normal-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Inter Tight";
        font-style: italic;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-tight-italic-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Inter Tight";
        font-style: italic;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-tight-italic-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Fragment Mono";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/fragment-mono-normal-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Fragment Mono";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/fragment-mono-normal-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>
  </head>
  <body>
    {/* Skip link. The site had neither this nor a <main> element, so a
        keyboard or screen-reader user had to tab through the whole header on
        every page with no landmark to jump to. Must be the first focusable
        thing in the body to be reachable at all. */}
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader companyEmail={siteEmail} />
    {/* tabindex="-1" so the skip link can actually move focus here; without it
        the browser scrolls but focus stays behind, and the next Tab returns to
        the header the user was trying to skip. */}
    <main id="main" tabindex="-1" aria-label={title} data-scroll-flow>
    <slot />
    </main>

    {!hideGlobalSections && (
      <>
        <!-- INDUSTRIES — suppressed on pages that carry their own industries
             block (see hideGlobalIndustries). -->
        {!hideGlobalIndustries && (
          showIndustries && (
          <section class="wrap global-industries" id="industries" aria-labelledby="industries-title">
            <h2 id="industries-title">{industriesTitle}</h2>
            <p>{industriesSubtitle}</p>
            <ul class="industry-tags">
              {globalIndustries.map((i) => <li>{i}</li>)}
            </ul>
            {industriesCtaLabel && industriesCtaHref && (
              <a href={industriesCtaHref} class="btn btn-ghost">{industriesCtaLabel}</a>
            )}
          </section>
          )
        )}

        <!-- BLOG TEASER — suppressed on pages that carry their own insights
             block (see hideGlobalBlog), so the two never stack up together. -->
        {!hideGlobalBlog && showInsights && (
          <InsightsBlock
            posts={teaserPosts}
            eyebrow={insightsSection?.eyebrow}
            heading={insightsSection?.title}
            ctaLabel={insightsSection?.ctaLabel}
            ctaHref={insightsSection?.ctaHref}
          />
        )}

        {/* TRUST & RECOGNITION — removed from all pages for now (2026-09-23,
             user request). Component (TrustBadges.astro) is untouched;
             re-add the <section class="wrap"><TrustBadges /></section>
             block above when it comes back. */}

        <!-- FINAL CTA — device backdrop banner. Own component now
             (`src/components/FooterCTA.astro`); see that file's header for
             what moved and why. -->
        {showFinalCta && (
          <FooterCTA
            socialDiscs={socialDiscs}
            heading={finalCtaSection?.title}
            copy={finalCtaSection?.subtitle}
            ctaLabel={finalCtaSection?.ctaLabel}
            ctaHref={finalCtaSection?.ctaHref}
          />
        )}
      </>
    )}

    <SiteFooter copyright={copyrightText} companyEmail={siteEmail} />

    <!-- Cookie Consent Banner -->
    <div id="wugweb-cookie-banner" class="cookie-banner-wrap">
      <div class="cookie-banner-inner">
        <div class="cookie-banner-text">
          <p class="cookie-title">{CK.title}</p>
          <p>{CK.subtitle}</p>
        </div>
        <div class="cookie-banner-actions">
          <button id="cookie-btn-accept-all" class="btn btn-solid btn-sm-cookie">{CK.accept}</button>
          <button id="cookie-btn-reject-optional" class="btn btn-ghost btn-sm-cookie">{CK.reject}</button>
          <button id="cookie-btn-manage" class="btn btn-ghost btn-sm-cookie">{CK.manage}</button>
        </div>
      </div>
    </div>

    <!-- Cookie Preferences Modal -->
    <div id="wugweb-cookie-modal" class="cookie-modal-overlay">
      <div class="cookie-modal-box">
        <button id="cookie-modal-close" class="cookie-modal-close-btn" aria-label={CK.close}>&times;</button>
        <h2>{CK.modalTitle}</h2>
        <p class="cookie-modal-intro">{CK.modalIntro}</p>
        
        <div class="cookie-options-list">
          <div class="cookie-opt-row">
            <div class="opt-desc">
              <h3>{CK_CATS[0].title}</h3>
              <p>{CK_CATS[0].text}</p>
            </div>
            <div class="opt-control">
              <span class="active-badge">{CK.alwaysActive}</span>
            </div>
          </div>

          <div class="cookie-opt-row">
            <div class="opt-desc">
              <h3>{CK_CATS[1].title}</h3>
              <p>{CK_CATS[1].text}</p>
            </div>
            <div class="opt-control">
              <label class="toggle-switch">
                <input type="checkbox" id="cookie-toggle-functional" checked>
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="cookie-opt-row">
            <div class="opt-desc">
              <h3>{CK_CATS[2].title}</h3>
              <p>{CK_CATS[2].text}</p>
            </div>
            <div class="opt-control">
              <label class="toggle-switch">
                <input type="checkbox" id="cookie-toggle-analytics" checked>
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <div class="cookie-modal-actions">
          <button id="cookie-modal-reject" class="btn btn-ghost">{CK.reject}</button>
          <button id="cookie-modal-save" class="btn btn-solid">{CK.save}</button>
          <button id="cookie-modal-accept" class="btn btn-solid">{CK.accept}</button>
        </div>
      </div>
    </div>

    <!-- PWA Install Prompt — custom UI over the native beforeinstallprompt,
         top-fixed so it never stacks with the bottom-fixed cookie banner.
         Hidden until JS confirms the browser actually offered install. -->
    <div id="wugweb-install-banner" class="install-banner-wrap">
      <div class="install-banner-inner">
        <img src="/brand/pwa-192.png" alt="" width="36" height="36" class="install-banner-icon" />
        <div class="install-banner-text">
          <p class="install-banner-title">Install Wugweb</p>
          <p class="install-banner-sub">Add to your home screen for the full app experience.</p>
        </div>
        <div class="install-banner-actions">
          <button id="install-banner-accept" class="btn btn-solid btn-sm">Install</button>
          <button id="install-banner-dismiss" class="install-banner-close" aria-label="Dismiss">&times;</button>
        </div>
      </div>
    </div>

    <style is:global>
      /* Global Cookie styles integrated with Wugweb tokens */
      .cookie-banner-wrap {
        position: fixed;
        /* Clears the home indicator and any landscape notch — see --safe-*. */
        bottom: calc(var(--safe-bottom) + var(--space-page-xs));
        left: calc(var(--safe-left) + var(--space-page-xs));
        right: calc(var(--safe-right) + var(--space-page-xs));
        background-color: var(--neutral-8);
        border: var(--stroke-thin) solid var(--color-border-subtle);
        padding: var(--p-5);
        border-radius: var(--radius-4);
        z-index: 9999;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        display: none;
        animation: cookieSlideUp var(--duration-slow) cubic-bezier(0.16, 1, 0.3, 1) forwards;      }

      @keyframes cookieSlideUp {
        from { transform: translateY(120%); }
        to { transform: translateY(0); }
      }

      @media (min-width: 768px) {
        .cookie-banner-wrap {
          left: auto;
          right: var(--space-page-md);
          max-width: 480px;
          bottom: var(--space-page-md);
        }
      }

      .cookie-banner-inner {
        display: flex;
        flex-direction: column;
        gap: var(--gap-4);
      }

      .cookie-banner-text .cookie-title {
        font-family: var(--font-body);
        line-height: var(--core-line-height-normal);
        font-size: var(--fluid-body-lg);
        font-weight: var(--font-weight-semibold);
        margin-bottom: var(--gap-1);
        color: var(--color-text-primary);
      }

      .cookie-banner-text p {
        font-size: var(--fluid-body-sm);
        color: var(--color-text-secondary);
        line-height: var(--lh-body);
      }

      .cookie-banner-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--gap-2);
      }

      .btn-sm-cookie {
        padding: var(--p-2) var(--p-4) !important;
        font-size: var(--fluid-caption) !important;
      }

      .cookie-modal-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.85);
        z-index: 10000;
        display: none;
        justify-content: center;
        align-items: center;
        padding: var(--p-4);
      }

      .cookie-modal-box {
        background-color: var(--neutral-9);
        border: var(--stroke-thin) solid var(--color-border-subtle);
        border-radius: var(--radius-5);
        width: 100%;
        max-width: 500px;
        padding: var(--p-8);
        position: relative;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8);
      }

      .cookie-modal-close-btn {
        position: absolute;
        top: var(--p-6);
        right: var(--p-6);
        background: none;
        border: none;
        color: var(--color-text-secondary);
    /* Deliberately NOT a type token: this is the close glyph's box, not text.
       Sizing it from the heading scale would tie an icon's dimensions to
       typography and it fits no step anyway — 28px sits in the gap between
       --t-h3 (21-24px) and --t-h2 (30-36px). */
        font-size: 1.75rem;
        cursor: pointer;
        line-height: 1;
      }

      .cookie-modal-box h2 {
        font-size: var(--fluid-h3);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--gap-3);
        color: var(--color-text-primary);
      }

      .cookie-modal-intro {
        font-size: var(--fluid-body-sm);
        color: var(--color-text-secondary);
        line-height: var(--lh-body);
        margin-bottom: var(--gap-6);
      }

      .cookie-options-list {
        display: flex;
        flex-direction: column;
        gap: var(--gap-4);
        margin-bottom: var(--gap-8);
      }

      .cookie-opt-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: var(--stroke-thin) solid var(--color-border-subtle);
        padding-bottom: var(--p-4);
      }

      .cookie-opt-row:last-child {
        border-bottom: none;
      }

      .opt-desc h3 {
        font-size: var(--fluid-body-md);
        line-height: var(--core-line-height-normal);
        font-weight: var(--font-weight-semibold);
        margin-bottom: var(--gap-1);
        color: var(--color-text-primary);
      }

      .opt-desc p {
        font-size: var(--fluid-caption);
        color: var(--color-text-muted);
        line-height: var(--lh-caption);
        max-width: 38ch;
      }

      .active-badge {
        font-family: var(--font-mono);
        font-size: var(--fluid-caption);
        color: var(--color-text-muted);
      }

      .toggle-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
      }

      .toggle-switch input {
        opacity: var(--opacity-0);
        width: 0;
        height: 0;
      }

      .toggle-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: var(--neutral-6);
        transition: var(--duration-normal);        border-radius: var(--r-full);
      }

      .toggle-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: var(--color-text-primary);
        transition: var(--duration-normal);        border-radius: 50%;
      }

      .toggle-switch input:checked + .toggle-slider {
        background-color: var(--color-accent-primary);
      }

      .toggle-switch input:checked + .toggle-slider:before {
        transform: translateX(20px);
        background-color: var(--neutral-10);
      }

      .cookie-modal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--gap-2);
        justify-content: space-between;
      }

      /* Install prompt — top-fixed (the cookie banner already owns the
         bottom edge), same slide/shadow/safe-area treatment. */
      .install-banner-wrap {
        position: fixed;
        top: calc(var(--safe-top) + var(--space-page-xs));
        left: calc(var(--safe-left) + var(--space-page-xs));
        right: calc(var(--safe-right) + var(--space-page-xs));
        background-color: var(--neutral-8);
        border: var(--stroke-thin) solid var(--color-border-subtle);
        padding: var(--p-4);
        border-radius: var(--radius-4);
        z-index: 9998;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        display: none;
        animation: installSlideDown var(--duration-slow) cubic-bezier(0.16, 1, 0.3, 1) forwards;      }
      @keyframes installSlideDown {
        from { transform: translateY(-120%); }
        to { transform: translateY(0); }
      }
      @media (min-width: 768px) {
        .install-banner-wrap {
          left: auto;
          right: var(--space-page-md);
          max-width: 420px;
          top: var(--space-page-md);
        }
      }
      .install-banner-inner {
        display: flex;
        align-items: center;
        gap: var(--gap-3);
      }
      .install-banner-icon {
        border-radius: var(--radius-sm);
        flex-shrink: 0;
      }
      .install-banner-text { flex: 1; min-width: 0; }
      .install-banner-title {
        color: var(--fg);
        font-weight: var(--font-weight-semibold);
        font-size: var(--fluid-body-sm);
      }
      .install-banner-sub {
        color: var(--fg-muted);
        font-size: var(--t-micro);
        margin-top: var(--gap-1);
      }
      .install-banner-actions {
        display: flex;
        align-items: center;
        gap: var(--gap-2);
        flex-shrink: 0;
      }
      .install-banner-close {
        background: none;
        border: none;
        color: var(--fg-muted);
        font-size: var(--t-h4);
        line-height: 1;
        cursor: pointer;
        padding: var(--gap-1);
      }
      .install-banner-close:hover { color: var(--fg); }
    </style>
  </body>
</html>

<script>
  import { initScrollAnimations } from '../lib/scroll-animations';
  import { initLazyVideo } from '../lib/lazy-video';
  import { initAnalytics } from '../lib/analytics';
  // Module is alive, so the head watchdog is no longer needed. Cancel it
  // before running, so a slow first paint cannot un-hide mid-animation.
  clearTimeout((window as any).__revealWatchdog);
  initScrollAnimations();
  // Below-fold looping video: nothing downloads until it is near the viewport.
  initLazyVideo();
  // Page scroll flow — layout-shell.md. Every top-level section, in document
  // order, gets data-scroll-index (1..n), and <main data-scroll-flow> carries
  // the ordered list of section anchors for the whole canvas. Computed at
  // runtime because two sections render from layouts OUTSIDE <main> (the
  // industries strip, the footer CTA band), so only the live DOM knows the
  // true order.
  {
    const flow = [...document.querySelectorAll('section')]
      .filter((s) => !s.parentElement?.closest('section') && s.id);
    flow.forEach((s, i) => s.setAttribute('data-scroll-index', String(i + 1)));
    document.querySelector('main[data-scroll-flow]')
      ?.setAttribute('data-scroll-flow', flow.map((s) => s.id).join(' '));
  }
  // initBallField() now lives in FooterCTA.astro's own script — it's the
  // only consumer of `[data-ball-field]`.
  // Registers a listener only. GA is gated on host AND consent, and the
  // consent manager below is what eventually fires it — see lib/analytics.ts.
  initAnalytics();

  // COOKIE CONSENT STATE MANAGER
  const banner = document.getElementById('wugweb-cookie-banner');
  const modal = document.getElementById('wugweb-cookie-modal');
  const btnAcceptAll = document.getElementById('cookie-btn-accept-all');
  const btnRejectOptional = document.getElementById('cookie-btn-reject-optional');
  const btnManage = document.getElementById('cookie-btn-manage');
  
  const toggleFunctional = document.getElementById('cookie-toggle-functional') as HTMLInputElement | null;
  const toggleAnalytics = document.getElementById('cookie-toggle-analytics') as HTMLInputElement | null;
  
  const btnModalClose = document.getElementById('cookie-modal-close');
  const btnModalReject = document.getElementById('cookie-modal-reject');
  const btnModalSave = document.getElementById('cookie-modal-save');
  const btnModalAccept = document.getElementById('cookie-modal-accept');
  
  const btnFooterSettings = document.getElementById('btn-footer-cookie-settings');

  const CONSENT_KEY = 'wugweb_cookie_consent_v1';

  const defaultConsent = {
    necessary: true,
    functional: false,
    analytics: false
  };

  const getSavedConsent = () => {
    try {
      const saved = localStorage.getItem(CONSENT_KEY);
      return saved ? JSON.parse(saved) : null;
    } catch {
      return null;
    }
  };

  const saveConsent = (consent: any) => {
    try {
      localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
      applyScripts(consent);
    } catch {}
  };

  /**
   * The only thing consent actually switches on. Until 2026-09-24 this event
   * had no listener anywhere in the codebase — audit finding 16, "the consent
   * UI does nothing". `src/lib/analytics.ts` listens now, so rejecting
   * optional cookies means gtag is never requested at all.
   *
   * Called on a fresh accept and on load when consent was already stored, so
   * the listener does not need its own startup path.
   */
  const applyScripts = (consent: any) => {
    if (consent.analytics) {
      window.dispatchEvent(new CustomEvent('wugweb-analytics-allowed'));
    }
  };

  if (banner && modal) {
    const saved = getSavedConsent();
    if (!saved) {
      banner.style.display = 'block';
    } else {
      applyScripts(saved);
    }

    const openSettings = () => {
      const current = getSavedConsent() || defaultConsent;
      if (toggleFunctional) toggleFunctional.checked = current.functional;
      if (toggleAnalytics) toggleAnalytics.checked = current.analytics;
      modal.style.display = 'flex';
    };

    // Export globally for footer click triggers
    (window as any).openWugwebCookieSettings = openSettings;

    if (btnFooterSettings) {
      btnFooterSettings.addEventListener('click', (e) => {
        e.preventDefault();
        openSettings();
      });
    }

    if (btnManage) {
      btnManage.addEventListener('click', openSettings);
    }

    const closeSettings = () => {
      modal.style.display = 'none';
    };

    if (btnModalClose) btnModalClose.addEventListener('click', closeSettings);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeSettings();
    });

    const acceptAll = () => {
      const consent = { necessary: true, functional: true, analytics: true };
      saveConsent(consent);
      banner.style.display = 'none';
      closeSettings();
    };

    if (btnAcceptAll) btnAcceptAll.addEventListener('click', acceptAll);
    if (btnModalAccept) btnModalAccept.addEventListener('click', acceptAll);

    const rejectOptional = () => {
      const consent = { necessary: true, functional: false, analytics: false };
      saveConsent(consent);
      banner.style.display = 'none';
      closeSettings();
    };

    if (btnRejectOptional) btnRejectOptional.addEventListener('click', rejectOptional);
    if (btnModalReject) btnModalReject.addEventListener('click', rejectOptional);

    if (btnModalSave) {
      btnModalSave.addEventListener('click', () => {
        const consent = {
          necessary: true,
          functional: toggleFunctional ? toggleFunctional.checked : false,
          analytics: toggleAnalytics ? toggleAnalytics.checked : false
        };
        saveConsent(consent);
        banner.style.display = 'none';
        closeSettings();
      });
    }
  }

  // PWA INSTALL PROMPT
  // The browser's own beforeinstallprompt UI is suppressed (preventDefault)
  // in favour of this banner, which only appears once the browser has
  // actually confirmed the app is installable — never fabricated/forced.
  const installBanner = document.getElementById('wugweb-install-banner');
  const installAccept = document.getElementById('install-banner-accept');
  const installDismiss = document.getElementById('install-banner-dismiss');
  const INSTALL_DISMISS_KEY = 'wugweb_install_dismissed_v1';

  const alreadyStandalone =
    window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone;

  let deferredInstallPrompt: any = null;

  if (installBanner && installAccept && installDismiss && !alreadyStandalone) {
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      let dismissed = false;
      try {
        dismissed = localStorage.getItem(INSTALL_DISMISS_KEY) === '1';
      } catch {}
      if (dismissed) return;
      deferredInstallPrompt = e;
      installBanner.style.display = 'block';
    });

    installAccept.addEventListener('click', async () => {
      installBanner.style.display = 'none';
      if (!deferredInstallPrompt) return;
      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice.catch(() => {});
      deferredInstallPrompt = null;
    });

    installDismiss.addEventListener('click', () => {
      installBanner.style.display = 'none';
      try {
        localStorage.setItem(INSTALL_DISMISS_KEY, '1');
      } catch {}
    });

    window.addEventListener('appinstalled', () => {
      installBanner.style.display = 'none';
      deferredInstallPrompt = null;
    });
  }
</script>
