---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { siteSettingsQuery, postsListQuery } from '../lib/queries';
import { assetUrl } from '../lib/assets';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  ogImage?: string;
  language?: string;
}
const { title, description, seoTitle, ogImage, language } = Astro.props;

const settings = await sanityClient.fetch(siteSettingsQuery).catch(() => null);
const defaultLang = language || settings?.language || 'en-GB';
const siteName = settings?.siteTitle || 'wugweb — Digital Experience Agency';
const defaultDesc = settings?.seoDescription || 'Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.';
const defaultOgImage = settings?.ogImage
  ? urlFor(settings.ogImage).width(1200).height(630).url()
  : '/brand/og-default.png';
// Self-hosted from /public/brand — these used to hotlink Framer's CDN, which
// dies the moment the old Framer project is deleted.
const defaultFavicon = settings?.favicon
  ? urlFor(settings.favicon).width(32).url()
  : '/brand/favicon-32.png';
const defaultAppleTouch = settings?.favicon
  ? urlFor(settings.favicon).width(180).url()
  : '/brand/logo-small.svg';
const copyrightText = settings?.copyright || '© 2020–2026 Wugweb. All rights reserved.';
const siteEmail = settings?.contactEmail || 'hello@wugweb.com';

const pageTitle = seoTitle || title;
const metaDesc = description || defaultDesc;
const metaOgImage = ogImage || defaultOgImage;

// Global blog teaser — latest 3 posts, Sanity-driven with cover thumbnails.
const teaserPosts = (await sanityClient.fetch(postsListQuery).catch(() => [])).slice(0, 3);
const teaserCovers = teaserPosts.map((p: any) => {
  const cover = p.coverPath
    ? assetUrl(p.coverPath)
    : (p.coverImage ? urlFor(p.coverImage).width(640).height(400).url() : '');
  return cover;
});

// Industries section — sourced from the Sanity industry master.
const curatedIndustries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
const sanityIndustries = (await sanityClient
  .fetch('*[_type == "industry"] | order(order asc) { name }[0..23]')
  .catch(() => [])).map((i: any) => i.name);
const globalIndustries = (sanityIndustries as string[]).length
  ? (sanityIndustries as string[])
  : curatedIndustries;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · wugweb</title>
    <meta name="description" content={metaDesc} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle + ' · wugweb'} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaOgImage} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle + ' · wugweb'} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaOgImage} />

    <!-- Favicon -->
    <link href={defaultFavicon} rel="icon" />
    <link rel="apple-touch-icon" href={defaultAppleTouch} />

    <!-- PWA -->
    <meta name="theme-color" content="#050505" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="wugweb" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <script is:inline>
      if ('serviceWorker' in navigator && !location.hostname.startsWith('localhost')) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fragment+Mono:wght@400&family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader companyEmail={siteEmail} />
    <slot />

    <!-- PARTNERS -->
    <section class="wrap global-partners">
      <p class="eyebrow">Our Partners in Experience Innovation</p>
      <a href="/contact-us" class="btn btn-solid btn-partners-cta">Let's Talk</a>
    </section>

    <!-- INDUSTRIES -->
    <section class="wrap global-industries">
      <h2>Industries We Empower</h2>
      <p>From local businesses to international corporations, our clients all share one common understanding when it comes to building authentic brands: the power of research, strategy, creativity, and design.</p>
      <ul class="industry-tags">
        {globalIndustries.map((i) => <li>{i}</li>)}
      </ul>
      <a href="/about" class="btn btn-ghost">More about us</a>
    </section>

    <!-- BLOG TEASER -->
    <section class="wrap global-blog-teaser">
      <div class="global-blog-head">
        <h2>Some of our recent thoughts</h2>
        <a href="/blog" class="btn btn-ghost">Visit our Blog</a>
      </div>
      <ul class="global-blog-list">
        {teaserPosts.map((p: any, i: number) => (
          <li>
            {teaserCovers[i] ? (
              <a href={`/blog/${p.slug}`} class="blog-teaser-media">
                <img src={teaserCovers[i]} alt={p.title} loading="lazy" />
              </a>
            ) : null}
            {p.category && <span class="eyebrow">{p.category}</span>}
            <a href={`/blog/${p.slug}`}>{p.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- TRUST & RECOGNITION -->
    <section class="wrap">
      <TrustBadges />
    </section>

    <!-- FINAL CTA -->
    <section class="global-final-cta">
      <div class="wrap final-cta-inner">
        <div>
          <h2>We speak your Industry's language.</h2>
          <p>Partner with Wugweb for domain-driven design and development that delivers.</p>
        </div>
        <a href="/contact-us" class="btn btn-solid">Request Quote</a>
      </div>
    </section>

    <SiteFooter copyright={copyrightText} companyEmail={siteEmail} />
  </body>
</html>

<script>
  // GSAP scroll-transform animations for [data-scroll] elements on every page.
  import { initScrollAnimations } from '../lib/scroll-animations';
  initScrollAnimations();
</script>
