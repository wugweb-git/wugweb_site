---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { siteSettingsQuery } from '../lib/queries';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  ogImage?: string;
  language?: string;
}
const { title, description, seoTitle, ogImage, language } = Astro.props;

const settings = await sanityClient.fetch(siteSettingsQuery).catch(() => null);
const defaultLang = language || settings?.language || 'en-GB';
const siteName = settings?.siteTitle || 'wugweb — Digital Experience Agency';
const defaultDesc = settings?.seoDescription || 'Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.';
const defaultOgImage = settings?.ogImage
  ? urlFor(settings.ogImage).width(1200).height(630).url()
  : 'https://framerusercontent.com/assets/HGyE1GVVipOJ7v9BLJTPI7UW8.jpg';
const defaultFavicon = settings?.favicon
  ? urlFor(settings.favicon).width(32).url()
  : 'https://framerusercontent.com/images/yJuYg2lrJmWntF3zHlL9zyg8sdM.png';
const defaultAppleTouch = settings?.favicon
  ? urlFor(settings.favicon).width(180).url()
  : 'https://framerusercontent.com/images/eyKzVpdm2A4IB87tYf4LkVIM9mM.png';
const copyrightText = settings?.copyright || '© 2020–2026 Wugweb. All rights reserved.';
const siteEmail = settings?.contactEmail || 'hello@wugweb.com';

const pageTitle = seoTitle || title;
const metaDesc = description || defaultDesc;
const metaOgImage = ogImage || defaultOgImage;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · wugweb</title>
    <meta name="description" content={metaDesc} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle + ' · wugweb'} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaOgImage} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle + ' · wugweb'} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaOgImage} />

    <!-- Favicon -->
    <link href={defaultFavicon} rel="icon" />
    <link rel="apple-touch-icon" href={defaultAppleTouch} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500&family=Fragment+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader companyEmail={siteEmail} />
    <slot />

    <!-- PARTNERS -->
    <section class="wrap global-partners">
      <p class="eyebrow">Our Partners in Experience Innovation</p>
      <a href="/contact-us" class="btn btn-solid btn-partners-cta">Let's Talk</a>
    </section>

    <!-- INDUSTRIES -->
    <section class="wrap global-industries">
      <h2>Industries We Empower</h2>
      <p>From local businesses to international corporations, our clients all share one common understanding when it comes to building authentic brands: the power of research, strategy, creativity, and design.</p>
      <ul class="industry-tags">
        {['Government','Insurtech','Travel','Logistics','Automotive','Fintech','Edtech','Sports','E-commerce','Media','Energy','NGOs'].map((i) => <li>{i}</li>)}
      </ul>
      <a href="/about" class="btn btn-ghost">More about us</a>
    </section>

    <!-- BLOG TEASER -->
    <section class="wrap global-blog-teaser">
      <p class="eyebrow">Some of our recent thoughts</p>
      <a href="/blog" class="btn btn-ghost">Visit our Blog</a>
    </section>

    <!-- FINAL CTA -->
    <section class="global-final-cta">
      <div class="wrap final-cta-inner">
        <h2>We speak your Industry's language. Partner with Wugweb for domain-driven design and development that delivers.</h2>
        <a href="/contact-us" class="btn btn-solid">Request Quote</a>
      </div>
    </section>

    <SiteFooter copyright={copyrightText} companyEmail={siteEmail} />
  </body>
</html>
