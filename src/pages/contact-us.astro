---
// Dynamic — this is where the form POST will land.
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery } from '../lib/queries';

// Title/intro Sanity-editable now; contact details and form field
// definitions stay hardcoded (config, not editorial copy).
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'contact' }).catch(() => null);
const heroTitle = page?.title ?? 'Are you ready to build something that matters?';
const heroText =
  page?.body?.[0]?.children?.[0]?.text ??
  "We're always looking for passionate clients and talented professionals to join us in creating impactful work. Whether you have a bold vision you want to bring to life or expertise to contribute, let's collaborate and make something great together.";

const interests = ['Branding', 'Design', 'Software', 'Product', 'Marketing'];
const budgets = ['<$3K', '<$6K', '<$15K', '<$25K'];
---

<BaseLayout title="Contact Us" description="Have a project in mind? Get in touch with Wugweb for UI/UX design and digital solutions.">
  <section class="wrap contact">
    <div class="contact-intro">
      <h1>{heroTitle}</h1>
      <p>
        {heroText}
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-details">
        <div>
          <p class="eyebrow">Email</p>
          <p class="detail-value"><a href="mailto:hello@wugweb.com">hello@wugweb.com</a></p>
        </div>
        <div>
          <p class="eyebrow">Phone</p>
          <p class="detail-value">
            <a href="tel:+918802139220">+91 88021 39220</a><br />
            <a href="tel:+971504647672">+971 50 464 7672</a>
          </p>
        </div>
        <div>
          <p class="eyebrow">Address</p>
          <p class="detail-value">
            Floor 19, WeWork Berger Delhi One, C-001/A2, Sector 16B, Noida, UP, India - 201301
          </p>
        </div>
      </div>

      <!-- Submits to /api/contact — see that file for what's actually
           wired up vs. still stubbed. -->
      <form class="contact-form" method="POST" action="/api/contact">
        <label>
          Hi, my name is
          <input type="text" name="name" required />
        </label>

        <label>
          and I'm from
          <input type="text" name="company" placeholder="Company / location" />
        </label>

        <fieldset>
          <legend>I'm interested in</legend>
          {interests.map((i) => (
            <label class="checkbox">
              <input type="checkbox" name="interests" value={i} />
              {i}
            </label>
          ))}
        </fieldset>

        <label>
          on the topic
          <textarea name="topic" rows="3" placeholder="Tell us about the project"></textarea>
        </label>

        <fieldset>
          <legend>My budget for this project is</legend>
          {budgets.map((b) => (
            <label class="radio">
              <input type="radio" name="budget" value={b} />
              {b}
            </label>
          ))}
        </fieldset>

        <label>
          You can reach me at
          <input type="email" name="email" required placeholder="you@company.com" />
        </label>

        <label>
          or call me on
          <input type="tel" name="phone" placeholder="Optional" />
        </label>

        <label>
          I'd prefer to be contacted by
          <select name="contactMethod">
            <option>Email</option>
            <option>Phone</option>
          </select>
        </label>

        <label class="checkbox">
          <input type="checkbox" name="newsletter" value="yes" />
          I would like to receive newsletters by email. Read our <a href="/privacy-policy">Privacy Policy</a>.
        </label>

        <button type="submit" class="btn btn-solid">Submit</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: var(--space-section-xl); }
  .contact-intro h1 { font-size: var(--t-h2); max-width: 18ch; }
  .contact-intro p { margin-top: var(--gap-5); max-width: 55ch; }
  .contact-grid { margin-top: var(--space-section-md); display: grid; gap: var(--gap-12); }
  @media (min-width: 900px) { .contact-grid { grid-template-columns: 1fr 1.6fr; } }
  .contact-details { display: flex; flex-direction: column; gap: var(--gap-8); }
  .detail-value { margin-top: var(--gap-1); color: var(--fg); }
  .detail-value a { text-decoration: none; color: var(--fg); }
  .contact-form { display: flex; flex-direction: column; gap: var(--gap-6); }
  .contact-form label { display: flex; flex-direction: column; gap: var(--gap-2); font-family: var(--font-mono); font-size: var(--fluid-label); color: var(--fg-muted); }
  .contact-form input[type='text'], .contact-form textarea, .contact-form select { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-1); padding: var(--gap-3) var(--gap-4); color: var(--fg); font-family: var(--font-body); font-size: var(--fluid-body-md); }
  .contact-form fieldset { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--gap-2); }
  .contact-form legend { font-family: var(--font-mono); font-size: var(--fluid-label); color: var(--fg-muted); padding: 0; margin-bottom: var(--s-1); }
  .contact-form .checkbox, .contact-form .radio { flex-direction: row; align-items: center; gap: var(--gap-2); color: var(--fg); }
  .contact-form a { color: var(--accent-warm); }
  .contact-form button { align-self: flex-start; border: none; cursor: pointer; margin-top: var(--gap-2); }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.contact-details div, .contact-form label, .contact-form fieldset, .contact-form button', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
