---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    n: '01', title: 'Strategy',
    tags: ['Brand Strategy', 'Market Positioning', 'Digital Strategy', 'Growth Roadmaps'],
    body: 'We help organisations define their north star. From brand positioning and market strategy to digital transformation roadmaps, our strategists combine deep research with creative thinking to chart a clear path forward. We don\'t just plan — we build strategies that translate into measurable outcomes.',
    video: 'https://wugweb.online/assets/more/services/services_brand-mp4.mp4',
  },
  {
    n: '02', title: 'Brand',
    tags: ['Identity Systems', 'Naming', 'Visual Identity', 'Brand Guidelines'],
    body: 'Your brand is more than a logo — it\'s the sum of every interaction people have with you. We craft distinct brand identities, from naming and visual systems to tone of voice and comprehensive guidelines, ensuring your brand stands out and stays consistent across every touchpoint.',
    video: 'https://wugweb.online/assets/more/services/services_brand-mp4.mp4',
  },
  {
    n: '03', title: 'Experience',
    tags: ['UX Design', 'UI Design', 'Design Systems', 'User Research'],
    body: 'We design digital experiences that people love to use. Rooted in human-centered design and rigorous user research, our UX/UI services cover everything from journey mapping and wireframing to polished visual design and scalable design systems — all focused on creating intuitive, engaging products.',
    video: 'https://wugweb.online/assets/more/services/services_uxdesign-mp4.mp4',
  },
  {
    n: '04', title: 'Growth',
    tags: ['MarTech', 'AI & Automation', 'Lead Generation', 'Analytics'],
    body: 'Growth is driven by smart systems and sharper insights. We help businesses unlock data-driven marketing through MarTech consulting, marketing automation, AI integration, and lead generation strategies — turning your marketing into a measurable, scalable engine for acquisition and retention.',
    video: 'https://wugweb.online/assets/more/services/services_martech-mp4.mp4',
  },
  {
    n: '05', title: 'Engineering',
    tags: ['Web Development', 'App Development', 'Cloud & DevOps', 'Full-Stack'],
    body: 'We build robust, performant digital products using modern engineering practices. From responsive websites and e-commerce platforms to native mobile apps and cloud-native architectures, our engineering team delivers scalable solutions that are secure, fast, and built to last.',
    video: 'https://wugweb.online/assets/more/services/services_webdevelopment-mp4.mp4',
  },
  {
    n: '06', title: 'Operations',
    tags: ['QA & Testing', 'No-Code Solutions', 'Process Automation', 'SRE'],
    body: 'Great products need great operations behind them. We provide QA and testing services, no-code development for rapid delivery, workflow automation, and site reliability engineering — ensuring your digital products run smoothly, ship faster, and scale without friction.',
    video: 'https://wugweb.online/assets/more/services/services_nocode-mp4.mp4',
  },
];

const stats = [
  { n: '01', label: 'Years of experience', copy: 'Expertise that drives meaningful results.' },
  { n: '02', label: 'Projects delivered', copy: 'Creative solutions built with purpose.' },
  { n: '03', label: 'Client Retention Rate', copy: 'Long-term partnerships built on real results.' },
  { n: '04', label: 'Start Smart, Start Small', copy: '' },
];
---

<BaseLayout title="Services" description="Digital Experience Services — Wugweb">
  <!-- HERO -->
  <section class="services-hero">
    <div class="wrap services-hero-content">
      <p class="eyebrow" data-reveal>Services</p>
      <h1 data-reveal>At Wugweb, we design with function driving aesthetics—crafting scalable, human-centered systems across brand, UI/UX, web, apps, martech, AI, QA, and no-code.</h1>
      <p class="services-hero-sub" data-reveal>As a UX design agency and development partner, we blend creativity with technical precision to deliver impactful, multi-platform experiences.</p>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats">
    <ul>
      {stats.map((s) => (
        <li data-reveal>
          <span class="stat-n">{s.n}</span>
          <p class="stat-label">{s.label}</p>
          {s.copy && <p class="stat-copy">{s.copy}</p>}
        </li>
      ))}
    </ul>
  </section>

  <!-- INTRO -->
  <section class="wrap services-intro">
    <h2 data-reveal>Bringing intuitive and beautiful innovations to life.</h2>
    <p data-reveal>
      We create at the intersection of design and technology, combining UX design services with innovative systems to bring the future into the present. Our UI UX design agency develops comprehensive strategies through a human-centered design lens, then brings them to life with adaptable, scalable platforms. With our experience design services and technical expertise, every solution is built to thrive in today's fast-changing digital environment.
    </p>
  </section>

  <!-- SERVICE CARDS -->
  <div class="service-cards">
    {services.map((s, i) => (
      <section class="service-card" id={s.title.toLowerCase()} data-service={i}>
        <div class="service-card-sticky">
          <div class="service-card-content">
            <video class="service-card-video" autoplay muted loop playsinline src={s.video}></video>
            <div class="service-card-overlay"></div>
            <div class="service-card-info">
              <span class="service-card-n">{s.n}</span>
              <h2 class="service-card-title">{s.title}</h2>
              <ul class="service-card-tags">
                {s.tags.map((t) => <li>{t}</li>)}
              </ul>
              <p class="service-card-body">{s.body}</p>
              <div class="service-card-ctas">
                <a href={`/services/${s.title.toLowerCase()}`} class="btn btn-ghost">Learn More</a>
                <a href="/contact-us" class="btn btn-solid">Get in Touch</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- WHY WUGWEB -->
  <section class="wrap why-section">
    <p class="eyebrow" data-reveal>Why Wugweb?</p>
    <h2 data-reveal>In a world clamoring for attention, your brand deserves more than fleeting visibility.</h2>
    <p data-reveal>It requires a strategic partner that architects compelling narratives, cultivates authentic connections, and engineers brand experiences designed to stand the test of time.</p>
    <ul class="why-grid">
      <li data-reveal>
        <h3>Strategic Brand Vision</h3>
        <p>Resonant brand foundations are architected through the synthesis of strategic insight and creative brilliance, driving measurable business growth.</p>
      </li>
      <li data-reveal>
        <h3>Data-Driven Brand Evolution</h3>
        <p>Data and analytics inform brand strategy, optimizing brand performance and fueling sustainable brand evolution.</p>
      </li>
      <li data-reveal>
        <h3>Authentic Brand Storytelling</h3>
        <p>Brand's core essence is unearthed, crafting authentic narratives that forge emotional connections and inspire unwavering loyalty.</p>
      </li>
      <li data-reveal>
        <h3>Holistic Brand Experience Design</h3>
        <p>Cohesive brand experiences are engineered across all touchpoints, ensuring consistency, impact, and a seamless customer journey.</p>
      </li>
    </ul>
  </section>

  <!-- FAQ -->
  <section class="wrap services-faq">
    <h2 data-reveal>Frequently asked questions</h2>
    <p data-reveal>To help you get the information you need quickly, we've compiled a list of frequently asked questions. If you don't find the answer you're looking for, please feel free to contact us directly.</p>
    <div class="faq-list">
      <details class="faq-item"><summary>What services does Wugweb offer?</summary><p>Wugweb offers six core service areas: Strategy, Brand, Experience, Growth, Engineering, and Operations — covering everything from brand positioning and UX design to development, marketing, QA, and automation.</p></details>
      <details class="faq-item"><summary>What is the difference between Strategy and Brand services?</summary><p>Strategy focuses on market positioning, research, and roadmapping — defining where you need to go. Brand brings that strategy to life through visual identity, naming, and guidelines — defining who you are.</p></details>
      <details class="faq-item"><summary>What does the Experience service cover?</summary><p>Experience covers UX/UI design — user research, journey mapping, wireframing, visual design, design systems, and usability testing. It's about creating digital products people love to use.</p></details>
      <details class="faq-item"><summary>How do Growth and Engineering differ?</summary><p>Growth focuses on marketing technology, AI automation, lead generation, and analytics — driving acquisition and retention. Engineering builds the actual digital products — websites, apps, APIs, and cloud infrastructure.</p></details>
      <details class="faq-item"><summary>What's included in Operations?</summary><p>Operations covers QA & testing, no-code development, workflow automation, and site reliability — ensuring your digital products run smoothly, ship faster, and scale without friction.</p></details>
      <details class="faq-item"><summary>Do you offer both design and development?</summary><p>Yes. Our Experience and Brand services cover design, while Engineering handles development. We often combine them for end-to-end projects — from strategy through design to build and launch.</p></details>
      <details class="faq-item"><summary>Can I get a custom package combining multiple services?</summary><p>Absolutely. Most of our engagements combine multiple service areas. We'll work with you to define a scope that fits your specific goals and budget.</p></details>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero { padding-block: 8rem 4rem; }
  .services-hero-content h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 500; max-width: 28ch; margin-top: 1rem; }
  .services-hero-sub { margin-top: 1.25rem; max-width: 55ch; }
  .stats { padding-block: 5rem; border-top: 1px solid var(--line); }
  .stats ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .stats ul { grid-template-columns: repeat(4, 1fr); } }
  .stats li { border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .stat-n { font-family: var(--font-mono); color: var(--accent-warm); }
  .stat-label { color: var(--fg); font-size: 1.1rem; margin-top: 0.5rem; }
  .stat-copy { margin-top: 0.4rem; }

  .services-intro { padding-block: 6rem; border-top: 1px solid var(--line); }
  .services-intro h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); max-width: 20ch; }
  .services-intro p { margin-top: 1.25rem; max-width: 65ch; }

  /* Service cards — full-viewport, scroll-transform */
  .service-cards { position: relative; }
  .service-card {
    height: 100vh; max-height: 1080px;
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .service-card-sticky {
    position: sticky; top: 0;
    height: 100vh; max-height: 1080px;
    width: 100%;
    display: flex; align-items: center; justify-content: center;
    transform-origin: center center;
    will-change: transform, opacity;
  }
  .service-card-content {
    position: relative;
    width: 92%; max-width: 1200px;
    height: 85vh; max-height: 880px;
    border-radius: 24px;
    overflow: hidden;
    display: flex; align-items: flex-end;
  }
  .service-card-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .service-card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.15) 50%, rgba(0,0,0,.05) 100%);
    z-index: 1;
  }
  .service-card-info {
    position: relative; z-index: 2;
    padding: 3rem 3.5rem;
    max-width: 640px;
  }
  .service-card-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: 0.8rem; }
  .service-card-title { font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 600; letter-spacing: -0.02em; margin-top: 0.35rem; }
  .service-card-tags { list-style: none; margin: 0.75rem 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .service-card-tags li { font-family: var(--font-mono); font-size: 0.7rem; padding: 0.25rem 0.7rem; border: 1px solid rgba(255,255,255,.25); border-radius: 999px; color: rgba(255,255,255,.7); }
  .service-card-body { margin-top: 0.75rem; font-size: 0.95rem; line-height: 1.65; color: rgba(255,255,255,.75); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .service-card-ctas { display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .service-card-ctas .btn-ghost { border-color: rgba(255,255,255,.3); color: #fff; }
  .service-card-ctas .btn-ghost:hover { border-color: rgba(255,255,255,.7); }
  .service-card-ctas .btn-solid { background: var(--accent-warm); color: #000; }
  .service-card-ctas .btn-solid:hover { background: #ffd44d; }

  @media (max-width: 767px) {
    .service-card-info { padding: 2rem 1.5rem; }
    .service-card-content { height: 90vh; border-radius: 16px; width: 96%; }
    .service-card-body { -webkit-line-clamp: 3; }
  }

  .why-section { padding-block: 6rem; border-top: 1px solid var(--line); }
  .why-section h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); margin-top: 0.75rem; max-width: 22ch; }
  .why-section > p { margin-top: 1.25rem; max-width: 55ch; }
  .why-grid { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  .why-grid li { border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .why-grid h3 { font-size: 1.15rem; font-weight: 500; }
  .why-grid p { margin-top: 0.5rem; }

  .services-faq { padding-block: 6rem; border-top: 1px solid var(--line); }
  .services-faq h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); }
  .services-faq > p { margin-top: 1rem; max-width: 55ch; }
  .faq-list { margin-top: 3rem; border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); padding-block: 1.25rem; }
  .faq-item summary { font-family: var(--font-display); font-size: 1.1rem; cursor: pointer; }
</style>

<script>
  import { animate, inView, scroll, timeline } from 'motion';

  // Entrance reveal for hero and static sections
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.stats li, .why-grid li, .faq-item, .services-faq .faq-item', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });

  // Scroll-driven card transforms
  const cards = document.querySelectorAll('.service-card');
  const cardHeight = window.innerHeight;
  const total = cards.length;

  cards.forEach((card, i) => {
    const sticky = card.querySelector('.service-card-sticky');
    const content = card.querySelector('.service-card-content');

    // Stagger entrance — card fades in from bottom as it enters viewport
    inView(card, () => {
      animate(sticky, { opacity: [0, 1], y: [80, 0] }, { duration: 0.8, easing: [0.16, 1, 0.3, 1] });
    }, { amount: 0.2 });

    // Scroll-driven scale — card shrinks as it scrolls up and out
    scroll(animate(sticky, {
      transform: [
        'scale(1) translateY(0)',
        'scale(0.92) translateY(0)',
        'scale(0.85) translateY(-60px)',
      ],
      opacity: [1, 1, 0],
    }), {
      target: card,
      axis: 'y',
    });
  });
</script>
