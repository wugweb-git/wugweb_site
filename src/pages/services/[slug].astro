---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { serviceBySlugQuery, caseStudiesListQuery, postsListQuery } from '../../lib/queries';

const hardcodedServices: Record<string, any> = {
  'strategy': {
    title: 'Strategy',
    subtitle: 'Define the future before building it.',
    tags: ['Business Strategy', 'Product Strategy', 'AI Strategy', 'Transformation'],
    heroText: "Every great digital experience starts with a clear strategy. We help organisations define their north star, uncover market opportunities, and build actionable roadmaps that align vision with execution. From brand positioning to digital transformation, our strategic work sets the foundation for everything that follows.",
    body: 'We don\'t just plan — we build strategies that translate into measurable outcomes. Our strategists combine deep research, market intelligence, and creative thinking to chart a clear path forward. Whether you\'re launching a new brand, entering a new market, or reimagining your digital presence, we provide the strategic clarity you need to move with confidence.',
    capabilities: [
      { n: '01', title: 'Business', items: ['Business Strategy', 'Digital Transformation', 'Innovation', 'Market Research'] },
      { n: '02', title: 'Product', items: ['Product Strategy', 'Product Discovery', 'Roadmapping', 'MVP Planning'] },
      { n: '03', title: 'AI', items: ['AI Strategy', 'AI Readiness', 'AI Opportunity Mapping', 'Transformation Workshops'] },
    ],
    approach: [
      { n: '01', title: 'Discovery & Research', body: 'We immerse ourselves in your business, market, and audience to uncover the insights that inform every decision.' },
      { n: '02', title: 'Strategic Framing', body: 'We synthesise research into a clear strategic framework — defining your positioning, narrative, and path forward.' },
      { n: '03', title: 'Roadmap & Execution Planning', body: 'We build actionable roadmaps that sequence initiatives, align stakeholders, and set measurable milestones.' },
      { n: '04', title: 'Validation & Refinement', body: 'We validate strategy through data and feedback, refining direction based on real-world performance.' },
    ],
    faqs: [
      { q: 'What does your Strategy service include?', a: 'Our Strategy service covers brand positioning, market research, digital transformation planning, growth roadmapping, and go-to-market strategy.' },
      { q: 'How long does a typical strategy engagement take?', a: 'Timelines vary by scope. A typical strategy engagement runs 2-6 weeks from discovery to delivery.' },
      { q: 'Do you work with startups or only established businesses?', a: 'Both. We work with early-stage startups needing product-market fit strategy and established enterprises pursuing digital transformation.' },
      { q: 'How do you measure strategy success?', a: 'We define clear KPIs upfront — whether that\'s market share, user adoption, revenue growth, or brand awareness metrics.' },
    ],
    why: [
      { title: 'Research-Backed Clarity', body: 'Every recommendation is grounded in real market data and user research, not assumptions.' },
      { title: 'Actionable Roadmaps', body: 'We don\'t just deliver decks — we provide execution-ready plans with clear ownership and timelines.' },
      { title: 'Cross-Disciplinary Thinking', body: 'Our strategists draw on brand, design, engineering, and growth perspectives for holistic solutions.' },
      { title: 'Measurable Outcomes', body: 'We define success metrics upfront and build strategy around achieving tangible business results.' },
    ],
  },
  'brand': {
    title: 'Brand',
    subtitle: 'Create brands people remember.',
    tags: ['Brand Strategy', 'Identity Systems', 'Naming', 'Brand Guidelines'],
    heroText: "Your brand is more than a logo — it's the sum of every interaction people have with you. We craft distinct brand identities that build emotional connection, inspire loyalty, and drive long-term growth. From naming and visual systems to voice and comprehensive guidelines, we ensure your brand stands out and stays consistent.",
    body: 'A strong brand is a strategic asset. We help organisations define who they are, what they stand for, and how they show up in the world. Our brand process combines strategic thinking with creative excellence — resulting in identities that are not only beautiful but strategically grounded and built to last.',
    capabilities: [
      { n: '01', title: 'Brand Strategy', items: ['Positioning', 'Narrative', 'Naming', 'Messaging'] },
      { n: '02', title: 'Identity', items: ['Identity Systems', 'Voice & Tone', 'Employer Brand', 'Brand Guidelines'] },
      { n: '03', title: 'Activation', items: ['Brand Activation', 'Campaigns', 'Brand Audits', 'Brand Evolution'] },
    ],
    approach: [
      { n: '01', title: 'Discovery & Brand Audit', body: 'We dive deep into your brand\'s current state, market position, and aspirations to identify opportunities.' },
      { n: '02', title: 'Strategic Positioning', body: 'We define your brand\'s purpose, personality, and positioning — the strategic foundation for all creative work.' },
      { n: '03', title: 'Visual & Verbal Identity', body: 'We craft the visual system — logo, colour, typography, imagery — and the verbal identity that brings your brand to life.' },
      { n: '04', title: 'Guidelines & Activation', body: 'We deliver comprehensive brand guidelines that empower your team to apply the identity consistently across every touchpoint.' },
    ],
    faqs: [
      { q: 'What\'s included in a full brand identity project?', a: 'A full brand identity includes brand strategy, naming (if needed), logo design, visual identity system, typography, colour palette, tone of voice, and comprehensive brand guidelines.' },
      { q: 'Do you design logos only?', a: 'Logo design is part of our offering, but we always deliver it as part of a full visual identity system — not in isolation.' },
      { q: 'How long does a brand project take?', a: 'A typical brand identity project runs 4-8 weeks from discovery to final deliverables, depending on scope.' },
      { q: 'Do you create brand guidelines?', a: 'Absolutely. We create comprehensive brand guidelines that ensure consistency across all channels and touchpoints.' },
    ],
    why: [
      { title: 'Strategic Foundation', body: 'Every brand we create is built on a clear strategic foundation — not just aesthetics.' },
      { title: 'Holistic Identity Systems', body: 'We design cohesive systems that work across digital, print, environmental, and every other touchpoint.' },
      { title: 'Authentic Storytelling', body: 'We uncover the core of your brand to craft narratives that resonate, connect, and inspire loyalty.' },
      { title: 'Practical Guidelines', body: 'Our guidelines are designed to be used — clear, actionable, and easy for your team to implement.' },
    ],
  },
  'experience': {
    title: 'Experience',
    subtitle: 'Design products people love using.',
    tags: ['UX Design', 'UI Design', 'Design Systems', 'User Research'],
    heroText: "We design digital experiences that people love to use. Rooted in human-centered design and rigorous user research, our UX/UI services cover everything from journey mapping and wireframing to polished visual design and scalable design systems — all focused on creating intuitive, engaging products that drive business results.",
    body: 'In the experience economy, exceptional design is a competitive advantage. We design and engineer intuitive, engaging digital experiences that captivate users, build brand loyalty, and fuel sustainable growth. Our process is collaborative, data-informed, and relentlessly focused on delivering value to both users and businesses.',
    capabilities: [
      { n: '01', title: 'Research', items: ['UX Research', 'Service Design', 'Information Architecture', 'Journey Mapping'] },
      { n: '02', title: 'Design', items: ['UX Design', 'UI Design', 'Design Systems', 'Prototyping'] },
      { n: '03', title: 'Testing & Accessibility', items: ['User Testing', 'Accessibility', 'Usability Testing', 'Design Critique'] },
    ],
    approach: [
      { n: '01', title: 'User Discovery', body: 'We illuminate design possibilities through deep dives into user behaviour, needs, and pain points.' },
      { n: '02', title: 'Design & Prototyping', body: 'We rapidly explore solutions through wireframes, prototypes, and iterative design cycles.' },
      { n: '03', title: 'Testing & Validation', body: 'We validate designs through usability testing and data analysis, driving continuous improvement.' },
      { n: '04', title: 'Design & Development Handoff', body: 'We ensure seamless translation from design to development with detailed specs and design system components.' },
    ],
    process: [
      { phase: 'Discovery', steps: ['Kick-off meeting', 'Competitor analysis', 'User interview', 'Brain storming'] },
      { phase: 'Ideation', steps: ['User journey', 'Sitemap', 'Wireframes & prototyping', 'Usability testing'] },
      { phase: 'Prototyping & Testing', steps: ['Analysing results', 'Look and feel drafts', 'Design concept', 'Final UI design'] },
      { phase: 'UI Design', steps: ['Final UI design', 'Handover meeting'] },
    ],
    tools: [
      { category: 'User Research & Testing', items: ['Maze', 'Dovetail', 'Lyssna', 'Remesh', 'UserZoom', 'UserLytics', 'Reflect', 'Trymata'] },
      { category: 'Collaboration & Workflow', items: ['Notion', 'Zeroheight', 'Supernova', 'UiInspector', 'Keep'] },
      { category: 'Designing & Prototyping', items: ['Plasmic', 'Sketch', 'Figma', 'Vercel', 'RIVE', 'Webflow', 'penpot', 'Framer', 'Canva'] },
      { category: 'Organization & Productivity', items: ['Mem', 'Opal', 'ValidatorAI', 'Perplexity', 'Obsidian', 'Any.do', 'BeeDone', 'Tavus'] },
      { category: 'AI-Powered Design Tools', items: ['Uizard', 'Lummi', 'GalileoAI', 'Stockimg.ai', 'Khroma', 'Midjourney', 'OpenArt', 'Jitter', 'Illustroke'] },
    ],
    faqs: [
      { q: 'What is Experience Design?', a: 'Experience design is the practice of designing products and services with a focus on the quality of the user experience across every touchpoint.' },
      { q: 'Why is Customer Experience Design important?', a: 'Exceptional customer experience drives loyalty, increases conversions, and creates competitive advantage in the experience economy.' },
      { q: 'What services do you offer?', a: 'We offer UX strategy, user research, information architecture, interaction design, visual design, usability testing, design systems, and accessibility.' },
      { q: 'What\'s your design approach?', a: 'Our approach is human-centered, data-informed, and collaborative. We start with deep user research and iterate through testing and refinement.' },
      { q: 'How do you ensure user needs are met?', a: 'Through continuous user research, usability testing, and data-driven validation at every stage of the design process.' },
      { q: 'How do you measure design effectiveness?', a: 'We measure effectiveness through usability metrics, user satisfaction scores, conversion rates, and business KPIs aligned with your goals.' },
      { q: 'How do you approach collaboration?', a: 'We collaborate closely with your team throughout the process — from discovery workshops to design reviews to development handoff.' },
      { q: 'Can you help with new product design?', a: 'Absolutely. We specialise in taking products from concept to launch, including MVP design, full product design, and redesigns.' },
      { q: 'Do you design for accessibility?', a: 'Yes. Accessibility is built into our process from day one, following WCAG guidelines to ensure inclusive experiences.' },
      { q: 'What\'s the final deliverable?', a: 'Deliverables include design files, interactive prototypes, design system documentation, asset exports, and developer handoff specs.' },
    ],
    why: [
      { title: 'Human-Centered Process', body: 'Every design decision is grounded in real user needs and behavioural insights — not assumptions.' },
      { title: 'Rapid Iteration', body: 'We move fast through prototypes and testing cycles, validating ideas before investing in development.' },
      { title: 'Scalable Design Systems', body: 'We build design systems that grow with your product, ensuring consistency across every feature and platform.' },
      { title: 'Accessibility First', body: 'We design for everyone, following WCAG guidelines to ensure your product is usable by all.' },
    ],
  },
  'growth': {
    title: 'Growth',
    subtitle: 'Turn products into businesses.',
    tags: ['Marketing', 'MarTech', 'Analytics', 'AI Marketing'],
    heroText: "Growth is driven by smart systems and sharper insights. We help businesses unlock data-driven marketing through MarTech consulting, marketing automation, AI integration, and lead generation strategies — turning your marketing into a measurable, scalable engine for acquisition and retention.",
    body: 'Marketing success today is powered by smart systems and sharper insights. We help unlock your marketing potential through MarTech consulting that connects data, automates workflows, and creates tailored experiences. Our approach is holistic — we test, adapt, and optimise continuously using AI-powered marketing strategies to drive measurable growth.',
    capabilities: [
      { n: '01', title: 'Marketing', items: ['SEO', 'Performance Marketing', 'Content Strategy', 'Social', 'Campaigns'] },
      { n: '02', title: 'MarTech', items: ['CRM', 'Marketing Automation', 'Email Automation', 'Customer Journeys', 'Personalization'] },
      { n: '03', title: 'Intelligence', items: ['Analytics', 'Attribution', 'CRO', 'Experimentation', 'AI Marketing', 'Customer Insights'] },
    ],
    approach: [
      { n: '01', title: 'Audit & Strategy', body: 'We start with a comprehensive audit of your current marketing stack, data flows, and growth opportunities.' },
      { n: '02', title: 'Implementation & Integration', body: 'We activate strategy through seamless MarTech stack integration and AI-powered campaign setup.' },
      { n: '03', title: 'Optimisation & Analysis', body: 'We continuously refine using real-time performance analytics across the full marketing lifecycle.' },
      { n: '04', title: 'Scale & Evolve', body: 'We evolve your growth systems over time, adapting to new channels, data insights, and market changes.' },
    ],
    faqs: [
      { q: 'What is MarTech and how can it help my business?', a: 'MarTech combines marketing and technology to automate, measure, and optimize marketing efforts for better ROI and customer experiences.' },
      { q: 'How do you use AI in marketing?', a: 'We leverage AI for content personalisation, predictive analytics, campaign optimisation, and automated customer segmentation.' },
      { q: 'Do you offer lead generation services?', a: 'Yes. We design and execute multi-channel lead generation strategies including paid media, content marketing, email campaigns, and marketing automation.' },
      { q: 'How do you measure growth?', a: 'We track key metrics including customer acquisition cost, conversion rates, ROI, pipeline value, and lifetime value.' },
    ],
    why: [
      { title: 'Integrated Innovation', body: 'We combine MarTech strategy with AI integration to deliver intelligent targeting and personalised experiences.' },
      { title: 'Data-Driven Decisions', body: 'Every campaign is informed by data and continuously optimised for performance.' },
      { title: 'Full-Funnel Approach', body: 'We build growth systems that cover the entire customer journey — from awareness to retention.' },
      { title: 'Scalable Systems', body: 'We design marketing stacks and processes that grow with your business, not against it.' },
    ],
  },
  'engineering': {
    title: 'Engineering',
    subtitle: 'Engineer products built to scale.',
    tags: ['Web Development', 'App Development', 'Infrastructure', 'AI'],
    heroText: 'We build robust, performant digital products using modern engineering practices. From responsive websites and e-commerce platforms to native mobile apps and cloud-native architectures, our engineering team delivers scalable solutions that are secure, fast, and built to last.',
    body: 'It takes just 50 milliseconds for users to form an opinion about your website. We specialise in building scalable web solutions and custom digital products across marketing, eCommerce, and enterprise platforms. Our agile development process ensures speed, flexibility, and transparency from planning to deployment.',
    capabilities: [
      { n: '01', title: 'Applications', items: ['Websites', 'Web Apps', 'Mobile Apps', 'SaaS', 'Ecommerce', 'Platforms'] },
      { n: '02', title: 'Infrastructure', items: ['CMS', 'APIs', 'Integrations', 'Databases', 'Authentication', 'Cloud', 'DevOps', 'CI/CD', 'Performance', 'Security'] },
      { n: '03', title: 'Modern Development', items: ['AI Applications', 'AI Agents', 'No-Code', 'Low-Code', 'Internal Tools'] },
    ],
    approach: [
      { n: '01', title: 'Discovery & Architecture', body: 'We define core objectives and system architecture through collaborative discovery sessions.' },
      { n: '02', title: 'Agile Development', body: 'We build iteratively using agile practices, delivering working software in regular cycles.' },
      { n: '03', title: 'Testing & Quality Assurance', body: 'We ensure stability, security, and performance through CI/CD, code reviews, and rigorous testing.' },
      { n: '04', title: 'Launch & Evolution', body: 'We launch with precision, monitor post-release behaviour, and continuously evolve your product.' },
    ],
    faqs: [
      { q: 'What technologies do you work with?', a: 'We work with modern stacks including React, Next.js, Astro, Node.js, Python, TypeScript, cloud platforms (AWS, Cloudflare), and more.' },
      { q: 'Do you build mobile apps?', a: 'Yes. We develop native mobile apps for iOS and Android as well as cross-platform solutions.' },
      { q: 'What is your development process?', a: 'We follow an agile process with discovery, architecture, development, testing, and deployment phases — with regular client check-ins throughout.' },
      { q: 'Do you provide ongoing support after launch?', a: 'Yes. We offer post-launch support, maintenance, and continuous improvement services.' },
    ],
    why: [
      { title: 'Modern Tech Stack', body: 'We use current, well-supported technologies that scale — not outdated frameworks that create technical debt.' },
      { title: 'Performance Obsession', body: 'We optimise for speed, accessibility, and Core Web Vitals from day one — not as an afterthought.' },
      { title: 'Security First', body: 'Security is built into our development process, not bolted on at the end.' },
      { title: 'Long-Term Partnership', body: 'We build maintainable systems and document everything, ensuring your product thrives long after launch.' },
    ],
  },
  'operations': {
    title: 'Operations',
    subtitle: 'Keep everything running and improving.',
    tags: ['QA', 'Reliability', 'Support', 'Continuous Improvement'],
    heroText: 'Great products need great operations behind them. We provide QA and testing services, no-code development for rapid delivery, workflow automation, and site reliability engineering — ensuring your digital products run smoothly, ship faster, and scale without friction.',
    body: 'We build quality into every stage of the digital lifecycle. Our operations services ensure your products are reliable, high-performing, and ready for growth. From rigorous QA and testing to rapid no-code development and process automation, we provide the operational backbone that lets your team move fast with confidence.',
    capabilities: [
      { n: '01', title: 'Reliability', items: ['QA', 'Test Automation', 'Performance Testing', 'Security Testing', 'Accessibility Audits'] },
      { n: '02', title: 'Support', items: ['Maintenance', 'Monitoring', 'Release Management', 'SLA Support', 'Incident Response'] },
      { n: '03', title: 'Continuous Improvement', items: ['Product Optimization', 'UX Audits', 'Technical Audits', 'Feature Evolution', 'Performance Optimization'] },
    ],
    approach: [
      { n: '01', title: 'Assessment & Planning', body: 'We evaluate your current operations, identify bottlenecks, and define a plan for improvement.' },
      { n: '02', title: 'Implementation', body: 'We deploy testing frameworks, automation workflows, and no-code solutions to streamline your operations.' },
      { n: '03', title: 'Monitoring & Optimisation', body: 'We continuously monitor performance, reliability, and quality metrics to drive ongoing improvement.' },
      { n: '04', title: 'Scale & Sustain', body: 'We build operational systems that scale with your business and sustain quality over time.' },
    ],
    faqs: [
      { q: 'What QA services do you offer?', a: 'We offer functional, performance, security, usability, accessibility, and automation testing — covering the full quality spectrum.' },
      { q: 'What is no-code development?', a: 'No-code development enables building applications visually without writing code, using platforms like Webflow, Bubble, and FlutterFlow for rapid delivery.' },
      { q: 'How do you approach workflow automation?', a: 'We identify repetitive tasks and manual processes, then design automated workflows using tools like Zapier, Make, and custom integrations.' },
      { q: 'What is Site Reliability Engineering?', a: 'SRE applies software engineering principles to operations — ensuring your systems are reliable, scalable, and observable.' },
    ],
    why: [
      { title: 'Quality Built In', body: 'We embed quality throughout the development lifecycle, not just at the end.' },
      { title: 'Speed Without Sacrifice', body: 'We use no-code and automation to accelerate delivery without compromising quality or reliability.' },
      { title: 'End-to-End Coverage', body: 'From testing to deployment to ongoing monitoring, we cover every aspect of digital operations.' },
      { title: 'Continuous Improvement', body: 'We\'re committed to ongoing optimisation and refinement of your operational systems.' },
    ],
  },
};

const slug = Astro.params.slug || '';
const fromSanity = await sanityClient.fetch(serviceBySlugQuery, { slug }).catch(() => null);
const fallback = hardcodedServices[slug] || null;
const service = fallback || fromSanity;

// Fetch related work + blog posts for this service
const allCaseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const allPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const relatedWork = allCaseStudies.filter((cs: any) => {
  const d = (cs.disciplines || []).map((x: string) => x.toLowerCase());
  const t = (cs.tags || []).map((x: string) => x.toLowerCase());
  const slugLower = slug.toLowerCase();
  return d.includes(slugLower) || t.includes(slugLower) || (cs.industry || '').toLowerCase().includes(slugLower);
}).slice(0, 4);
const relatedPosts = allPosts.filter((p: any) => {
  const cat = (p.category || '').toLowerCase();
  const slugLower = slug.toLowerCase();
  return cat.includes(slugLower) || (slugLower === 'strategy' && cat === 'strategy');
}).slice(0, 3);

// Helper to safely access array fields
function safeArr(arr: any[] | null | undefined, fallbackArr: any[]) {
  return Array.isArray(arr) && arr.length > 0 ? arr : fallbackArr;
}

if (!service) {
  return Astro.redirect('/404');
}

export async function getStaticPaths() {
  return ['strategy', 'brand', 'experience', 'growth', 'engineering', 'operations'].map(s => ({ params: { slug: s } }));
}
---

<BaseLayout title={service.title} description={(typeof service.body === 'string' ? service.body : service.summary || service.subtitle || '').slice(0, 160)}>
  <!-- HERO -->
  <section class="detail-hero">
    <div class="wrap detail-hero-content">
      <p class="eyebrow"><a href="/services">Services</a></p>
      <h1 data-reveal>{service.title}</h1>
      <p class="hero-sub" data-reveal>{service.subtitle}</p>
      <p class="hero-text" data-reveal>{service.heroText}</p>
      <ul class="service-tags" data-reveal>
        {(safeArr(service.tags, [])).map((t: string) => <li>{t}</li>)}
      </ul>
      <a href="/contact-us" class="btn btn-solid" data-reveal>Get in Touch</a>
    </div>
  </section>

  <!-- BODY -->
  <section class="wrap detail-body">
    <p data-reveal>{typeof service.body === 'string' ? service.body : (service.fullDescription || service.summary || '')}</p>
  </section>

  <!-- CAPABILITIES -->
  <section class="wrap capabilities-section">
    <p class="eyebrow" data-reveal>What we can do</p>
    <div class="caps-grouped">
      {(safeArr(service.capabilities, [])).map((c: any) => (
        <div class="cap-group" data-reveal>
          <span class="cap-group-n">{c.n}</span>
          <h3 class="cap-group-title">{c.title}</h3>
          <ul class="cap-group-items">
            {c.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY -->
  <section class="wrap why-section">
    <p class="eyebrow" data-reveal>Why us?</p>
    <h2 data-reveal>Built to deliver lasting impact.</h2>
    <div class="why-grid">
      {(safeArr(service.why, [])).map((w: any) => (
        <div class="why-item" data-reveal>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- APPROACH -->
  <section class="wrap approach-section">
    <p class="eyebrow" data-reveal>Our Approach</p>
    <h2 data-reveal>A collaborative process rooted in strategic clarity.</h2>
    <div class="approach-steps">
      {(safeArr(service.approach, [])).map((a: any) => (
        <div class="approach-step" data-reveal>
          <span class="step-n">{a.n}</span>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </section>

  {safeArr(service.process, null) && (
  <!-- PROCESS FLOW -->
  <section class="wrap process-section">
    <p class="eyebrow" data-reveal>How we do it</p>
    <h2 data-reveal>The process model that we follow gives us the most important advantage — the product that works.</h2>
    <div class="process-flow">
      {service.process.map((p) => (
        <div class="process-phase" data-reveal>
          <h3 class="process-phase-title">{p.phase}</h3>
          <ul class="process-steps">
            {p.steps.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

  {(safeArr(service.tools, null)) && (
  <!-- TOOLKIT -->
  <section class="wrap toolkit-section">
    <p class="eyebrow" data-reveal>Our Design Toolkit</p>
    <h2 data-reveal>Wugweb leverages a diverse toolkit of industry-leading technologies to craft exceptional user experiences.</h2>
    <div class="toolkit-grid">
      {service.tools.map((t) => (
        <div class="toolkit-category" data-reveal>
          <div class="toolkit-category-header">{t.category}</div>
          <ul class="toolkit-items">
            {t.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

    
  <!-- FAQ -->
  <section class="wrap detail-faq">
    <h2 data-reveal>Frequently asked questions</h2>
    <div class="faq-list" data-reveal>
      {(safeArr(service.faqs, [])).map((f: any) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .detail-hero { padding-block: var(--space-section-xl) var(--space-section-md); }
  .detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .detail-hero .eyebrow a:hover { color: var(--fg); }
  .detail-hero h1 { font-size: var(--t-display); margin-top: var(--gap-4); max-width: 16ch; }
  .hero-sub { font-size: 1.3rem; color: var(--fg); margin-top: var(--gap-2); }
  .hero-text { margin-top: var(--gap-6); max-width: 55ch; font-size: 1.1rem; line-height: 1.7; }
  .service-tags { list-style: none; margin: var(--gap-6) 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .service-tags li { font-family: var(--font-mono); font-size: .75rem; padding: .35rem .85rem; border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--fg-muted); }
  .detail-hero .btn { margin-top: var(--gap-4); display: inline-flex; }

  .detail-body { padding-block: var(--space-section-md) var(--space-section-xl); border-top: 1px solid var(--line); }
  .detail-body p { max-width: 65ch; font-size: 1.1rem; line-height: 1.7; }

  .capabilities-section { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .caps-grouped { display: grid; gap: 0; margin-top: var(--gap-8); border-top: 1px solid var(--line); }
  @media (min-width: 768px) { .caps-grouped { grid-template-columns: repeat(3, 1fr); } }
  .cap-group { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: var(--gap-8); }
  @media (min-width: 768px) { .cap-group { border-bottom: none; } }
