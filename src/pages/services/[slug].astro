---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { serviceBySlugQuery, caseStudiesListQuery, postsListQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';
import { hardcodedServices } from '../../lib/services-data';

/** Framer marketing slugs → 6-pillar keys used in related-work filters + hardcoded fallbacks */
const FRAMER_TO_PILLAR: Record<string, string> = {
  'brand-strategy': 'brand',
  'experience-design': 'experience',
  'martech-genai': 'growth',
  'web-app-development': 'engineering',
  'qa-testing': 'operations',
  'no-code-solutions': 'engineering',
  'lead-generation': 'growth',
};

export async function getStaticPaths() {
  const pillar = ['strategy', 'brand', 'experience', 'growth', 'engineering', 'operations'];
  const framer = [
    'brand-strategy',
    'experience-design',
    'martech-genai',
    'web-app-development',
    'qa-testing',
    'no-code-solutions',
    'lead-generation',
  ];
  return [...pillar, ...framer].map((s) => ({ params: { slug: s } }));
}

const slug = Astro.params.slug || '';

const pillarSlug = FRAMER_TO_PILLAR[slug] || slug;
const fromSanity = await sanityClient.fetch(serviceBySlugQuery, { slug }).catch(() => null);
const fallback = hardcodedServices[slug] || hardcodedServices[pillarSlug] || null;

function preferArr<T>(primary: T[] | null | undefined, secondary: T[] | null | undefined): T[] {
  return Array.isArray(primary) && primary.length > 0 ? primary : Array.isArray(secondary) ? secondary : [];
}

function preferStr(primary: unknown, secondary: unknown): string {
  const a = typeof primary === 'string' ? primary.trim() : '';
  const b = typeof secondary === 'string' ? secondary.trim() : '';
  return a || b;
}

const service = !fallback && !fromSanity
  ? null
  : {
      ...(fallback || {}),
      ...(fromSanity || {}),
      title: preferStr(fromSanity?.title, fallback?.title),
      subtitle: preferStr(fromSanity?.subtitle, fallback?.subtitle),
      heroText: preferStr(fromSanity?.heroText, fallback?.heroText),
      body: preferStr(
        typeof fromSanity?.body === 'string' ? fromSanity.body : fromSanity?.fullDescription || fromSanity?.summary,
        fallback?.body
      ),
      tags: preferArr(fromSanity?.tags, fallback?.tags),
      capabilities: preferArr(fromSanity?.capabilities, fallback?.capabilities),
      why: preferArr(fromSanity?.why, fallback?.why),
      approach: preferArr(fromSanity?.approach, fallback?.approach),
      process: preferArr(fromSanity?.process, fallback?.process),
      tools: preferArr(fromSanity?.tools, fallback?.tools),
      faqs: preferArr(fromSanity?.faqs, fallback?.faqs),
      stats: preferArr(fromSanity?.stats, fallback?.stats),
      framework: preferArr(fromSanity?.framework, fallback?.framework),
      seoTitle: preferStr(fromSanity?.seoTitle, fallback?.title),
      seoDescription: preferStr(fromSanity?.seoDescription, typeof fallback?.body === 'string' ? fallback.body : ''),
    };

// Tech-stack icons for toolkit chips
const techTools = await sanityClient
  .fetch(`*[_type=="taxonomy" && vocabulary=="tech-stack"]{name, iconPath}`)
  .catch(() => []);
const toolIconByName = new Map(
  (techTools || []).map((t: any) => [String(t.name).toLowerCase(), t.iconPath ? assetUrl(t.iconPath) : null])
);

// Fetch related work + blog posts for this service
const allCaseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const allPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const relatedWork = allCaseStudies.filter((cs: any) => {
  const d = (cs.disciplines || []).map((x: string) => x.toLowerCase());
  const t = (cs.tags || []).map((x: string) => x.toLowerCase());
  const slugLower = pillarSlug.toLowerCase();
  return d.includes(slugLower) || t.includes(slugLower) || (cs.industry || '').toLowerCase().includes(slugLower);
}).slice(0, 4);
const relatedPosts = allPosts.filter((p: any) => {
  const cat = (p.category || '').toLowerCase();
  const slugLower = pillarSlug.toLowerCase();
  return cat.includes(slugLower) || (slugLower === 'strategy' && cat === 'strategy');
}).slice(0, 3);

// Helper to safely access array fields
function safeArr(arr: any[] | null | undefined, fallbackArr: any[]) {
  return Array.isArray(arr) && arr.length > 0 ? arr : fallbackArr;
}

if (!service) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={service.seoTitle || service.title}
  description={(service.seoDescription || (typeof service.body === 'string' ? service.body : service.summary || service.subtitle || '')).slice(0, 160)}
>
  <!-- HERO -->
  <section class="detail-hero">
    <div class="wrap detail-hero-content">
      <p class="eyebrow"><a href="/services">Services</a></p>
      <h1 class="t-display" data-reveal>{service.title}</h1>
      <p class="hero-sub" data-reveal>{service.subtitle}</p>
      <p class="hero-text" data-reveal>{service.heroText}</p>
      <ul class="service-tags" data-reveal>
        {(safeArr(service.tags, [])).map((t: string) => <li>{t}</li>)}
      </ul>
      <a href="/contact-us" class="btn btn-solid" data-reveal>Get in Touch</a>
    </div>
  </section>

  <!-- BODY -->
  <section class="wrap detail-body">
    <p data-reveal>{typeof service.body === 'string' ? service.body : (service.fullDescription || service.summary || '')}</p>
  </section>

  <!-- STATS -->
  {(service.stats?.length > 0) && (
    <section class="wrap svc-stats" data-scroll="rise">
      <ul>
        {service.stats.map((s: any) => (
          <li data-reveal>
            <span class="svc-stat-n">{s.n}</span>
            <p class="svc-stat-label">{s.label}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- CAPABILITIES -->
  <section class="wrap capabilities-section">
    <p class="eyebrow" data-reveal>What we can do</p>
    <div class="caps-grouped">
      {(safeArr(service.capabilities, [])).map((c: any) => (
        <div class="cap-group" data-reveal>
          <span class="cap-group-n">{c.n}</span>
          <h3 class="cap-group-title">{c.title}</h3>
          <ul class="cap-group-items">
            {c.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY -->
  <section class="wrap why-section">
    <p class="eyebrow" data-reveal>Why us?</p>
    <h2 data-reveal>Built to deliver lasting impact.</h2>
    <div class="why-grid">
      {(safeArr(service.why, [])).map((w: any) => (
        <div class="why-item" data-reveal>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- APPROACH -->
  <section class="wrap approach-section">
    <p class="eyebrow" data-reveal>Our Approach</p>
    <h2 data-reveal>A collaborative process rooted in strategic clarity.</h2>
    <div class="approach-steps">
      {(safeArr(service.approach, [])).map((a: any) => (
        <div class="approach-step" data-reveal>
          <span class="step-n">{a.n}</span>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FRAMEWORK (How we work) -->
  {(service.framework?.length > 0) && (
    <section class="wrap framework-section">
      <p class="eyebrow" data-reveal>How we work</p>
      <h2 data-reveal>Our {service.title} Framework</h2>
      <div class="framework-flow">
        {service.framework.map((f: any) => (
          <div class="framework-phase" data-reveal>
            <h3 class="framework-phase-title">{f.phase}</h3>
            <p class="framework-outcome">{f.outcome}</p>
            {f.includes?.length > 0 && (
              <ul class="framework-includes">
                {f.includes.map((i: string) => <li>{i}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {safeArr(service.process, null) && (
  <!-- PROCESS FLOW -->
  <section class="wrap process-section">
    <p class="eyebrow" data-reveal>How we do it</p>
    <h2 data-reveal>The process model that we follow gives us the most important advantage — the product that works.</h2>
    <div class="process-flow">
      {service.process.map((p) => (
        <div class="process-phase" data-reveal>
          <h3 class="process-phase-title">{p.phase}</h3>
          <ul class="process-steps">
            {p.steps.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

  {(safeArr(service.tools, null)) && (
  <!-- TOOLKIT -->
  <section class="wrap toolkit-section">
    <p class="eyebrow" data-reveal>Our Design Toolkit</p>
    <h2 data-reveal>Wugweb leverages a diverse toolkit of industry-leading technologies to craft exceptional user experiences.</h2>
    <div class="toolkit-grid">
      {service.tools.map((t) => (
        <div class="toolkit-category" data-reveal>
          <div class="toolkit-category-header">{t.category}</div>
          <ul class="toolkit-items">
            {t.items.map((item) => {
              const icon = toolIconByName.get(String(item).toLowerCase());
              return (
                <li>
                  {icon ? <img src={icon} alt="" width="16" height="16" loading="lazy" /> : null}
                  <span>{item}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

    
  <!-- FAQ -->
  <section class="wrap detail-faq">
    <h2 data-reveal>Frequently asked questions</h2>
    <div class="faq-list" data-reveal>
      {(safeArr(service.faqs, [])).map((f: any) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- RELATED WORK -->
  {relatedWork.length > 0 && (
    <section class="wrap svc-work">
      <div class="svc-work-head">
        <h2 data-reveal>Work that leads with clarity and delivers with impact</h2>
        <a href="/work" class="btn btn-ghost" data-reveal>View all case studies</a>
      </div>
      <ul class="svc-work-grid">
        {relatedWork.map((cs: any) => (
          <li data-reveal>
            <a href={`/work/${cs.slug}`} class="svc-work-card">
              <h3>{cs.title}</h3>
              <p>{cs.client}{cs.disciplines?.length ? ` — ${cs.disciplines.join(', ')}` : ''}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- RELATED INSIGHTS -->
  {relatedPosts.length > 0 && (
    <section class="wrap svc-insights">
      <div class="svc-work-head">
        <h2 data-reveal>Fresh takes from the team</h2>
        <a href="/blog" class="btn btn-ghost" data-reveal>Visit our Blog</a>
      </div>
      <ul class="svc-insights-list">
        {relatedPosts.map((p: any) => (
          <li data-reveal>
            <a href={`/blog/${p.slug}`} class="svc-insight-card">
              {p.category && <span class="eyebrow">{p.category}</span>}
              <h3>{p.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- DUAL CTA -->
  <section class="wrap detail-cta">
    <h2 data-reveal>Ready to talk {service.title}?</h2>
    <p data-reveal>Let's discuss your project and how we can work together.</p>
    <div class="detail-cta-btns" data-reveal>
      <a href="/contact-us" class="btn btn-solid">Let's Talk</a>
      <a href="/work" class="btn btn-ghost">View Our Work</a>
    </div>
  </section>

</BaseLayout>

<style>
  .detail-hero { padding-block: var(--space-section-xl) var(--space-section-md); }
  .detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .detail-hero .eyebrow a:hover { color: var(--fg); }
  .detail-hero h1 { margin-top: var(--gap-4); max-width: 16ch; }
  .hero-sub { font-size: var(--t-xl); color: var(--fg); margin-top: var(--gap-2); line-height: var(--lh-xl); }
  .hero-text { margin-top: var(--gap-6); max-width: 55ch; font-size: var(--t-l); line-height: var(--lh-l); }
  .service-tags { list-style: none; margin: var(--gap-6) 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .service-tags li { font-family: var(--font-mono); font-size: var(--t-micro); padding: var(--gap-1) var(--gap-3); border: var(--stroke-thin) solid var(--line); border-radius: var(--r-pill); color: var(--fg-muted); }
  .detail-hero .btn { margin-top: var(--gap-4); display: inline-flex; }

  .detail-body { padding-block: var(--space-section-md) var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .detail-body p { max-width: 65ch; font-size: var(--t-l); line-height: var(--lh-l); }

  .capabilities-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .caps-grouped { display: grid; gap: 0; margin-top: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  @media (min-width: 768px) { .caps-grouped { grid-template-columns: repeat(3, 1fr); } }
  .cap-group { border-right: var(--stroke-thin) solid var(--line); border-bottom: var(--stroke-thin) solid var(--line); padding: var(--gap-8); }
  @media (min-width: 768px) { .cap-group { border-bottom: none; } }
  .cap-group:last-child { border-right: none; }
  .cap-group-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: var(--t-sm); }
  .cap-group-title { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); }
  .cap-group-items { list-style: none; margin: var(--gap-4) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-1); }
  .cap-group-items li { font-size: var(--fluid-body-sm); color: var(--fg-muted); position: relative; padding-left: var(--gap-4); }
  .cap-group-items li::before { content: '—'; position: absolute; left: 0; color: var(--accent-warm); }

  .why-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .why-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 20ch; }
  .why-grid { display: grid; gap: var(--gap-8); margin-top: var(--gap-12); }
  @media (min-width: 768px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  .why-item { border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-5); }
  .why-item h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); }
  .why-item p { margin-top: var(--gap-2); }

  .approach-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .approach-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 22ch; }
  .approach-steps { display: grid; gap: var(--gap-8); margin-top: var(--gap-12); }
  .approach-step { border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-5); }
  .step-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: var(--t-sm); }
  .approach-step h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-2); }
  .approach-step p { margin-top: var(--gap-2); max-width: 50ch; }

  .detail-faq { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .detail-faq h2 { font-size: var(--t-h3); }
  .faq-list { margin-top: var(--gap-12); border-top: var(--stroke-thin) solid var(--line); }
  .faq-item { border-bottom: var(--stroke-thin) solid var(--line); padding-block: var(--gap-5); }
  .faq-item summary { font-family: var(--font-display); font-size: var(--t-l); cursor: pointer; }
  .faq-item p { margin-top: var(--gap-3); }

  .detail-cta { padding-block: var(--space-section-xl); text-align: center; border-top: var(--stroke-thin) solid var(--line); }
  .detail-cta h2 { font-size: var(--t-h2); max-width: 18ch; margin-inline: auto; }
  .detail-cta .btn { margin-top: var(--gap-8); display: inline-flex; }

  .process-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .process-section h2 { font-size: var(--t-h4); margin-top: var(--gap-3); max-width: 45ch; font-weight: var(--font-weight-semibold); }
  .process-flow { display: grid; gap: 0; margin-top: var(--gap-12); border-top: var(--stroke-thin) solid var(--line); }
  @media (min-width: 768px) { .process-flow { grid-template-columns: repeat(4, 1fr); } }
  .process-phase { border-right: var(--stroke-thin) solid var(--line); border-bottom: var(--stroke-thin) solid var(--line); padding: var(--gap-8); }
  @media (min-width: 768px) { .process-phase { border-bottom: none; } }
  .process-phase:last-child { border-right: none; }
  .process-phase-title { font-size: var(--fluid-body-md); font-weight: var(--font-weight-semibold); color: var(--accent-warm); margin-bottom: var(--gap-4); }
  .process-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-2); }
  .process-steps li { font-size: var(--fluid-body-sm); color: var(--fg-muted); position: relative; padding-left: var(--gap-4); }
  .process-steps li::before { content: '→'; position: absolute; left: 0; color: var(--accent-warm); }

  .toolkit-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .toolkit-section h2 { font-size: var(--t-h4); margin-top: var(--gap-3); max-width: 50ch; font-weight: var(--font-weight-semibold); }
  .toolkit-grid { display: grid; gap: var(--stroke-thin); background: var(--line); border: var(--stroke-thin) solid var(--line); margin-top: var(--gap-8); }
  @media (min-width: 640px) { .toolkit-grid { grid-template-columns: repeat(3, 1fr); } }
  .toolkit-category { background: var(--bg); padding: var(--gap-6); }
  .toolkit-category-header { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--accent-warm); margin-bottom: var(--gap-3); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .toolkit-items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-1); }
  .toolkit-items li { display: inline-flex; align-items: center; gap: var(--gap-2); font-size: var(--fluid-label); padding: var(--gap-1) var(--gap-2); border: var(--stroke-thin) solid var(--line); border-radius: var(--r-1); color: var(--fg-muted); }
  .toolkit-items li img { flex-shrink: 0; opacity: .9; }

  .svc-work { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .svc-work-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--gap-6); }
  .svc-work-head h2 { font-size: var(--t-h3); max-width: 22ch; }
  .svc-work-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc-work-grid { grid-template-columns: repeat(2, 1fr); } }
  .svc-work-card { text-decoration: none; display: block; border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-4); }
  .svc-work-card h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); color: var(--fg); line-height: var(--lh-h5); }
  .svc-work-card p { margin-top: var(--gap-1); font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .svc-work-card:hover h3 { color: var(--accent); }

  .svc-insights { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .svc-insights-list { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc-insights-list { grid-template-columns: repeat(3, 1fr); } }
  .svc-insight-card { text-decoration: none; display: block; border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-4); }
  .svc-insight-card .eyebrow { display: block; margin-bottom: var(--gap-2); }
  .svc-insight-card h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); color: var(--fg); line-height: var(--lh-h5); }
  .svc-insight-card:hover h3 { color: var(--accent); }

  .svc-stats { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .svc-stats ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-8); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .svc-stats ul { grid-template-columns: repeat(3, 1fr); } }
  .svc-stats li { border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-5); }
  .svc-stat-n { display: block; font-family: var(--font-display); font-size: var(--fluid-h2); font-weight: var(--font-weight-extrabold); line-height: var(--core-line-height-tight); color: var(--accent-warm); }
  .svc-stat-label { margin-top: var(--gap-2); color: var(--fg-muted); }

  .framework-section { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .framework-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 30ch; }
  .framework-flow { display: grid; gap: 0; margin-top: var(--gap-12); border-top: var(--stroke-thin) solid var(--line); }
  @media (min-width: 768px) { .framework-flow { grid-template-columns: repeat(3, 1fr); } }
  .framework-phase { border-right: var(--stroke-thin) solid var(--line); border-bottom: var(--stroke-thin) solid var(--line); padding: var(--gap-8); }
  @media (min-width: 768px) { .framework-phase { border-bottom: none; } }
  .framework-phase:nth-child(3n) { border-right: none; }
  .framework-phase-title { font-size: var(--fluid-body-md); font-weight: var(--font-weight-semibold); color: var(--accent-warm); margin-bottom: var(--gap-3); }
  .framework-outcome { color: var(--fg); font-size: var(--fluid-body-sm); line-height: var(--core-line-height-normal); }
