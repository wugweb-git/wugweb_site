<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, delay: 0.2, easing: 'ease-out' });
  inView('.cap-group, .why-item, .approach-step, .faq-item', (el) => {
