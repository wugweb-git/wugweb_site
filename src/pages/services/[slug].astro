</style>

<script>
  // Mouse cursor hover tracking glow effect for glass cards
  const initGlows = () => {
    const cards = document.querySelectorAll('.glass-panel');
    cards.forEach((card) => {
      const glow = card.querySelector('.card-glow, .cta-glow') as HTMLElement | null;
      if (!glow) return;
      
      card.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = me.clientX - rect.left;
        const y = me.clientY - rect.top;
        glow.style.setProperty('--mouse-x', `${x}px`);
        glow.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  };

  // initShowcase() moved into ServiceSpotlightPanel.astro's own script
  // (src/lib/service-spotlight-panel.ts) — this page no longer owns
  // [data-showcase] markup.

  // Run on load and after dynamic content shifts
  initGlows();
  document.addEventListener('astro:page-load', initGlows);
</script>
<script>
  /**
   * Approach cards: the + reveals the step's description.
   *
   * Not exclusive — these are sequential stages and a reader may well want two
   * open side by side to compare them, unlike the FAQ where one answer at a
   * time is the point.
   *
   * The height is animated by `grid-template-rows: 0fr → 1fr` in CSS, so there
   * is nothing to measure here and reflowing text stays correct.
   */
  function initApproachCards() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-approach-card]'));
    if (cards.length === 0) return;

    const set = (card: HTMLElement, open: boolean) => {
      card.classList.toggle('is-open', open);
      card.querySelector('[data-approach-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    /**
     * Exclusive: opening one closes the rest, and the open one cannot be
     * closed by clicking it — one card is always expanded. The column's height
     * therefore stays constant as you move between them, which is what lets
     * the CTA beside it hold a steady height instead of jumping on every tap.
     */
    const open = (card: HTMLElement) => {
      cards.forEach((c) => set(c, c === card));
    };

    cards.forEach((card) => {
      if (card.dataset.bound === '1') return;
      card.dataset.bound = '1';

      // The whole card is the target, not just the +. The button stays in the
      // markup because it is what a keyboard and a screen reader operate; the
      // card listener skips events that came from it, or the two would fire
      // twice for one click.
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-approach-toggle]')) return;
        open(card);
      });
      card.querySelector('[data-approach-toggle]')?.addEventListener('click', () => open(card));
    });
  }
  initApproachCards();
  document.addEventListener('astro:page-load', initApproachCards);
</script>

