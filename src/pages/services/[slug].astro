const { slug } = Astro.params;
const service = services[slug];

if (!service) {
  return Astro.redirect('/404');
}

export async function getStaticPaths() {
  return [
    'brand-strategy',
    'experience-design',
    'martech-genai',
    'web-app-development',
    'qa-testing',
    'no-code-solutions',
    'lead-generation',
  ].map(s => ({ params: { slug: s } }));
}
---

<BaseLayout title={service.title} description={service.body.slice(0, 160)}>
  <!-- HERO -->
  <section class="detail-hero">
    <div class="wrap detail-hero-content">
      <p class="eyebrow"><a href="/services">Services</a></p>
      <h1 data-reveal>{service.title}</h1>
      <p class="hero-sub" data-reveal>{service.subtitle}</p>
      <p class="hero-text" data-reveal>{service.heroText}</p>
      <ul class="service-tags" data-reveal>
        {service.tags.map((t) => <li>{t}</li>)}
      </ul>
      <a href="/contact-us" class="btn btn-solid" data-reveal>Get in Touch</a>
    </div>
  </section>

  <!-- BODY -->
  <section class="wrap detail-body">
    <p data-reveal>{service.body}</p>
  </section>

  <!-- CAPABILITIES -->
  <section class="wrap capabilities-section">
    <p class="eyebrow" data-reveal>What we can do</p>
    <div class="caps-grid">
      {service.capabilities.map((c) => (
        <div class="cap-item" data-reveal>
          <span class="cap-n">{c.n}</span>
          <p>{c.title}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY -->
  <section class="wrap why-section">
    <p class="eyebrow" data-reveal>Why us?</p>
    <h2 data-reveal>Built to deliver lasting impact.</h2>
    <div class="why-grid">
      {service.why.map((w) => (
        <div class="why-item" data-reveal>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- APPROACH -->
  <section class="wrap approach-section">
    <p class="eyebrow" data-reveal>Our Approach</p>
    <h2 data-reveal>A collaborative process rooted in strategic clarity.</h2>
    <div class="approach-steps">
      {service.approach.map((a) => (
        <div class="approach-step" data-reveal>
          <span class="step-n">{a.n}</span>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap detail-faq">
    <h2 data-reveal>Frequently asked questions</h2>
    <div class="faq-list" data-reveal>
      {service.faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap detail-cta">
    <h2 data-reveal>Let's create something remarkable together.</h2>
    <a href="/contact-us" class="btn btn-solid" data-reveal>Contact Wugweb</a>
  </section>
</BaseLayout>

<style>
  .detail-hero { padding-block: 8rem 4rem; }
  .detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .detail-hero .eyebrow a:hover { color: var(--fg); }
  .detail-hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); margin-top: 1rem; max-width: 16ch; }
  .hero-sub { font-size: 1.3rem; color: var(--fg); margin-top: 0.5rem; }
  .hero-text { margin-top: 1.5rem; max-width: 55ch; font-size: 1.1rem; line-height: 1.7; }
  .service-tags { list-style: none; margin: 1.5rem 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .service-tags li { font-family: var(--font-mono); font-size: 0.75rem; padding: 0.35rem 0.85rem; border: 1px solid var(--line); border-radius: 999px; color: var(--fg-muted); }
  .detail-hero .btn { margin-top: 1rem; display: inline-flex; }

  .detail-body { padding-block: 4rem 6rem; border-top: 1px solid var(--line); }
  .detail-body p { max-width: 65ch; font-size: 1.1rem; line-height: 1.7; }

  .capabilities-section { padding-block: 6rem; border-top: 1px solid var(--line); }
  .caps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 2rem; }
  @media (min-width: 640px) { .caps-grid { grid-template-columns: repeat(3, 1fr); } }
  .cap-item { background: var(--bg); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .cap-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: 0.8rem; }
  .cap-item p { font-family: var(--font-display); font-size: 1rem; }

  .why-section { padding-block: 6rem; border-top: 1px solid var(--line); }
  .why-section h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); margin-top: 0.75rem; max-width: 20ch; }
  .why-grid { display: grid; gap: 2rem; margin-top: 3rem; }
  @media (min-width: 768px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  .why-item { border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .why-item h3 { font-size: 1.15rem; font-weight: 500; }
  .why-item p { margin-top: 0.5rem; }

  .approach-section { padding-block: 6rem; border-top: 1px solid var(--line); }
  .approach-section h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); margin-top: 0.75rem; max-width: 22ch; }
  .approach-steps { display: grid; gap: 2rem; margin-top: 3rem; }
  .approach-step { border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .step-n { font-family: var(--font-mono); color: var(--accent-warm); font-size: 0.85rem; }
  .approach-step h3 { font-size: 1.25rem; font-weight: 500; margin-top: 0.5rem; }
  .approach-step p { margin-top: 0.5rem; max-width: 50ch; }

  .detail-faq { padding-block: 6rem; border-top: 1px solid var(--line); }
  .detail-faq h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); }
  .faq-list { margin-top: 3rem; border-top: 1px solid var(--line); }
