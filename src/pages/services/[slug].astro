---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { serviceBySlugQuery, caseStudiesListQuery, postsListQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';
import { serviceMediaFor, phaseMediaFor } from '../../lib/service-media';
import { serviceCopyFor } from '../../lib/service-copy';
import { hardcodedServices } from '../../lib/services-data';
import BentoBlock, { type BentoTile } from '../../components/BentoBlock.astro';
import ProcessMap, { type MapShape } from '../../components/ProcessMap.astro';
import { relatedWorkFor } from '../../lib/work-mapping';
import { iconFor } from '../../lib/step-icons';
import FaqAccordion from '../../components/FaqAccordion.astro';
import InsightsBlock from '../../components/InsightsBlock.astro';
import ServiceSpotlightPanel from '../../components/ServiceSpotlightPanel.astro';

/** Framer marketing slugs → 6-pillar keys used in related-work filters + hardcoded fallbacks */
const FRAMER_TO_PILLAR: Record<string, string> = {
  'brand-strategy': 'brand',
  'experience-design': 'experience',
  'martech-genai': 'growth',
  'web-app-development': 'engineering',
  'qa-testing': 'operations',
  'no-code-solutions': 'engineering',
  'lead-generation': 'growth',
};



const slug = Astro.params.slug || '';

const pillarSlug = FRAMER_TO_PILLAR[slug] || slug;
const fromSanity = await sanityClient.fetch(serviceBySlugQuery, { slug }).catch(() => null);
const fallback = hardcodedServices[slug] || hardcodedServices[pillarSlug] || null;

function preferArr<T>(primary: T[] | null | undefined, secondary: T[] | null | undefined): T[] {
  return Array.isArray(primary) && primary.length > 0 ? primary : Array.isArray(secondary) ? secondary : [];
}

function preferStr(primary: unknown, secondary: unknown): string {
  const a = typeof primary === 'string' ? primary.trim() : '';
  const b = typeof secondary === 'string' ? secondary.trim() : '';
  return a || b;
}

const service = !fallback && !fromSanity
  ? null
  : {
      ...(fallback || {}),
      ...(fromSanity || {}),
      title: preferStr(fromSanity?.title, fallback?.title),
      subtitle: preferStr(fromSanity?.subtitle, fallback?.subtitle),
      heroText: preferStr(fromSanity?.heroText, fallback?.heroText),
      body: preferStr(
        typeof fromSanity?.body === 'string' ? fromSanity.body : fromSanity?.fullDescription || fromSanity?.summary,
        fallback?.body
      ),
      tags: preferArr(fromSanity?.tags, fallback?.tags),
      capabilities: preferArr(fromSanity?.capabilities, fallback?.capabilities),
      why: preferArr(fromSanity?.why, fallback?.why),
      approach: preferArr(fromSanity?.approach, fallback?.approach),
      tools: preferArr(fromSanity?.tools, fallback?.tools),
      faqs: preferArr(fromSanity?.faqs, fallback?.faqs),
      stats: preferArr(fromSanity?.stats, fallback?.stats),
      framework: preferArr(fromSanity?.framework, fallback?.framework),
      seoTitle: preferStr(fromSanity?.seoTitle, fallback?.title),
      seoDescription: preferStr(fromSanity?.seoDescription, typeof fallback?.body === 'string' ? fallback.body : ''),
    };

// Tech-stack icons for toolkit chips
const techTools = await sanityClient
  .fetch(`*[_type=="taxonomy" && vocabulary=="tech-stack"]{name, iconPath}`)
  .catch(() => []);
const toolIconByName = new Map(
  (techTools || []).map((t: any) => [String(t.name).toLowerCase(), t.iconPath ? assetUrl(t.iconPath) : null])
);

// Fetch related work + blog posts for this service
const allCaseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const allPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
// Mapped through `src/lib/work-mapping.ts` — the case studies' `services[]`
// reference is empty on all 57 docs, so disciplines carry the join. Also
// de-duplicates: 13 titles exist twice in Sanity.
const relatedWork = relatedWorkFor(allCaseStudies as any[], pillarSlug, 4);
const relatedPosts = allPosts.filter((p: any) => {
  const cat = (p.category || '').toLowerCase();
  const slugLower = pillarSlug.toLowerCase();
  return cat.includes(slugLower) || (slugLower === 'strategy' && cat === 'strategy');
}).slice(0, 3);

// Helper to safely access array fields
function safeArr(arr: any[] | null | undefined, fallbackArr: any[]) {
  return Array.isArray(arr) && arr.length > 0 ? arr : fallbackArr;
}

/**
 * Capability showcase: flatten `capabilities[].items` into one list of
 * sub-services (the group headings are dropped — the showcase reads as a flat
 * set of ten-to-twenty things we do) and attach media where we have it.
 */
const capabilityItems = safeArr(service.capabilities, [])
  .flatMap((c: any) => safeArr(c?.items, []))
  .filter((t: any) => typeof t === 'string' && t.trim().length > 0)
  .map((title: string, i: number) => ({
    title: title.trim(),
    n: String(i + 1).padStart(2, '0'),
    index: i,
    media: serviceMediaFor(pillarSlug, title, assetUrl),
    blurb: serviceCopyFor(pillarSlug, title),
  }));

// Pillars with long capability lists (Engineering has 20) split the panel into
// two columns on wide viewports so it does not become a 2,000px scroll.
const capabilityDense = capabilityItems.length > 12;

/**
 * The showcase is live on /services/brand only until the pattern is signed off.
 * Every other pillar keeps the original grouped capability panels. Add slugs
 * here (or drop the pillar check) to roll it out.
 */
const showcaseEnabled = pillarSlug === 'brand' && capabilityItems.length > 0;

/**
 * "Why us?" BentoBlock — the four reasons are the service's own `why` array,
 * so all six pillars are covered by this one file. The two flexible slots take
 * whatever media the pillar actually has; pillars with none fall back to plain
 * tiles rather than an empty frame.
 */
const whyItems = safeArr(service.why, []).slice(0, 4);
const whyClips = capabilityItems.filter((c) => c.media).map((c) => c.media!);

/**
 * Six layouts, one per pillar, so the same six slots never land the same way
 * twice. Each row is a slot: [column, weight, role]. Roles `0–3` are the four
 * reasons; `cta` and `media` are the flexible pair. Every layout keeps a
 * different column signature, which is also what the component's build-time
 * guard enforces — a bento must never resolve into an even grid.
 */
type Slot = [number, BentoTile['span'], '0' | '1' | '2' | '3' | 'cta' | 'media'];
const BENTO_LAYOUTS: Slot[][] = [
  // A — weight front-left, CTA tucked under it
  [[0, 'tall', '0'], [0, 'strip', 'cta'], [1, 'short', '1'], [1, 'mid', '2'], [2, 'slim', 'media'], [2, 'tall', '3']],
  // B — hero in the middle column
  [[0, 'short', '0'], [0, 'mid', '1'], [1, 'tall', '2'], [1, 'strip', 'cta'], [2, 'mid', '3'], [2, 'slim', 'media']],
  // C — opens on media, weight falls to the right
  [[0, 'slim', 'media'], [0, 'tall', '0'], [1, 'mid', '1'], [1, 'short', '2'], [2, 'tall', '3'], [2, 'strip', 'cta']],
  // D — CTA leads the middle column
  [[0, 'mid', '0'], [0, 'short', '1'], [1, 'strip', 'cta'], [1, 'tall', '2'], [2, 'tall', '3'], [2, 'slim', 'media']],
  // E — tall left, media closing beneath it
  [[0, 'tall', '0'], [0, 'slim', 'media'], [1, 'strip', 'cta'], [1, 'mid', '1'], [2, 'short', '2'], [2, 'tall', '3']],
  // F — staggered, heaviest tile last
  [[0, 'short', '0'], [0, 'tall', '1'], [1, 'mid', '2'], [1, 'slim', 'media'], [2, 'tall', '3'], [2, 'strip', 'cta']],
];

/**
 * "How we work" process map, one silhouette per service. The shape is not
 * decoration: a pipeline discipline gets a flat chain, a discipline that
 * explores before it commits gets a crest, one that compounds gets a climb.
 * The loop marks where the work genuinely cycles rather than ending.
 */
const MAP_BY_PILLAR: Record<string, { shape: MapShape; loopTo?: number; loopLabel?: string }> = {
  strategy:    { shape: 'descending', loopTo: 1, loopLabel: 'Re-test' },
  brand:       { shape: 'arc',        loopTo: 1, loopLabel: 'Refine' },
  experience:  { shape: 'wave',       loopTo: 2, loopLabel: 'Iterate' },
  engineering: { shape: 'line',       loopTo: 2, loopLabel: 'Ship again' },
  growth:      { shape: 'zigzag',     loopTo: 1, loopLabel: 'Compound' },
  operations:  { shape: 'ascending',  loopTo: 2, loopLabel: 'Improve' },
};
const mapConf = MAP_BY_PILLAR[pillarSlug] || { shape: 'wave' as MapShape, loopTo: 1 };
const mapShape = mapConf.shape;
const mapLoopLabel = mapConf.loopLabel;

/**
 * Approach steps. Four or five per pillar; the card grid and the segment meter
 * both derive from the count, so neither needs touching if a pillar changes.
 */
const approachSteps = safeArr(service.approach, []).slice(0, 5);

/**
 * Approach CTA copy. Experience is the line supplied for this panel; the other
 * five take the pillar's own `subtitle` and hero line from `services-data.ts`,
 * so nothing here is invented. Replace as each pillar's copy is written.
 */
const APPROACH_CTA: Record<string, { title: string; body: string }> = {
  experience: {
    title: 'UX design services you can rely on.',
    body: 'Strategy-led experience design built to solve real business problems.',
  },
};
/** Ad art. Per-pillar where the old site has one; the services hero otherwise. */
const AD_IMAGE: Record<string, string> = {
  experience: 'services/reference/experience-hero.jpg',
  brand: 'services/reference/brand-hero.jpg',
};
const approachAdImage = assetUrl(AD_IMAGE[pillarSlug] || 'services/reference/services-hero.jpg');

const approachCta = APPROACH_CTA[pillarSlug] || {
  title: `${service.title} services you can rely on.`,
  body: service.subtitle || '',
};

const frameworkPhases = safeArr(service.framework, []);
/**
 * Phase cards take the pillar's own clips, in order, from the same manifest the
 * capability showcase uses. A pillar with no genuine footage gets cards with no
 * media frame rather than a placeholder — `service-media.ts` deliberately leaves
 * strategy and operations unmapped because their folders are byte-identical
 * copies of brand and engineering.
 */
const mapPhases = frameworkPhases.map((f: any) => {
  const clip = phaseMediaFor(pillarSlug, f.phase, assetUrl);
  return {
    name: f.phase,
    outcome: f.outcome,
    steps: safeArr(f.includes, []),
    ...(clip ? { media: { video: clip.video, poster: clip.poster } } : {}),
  };
});
// Guard the loop against a service with fewer phases than the map config assumes.
/**
 * Live on all six. Every pillar's `framework[].includes` is authored to three
 * per phase, which is what the map can label legibly — the component throws
 * above its cap rather than dropping steps silently, so this stays true.
 */
const processMapEnabled = mapPhases.length > 0;

const mapLoopTo =
  typeof mapConf.loopTo === 'number' && mapConf.loopTo < mapPhases.length - 1
    ? mapConf.loopTo
    : undefined;

const PILLAR_ORDER = ['strategy', 'brand', 'experience', 'engineering', 'growth', 'operations'];
const layoutIndex = Math.max(0, PILLAR_ORDER.indexOf(pillarSlug)) % BENTO_LAYOUTS.length;
const layout = BENTO_LAYOUTS[layoutIndex];

/**
 * Only three of the six slots carry motion — the first `tall` (which also takes
 * the light tone and anchors the block), the `mid` reason, and the media slot.
 * Clips are handed out in layout order so no two tiles play the same file, and
 * so a pillar with only one clip spends it on the anchor rather than a filler.
 */
const clipSlots = new Set<number>();
const heroIndex = layout.findIndex(([, span]) => span === 'tall');
if (heroIndex >= 0) clipSlots.add(heroIndex);
const midIndex = layout.findIndex(([, span, role]) => span === 'mid' && role !== 'cta' && role !== 'media');
if (midIndex >= 0) clipSlots.add(midIndex);
const mediaIndex = layout.findIndex(([, , role]) => role === 'media');
if (mediaIndex >= 0) clipSlots.add(mediaIndex);
const clipFor = new Map<number, (typeof whyClips)[number]>();
[...clipSlots].sort((a, b) => a - b).forEach((slot, n) => {
  if (whyClips[n]) clipFor.set(slot, whyClips[n]);
});

const whyTiles: BentoTile[] = whyItems.length
  ? layout
      .map(([col, span, role], i): BentoTile | null => {
        const clip = clipFor.get(i);
        if (role === 'cta') {
          return { col, span, kind: 'cta', href: '/contact-us', linkLabel: `Talk ${service.title}` };
        }
        if (role === 'media') {
          return {
            col,
            span,
            kind: 'media',
            ...(clip
              ? { video: clip.video, poster: clip.poster, fit: 'cover' as const }
              : { image: assetUrl('more/service/service_benefit_6.webp'), fit: 'cover' as const }),
          };
        }
        const reason = whyItems[Number(role)];
        if (!reason?.title) return null;
        return {
          col,
          span,
          title: reason.title,
          body: reason.body,
          ...(i === heroIndex ? { tone: 'light' as const } : {}),
          ...(clip
            ? { video: clip.video, poster: clip.poster, fit: (span === 'mid' ? 'inset' : 'cover') as const }
            : {}),
        };
      })
      .filter((t): t is BentoTile => t !== null)
  : [];

if (!service) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={service.seoTitle || service.title}
  description={(service.seoDescription || (typeof service.body === 'string' ? service.body : service.summary || service.subtitle || '')).slice(0, 160)}
  {/* This page carries its own insights block, filtered to the pillar, so the
      global one is suppressed — a service page was rendering two different
      blog teasers one after the other. */}
  hideGlobalBlog={relatedPosts.length > 0}
>
  <div class="service-page-wrapper" style={`--theme-base: var(--svc-${pillarSlug}, var(--color-accent-primary)); --theme-dark: var(--svc-${pillarSlug}-dark, var(--color-ash)); --theme-light: var(--svc-${pillarSlug}-light, var(--color-surface-inverse)); --theme-gradient: var(--gradient-${pillarSlug}, var(--gradient-brand));`}>
    
    <!-- HERO -->
    <section class="detail-hero">
      <div class="hero-glow" data-reveal></div>
      <div class="wrap detail-hero-content">
        <p class="eyebrow"><a href="/services">Services</a></p>
        <h1 class="page-title" data-reveal>{service.title}</h1>
        <p class="hero-sub" data-reveal>{service.subtitle}</p>
        <p class="hero-text" data-reveal>{service.heroText}</p>
        <ul class="service-tags" data-reveal>
          {(safeArr(service.tags, [])).map((t) => <li>{t}</li>)}
        </ul>
        <a href="/contact-us" class="btn btn-solid" data-reveal>Get in Touch</a>
      </div>
    </section>

    <!-- BODY -->
    <section class="wrap detail-body">
      <div class="glass-panel body-glass" data-reveal>
        <p>{typeof service.body === 'string' ? service.body : (service.fullDescription || service.summary || '')}</p>
      </div>
    </section>

    <!-- STATS -->
    {(service.stats?.length > 0) && (
      <section class="wrap svc-stats" data-scroll="rise">
        <ul>
          {service.stats.map((s) => (
            <li class="glass-panel stat-card" data-reveal>
              <span class="svc-stat-n">{s.n}</span>
              <p class="svc-stat-label">{s.label}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- CAPABILITIES — glass showcase.
         Scoped to /services/brand while the pattern is being signed off. The
         other five pillars keep the original grouped panels below, untouched.
         Widen `showcaseEnabled` to roll it out. -->
    {showcaseEnabled && (
      <section class="wrap capabilities-section" aria-labelledby="caps-heading">
        {/* A real h2 so the ten sub-service h3s below sit under a parent
            heading. Styled as the eyebrow, so nothing changes visually. */}
        <h2 class="eyebrow caps-heading" id="caps-heading" data-reveal>What we can do</h2>

        <ServiceSpotlightPanel
          items={capabilityItems}
          dense={capabilityDense}
          idPrefix={pillarSlug}
          themeBase={`var(--svc-${pillarSlug}, var(--color-accent-primary))`}
        />
      </section>
    )}

    {!showcaseEnabled && (
      <section class="wrap capabilities-section">
        <p class="eyebrow" data-reveal>What we can do</p>
        <div class="caps-grouped">
          {(safeArr(service.capabilities, [])).map((c) => (
            <div class="glass-panel cap-group" data-reveal>
              <span class="cap-group-n">{c.n}</span>
              <h3 class="cap-group-title">{c.title}</h3>
              <ul class="cap-group-items">
                {c.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- WHY — BentoBlock, fed by this service's own `why` array, so all six
         pillars are covered here. Falls back to nothing if a service has none. -->
    {whyTiles.length > 0 && (
      <BentoBlock heading="Built to deliver lasting impact." tiles={whyTiles} showNumbers={false} />
    )}

    <!-- APPROACH -->
    {approachSteps.length > 0 && (
      <section class="wrap approach-section">
        <h2 data-reveal>From first conversation to handover.</h2>

        <div class="approach-layout">
        <!-- Cards, not the old stack of full-width glass bars. The Process Map
             sits directly below and is the page's big diagram; four 1200px-wide
             panels ahead of it read as a weaker second version of the same
             thing. The design element in each card is a segment meter — it
             shows how far through the sequence the step is, so the graphic
             carries information rather than decorating. -->
        <ol class="approach-cards" data-scroll="cardstack">
          {approachSteps.map((a: any, i: number) => (
            <li
              class:list={['approach-card', i === 0 && 'is-open']}
              data-stack-card
              data-approach-card
              style={`z-index:${approachSteps.length - i}`}
            >
              <div class="approach-card-visual">
                {a.image ? (
                  <img src={a.image} alt="" loading="lazy" decoding="async" />
                ) : (
                  /* No per-step photography exists for any pillar, and the
                     `services/<pillar>` clip library is third-party showreel
                     footage (pending #6). Rather than repeat one stock image
                     down the column, the slot renders a graphic: the step
                     number over a meter showing how far through the sequence
                     it is. Swap in `a.image` the moment real art lands. */
                  <span class="approach-visual-mark" aria-hidden="true">
                    <svg class="approach-icon" viewBox="0 0 16 16" focusable="false">
                      <path d={iconFor(a.title || '')} />
                    </svg>
                    <span class="approach-meter">
                      {approachSteps.map((_: any, j: number) => (
                        <span class:list={['approach-seg', j <= i && 'is-on']}></span>
                      ))}
                    </span>
                  </span>
                )}
              </div>
              <div class="approach-card-body">
                <div class="approach-card-head">
                  <span class="u-index">{a.n || String(i + 1).padStart(2, '0')}</span>
                  <button
                    type="button"
                    class="u-chip approach-toggle"
                    aria-expanded={i === 0 ? 'true' : 'false'}
                    aria-label={`Show what happens during ${a.title}`}
                    data-approach-toggle
                  >
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M8 1.5v13M1.5 8h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  </button>
                </div>
                <h3>{a.title}</h3>
                <div class="approach-card-desc"><p>{a.body}</p></div>
              </div>
              <span class="approach-rule" aria-hidden="true"></span>
            </li>
          ))}
        </ol>

        <!-- Second column: a standing CTA that holds beside the cards while
             they deal out. Sticky, so the offer stays put through the read
             rather than scrolling away with the first card. -->
        <aside class="approach-cta" data-reveal>
          <img
            class="approach-cta-bg"
            src={approachAdImage}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="approach-cta-inner">
            <img class="approach-cta-mark" src="/brand/logo-small.svg" alt="Wugweb" width="36" height="36" />
            <h3>{approachCta.title}</h3>
            {approachCta.body && <p class="approach-cta-body">{approachCta.body}</p>}
            <a href="/contact-us" class="btn btn-solid approach-cta-btn">Start a project</a>
            <a href="/work" class="approach-cta-link">See the work first</a>
          </div>
        </aside>
        </div>
      </section>
    )}

    <!-- FRAMEWORK (How we work) — orbital ProcessMap. Each phase is a hub, its
         `includes` orbit it, and the hub chain carries the sequence.
         Live on Experience only until the pattern is signed off; the other five
         keep the card grid below, exactly as the Service Spotlight Panel is
         gated to Brand. The map caps a phase at three steps and throws above
         it, and only Experience's data has been trimmed to suit — so this gate
         is load-bearing, not just a rollout flag. -->
    {processMapEnabled ? (
      <ProcessMap
        eyebrow="How we work"
        heading={`Our ${service.title} Framework`}
        phases={mapPhases}
        shape={mapShape}
        loopTo={mapLoopTo}
        loopLabel={mapLoopLabel}
      />
    ) : (service.framework?.length > 0) && (
      <section class="wrap framework-section">
        <p class="eyebrow" data-reveal>How we work</p>
        <h2 data-reveal>Our {service.title} Framework</h2>
        <div class="framework-flow">
          {service.framework.map((f) => (
            <div class="glass-panel framework-phase" data-reveal>
              <h3 class="framework-phase-title">{f.phase}</h3>
              <p class="framework-outcome">{f.outcome}</p>
              {f.includes?.length > 0 && (
                <ul class="framework-includes">
                  {f.includes.map((i) => <li>{i}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {(safeArr(service.tools, null)) && (
    <!-- TOOLKIT -->
    <section class="wrap toolkit-section">
      <p class="eyebrow" data-reveal>Our Design Toolkit</p>
      <h2 data-reveal>Wugweb leverages a diverse toolkit of industry-leading technologies to craft exceptional user experiences.</h2>
      <div class="toolkit-grid">
        {service.tools.map((t) => (
          <div class="glass-panel toolkit-category" data-reveal>
            <div class="toolkit-category-header">{t.category}</div>
            <ul class="toolkit-items">
              {t.items.map((item) => {
                const icon = toolIconByName.get(String(item).toLowerCase());
                return (
                  <li>
                    {icon ? <img src={icon} alt="" width="16" height="16" loading="lazy" /> : null}
                    <span>{item}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
    )}

    <!-- FAQ -->
    <FaqAccordion
      items={safeArr(service.faqs, [])}
      heading="Frequently asked questions"
      lede={`Everything worth knowing before we start on ${service.title.toLowerCase()}.`}
    />

    <!-- RELATED WORK -->
    {relatedWork.length > 0 && (
      <section class="wrap svc-work">
        <div class="svc-work-head">
          <h2 data-reveal>Work that leads with clarity and delivers with impact</h2>
          <a href="/work" class="btn btn-ghost" data-reveal>View all case studies</a>
        </div>
        <ul class="svc-work-grid">
          {relatedWork.map((cs) => (
            <li data-reveal>
              <a href={`/work/${cs.slug}`} class="glass-panel svc-work-card">
                <div class="card-glow"></div>
                <h3>{cs.title}</h3>
                <p>{cs.client}{cs.disciplines?.length ? ` — ${cs.disciplines.join(', ')}` : ''}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- RELATED INSIGHTS -->
    {relatedPosts.length > 0 && (
      <InsightsBlock
        posts={relatedPosts}
        heading={`${service.title} thinking from the team`}
        ctaLabel="Visit our Blog"
      />
    )}

  </div>
</BaseLayout>

<style>
  /* Base Glass Panel Utilities */
  .glass-panel {
    background: color-mix(in srgb, var(--neutral-8) 60%, transparent);
    border: var(--stroke-thin) solid color-mix(in srgb, var(--neutral-0) 12%, transparent);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  
  .glass-panel:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 22%, transparent);
  }

  /* Typography Enhancements */
  .detail-hero { 
    padding-block: var(--space-section-xl) var(--space-section-md); 
    position: relative;
    overflow: hidden;
  }
  
  .hero-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    height: 80vh;
    background: radial-gradient(circle, color-mix(in srgb, var(--theme-base) 15%, transparent) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .detail-hero .eyebrow a:hover { color: var(--fg); }
  .detail-hero h1 { 
    margin-top: var(--gap-4); 
    max-width: 16ch;
    color: var(--neutral-0);
  }
  
  .hero-sub { font-size: var(--t-xl); color: var(--neutral-0); margin-top: var(--gap-2); line-height: var(--lh-xl); font-weight: var(--font-weight-semibold); }
  .hero-text { margin-top: var(--gap-6); max-width: 55ch; font-size: var(--t-l); line-height: var(--lh-l); color: rgba(255,255,255,0.8); }
  
  .service-tags { list-style: none; margin: var(--gap-6) 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .service-tags li { 
    font-family: var(--font-mono); 
    font-size: var(--t-micro); 
    padding: var(--gap-2) var(--gap-5); 
    border: var(--stroke-thin) solid color-mix(in srgb, var(--neutral-0) 25%, transparent); 
    border-radius: var(--r-pill); 
    color: var(--neutral-0);
    background: color-mix(in srgb, var(--neutral-0) 12%, transparent);
    backdrop-filter: var(--glass-light);
    -webkit-backdrop-filter: var(--glass-light);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .service-tags li:hover {
    background: color-mix(in srgb, var(--neutral-0) 20%, transparent);
    border-color: color-mix(in srgb, var(--neutral-0) 40%, transparent);
  }
  
  .detail-hero .btn { margin-top: var(--gap-4); display: inline-flex; }

  /* Body Panel */
  .detail-body { padding-block: var(--space-section-md) var(--space-section-lg); }
  .body-glass { padding: var(--gap-8); }
  .detail-body p { max-width: 75ch; font-size: var(--t-l); line-height: var(--lh-l); margin: 0 auto; text-align: center;}

  /* Stats */
  .svc-stats { padding-block: var(--space-section-lg); }
  .svc-stats ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .svc-stats ul { grid-template-columns: repeat(3, 1fr); } }
  .stat-card {
    padding: var(--gap-8); text-align: center;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; z-index: var(--layer-base);
    transition: border-color var(--duration-normal) var(--easing-smooth),
                box-shadow var(--duration-normal) var(--easing-smooth),
                filter var(--duration-normal) var(--easing-smooth);
  }
  /* Same interaction-as-hierarchy rule the rest of the page uses. */
  .svc-stats ul:hover .stat-card { filter: brightness(0.7); }
  .svc-stats ul:hover .stat-card:hover { filter: none; }
  .stat-card:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 22%, transparent);
    box-shadow: var(--shadow-md);
    z-index: var(--layer-card);
  }
  .svc-stat-n { display: block; font-family: var(--font-display); font-size: var(--fluid-h2); font-weight: var(--font-weight-extrabold); line-height: var(--core-line-height-tight); color: var(--fg); }
  .svc-stat-label { margin-top: var(--gap-2); color: var(--fg-muted); }

  /* Capabilities — original grouped panels (every pillar except brand) */
  .capabilities-section { padding-block: var(--space-section-xl); position: relative; overflow: clip; }
  .caps-grouped { display: grid; gap: var(--gap-6); margin-top: var(--gap-8); }
  @media (min-width: 768px) { .caps-grouped { grid-template-columns: repeat(3, 1fr); } }
  .cap-group { padding: var(--gap-8); }
  .cap-group:hover { transform: translateY(-4px); }
  .cap-group-n { font-family: var(--font-mono); color: var(--fg-muted); font-size: var(--t-sm); display: block; margin-bottom: var(--gap-4);}
  .cap-group-title { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); }
  .cap-group-items { list-style: none; margin: var(--gap-4) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-2); }
  .cap-group-items li { font-size: var(--fluid-body-sm); color: var(--fg-muted); position: relative; padding-left: var(--gap-4); }
  .cap-group-items li::before { content: '—'; position: absolute; left: 0; color: var(--fg-muted); }

  /* Capabilities — glass showcase (brand only, pending sign-off) */

  /* h2 carrying the eyebrow's look — reset the heading defaults it inherits. */
  .caps-heading { margin: 0; font-weight: inherit; }

  /* .showcase* rules moved to ServiceSpotlightPanel.astro's own scoped
     style (2026-09-16) — this page only renders <ServiceSpotlightPanel>
     now, it no longer owns that markup. */


  /* Why Grid */
  .why-section { padding-block: var(--space-section-xl); }
  .why-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 20ch; }
  .why-grid { display: grid; gap: var(--gap-6); margin-top: var(--gap-10); }
  @media (min-width: 768px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  .why-item { padding: var(--gap-8); position: relative; }
  .why-icon-glow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--theme-gradient);
    opacity: 0.15;
    position: absolute;
    top: var(--gap-8);
    left: var(--gap-8);
    filter: blur(8px);
  }
  .why-item h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); position: relative; z-index: 1;}
  .why-item p { margin-top: var(--gap-4); color: var(--fg-muted); position: relative; z-index: 1;}

  /* Approach Stepper */
  .approach-section { padding-block: var(--space-section-xl); }
  .approach-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 22ch; }
  /* Mobile is the app screen, not a slice of a scrolling document — this
     section had no height rule at all, so it was whatever the card
     count/padding happened to add up to, which made the deal-out
     scroll-scrub (see scroll-animations.ts's 'cardstack' kind) feel
     cramped or oddly paced depending on how many steps a pillar has.
     Fixing it to one full screen gives the scrub a stable, generous
     range to play out in, matching InsightsBlock's mobile treatment. */
  @media (max-width: 767px) {
    .approach-section {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
  /* Landscape cards: wide and short, one per row. The card's own grid does the
     work — meter and number in a narrow left column, title next, body last —
     so the height stays low and five of them read as a sequence rather than a
     wall. The Process Map sits directly below and is the page's big diagram;
     tall portrait cards ahead of it would compete with it. */
  .approach-layout {
    margin-top: var(--gap-10);
    display: grid;
    gap: var(--gap-6);
    grid-template-columns: 1fr;
    /* `stretch`, not `start`: the CTA matches the card column's height rather
       than sitting as a short panel against a tall list. */
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    /* Even split. The cards were on 1.55fr against the CTA's 1fr, which read as
       a main column with a sidebar bolted on rather than two halves. */
    .approach-layout { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-6); }
  }

  .approach-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap-3);
    /* The deck's depth. Without a perspective the cards' translateZ does
       nothing and the stack collapses to a flat pile. */
    perspective: 500px;
    transform-style: preserve-3d;
  }
  .approach-card {
    position: relative;
    z-index: var(--layer-base);
    display: grid;
    /* Visual left, copy right. The visual keeps a fixed ratio at every
       breakpoint (governance §8) and the copy column takes the rest. */
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--gap-4);
    align-items: stretch;
    padding: var(--gap-4);
    /* Near-opaque on purpose. At 48% the cards were translucent, so while the
       deck was dealing the card behind showed straight through the one in
       front — two titles and two + chips visible at once. A card in a stack
       has to occlude what is under it. */
    background: color-mix(in srgb, var(--neutral-8) 97%, var(--bg));
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    /* GSAP owns `transform`, `opacity` and `filter` here for the deck reveal,
       so hover uses none of the three — border, background and shadow only. */
    transition: border-color var(--duration-normal) var(--easing-smooth),
                background-color var(--duration-normal) var(--easing-smooth),
                box-shadow var(--duration-normal) var(--easing-smooth),
                filter var(--duration-normal) var(--easing-smooth);
  }
  @media (min-width: 500px) { .approach-card { grid-template-columns: 8rem minmax(0, 1fr); } }

  .approach-card-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius-lg) - var(--gap-2));
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 30% 0%,
        color-mix(in srgb, var(--neutral-0) 9%, transparent) 0%,
        transparent 70%),
      color-mix(in srgb, var(--neutral-10) 62%, transparent);
    display: grid;
    place-items: center;
    transition: background var(--duration-normal) var(--easing-smooth);
  }
  .approach-card.is-open .approach-card-visual {
    background:
      radial-gradient(120% 100% at 30% 0%,
        color-mix(in srgb, var(--neutral-0) 16%, transparent) 0%,
        transparent 70%),
      color-mix(in srgb, var(--neutral-10) 45%, transparent);
  }
  .approach-card-visual img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Icon tile. The mark is matched to the step's own wording by
     `src/lib/step-icons.ts`, so "Discovery" gets the same icon here as it does
     in the Process Map. */
  .approach-visual-mark { display: grid; gap: var(--gap-3); justify-items: center; }
  .approach-icon {
    width: 1.75rem; height: 1.75rem;
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }
  /* Segment meter — fills to this step's position, so the graphic reports
     progress through the sequence rather than decorating. */
  .approach-meter { display: inline-flex; gap: 3px; }
  .approach-seg {
    width: 8px; height: 3px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--neutral-0) 16%, transparent);
    transition: background var(--duration-normal) var(--easing-out);
  }
  .approach-seg.is-on { background: var(--fg-muted); }

  /* Per the system's "Sub Service : Full" card: number above the title, the
     description beneath, and the round + at the top right. */
  .approach-card-body { display: grid; align-content: start; gap: var(--gap-1); min-width: 0; padding-top: var(--gap-1); }
  /* Index and + on one row, both --chip-size tall, so the header keeps the
     same height whichever it carries. Both come from the site-wide `.u-index`
     / `.u-chip` pair in global.css. */
  .approach-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-3);
  }
  /* The description is what the + reveals. `grid-template-rows: 0fr → 1fr`
     animates a height the browser has to measure for itself, so there is no
     scrollHeight bookkeeping and reflowing text stays correct. */
  .approach-card-desc {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-normal) var(--easing-out),
                opacity var(--duration-fast) var(--easing-out);
    opacity: var(--opacity-0);
  }
  .approach-card-desc > p { overflow: hidden; min-height: 0; }
  .approach-card.is-open .approach-card-desc {
    grid-template-rows: 1fr;
    opacity: var(--opacity-100);
    margin-top: var(--gap-2);
  }

  .approach-card.is-open .approach-toggle {
    transform: rotate(45deg);
    background: var(--neutral-2);
    color: var(--neutral-10);
  }
  .approach-card h3 {
    font-size: var(--fluid-body-md);
    font-weight: var(--font-weight-semibold);
    color: var(--fg);
    line-height: var(--core-line-height-tight);
    text-wrap: balance;
  }
  .approach-card p {
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
    line-height: var(--core-line-height-relaxed);
  }

  /* Hairline that draws down the left edge on hover. */
  .approach-rule {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--fg);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform var(--duration-normal) var(--easing-out);
  }

  .approach-cards:hover .approach-card { filter: brightness(0.66); }
  .approach-cards:hover .approach-card:hover { filter: none; }
  .approach-card:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 22%, transparent);
    background: color-mix(in srgb, var(--neutral-8) 100%, var(--bg));
    box-shadow: var(--shadow-md);
    z-index: var(--layer-card);
  }
  .approach-card:hover .approach-rule { transform: scaleY(1); }
  .approach-card:hover .approach-seg.is-on { background: var(--fg); }

  @media (prefers-reduced-motion: reduce) {
    .approach-card, .approach-seg, .approach-rule,
    .approach-card-desc, .approach-toggle { transition: none; }
  }

  /* ---- second column ---- */
  .approach-cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--neutral-8) 62%, transparent);
    border: var(--stroke-thin) solid var(--line);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--neutral-0) 7%, transparent);
    padding: var(--gap-6);
  }
  /* Art-directed, not a background fill.
     The picture holds the top two-thirds at full strength and is cut away
     underneath by a scrim shaped to the copy, so the image is *seen* and the
     type still reads at AA. Duotone rather than plain grayscale: the image is
     desaturated and then warmed slightly, which sits it in the brand's own
     temperature instead of leaving it a grey rectangle.
     Ratio is never touched — `cover` fills, and nothing animates the box
     (governance §8). Only a slow uniform scale runs on hover. */
  .approach-cta-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: var(--opacity-90);
    filter: grayscale(1) contrast(1.12) brightness(0.72) sepia(0.18);
    transform: scale(1.02);
    transition: transform 0.9s var(--easing-smooth), filter var(--duration-slow) var(--easing-smooth);
  }
  .approach-cta:hover .approach-cta-bg {
    transform: scale(1.06);
    filter: grayscale(0.85) contrast(1.16) brightness(0.78) sepia(0.14);
  }
  /* Scrim: transparent over the picture, opaque under the copy. Two stops do
     the work — a soft top veil so the mark reads, then a hard ramp from 55%
     down so the heading, body and button sit on near-solid ground. */
  .approach-cta::after {
    content: '';
    position: absolute; inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--neutral-10) 42%, transparent) 0%,
        color-mix(in srgb, var(--neutral-10) 18%, transparent) 26%,
        color-mix(in srgb, var(--neutral-10) 82%, transparent) 62%,
        color-mix(in srgb, var(--neutral-10) 96%, transparent) 100%
      );
  }
  /* A single hairline of light along the top edge — the same bevel the Bento
     tiles and the Process Map panel carry, so the ad belongs to the set. */
  .approach-cta {
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--neutral-0) 12%, transparent),
      var(--shadow-md);
  }
  .approach-cta-inner { position: relative; z-index: var(--layer-base); }
  .approach-cta-mark {
    display: block;
    width: 2.25rem; height: auto;
    margin-bottom: var(--gap-5);
    filter: drop-shadow(0 2px 12px color-mix(in srgb, var(--neutral-10) 70%, transparent));
  }
  @media (min-width: 1024px) {
    .approach-cta { padding: var(--gap-8); }
    /* Copy sits at the foot of the full-height panel, so the picture has room
       above it and the button lands level with the last card. */
    .approach-cta-inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    /* The mark stays at the top while the copy holds the bottom. */
    .approach-cta-mark { margin-bottom: auto; }
  }
  .approach-cta h3 {
    font-size: var(--fluid-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--core-line-height-tight);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .approach-cta-body {
    margin-top: var(--gap-3);
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
    line-height: var(--core-line-height-relaxed);
  }
  .approach-cta-btn { margin-top: var(--gap-6); display: inline-flex; }
  .approach-cta-link {
    display: inline-block;
    margin-top: var(--gap-4);
    font-size: var(--fluid-label);
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: var(--stroke-thin) solid color-mix(in srgb, var(--fg-muted) 40%, transparent);
    transition: color var(--duration-normal) var(--easing-out),
                border-color var(--duration-normal) var(--easing-out);
  }
  .approach-cta-link:hover { color: var(--fg); border-color: var(--fg); }

  @media (prefers-reduced-motion: reduce) {
    .approach-card, .approach-seg, .approach-rule,
    .approach-card-desc, .approach-toggle { transition: none; }
  }

  .step-n { 
    width: 40px; height: 40px; border-radius: 50%; 
    background: color-mix(in srgb, var(--neutral-0) 10%, transparent);
    color: var(--fg);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: var(--t-sm);
  }


  /* Framework */
  .framework-section { padding-block: var(--space-section-xl); }
  .framework-section h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 30ch; }
  .framework-flow { display: grid; gap: var(--gap-6); margin-top: var(--gap-10); }
  @media (min-width: 768px) { .framework-flow { grid-template-columns: repeat(3, 1fr); } }
  .framework-phase { padding: var(--gap-8); }
  .framework-phase-title { font-size: var(--fluid-body-md); font-weight: var(--font-weight-semibold); color: var(--fg); margin-bottom: var(--gap-4); }
  .framework-outcome { color: var(--fg); font-size: var(--fluid-body-sm); line-height: var(--core-line-height-normal); }
  .framework-includes { list-style: none; margin: var(--gap-6) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-2); border-top: var(--stroke-thin) solid color-mix(in srgb, var(--neutral-0) 12%, transparent); padding-top: var(--gap-4);}
  .framework-includes li { font-size: var(--fluid-body-sm); color: var(--fg-muted); position: relative; padding-left: var(--gap-4); }
  .framework-includes li::before { content: '→'; position: absolute; left: 0; color: var(--fg-muted); }

  /* Toolkit */
  .toolkit-section { padding-block: var(--space-section-xl); }
  .toolkit-section h2 { font-size: var(--t-h4); margin-top: var(--gap-3); max-width: 50ch; font-weight: var(--font-weight-semibold); }
  .toolkit-grid { display: grid; gap: var(--gap-6); margin-top: var(--gap-10); }
  @media (min-width: 640px) { .toolkit-grid { grid-template-columns: repeat(3, 1fr); } }
  .toolkit-category { padding: var(--gap-8); }
  .toolkit-category:hover { transform: translateY(-4px); }
  .toolkit-category-header { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); margin-bottom: var(--gap-4); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .toolkit-items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .toolkit-items li { display: inline-flex; align-items: center; gap: var(--gap-2); font-size: var(--fluid-label); padding: var(--gap-1) var(--gap-3); border: var(--stroke-thin) solid color-mix(in srgb, var(--neutral-0) 12%, transparent); border-radius: var(--r-pill); color: var(--fg-muted); background: color-mix(in srgb, var(--neutral-8) 40%, transparent);}
  .toolkit-items li img { flex-shrink: 0; opacity: .9; transition: opacity var(--duration-fast) var(--easing-out); }
  /* The chips were inert — 89 of them on a page, none reacting to the pointer. */
  .toolkit-items li {
    transition: border-color var(--duration-fast) var(--easing-out),
                color var(--duration-fast) var(--easing-out),
                background-color var(--duration-fast) var(--easing-out);
  }
  .toolkit-items li:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 28%, transparent);
    background: color-mix(in srgb, var(--neutral-8) 75%, transparent);
    color: var(--fg);
  }
  .toolkit-items li:hover img { opacity: 1; }

  /* FAQ */
  .svc-work, .svc-insights { padding-block: var(--space-section-xl); }
  .svc-work-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--gap-6); margin-bottom: var(--gap-10);}
  .svc-work-head h2 { font-size: var(--t-h3); max-width: 22ch; }
  .svc-work-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc-work-grid { grid-template-columns: repeat(2, 1fr); } }
  .svc-insights-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc-insights-list { grid-template-columns: repeat(3, 1fr); } }
  
  .svc-work-card, .svc-insight-card { 
    text-decoration: none; display: block; padding: var(--gap-8); height: 100%;
    display: flex; flex-direction: column; justify-content: center;
  }
  
  .card-glow {
    position: absolute;
    inset: 0;
