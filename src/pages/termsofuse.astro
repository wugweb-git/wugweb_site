---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery } from '../lib/queries';

// Legal content is CMS-driven (Sanity singletonPage body, portable text).
// Falls back to the hardcoded section below if Sanity body is empty.
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'terms-of-use' }).catch(() => null);
const blocks: any[] = Array.isArray(page?.body) && page.body.length ? page.body : [];

function renderBlock(block: any) {
  const text = block.children?.map((c: any) => c.text || '').join('') || '';
  if (block.style === 'h2') return `<h2>${text}</h2>`;
  if (block.listItem === 'bullet') return `<li>${text}</li>`;
  return `<p>${text}</p>`;
}
const bodyHtml = blocks.map(renderBlock).join('');
const hasCms = bodyHtml.length > 0;
