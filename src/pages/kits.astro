---
// Kits Design System Master Showcase Page (/kits)
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  secondaryColors,
  neutrals,
  pillars,
  typographySpecimens,
  spacingRamp,
  radiusRamp,
  opacityRamp,
  motionEasings,
  faqs,
} from '../lib/design-tokens';
---

<BaseLayout title="Kits Design System & Component Library | Wugweb" description="Complete specification of Wugweb's Kits Design System — primitives, tokens, secondary colors, UI controls, blocks, widgets, and animation effects.">
  <div class="kits-page wrap">

    <!-- ── Hero Header ── -->
    <header class="kits-hero" data-reveal>
      <div class="kits-hero-pill">
        <span class="pulse-dot"></span>
        
      </div>
      <h1 class="kits-hero-title">Kits Design System</h1>
      <p class="kits-hero-lead">
        Primitives, tokens, color matrices, UI controls, structural blocks, interactive widgets, and motion effects powering Wugweb’s digital engineering.
      </p>

      <div class="kits-nav-strip">
        <a href="#primitives" class="nav-chip">Primitives & Tokens</a>
        <a href="#colors" class="nav-chip">Colors & Pillars</a>
        <a href="#typography" class="nav-chip">Typography</a>
        <a href="#components" class="nav-chip">UI Controls</a>
        <a href="#blocks" class="nav-chip">Blocks & Cards</a>
        <a href="#widgets" class="nav-chip">Widgets</a>
        <a href="#motion" class="nav-chip">Motion & Effects</a>
      </div>

      <div class="kits-stats-grid">
        <div class="stat-card"><span class="stat-val">22</span><span class="stat-lbl">Token Specs</span></div>
        <div class="stat-card"><span class="stat-val">10</span><span class="stat-lbl">Fluid Clamps</span></div>
        <div class="stat-card"><span class="stat-val">7</span><span class="stat-lbl">Secondary Colors</span></div>
        <div class="stat-card"><span class="stat-val">6</span><span class="stat-lbl">Service Pillars</span></div>
        <div class="stat-card"><span class="stat-val">5</span><span class="stat-lbl">Motion Easings</span></div>
      </div>
    </header>

    <!-- ── Interactive Pillar Theme Switcher Engine ── -->
    <section class="kits-section theme-switcher-bar" data-reveal>
      <div class="section-hdr">
        
        <h2>Dynamic Service Pillar Switcher</h2>
        <p>Click a service pillar to inspect its base hue, darkened background, light foreground accent, and gradient spectrum.</p>
      </div>

      <div class="pillar-tabs" id="pillarTabs">
        {pillars.map((p, idx) => (
          <button
            class={`pillar-tab ${idx === 0 ? 'active' : ''}`}
            data-pillar={p.id}
            data-base={p.baseHex}
            data-dark={p.darkHex}
            data-light={p.lightHex}
            data-gradient={p.gradient}
          >
            <span class="tab-dot" style={`background: ${p.baseHex}`}></span>
            <span class="tab-name">{p.name}</span>
          </button>
        ))}
      </div>

      <div class="active-pillar-banner" id="pillarBanner" style={`background: ${pillars[0].gradient}; border-color: ${pillars[0].baseHex}`}>
        <div class="banner-content">
          <span class="banner-title" id="bannerTitle">{pillars[0].name} Pillar</span>
          <span class="banner-desc" id="bannerDesc">{pillars[0].desc}</span>
        </div>
        <div class="banner-codes">
          <code id="codeBase">--svc-base: {pillars[0].baseHex}</code>
          <code id="codeLight">--svc-light: {pillars[0].lightHex}</code>
        </div>
      </div>
    </section>

    <!-- ── Section 1: Primitives & Tokens (Colors, Typography, Spacing, Radius, Opacity) ── -->
    <section class="kits-section" id="primitives" data-reveal>
      <div class="section-hdr">
        
        <h2>Color Swatches, Scale Ramps & Tokens</h2>
        <p>The foundational variables and static scales defining background, text, borders, and interactive feedback.</p>
      </div>

      <!-- Color Palette: Secondary & Neutrals -->
      <div class="color-groups-grid" id="colors">
        <div class="color-group-card">
          <h3>Secondary Colors (§1.2)</h3>
          <div class="swatch-list">
            {secondaryColors.map((c) => (
              <div class="swatch-item">
                <div class="swatch-box" style={`background: ${c.hex}; border: 1px solid rgba(255,255,255,0.15);`}></div>
                <div class="swatch-info">
                  <span class="swatch-name">{c.name}</span>
                  <code>{c.token} ({c.hex})</code>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="color-group-card">
          <h3>Neutral Scale (--neutral-0 to --neutral-10)</h3>
          <div class="swatch-list">
            {neutrals.slice(0, 6).map((c) => (
              <div class="swatch-item">
                <div class="swatch-box" style={`background: ${c.hex}; border: 1px solid rgba(255,255,255,0.15);`}></div>
                <div class="swatch-info">
                  <span class="swatch-name">{c.name}</span>
                  <code>{c.token} ({c.hex})</code>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="color-group-card full-width">
          <h3>6 Service Pillar Color Spectrum</h3>
          <div class="pillars-swatch-grid">
            {pillars.map((p) => (
              <div class="pillar-swatch-card" style={`background: ${p.gradient}`}>
                <div class="swatch-hdr">
                  <span class="pillar-dot" style={`background: ${p.baseHex}`}></span>
                  <span class="pillar-title">{p.name}</span>
                </div>
                <span class="pillar-desc-sm">{p.desc}</span>
                <div class="swatch-hex-stack">
                  <code>Base: {p.baseHex}</code>
                  <code>Light: {p.lightHex}</code>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Spacing, Radius & Opacity Ramps -->
      <div class="ramps-grid">
        <div class="ramp-card">
          <h3>Spacing Ramp (--s-0 to --s-12)</h3>
          <div class="ramp-items">
            {spacingRamp.map((s) => (
              <div class="ramp-row">
                <span class="ramp-lbl">{s.token}</span>
                <div class="ramp-bar" style={`width: ${s.px}; background: var(--color-yellow, var(--color-yellow)); height: 8px; border-radius: 4px;`}></div>
                <span class="ramp-val">{s.px}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="ramp-card">
          <h3>Border Radius Ramp</h3>
          <div class="ramp-items">
            {radiusRamp.map((r) => (
              <div class="ramp-row">
                <span class="ramp-lbl">{r.token}</span>
                <div class="radius-box" style={`border-radius: ${r.val}; border: 2px solid var(--color-yellow, var(--color-yellow)); width: 32px; height: 32px;`}></div>
                <span class="ramp-val">{r.val}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="ramp-card">
          <h3>Opacity Scale</h3>
          <div class="ramp-items">
            {opacityRamp.map((o) => (
              <div class="ramp-row">
                <span class="ramp-lbl">{o.token}</span>
                <div class="opacity-box" style={`background: var(--color-yellow); opacity: ${o.val}; width: 40px; height: 16px; border-radius: 4px;`}></div>
                <span class="ramp-val">{o.val}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section 2: Fluid Typography Specimen Stack ── -->
    <section class="kits-section" id="typography" data-reveal>
      <div class="section-hdr">
        
        <h2>Fluid Clamp & Font Weight Hierarchy</h2>
        <p>Single font family (Inter Tight) with strict weight hierarchy: Display 800, H1 700, H2–H4 600, Labels 500, Body 400.</p>
      </div>

      <div class="type-specimen-stack">
        {typographySpecimens.map((spec) => (
          <div class="specimen-card" data-token={spec.token}>
            <div class="specimen-meta">
              <span class="token-name">{spec.token}</span>
              <span class="specimen-tag">{spec.role} · Weight {spec.weight}</span>
              <span class="specimen-px">{spec.px}</span>
              <button class="copy-btn" data-copy={spec.token}>Copy Token</button>
            </div>
            <div
              class="specimen-sample"
              style={`font-size: var(${spec.token}); font-weight: ${spec.weight}; line-height: ${spec.line}; ${spec.tracking ? `letter-spacing: ${spec.tracking};` : ''}`}
            >
              {spec.sample}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Section 3: UI Controls & Component System ── -->
    <section class="kits-section" id="components" data-reveal>
      <div class="section-hdr">
        
        <h2>Buttons, Form Controls, Badges & Tabs</h2>
        <p>Accessible, high-contrast interactive components powering marketing and application interfaces.</p>
      </div>

      <div class="widgets-demo-grid">
        <!-- Buttons Showcase — the real .btn/.btn-solid/.btn-ghost classes
             from global.css, not a separate hand-rolled demo. This page's
             whole job is to be the source of truth, so it has to render
             what the site actually ships, not a lookalike. -->
        <div class="widget-box">
          <div class="widget-hdr"><span class="widget-title">Button System — Brand / Primary / Ghost</span></div>
          <div class="button-stack">
            <button class="btn btn-solid">Brand — Start a project</button>
            <button class="btn">Primary — View all articles</button>
            <button class="btn btn-ghost">Ghost — Learn more</button>
          </div>
          <div class="button-stack" style="flex-direction: row; align-items: flex-end; flex-wrap: wrap; margin-top: var(--gap-4);">
            <button class="btn btn-solid btn-sm">Small</button>
            <button class="btn btn-solid">Medium</button>
            <button class="btn btn-solid btn-lg">Large</button>
          </div>
          <div class="button-stack" style="flex-direction: row; flex-wrap: wrap; margin-top: var(--gap-4);">
            <button class="btn btn-solid" disabled>Disabled</button>
            <a href="https://example.com" target="_blank" rel="noopener noreferrer" class="btn">External ↗ (automatic)</a>
          </div>
        </div>

        <!-- Form Controls -->
        <div class="widget-box">
          <div class="widget-hdr"><span class="widget-title">Form Inputs & Controls</span></div>
          <div class="form-demo-stack">
            <div class="input-field-group">
              <label class="input-lbl">Work Email Address</label>
              <input type="email" class="demo-input" placeholder="name@company.com" value="vedanshu@wugweb.com" />
            </div>
            <div class="input-field-group">
              <label class="input-lbl">Select Engagement Type</label>
              <select class="demo-select">
                <option>Strategy & Digital Transformation</option>
                <option>Platform Engineering & Web App</option>
                <option>Brand Identity System</option>
              </select>
            </div>
            <div class="toggle-row">
              <span class="toggle-lbl">Newsletter Opt-In</span>
              <label class="switch">
                <input type="checkbox" checked />
                <span class="slider round"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- Badges & Status Chips -->
        <div class="widget-box full-width">
          <div class="widget-hdr"><span class="widget-title">Badges, Tags & SLA Indicators</span></div>
          <div class="badges-flex">
            <span class="badge-tag tag-primary">Engineering</span>
            <span class="badge-tag tag-peach">Peach Accent (#E54F30)</span>
            <span class="badge-tag tag-green">Green Accent (#3ED219)</span>
            <span class="badge-tag tag-blue">Blue Accent (#2368D7)</span>
            <span class="badge-tag tag-aqua">Aqua Accent (#09E2C0)</span>
            <span class="badge-tag tag-yellow">Primary Yellow (var(--color-yellow))</span>
            <span class="badge-sla">⚡ 24h Response SLA Guaranteed</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section 4: Blocks & Layout Patterns ── -->
    <section class="kits-section" id="blocks" data-reveal>
      <div class="section-hdr">
        
        <h2>Bento Grids & Structural Containers</h2>
        <p>Modular block layouts used for services, case studies, and feature highlights.</p>
      </div>

      <div class="bento-demo-grid">
        <div class="bento-card bento-wide">
          <span class="bento-tag">BENTO BLOCK 01</span>
          <h3>Domain-Driven Architecture</h3>
          <p>Decoupled content modeling in Sanity Studio feeding dynamic Astro server endpoints.</p>
        </div>

        <div class="bento-card">
          <span class="bento-tag">BENTO BLOCK 02</span>
          <h3>Fluid Clamp Engine</h3>
          <p>Viewport-aware typography and gap scaling.</p>
        </div>

        <div class="bento-card">
          <span class="bento-tag">BENTO BLOCK 03</span>
          <h3>6-Pillar Theme Integration</h3>
          <p>Custom theme accents for every service capability.</p>
        </div>
      </div>
    </section>

    <!-- ── Section 5: Interactive Widgets ── -->
    <section class="kits-section" id="widgets" data-reveal>
      <div class="section-hdr">
        
        <h2>Scope Selector, Accordion & Token Inspector</h2>
        <p>Live functional widgets powering lead generation and developer documentation.</p>
      </div>

      <div class="widgets-demo-grid">
        <!-- 6-Pillar Scope Selector Widget -->
        <div class="widget-box full-width">
          <div class="widget-hdr">
            <span class="widget-title">Interactive 6-Pillar Scope Selector Widget</span>
            <span class="widget-badge" id="selectedCount">0 Pillars Selected</span>
          </div>
          <div class="scope-grid-demo" id="scopeGrid">
            {pillars.map((p) => (
              <div class="scope-chip-card" data-scope={p.name}>
                <div class="chip-top">
                  <span class="chip-dot" style={`background: ${p.baseHex}`}></span>
                  <span class="chip-name">{p.name}</span>
                  <span class="chip-check">✓</span>
                </div>
                <span class="chip-desc">{p.desc}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Accordion FAQ Widget -->
        <div class="widget-box full-width">
          <div class="widget-hdr"><span class="widget-title">Interactive Accordion FAQ Widget</span></div>
          <div class="kits-accordion">
            {faqs.map((f, i) => (
              <details class="accordion-item" open={i === 0}>
                <summary class="accordion-q">
                  <span>{f.q}</span>
                  <span class="acc-icon">+</span>
                </summary>
                <div class="accordion-a">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- Live Code Token Inspector Widget -->
        <div class="widget-box full-width code-inspector">
          <div class="widget-hdr">
            <span class="widget-title">Live Token Inspector & CSS Exporter</span>
            <button class="btn-ghost-sm" id="copyAllTokens">Copy All CSS Variables</button>
          </div>
          <pre class="code-block"><code>{`:root {
  --color-yellow: #FFBE1A;
  --color-peach: #E54F30;
  --color-green: #3ED219;
  --color-blue: #2368D7;
  --color-aqua: #09E2C0;
  --svc-strategy: #FA4108;
  --svc-brand: #E6309F;
  --svc-experience: #09E2C0;
  --svc-engineering: #2167E9;
  --svc-growth: #3ED219;
  --svc-operations: #7A4DFF;
  --fluid-display: clamp(2.5rem, 5.5vw + 0.5rem, 5rem);
  --fluid-h1: clamp(2rem, 4vw + 0.5rem, 3rem);
}`}</code></pre>
        </div>
      </div>
    </section>

    <!-- ── Section 6: Animations, Motion & Effects ── -->
    <section class="kits-section" id="motion" data-reveal>
      <div class="section-hdr">
        
        <h2>Easings, Durations, Glows & Noise</h2>
        <p>GSAP reveal triggers, cubic-bezier spring curves, glassmorphism, and grain data-URIs.</p>
      </div>

      <div class="motion-grid">
        <div class="motion-card">
          <h3>Motion Easing Curves</h3>
          <div class="easing-stack">
            {motionEasings.map((m) => (
              <div class="easing-row">
                <div class="easing-meta">
                  <span class="easing-name">{m.name}</span>
                  <code>{m.token}</code>
                </div>
                <div class="easing-demo-track">
                  <div class="easing-ball" style={`animation: moveBall 2s infinite ${m.cubic}`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="motion-card">
          <h3>Ambient Glow Shadows</h3>
          <div class="glow-stack">
            <div class="glow-box glow-blue">--shadow-glow-blue</div>
            <div class="glow-box glow-pink">--shadow-glow-pink</div>
            <div class="glow-box glow-teal">--shadow-glow-teal</div>
          </div>
        </div>

        <div class="motion-card">
          <h3>Noise Overlay Textures</h3>
          <div class="noise-stack">
            <div class="noise-box noise-light">Noise Light (4%)</div>
            <div class="noise-box noise-medium">Noise Medium (7%)</div>
            <div class="noise-box noise-heavy">Noise Heavy (12%)</div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Toast Notification element -->
  <div class="toast-box" id="toastBox">Token copied to clipboard!</div>
</BaseLayout>

<style>
  .kits-page {
    padding-top: calc(var(--space-section-lg, 4rem) + var(--gap-5));
    padding-bottom: var(--space-section-lg, 4rem);
    color: var(--color-text-primary);
  }

  /* Header */
  .kits-hero {
    text-align: center;
    max-width: 960px;
    margin: 0 auto 50px;
  }

  .kits-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.12);
    margin-bottom: var(--gap-5);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-yellow);
    box-shadow: 0 0 10px var(--color-yellow);
    animation: pulseGlow 2s infinite ease-in-out;  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .kits-hero-title {
    font-size: var(--fluid-display);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--gap-4);
    background: linear-gradient(180deg, var(--neutral-0) 0%, var(--neutral-3) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .kits-hero-lead {
    font-size: var(--fluid-body-lg);
    line-height: 1.6;
    color: var(--neutral-3);
    margin-bottom: 30px;
  }

  .kits-nav-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--gap-2);
    margin-bottom: 30px;
  }

  .nav-chip {
    font-size: var(--t-micro);
    font-weight: 600;
    color: var(--neutral-3);
    background: var(--color-surface-elevated);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-fast) ease;  }

  .nav-chip:hover {
    color: var(--color-yellow);
    border-color: var(--color-yellow);
    background: var(--neutral-7);
  }

  .kits-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 14px;
  }

  .stat-card {
    background: var(--color-surface-elevated);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: var(--gap-4);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-val {
    font-size: var(--t-h2);
    font-weight: 800;
    color: var(--color-yellow);
  }

  .stat-lbl {
    font-size: var(--t-micro);
    color: var(--neutral-5);
    margin-top: var(--gap-1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Section Styles */
  .kits-section {
    margin-bottom: 80px;
    scroll-margin-top: 100px;
  }

  .section-hdr {
    margin-bottom: var(--gap-8);
  }

  .section-hdr h2 {
    font-size: var(--fluid-h2);
    font-weight: 700;
    margin: var(--gap-2) 0;
  }

  .section-hdr p {
    font-size: var(--fluid-body-md);
    color: var(--neutral-3);
  }

  /* Theme Switcher */
  .pillar-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: var(--gap-5);
  }

  .pillar-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    padding: 10px 18px;
    border-radius: var(--radius-full);
    background: var(--color-surface-elevated);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.12);
    color: var(--neutral-2);
    font-weight: 600;
    font-size: var(--t-body);
    cursor: pointer;
    transition: all var(--duration-fast) ease;  }

  .pillar-tab.active, .pillar-tab:hover {
    background: var(--neutral-7);
    border-color: var(--color-yellow);
    color: var(--neutral-0);
  }

  .tab-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .active-pillar-banner {
    padding: var(--gap-6) 30px;
    border-radius: 16px;
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-4);
    transition: all var(--duration-normal) ease;  }

  .banner-title {
    font-size: var(--t-h3);
    font-weight: 700;
    color: var(--neutral-0);
    display: block;
  }

  .banner-desc {
    font-size: var(--t-body);
    color: color-mix(in srgb, var(--neutral-0) 85%, transparent);
  }

  .banner-codes {
    display: flex;
    gap: var(--gap-2);
  }

  .banner-codes code {
    background: color-mix(in srgb, var(--neutral-10) 50%, transparent);
    padding: 6px var(--gap-3);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--color-yellow);
  }

  /* Colors */
  .color-groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--gap-6);
    margin-bottom: var(--gap-10);
    scroll-margin-top: 100px;
  }

  .color-group-card {
    background: var(--color-surface-elevated);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: var(--gap-6);
  }

