<script>
  // 1. Dynamic Pillar Theme Switcher Script
  const pillarTabs = document.querySelectorAll('.pillar-tab');
  const bannerTitle = document.getElementById('bannerTitle');
  const bannerDesc = document.getElementById('bannerDesc');
  const codeBase = document.getElementById('codeBase');
  const codeLight = document.getElementById('codeLight');
  const pillarBanner = document.getElementById('pillarBanner');

  const pillarsData = {
    strategy: { name: 'Strategy Pillar', desc: 'Product, Brand & Growth Architecture', base: '#FA4108', light: '#FF8F66', gradient: 'linear-gradient(135deg, #FA4108 0%, #FF8F66 100%)' },
    brand: { name: 'Brand Pillar', desc: 'Identity Systems & Narrative Design', base: '#E6309F', light: '#F17CC3', gradient: 'linear-gradient(135deg, #E6309F 0%, #F17CC3 100%)' },
    experience: { name: 'Experience Pillar', desc: 'UI/UX, Digital Platforms & Design Systems', base: '#09E2C0', light: '#6EF0DC', gradient: 'linear-gradient(135deg, #09E2C0 0%, #6EF0DC 100%)' },
    engineering: { name: 'Engineering Pillar', desc: 'Web, Mobile App & Platform Modernization', base: '#2167E9', light: '#7FA8F3', gradient: 'linear-gradient(135deg, #2167E9 0%, #7FA8F3 100%)' },
    growth: { name: 'Growth Pillar', desc: 'Martech, CRO & Performance Engineering', base: '#3ED219', light: '#9BE97F', gradient: 'linear-gradient(135deg, #3ED219 0%, #9BE97F 100%)' },
    operations: { name: 'Operations Pillar', desc: 'Managed Application Support & Reliability', base: '#7A4DFF', light: '#B49CFF', gradient: 'linear-gradient(135deg, #7A4DFF 0%, #B49CFF 100%)' },
  };

  pillarTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      pillarTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const pillarKey = tab.getAttribute('data-pillar');
      const data = pillarsData[pillarKey];
      if (data) {
        if (bannerTitle) bannerTitle.textContent = data.name;
        if (bannerDesc) bannerDesc.textContent = data.desc;
        if (codeBase) codeBase.textContent = `--svc-base: ${data.base}`;
        if (codeLight) codeLight.textContent = `--svc-light: ${data.light}`;
        if (pillarBanner) {
          (pillarBanner as HTMLElement).style.background = data.gradient;
          (pillarBanner as HTMLElement).style.borderColor = data.base;
        }
      }
    });
  });

  // 2. Scope Selector Demo Script
  const scopeChips = document.querySelectorAll('.scope-chip-card');
  const selectedCount = document.getElementById('selectedCount');
  let selectedSet = new Set<string>();

  scopeChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const scopeName = chip.getAttribute('data-scope');
      if (selectedSet.has(scopeName)) {
        selectedSet.delete(scopeName);
        chip.classList.remove('selected');
      } else {
        selectedSet.add(scopeName);
        chip.classList.add('selected');
      }
      if (selectedCount) {
        selectedCount.textContent = `${selectedSet.size} Pillar${selectedSet.size === 1 ? '' : 's'} Selected`;
      }
    });
  });

  // 3. Toast & Copy to Clipboard
  const toastBox = document.getElementById('toastBox');
  function showToast(msg: string) {
    if (!toastBox) return;
    toastBox.textContent = msg;
    toastBox.classList.add('show');
    setTimeout(() => toastBox.classList.remove('show'), 2200);
  }

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const token = btn.getAttribute('data-copy');
      if (token) {
        navigator.clipboard.writeText(`var(${token})`);
        showToast(`Copied var(${token}) to clipboard!`);
      }
    });
  });

  const copyAllBtn = document.getElementById('copyAllTokens');
  if (copyAllBtn) {
    copyAllBtn.addEventListener('click', () => {
      const allTokens = `:root {\n  --color-yellow: #FFBE1A;\n  --color-peach: #E54F30;\n  --color-green: #3ED219;\n  --color-blue: #2368D7;\n  --color-aqua: #09E2C0;\n  --svc-strategy: #FA4108;\n  --svc-brand: #E6309F;\n  --svc-experience: #09E2C0;\n  --svc-engineering: #2167E9;\n  --svc-growth: #3ED219;\n  --svc-operations: #7A4DFF;\n  --fluid-display: clamp(2.5rem, 5.5vw + 0.5rem, 5rem);\n  --fluid-h1: clamp(2rem, 4vw + 0.5rem, 3rem);\n}`;
      navigator.clipboard.writeText(allTokens);
      showToast('All CSS variables copied to clipboard!');
    });
  }
</script>
