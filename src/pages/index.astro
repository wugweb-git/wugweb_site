---
// Dynamic (default under output: 'server') — the personalization hook
// stays available for later, just not driving the primary headline
// (would fight the actual brand thesis statement below).
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { servicesListQuery, caseStudiesListQuery, postsListQuery, singletonPageQuery } from '../lib/queries';

const services = await sanityClient.fetch(servicesListQuery).catch(() => []);

// Fetch Sanity data for homepage sections
const sanityCaseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const sanityPosts = await sanityClient.fetch(postsListQuery).catch(() => []);

// Hero headline + intro
const homePage = await sanityClient.fetch(singletonPageQuery, { pageId: 'home' }).catch(() => null);
const headlineText = homePage?.title ?? 'Where Vision Meets Velocity';
const introParas: string[] = (homePage?.body ?? [])
  .map((b: any) => b?.children?.[0]?.text)
  .filter(Boolean);
const fallbackIntro = [
  'Wugweb is a digital experience agency where design meets engineering to shape what is next. We deliver tailored UX design services, rooted in user-centered design and driven by a clear user experience strategy.',
  'Our experience design services and custom UX solutions help businesses craft impactful digital product design with precision. As a UI/UX-focused agency, we create digital experiences that not only look great but also perform with purpose.',
];
const intro = introParas.length ? introParas : fallbackIntro;
const homeTitle = homePage?.seoTitle || 'Wugweb — Digital Experience Agency';
const homeDescription =
  homePage?.seoDescription ||
  'Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.';

// Homepage services teaser is a curated, ordered subset — matches the
// live site's homepage (4 of the 7 total services), not a live Sanity
// query. The full list still lives at /services, Sanity-driven.
const teaserServices = [
  {
    n: '01',
    title: 'Brand & Strategy',
    copy: 'From brand strategy and naming to logo design, guidelines, campaigns, and messaging, we create meaningful brands that connect with the right audience.',
    video: '/assets/more/home/brand-strategy.mp4',
  },
  {
    n: '02',
    title: 'Experience Design',
    copy: 'Our approach integrates UX strategy, UX process, and consistent UX execution supported by flexible product design systems to deliver scalable and brand-led solutions.',
    video: '/assets/more/home/experience-design.mp4',
  },
  {
    n: '03',
    title: 'Martech & Gen AI',
    copy: 'We blend digital experience strategy with AI-powered marketing and generative AI in marketing, helping brands automate, personalize, and optimize user journeys across channels.',
    video: '/assets/more/home/martech-genai.mp4',
  },
  {
    n: '04',
    title: 'Web Development',
    copy: 'From static websites to fully customized platforms, we use full-stack development, CMS integration, and mobile-first design to build secure, high-performance websites and scalable web applications.',
    video: '/assets/more/home/web-app-development.mp4',
  },
];

// The six service pillars, each framed as the question it answers. Media are
// the client's own hosted clips; the active one also drives the section's
// blurred backdrop, so these double as thumbnail and background.
const pillars = [
  { n: '01', title: 'Strategy',    q: 'What should we build?',                     video: '/assets/services/martech-genai/digital-transformation-roadmaps.mp4' },
  { n: '02', title: 'Brand',       q: 'How should we be perceived?',               video: '/assets/more/home/brand-strategy.mp4' },
  { n: '03', title: 'Experience',  q: 'How should people interact with us?',       video: '/assets/more/home/experience-design.mp4' },
  { n: '04', title: 'Growth',      q: 'How do we acquire and retain customers?',   video: '/assets/more/home/martech-genai.mp4' },
  { n: '05', title: 'Engineering', q: 'How do we build and scale it?',             video: '/assets/more/home/web-app-development.mp4' },
  { n: '06', title: 'Operations',  q: 'How do we run, secure and improve it?',     video: '/assets/services/martech-genai/seamless-platform-integration.mp4' },
];

// Curated homepage case-study picks — prefer mapped thumbnailPath
const thumbAssets = await sanityClient.fetch(
  '*[_type == "asset" && usage == "Thumbnail"]{relativePath, sitePath, name}'
).catch(() => []);

function findThumb(slug: string, thumbnailPath?: string) {
  if (thumbnailPath) return thumbnailPath.startsWith('/') ? thumbnailPath : `/${thumbnailPath}`;
  const norm = slug?.toLowerCase().replace(/[^a-z0-9]/g, '') || '';
  for (const a of thumbAssets) {
    const p = (a.relativePath || a.sitePath || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    const n = (a.name || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    if (p.includes(norm) || n.includes(norm)) return a.sitePath || '/assets/' + a.relativePath;
  }
  return '';
}

const workItems = (sanityCaseStudies || []).slice(0, 8).map((cs: any) => ({
  client: cs.client || '',
  category: (cs.disciplines || []).join(', ') || '',
  title: cs.title,
  slug: cs.slug,
  video: findThumb(cs.slug, cs.thumbnailPath),
}));

// Local client logos copied from public/assets/framer/*/client-logo-*.
// Verified 19 available; 13 curated for the homepage grid. Now sourced
// from Sanity client.logoPath (fallback to the curated set if empty).
const curatedLogos = [
  { name: 'Aditya Birla Capital', src: '/assets/logos/client-logo-te1y.png' },
  { name: 'Airtel', src: '/assets/logos/client-logo-c6rj.png' },
  { name: 'Axis Bank', src: '/assets/logos/client-logo-d64b.png' },
  { name: 'Bankco', src: '/assets/logos/client-logo-qhmv.png' },
  { name: 'Cartier', src: '/assets/logos/client-logo-jrot.png' },
  { name: 'Gratifi', src: '/assets/logos/client-logo-5nzb.png' },
  { name: 'IndusInd Bank', src: '/assets/logos/client-logo-k5hy.png' },
  { name: 'Inkompass', src: '/assets/logos/client-logo-9fd5.png' },
  { name: 'Kia', src: '/assets/logos/client-logo-5nkj.png' },
  { name: 'NTUC', src: '/assets/logos/client-logo-grfk.png' },
  { name: 'Plufo', src: '/assets/logos/client-logo-6djh.png' },
  { name: 'RideEV', src: '/assets/logos/client-logo-1gbn.png' },
  { name: 'Valyu', src: '/assets/logos/client-logo-jj6k.png' },
];
const sanityLogos = await sanityClient
  .fetch('*[_type == "client" && defined(logoPath)]{name, logoPath} | order(name asc)')
  .catch(() => []);
const clientLogos = (sanityLogos as any[]).length
  ? (sanityLogos as any[]).map((c: any) => ({ name: c.name, src: c.logoPath }))
  : curatedLogos;

// Industries — sourced from the Sanity industry master (Global Settings);
// fallback to the curated grid if the query comes back empty.
const curatedIndustries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
const sanityIndustries = (await sanityClient
  .fetch('*[_type == "industry"] | order(order asc) { name }[0..23]')
  .catch(() => [])).map((i: any) => i.name);
const industries = (sanityIndustries as string[]).length
  ? (sanityIndustries as string[])
  : curatedIndustries;
---

<BaseLayout title={homeTitle} description={homeDescription}>
  <!-- HERO -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="none"
      src="/assets/more/home/home.mp4"></video>
    <div class="hero-overlay"></div>

    <div class="wrap hero-content">
      <p class="eyebrow" data-reveal>A world-class digital experience agency</p>
      <h1 class="hero-headline t-display" data-headline>{headlineText}</h1>
      <div class="hero-ctas" data-reveal>
        <a href="#services-content" class="btn btn-ghost">Explore Wugweb</a>
        <a href="/contact-us" class="btn btn-solid">Get in Touch</a>
      </div>
    </div>

    <div class="scroll-cue" data-reveal aria-hidden="true"></div>
  </section>

  <!-- INTRO -->
  <section class="wrap intro" data-scroll="rise">
    <h2 data-reveal>Wugweb is a tight team of thoughtful creatives, engineers, and strategists</h2>
    <div class="intro-body">
      <div class="intro-copy" data-reveal>
        {intro.map((p) => <p>{p}</p>)}
      </div>
      <ul class="intro-tags" data-reveal aria-hidden="true">
        <li>strategy</li>
        <li>technology</li>
        <li>design</li>
        <li>we are here</li>
      </ul>
    </div>
  </section>

  <!-- SERVICES TEASER -->
  <section class="wrap services" id="services-content" data-scroll="rise">
    <p class="eyebrow" data-reveal>What we do</p>
    <h2 data-reveal>Crafting UI, UX, and Brand Systems that drive meaning</h2>
    <p class="services-lede" data-reveal>
      In a world where the unexpected is becoming the norm, we build custom digital solutions
      through user experience design, delivering UX design services that are prepared for what is
      possible and what is probable. As a UI UX design agency, we craft experiences that adapt,
      evolve, and perform.
    </p>

    <ol class="service-cards">
      {teaserServices.map((s) => (
        <li class="service-card" data-reveal>
          <div class="service-card-media">
            <video muted loop playsinline preload="none" src={s.video}>
              <source src={s.video} type="video/mp4" />
            </video>
          </div>
          <div class="service-card-foot">
            <div class="service-card-heads">
              <span class="service-n">{s.n}</span>
              <h3>{s.title}</h3>
            </div>
          </div>
          <!-- Sits outside the footer: the footer is hidden while open, and
               the toggle has to stay reachable to close the card again. -->
          <button
            type="button"
            class="service-card-toggle"
            aria-expanded="false"
            aria-label={`Read more about ${s.title}`}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M8 1.5v13M1.5 8h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
          <div class="service-card-back" hidden>
            <span class="service-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </div>
        </li>
      ))}
    </ol>

    <a href="/services" class="btn btn-ghost">View Services</a>
  </section>

  <!-- WORK -->
  <section class="wrap work" data-scroll="rise">
    <div class="work-head">
      <h2 data-reveal>Work that Leads with Clarity and Delivers with Impact</h2>
      <a href="/work" class="btn btn-ghost">View case studies</a>
    </div>

    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal>
          <a href={`/work/${w.slug}`}>
            <video autoplay muted loop playsinline preload="none" src={w.video}></video>
            <p class="work-client">{w.client} — {w.category}</p>
            <h3>{w.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- PILLARS — glass showcase -->
  <section class="pillars" id="pillars" data-scroll="scale">
    <div class="pillars-backdrop" aria-hidden="true">
      {pillars.map((p, i) => (
          <video
          class:list={['pillars-bg', { 'is-active': i === 0 }]}
          data-bg={i}
          muted loop playsinline preload="none"
          src={p.video}
          aria-hidden="true"
        ></video>
      ))}
      <div class="pillars-scrim"></div>
    </div>

    <div class="wrap pillars-inner">
      <p class="eyebrow" data-reveal>How we think</p>
      <h2 data-reveal>Six pillars. Six questions worth answering properly.</h2>

      <ul class="glass-panel">
        {pillars.map((p, i) => (
          <li class:list={['pillar', { 'is-active': i === 0 }]} data-pillar={i}>
            <button type="button" class="pillar-hit" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="pillar-thumb">
                <video muted loop playsinline preload="none" src={p.video} aria-hidden="true"></video>
              </span>
              <span class="pillar-copy">
                <span class="pillar-title">{p.title}</span>
                <span class="pillar-q">{p.q}</span>
              </span>
              <span class="pillar-index">{p.n} / 06</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLIENT LOGOS -->
  <section class="wrap logos" data-scroll="fade-up">
    <p class="eyebrow" data-reveal>Trusted by leading brands</p>
    <ul class="logo-grid" data-reveal>
      {clientLogos.map((l) => (
        <li><img src={l.src} alt={l.name} loading="lazy" /></li>
      ))}
    </ul>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.75) 0%, rgba(10, 10, 12, 0.5) 45%, var(--bg) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: var(--space-section-xl);
  }

  .hero-headline {
    font-weight: var(--font-weight-extrabold);
    margin-block: 1rem 2rem;
    max-width: 16ch;
  }

  .hero-headline .word {
    display: inline-block;
    filter: blur(0px);
  }

  .hero-ctas {
    display: flex;
    gap: var(--gap-4);
    flex-wrap: wrap;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--gap-8);
    z-index: 2;
    width: 1px;
    height: var(--space-section-lg);
    background: var(--line);
    transform: translateX(-50%);
  }

  .intro {
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }

  .intro h2 {
    font-size: var(--t-h3);
    max-width: 20ch;
  }

  .intro-body {
    display: grid;
    gap: var(--gap-10);
    margin-top: var(--gap-10);
  }

  @media (min-width: 900px) {
    .intro-body {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .intro-copy p + p {
    margin-top: var(--gap-4);
  }

  .intro-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
    align-content: flex-start;
  }

  .intro-tags li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: var(--gap-2) var(--gap-4);
    height: fit-content;
    color: var(--fg-muted);
  }

  .services {
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }

  .services h2 {
    font-size: var(--t-h3);
    max-width: 18ch;
    margin-top: var(--gap-3);
  }

  .services-lede {
    max-width: 55ch;
    margin-top: var(--gap-5);
  }

  /* Polaroid-style service cards — light frames that flip to a dark
     detail face when opened, matching the live site's block. */
  .service-cards {
    list-style: none;
    margin: var(--gap-12) 0;
    padding: 0;
    display: grid;
    gap: var(--gap-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) { .service-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .service-cards { grid-template-columns: repeat(4, 1fr); } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--neutral-1);
    border-radius: var(--r-4);
    padding: var(--gap-3) var(--gap-3) var(--s-1);
    min-height: 350px;
    transition: background var(--duration-normal) var(--easing-out), transform var(--duration-normal) var(--easing-out);
  }
  .service-card:hover { transform: translateY(-4px); }
  .service-card.is-open { background: var(--surface-2); }

  .service-card-media {
    flex: 1;
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--neutral-2);
    transition: opacity var(--duration-fast) var(--easing-out);
  }
  .service-card-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .service-card.is-open .service-card-media { display: none; }

  .service-card-foot {
    display: flex;
    align-items: center;
    padding: var(--gap-4) var(--gap-8) var(--gap-4) var(--gap-2);
  }
  .service-card.is-open .service-card-foot { display: none; }
  .service-card-heads .service-n { font-family: var(--font-mono); font-size: var(--t-sm); color: var(--fg-subtle); }
  .service-card-heads h3 { font-size: var(--t-h4); font-weight: var(--font-weight-semibold); line-height: var(--lh-tight); color: var(--color-ash); margin-top: var(--gap-1); }

  .service-card-toggle {
    position: absolute;
    bottom: var(--gap-5);
    right: var(--gap-5);
    width: var(--gap-9); height: var(--gap-9);
    display: grid; place-items: center;
    border-radius: var(--r-pill);
    border: 0;
    background: rgba(0, 0, 0, 0.07);
    color: var(--color-ash);
    cursor: pointer;
    transition: background var(--duration-fast) var(--easing-out), transform var(--duration-fast) var(--easing-out);
  }
  .service-card-toggle svg { width: .9rem; height: .9rem; fill: none; }
  .service-card-toggle:hover { background: rgba(0, 0, 0, 0.14); }
  .service-card-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .service-card.is-open .service-card-toggle {
    top: var(--gap-5); bottom: auto; right: var(--gap-5);
    background: rgba(255, 255, 255, 0.12);
    color: var(--fg);
    transform: rotate(45deg);
  }
  .service-card.is-open .service-card-toggle:hover { background: rgba(255, 255, 255, 0.2); }

  .service-card-back { padding: var(--gap-6) var(--gap-5) var(--gap-7); }
  .service-card-back[hidden] { display: none; }
  .service-card-back .service-n { font-family: var(--font-mono); font-size: var(--t-sm); color: var(--fg-subtle); }
  .service-card-back h3 { font-size: var(--t-h4); font-weight: var(--font-weight-semibold); line-height: var(--lh-tight); color: var(--fg); margin-top: var(--gap-1); }
  .service-card-back p { margin-top: var(--gap-4); font-size: var(--t-sm); line-height: var(--lh-s); color: var(--fg-muted); }

  .pillars {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }
  .pillars-backdrop { position: absolute; inset: 0; z-index: -1; }
  .pillars-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.2);
    filter: blur(64px) saturate(1.35);
    opacity: 0; visibility: hidden;
    transition: opacity var(--duration-slow) var(--easing-in-out);
  }
  .pillars-bg.is-active { opacity: .85; visibility: visible; }
  .pillars-scrim { position: absolute; inset: 0; background: rgba(5,5,5,.5); }
  .pillars-inner h2 { font-size: var(--t-h3); margin-top: var(--gap-3); max-width: 22ch; }
  .glass-panel { list-style: none; margin: var(--gap-10) 0 0; padding: var(--gap-2); display: flex; flex-direction: column; gap: var(--gap-1); border-radius: var(--r-6); background: rgba(15,15,15,.42); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(26px) saturate(1.3); -webkit-backdrop-filter: blur(26px) saturate(1.3); box-shadow: 0 30px 70px rgba(0,0,0,.35); }

  .pillar-hit { position: relative; width: 100%; display: flex; align-items: center; gap: var(--gap-5); padding: var(--gap-2); border: 0; border-radius: var(--r-3); background: transparent; color: var(--fg); text-align: left; font: inherit; cursor: pointer; transition: background var(--duration-normal) var(--easing-in-out), color var(--duration-normal) var(--easing-out); }
  .pillar-hit:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pillar-thumb { flex-shrink: 0; width: 88px; height: 88px; border-radius: var(--r-3); overflow: hidden; background: rgba(255,255,255,.06); }
  .pillar-thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pillar-copy { display: block; min-width: 0; }
  .pillar-title { display: block; font-family: var(--font-display); font-size: var(--t-h4); font-weight: var(--font-weight-semibold); line-height: var(--lh-tight); }
  .pillar-q { display: block; max-height: 0; margin-top: 0; opacity: 0; overflow: hidden; font-size: var(--fluid-body-md); line-height: var(--core-line-height-normal); color: var(--fg-subtle); transition: max-height var(--duration-slow) var(--easing-in-out), opacity var(--duration-normal) var(--easing-out), margin-top var(--duration-slow) var(--easing-out); }
  .pillar-index { position: absolute; top: var(--gap-4); right: var(--gap-5); font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: .04em; color: var(--fg-subtle); opacity: 0; transition: opacity var(--duration-normal) var(--easing-out); }
  .pillar.is-active .pillar-hit { background: var(--neutral-1); color: var(--color-ash); }
  .pillar.is-active .pillar-q { max-height: 6rem; margin-top: var(--gap-1); opacity: 1; }
  .pillar.is-active .pillar-index { opacity: 1; }
  .pillar:not(.is-active) .pillar-hit:hover { background: rgba(255,255,255,.07); }

  @media (max-width: 700px) {
    .pillars { padding-block: var(--space-section-md); }
    .glass-panel { border-radius: var(--r-lg); }
    .pillar-thumb { width: 62px; height: 62px; border-radius: var(--r); }
    .pillar-hit { gap: var(--gap-4); }
    .pillar-index { display: none; }
    .pillar-q { font-size: var(--fluid-body-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-hit, .pillar-q, .pillar-index, .pillars-bg { transition: none; }
  }

  .work {
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-6);
  }

  .work-head h2 {
    font-size: var(--t-h3);
    max-width: 22ch;
  }

  .work-grid {
    list-style: none;
    margin: var(--gap-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--gap-8);
  }

  @media (min-width: 768px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  .work-grid a { text-decoration: none; display: block; }
  .work-grid video { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--r-2); }
  .work-client { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); margin-top: var(--gap-4); }
  .work-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); }

  .logos { padding-block: var(--space-section-md); border-top: 1px solid var(--line); }
  .logo-grid { list-style: none; margin: var(--gap-8) 0 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-10); }
  .logo-grid img { height: 32px; width: auto; filter: grayscale(1) brightness(1.6); opacity: .7; }

  .industries { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .industries h2 { font-size: var(--t-h3); max-width: 18ch; }
  .industries p { margin-top: var(--gap-5); max-width: 55ch; }
  .industries .btn { margin-top: var(--gap-6); }
  .industry-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 640px) { .industry-grid { grid-template-columns: repeat(4, 1fr); } }
  .industry-grid li { background: var(--bg); padding: var(--gap-6); font-family: var(--font-mono); font-size: var(--t-sm); }

  .blog-teaser { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .blog-teaser ul { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .blog-teaser ul { grid-template-columns: repeat(3, 1fr); } }
  .blog-teaser li { border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .blog-teaser .eyebrow { display: block; margin-bottom: var(--gap-2); }
  .blog-teaser a { text-decoration: none; color: var(--fg); font-size: var(--t-l); }

  .closing-cta { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); text-align: center; }
  .closing-cta h2 { font-size: var(--t-h2); }
  .closing-cta p { margin-top: var(--gap-4); }
  .closing-cta .btn { margin-top: var(--gap-8); }
</style>

<script>
  import { animate, stagger, inView } from 'motion';

  // Hero headline: split into words, reveal with blur + upward drift
  const headline = document.querySelector('[data-headline]');
  if (headline) {
    const text = headline.textContent ?? '';
    headline.innerHTML = text
      .split(' ')
      .map((w) => `<span class="word">${w}</span>`)
      .join(' ');

    animate(
      headline.querySelectorAll('.word'),
      { opacity: [0, 1], y: [24, 0], filter: ['blur(10px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.08), easing: [0.16, 1, 0.3, 1] }
    );
  }

  // Hero eyebrow + CTA reveal
  animate('[data-reveal]', { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, delay: 0.3, easing: 'ease-out' });

  // Scroll-triggered reveals with stagger
  inView('.service-card', (el) => {
    animate(el, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
  });

  inView('.work-grid li', (el) => {
    animate(el, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: stagger(0.08), easing: 'ease-out' });
  });

  inView('.industry-grid li, .blog-teaser li, .logo-grid li, .culture-grid li, .team-grid li, .why-grid li, .caps-grid .cap-item, .approach-step', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });

  // Service cards: hover plays the clip, the +/× button flips to the detail face
  document.querySelectorAll<HTMLLIElement>('.service-card').forEach((card) => {
    const video = card.querySelector('video');
    const toggle = card.querySelector<HTMLButtonElement>('.service-card-toggle');
    const back = card.querySelector<HTMLElement>('.service-card-back');

    if (video) {
      card.addEventListener('mouseenter', () => {
        if (card.classList.contains('is-open')) return;
        if (video.preload === 'none') video.preload = 'auto';
        video.play().catch(() => {});
      });
      card.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
    }

    if (toggle && back) {
      toggle.addEventListener('click', () => {
        const open = card.classList.toggle('is-open');
        back.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', `${open ? 'Close' : 'Read more about'} ${card.querySelector('h3')?.textContent ?? ''}`.trim());
        if (open && video) { video.pause(); video.currentTime = 0; }
      });
    }
  });

  // Glass showcase: hovering (or focusing/tapping) a pillar makes it the
  // active row and swaps the blurred backdrop. Only the active clips play.
  {
    const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.pillar'));
    const bgs = Array.from(document.querySelectorAll<HTMLVideoElement>('.pillars-bg'));
    let active = 0;

    const setActive = (i: number) => {
      if (i === active || !rows[i]) return;
      active = i;
      rows.forEach((row, n) => {
        const on = n === i;
        row.classList.toggle('is-active', on);
        row.querySelector('.pillar-hit')?.setAttribute('aria-expanded', String(on));
        const thumb = row.querySelector('video');
        if (thumb) {
          if (on) { if (thumb.preload === 'none') thumb.preload = 'auto'; thumb.play().catch(() => {}); }
          else { thumb.pause(); }
        }
      });
      bgs.forEach((bg, n) => {
        const on = n === i;
        bg.classList.toggle('is-active', on);
        if (on) { if (bg.preload === 'none') bg.preload = 'auto'; bg.play().catch(() => {}); }
        else { bg.pause(); }
      });
    };

    rows.forEach((row, i) => {
      const hit = row.querySelector<HTMLButtonElement>('.pillar-hit');
      if (!hit) return;
      hit.addEventListener('mouseenter', () => setActive(i));
      hit.addEventListener('focus', () => setActive(i));
      hit.addEventListener('click', () => setActive(i));
    });

    // Don't start any playback until the section is actually on screen.
    const section = document.querySelector('.pillars');
    if (section) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const idx = active;
          const play = e.isIntersecting;
          [bgs[idx], rows[idx]?.querySelector('video')].forEach((v) => {
            if (!v) return;
            if (play) { if (v.preload === 'none') v.preload = 'auto'; v.play().catch(() => {}); }
            else { v.pause(); }
          });
        });
      }, { rootMargin: '10% 0px' });
      io.observe(section);
    }
  }

  // Work card tilt effect
  document.querySelectorAll('.work-grid a').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });
</script>
