---
// Dynamic (default under output: 'server') — the personalization hook
// stays available for later, just not driving the primary headline
// (would fight the actual brand thesis statement below).
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { servicesListQuery, singletonPageQuery } from '../lib/queries';

const services = await sanityClient.fetch(servicesListQuery).catch(() => []);

// Hero headline + intro copy now Sanity-editable, same pattern as
// about/faq/contact-us. Falls back to the known real copy if empty.
const homePage = await sanityClient.fetch(singletonPageQuery, { pageId: 'home' }).catch(() => null);
const headlineText = homePage?.title ?? 'Where Vision Meets Velocity';
const introParas: string[] = (homePage?.body ?? [])
  .map((b: any) => b?.children?.[0]?.text)
  .filter(Boolean);
const fallbackIntro = [
  'Wugweb is a digital experience agency where design meets engineering to shape what is next. We deliver tailored UX design services, rooted in user-centered design and driven by a clear user experience strategy.',
  'Our experience design services and custom UX solutions help businesses craft impactful digital product design with precision. As a UI/UX-focused agency, we create digital experiences that not only look great but also perform with purpose.',
];
const intro = introParas.length ? introParas : fallbackIntro;

// Homepage services teaser is a curated, ordered subset — matches the
// live site's homepage (4 of the 7 total services), not a live Sanity
// query. The full list still lives at /services, Sanity-driven.
const teaserServices = [
  {
    n: '01',
    title: 'Brand & Strategy',
    copy: 'From brand strategy and naming to logo design, guidelines, campaigns, and messaging, we create meaningful brands that connect with the right audience.',
    video: 'https://wugweb.online/assets/more/home/Brand%20%26%20Strategy.mp4',
  },
  {
    n: '02',
    title: 'Experience Design',
    copy: 'Our approach integrates UX strategy, UX process, and consistent UX execution supported by flexible product design systems to deliver scalable and brand-led solutions.',
    video: 'https://wugweb.online/assets/more/home/Experience%20Design.mp4',
  },
  {
    n: '03',
    title: 'Martech & Gen AI',
    copy: 'We blend digital experience strategy with AI-powered marketing and generative AI in marketing, helping brands automate, personalize, and optimize user journeys across channels.',
    video: 'https://wugweb.online/assets/more/home/Martech%20%26%20GenAi.mp4',
  },
  {
    n: '04',
    title: 'Web Development',
    copy: 'From static websites to fully customized platforms, we use full-stack development, CMS integration, and mobile-first design to build secure, high-performance websites and scalable web applications.',
    video: 'https://wugweb.online/assets/more/home/Web%20%26%20App%20Development.mp4',
  },
];

// Curated homepage case-study picks — same treatment as services above:
// a fixed, ordered homepage teaser rather than a live Sanity query.
// Full list lives at /work, Sanity-driven once you add caseStudy docs.
// NOTE: two entries below share the same "Inkompass" thumbnail on the
// live site (Aditya Birla Capital + Philip Morris) — looks like a
// mismatched-asset bug there, not something I introduced. Flagging
// rather than silently fixing, since I don't know the intended thumb.
const workItems = [
  { client: 'Aditya Birla Capital', category: 'UX Design', title: "Demystifying Finance: Crafting the UX for Aditya Birla Capital's Credit Score Tool", slug: 'demystifying-finance-crafting-the-ux-for-aditya-birla-capital-s-credit-score-tool', video: 'https://wugweb.online/assets/work/Inkompass/inkompass_thumb.mp4' },
  { client: 'Axis Bank', category: 'Strategy, UX Design', title: 'The Architecture of Loyalty: Designing the Axis Bank Savings Account Platform', slug: 'the-architecture-of-loyalty-designing-the-axis-bank-savings-account-platform', video: 'https://wugweb.online/assets/work/Axis%20Bank/axis_thumb.mp4' },
  { client: 'METCRED', category: 'UX Design, Strategy', title: 'The Avant-Garde of Banking: Designing the METCRED Zero-Fee Mobile Experience', slug: 'the-avant-garde-of-banking-designing-the-metcred-zero-fee-mobile-experience', video: 'https://wugweb.online/assets/work/Metcred/metcred_thumb.mp4' },
  { client: 'Philip Morris International', category: 'UX Design', title: 'Redesigning Inkompass – Cultivating Global Talent for a Smoke-Free Future', slug: 'redesigning-inkompass-cultivating-global-talent-for-a-smoke-free-future', video: 'https://wugweb.online/assets/work/Inkompass/inkompass_thumb.mp4' },
  { client: 'Airtel', category: 'UX Design', title: 'Airtel Xsafe – Securing Homes with Intuitive Digital Experiences', slug: 'airtel-xsafe-securing-homes-with-intuitive-digital-experiences', video: 'https://wugweb.online/assets/work/Airtel%20Xsafe/Xsafe_thumb.mp4' },
  { client: 'VisiONE', category: 'UX Design', title: 'VisiONE – Empowering Workforce Development with Competency-Based Assessments', slug: 'visione-empowering-workforce-development-with-competency-based-assessments', video: 'https://wugweb.online/assets/work/VisiOne/visiOne_thumb.mp4' },
  { client: 'IndusInd Bank', category: 'UX Design', title: 'IndusNinja – Your AI-Powered Financial Ninja', slug: 'indusninja-your-ai-powered-financial-ninja', video: 'https://wugweb.online/assets/work/Indusninja/Indusninja_thumb.mp4' },
  { client: 'Sadhan', category: 'UX Design, Strategy', title: 'Sadhan – Streamlining Driver Onboarding & Lead Management', slug: 'sadhan-streamlining-driver-onboarding-lead-management', video: 'https://wugweb.online/assets/work/Sadhan/sadhan_thumb.mp4' },
];

// Client logos — still on Framer's CDN (framerusercontent.com), not
// migrated. These will break whenever Framer stops serving them. Real
// follow-up: re-upload as Sanity assets or drop into R2, then swap
// these src values. Using directly for now to get the section working.
const clientLogos = [
  { name: 'Adtech', src: 'https://framerusercontent.com/images/nc5UeWDPtjs9Ymj2mqK3OsFE.png' },
  { name: 'Acko', src: 'https://framerusercontent.com/images/7ZWZTC1heH7oAj2UEPk5WdmqgE.png' },
  { name: 'Tanishq', src: 'https://framerusercontent.com/images/RMGYiWyKTtfr6KxxFAgEP6B0s.png' },
  { name: 'ITC', src: 'https://framerusercontent.com/images/MNcVx0PTQNUOilSjr6j5zgy51u4.png' },
  { name: 'Airtel', src: 'https://framerusercontent.com/images/gYvQx01uxXUY8MKGB3kwJmqAQ.png' },
  { name: 'Amazon Ads', src: 'https://framerusercontent.com/images/vEyEWvs1Yb10Zww15nV4Db3E.png' },
  { name: 'Aditya Birla Capital', src: 'https://framerusercontent.com/images/F3H5mFd6YHEScmNRUFoy0ootKmQ.png' },
  { name: 'NTUC', src: 'https://framerusercontent.com/images/Xl4UZzHZx3eaDLzAtv1eQuxMac.png' },
  { name: 'LinkedIn Ads', src: 'https://framerusercontent.com/images/rhwTBbwxdPvvu180QCe16R0Ec.png' },
  { name: 'U Income', src: 'https://framerusercontent.com/images/9qQKBgCdUhU3Kv9lvj444xJXR4.png' },
  { name: 'SpiceJet', src: 'https://framerusercontent.com/images/iuPX9c0k6RRUKQwrtJlHCt4ymA.png' },
  { name: 'Cartier', src: 'https://framerusercontent.com/images/v3NYQBsmFqqlpLiBPnTSQgmgm9Q.png' },
  { name: 'IndusInd Bank', src: 'https://framerusercontent.com/images/OAJmygOGcSwLJKPhchwfcg95vg.png' },
];

const industries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
---

<BaseLayout title="Home" description="Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.">
  <!-- HERO -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline
      src="https://wugweb.online/assets/more/home/Home.mp4"></video>
    <div class="hero-overlay"></div>

    <!-- Nav comes from the shared SiteHeader in BaseLayout, rendered in
         normal flow above this section — not overlaid transparently on
         the video like the original. Deliberate simplification: safer
         than absolute-positioning it with no way for me to visually
         verify the result. Worth revisiting once you can see it live. -->

    <div class="wrap hero-content">
      <p class="eyebrow" data-reveal>A world-class digital experience agency</p>
      <h1 class="hero-headline" data-headline>{headlineText}</h1>
      <div class="hero-ctas" data-reveal>
        <a href="#services-content" class="btn btn-ghost">Explore Wugweb</a>
        <a href="/contact-us" class="btn btn-solid">Get in Touch</a>
      </div>
    </div>

    <div class="scroll-cue" data-reveal aria-hidden="true"></div>
  </section>

  <!-- INTRO -->
  <section class="wrap intro">
    <h2 data-reveal>Wugweb is a tight team of thoughtful creatives, engineers, and strategists</h2>
    <div class="intro-body">
      <div class="intro-copy" data-reveal>
        {intro.map((p) => <p>{p}</p>)}
      </div>
      <ul class="intro-tags" data-reveal aria-hidden="true">
        <li>strategy</li>
        <li>technology</li>
        <li>design</li>
        <li>we are here</li>
      </ul>
    </div>
  </section>

  <!-- SERVICES TEASER -->
  <section class="wrap services" id="services-content">
    <p class="eyebrow" data-reveal>What we do</p>
    <h2 data-reveal>Crafting UI, UX, and Brand Systems that drive meaning</h2>
    <p class="services-lede" data-reveal>
      In a world where the unexpected is becoming the norm, we build custom digital solutions
      through user experience design, delivering UX design services that are prepared for what is
      possible and what is probable. As a UI UX design agency, we craft experiences that adapt,
      evolve, and perform.
    </p>

    <ol class="service-rows">
      {teaserServices.map((s) => (
        <li class="service-row" data-reveal>
          <span class="service-n">{s.n}</span>
          <div class="service-text">
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </div>
          <video class="service-video" autoplay muted loop playsinline src={s.video}></video>
        </li>
      ))}
    </ol>

    <a href="/services" class="btn btn-ghost">View Services</a>
  </section>

  <!-- WORK -->
  <section class="wrap work">
    <div class="work-head">
      <h2 data-reveal>Work that Leads with Clarity and Delivers with Impact</h2>
      <a href="/work" class="btn btn-ghost">View case studies</a>
    </div>

    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal>
          <a href={`/work/${w.slug}`}>
            <video autoplay muted loop playsinline src={w.video}></video>
            <p class="work-client">{w.client} — {w.category}</p>
            <h3>{w.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- CLIENT LOGOS -->
  <section class="wrap logos">
    <p class="eyebrow" data-reveal>Trusted by leading brands</p>
    <ul class="logo-grid" data-reveal>
      {clientLogos.map((l) => (
        <li><img src={l.src} alt={l.name} loading="lazy" /></li>
      ))}
    </ul>
  </section>

  <!-- INDUSTRIES -->
  <section class="wrap industries">
    <h2 data-reveal>Industries We Empower</h2>
    <p data-reveal>
      From local businesses to international corporations, our clients all share one common
      understanding when it comes to building authentic brands: the power of research, strategy,
      creativity, and design.
    </p>
    <a href="/about" class="btn btn-ghost">More about us</a>

    <ul class="industry-grid">
      {industries.map((i) => <li data-reveal>{i}</li>)}
    </ul>
  </section>

  <!-- BLOG TEASER -->
  <section class="wrap blog-teaser">
    <div class="work-head">
      <h2 data-reveal>Some of our recent thoughts</h2>
      <a href="/blog" class="btn btn-ghost">Visit our Blog</a>
    </div>
    <ul>
      <li data-reveal><span class="eyebrow">Tech</span><a href="/blog/is-augmented-reality-the-future-of-ux">Is Augmented Reality the future of UX?</a></li>
      <li data-reveal><span class="eyebrow">Martech</span><a href="/blog/6-strategies-that-got-my-side-project-its-first-1-000-users">6 Strategies That Got My Side Project Its First 1,000 Users</a></li>
      <li data-reveal><span class="eyebrow">Design</span><a href="/blog/10-a-hole-design-patterns">10 A**hole Design Patterns</a></li>
    </ul>
  </section>

  <!-- CLOSING CTA -->
  <section class="wrap closing-cta">
    <h2 data-reveal>We speak your Industry's language.</h2>
    <p data-reveal>Partner with Wugweb for domain-driven design and development that delivers.</p>
    <a href="/contact-us" class="btn btn-solid">Request Quote</a>
  </section>

  <p class="wrap" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); padding-block: 3rem;">
    {services.length} services in Sanity
  </p>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.75) 0%, rgba(10, 10, 12, 0.5) 45%, var(--bg) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: 5rem;
  }

  .hero-headline {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    font-weight: 700;
    margin-block: 1rem 2rem;
    max-width: 16ch;
  }

  .hero-headline .word {
    display: inline-block;
    filter: blur(0px);
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 2;
    width: 1px;
    height: 3rem;
    background: var(--line);
    transform: translateX(-50%);
  }

  .intro {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .intro h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 20ch;
  }

  .intro-body {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .intro-body {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .intro-copy p + p {
    margin-top: 1rem;
  }

  .intro-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-content: flex-start;
  }

  .intro-tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    height: fit-content;
    color: var(--fg-muted);
  }

  .services {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .services h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 18ch;
    margin-top: 0.75rem;
  }

  .services-lede {
    max-width: 55ch;
    margin-top: 1.25rem;
  }

  .service-rows {
    list-style: none;
    margin: 3rem 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .service-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .service-row {
      grid-template-columns: auto 1fr auto;
    }
  }

  .service-n {
    font-family: var(--font-mono);
    color: var(--accent-warm);
    font-size: 1rem;
  }

  .service-text h3 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .service-text p {
    margin-top: 0.5rem;
    max-width: 50ch;
  }

  .service-video {
    display: none;
    width: 140px;
    height: 90px;
    object-fit: cover;
    border-radius: 8px;
  }

  @media (min-width: 768px) {
    .service-video {
      display: block;
    }
  }

  .work {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .work-head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 22ch;
  }

  .work-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .work-grid a {
    text-decoration: none;
    display: block;
  }

  .work-grid video {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
  }

  .work-client {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 1rem;
  }

  .work-grid h3 {
    font-size: 1.15rem;
    font-weight: 500;
    margin-top: 0.4rem;
  }

  .logos {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }

  .logo-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  .logo-grid img {
    height: 32px;
    width: auto;
    filter: grayscale(1) brightness(1.6);
    opacity: 0.7;
  }

  .industries {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .industries h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 18ch;
  }

  .industries p {
    margin-top: 1.25rem;
    max-width: 55ch;
  }

  .industries .btn {
    margin-top: 1.5rem;
  }

  .industry-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .industry-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .industry-grid li {
    background: var(--bg);
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .blog-teaser {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .blog-teaser ul {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-teaser ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-teaser li {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .blog-teaser .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
  }

  .blog-teaser a {
    text-decoration: none;
    color: var(--fg);
    font-size: 1.1rem;
  }

  .closing-cta {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .closing-cta h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .closing-cta p {
    margin-top: 1rem;
  }

  .closing-cta .btn {
    margin-top: 2rem;
  }
</style>

<script>
  import { animate, stagger, inView } from 'motion';

  // Hero headline: split into words, reveal with blur + upward drift
  const headline = document.querySelector('[data-headline]');
  if (headline) {
    const text = headline.textContent ?? '';
    headline.innerHTML = text
      .split(' ')
      .map((w) => `<span class="word">${w}</span>`)
      .join(' ');

    animate(
      headline.querySelectorAll('.word'),
      { opacity: [0, 1], y: [24, 0], filter: ['blur(10px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.08), easing: [0.16, 1, 0.3, 1] }
    );
  }

  // Hero eyebrow + CTA reveal
  animate('[data-reveal]', { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, delay: 0.3, easing: 'ease-out' });

  // Scroll-triggered reveals with stagger
  inView('.service-row', (el) => {
    animate(el, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
  });

  inView('.work-grid li', (el) => {
    animate(el, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: stagger(0.08), easing: 'ease-out' });
  });

  inView('.industry-grid li, .blog-teaser li, .logo-grid li, .culture-grid li, .team-grid li, .why-grid li, .caps-grid .cap-item, .approach-step', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });

  // Service row hover: play video on hover
  document.querySelectorAll('.service-row').forEach(row => {
    const video = row.querySelector('video');
    if (!video) return;
    row.addEventListener('mouseenter', () => video.play());
    row.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
  });

  // Work card tilt effect
  document.querySelectorAll('.work-grid a').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });
</script>
