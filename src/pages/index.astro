---
// Dynamic (default under output: 'server') — the personalization hook
// stays available for later, just not driving the primary headline
// (would fight the actual brand thesis statement below).
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { servicesListQuery, singletonPageQuery } from '../lib/queries';

const services = await sanityClient.fetch(servicesListQuery).catch(() => []);

// Hero headline + intro copy now Sanity-editable, same pattern as
// about/faq/contact-us. Falls back to the known real copy if empty.
const homePage = await sanityClient.fetch(singletonPageQuery, { pageId: 'home' }).catch(() => null);
const headlineText = homePage?.title ?? 'Where Vision Meets Velocity';
const introParas: string[] = (homePage?.body ?? [])
  .map((b: any) => b?.children?.[0]?.text)
  .filter(Boolean);
const fallbackIntro = [
  'Wugweb is a digital experience agency where design meets engineering to shape what is next. We deliver tailored UX design services, rooted in user-centered design and driven by a clear user experience strategy.',
  'Our experience design services and custom UX solutions help businesses craft impactful digital product design with precision. As a UI/UX-focused agency, we create digital experiences that not only look great but also perform with purpose.',
];
const intro = introParas.length ? introParas : fallbackIntro;

// Homepage services teaser is a curated, ordered subset — matches the
// live site's homepage (4 of the 7 total services), not a live Sanity
// query. The full list still lives at /services, Sanity-driven.
const teaserServices = [
  {
    n: '01',
    title: 'Brand & Strategy',
    copy: 'From brand strategy and naming to logo design, guidelines, campaigns, and messaging, we create meaningful brands that connect with the right audience.',
    video: '/assets/more/home/brand-strategy.mp4',
  },
  {
    n: '02',
    title: 'Experience Design',
    copy: 'Our approach integrates UX strategy, UX process, and consistent UX execution supported by flexible product design systems to deliver scalable and brand-led solutions.',
    video: '/assets/more/home/experience-design.mp4',
  },
  {
    n: '03',
    title: 'Martech & Gen AI',
    copy: 'We blend digital experience strategy with AI-powered marketing and generative AI in marketing, helping brands automate, personalize, and optimize user journeys across channels.',
    video: '/assets/more/home/martech-genai.mp4',
  },
  {
    n: '04',
    title: 'Web Development',
    copy: 'From static websites to fully customized platforms, we use full-stack development, CMS integration, and mobile-first design to build secure, high-performance websites and scalable web applications.',
    video: '/assets/more/home/web-app-development.mp4',
  },
];

// The six service pillars, each framed as the question it answers. Media are
// the client's own hosted clips; the active one also drives the section's
// blurred backdrop, so these double as thumbnail and background.
const pillars = [
  { n: '01', title: 'Strategy',    q: 'What should we build?',                     video: '/assets/services/martech-genai/digital-transformation-roadmaps.mp4' },
  { n: '02', title: 'Brand',       q: 'How should we be perceived?',               video: '/assets/more/home/brand-strategy.mp4' },
  { n: '03', title: 'Experience',  q: 'How should people interact with us?',       video: '/assets/more/home/experience-design.mp4' },
  { n: '04', title: 'Growth',      q: 'How do we acquire and retain customers?',   video: '/assets/more/home/martech-genai.mp4' },
  { n: '05', title: 'Engineering', q: 'How do we build and scale it?',             video: '/assets/more/home/web-app-development.mp4' },
  { n: '06', title: 'Operations',  q: 'How do we run, secure and improve it?',     video: '/assets/services/martech-genai/seamless-platform-integration.mp4' },
];

// Curated homepage case-study picks — same treatment as services above:
// a fixed, ordered homepage teaser rather than a live Sanity query.
// Full list lives at /work, Sanity-driven once you add caseStudy docs.
// Aditya Birla Capital previously reused the Inkompass clip; the Notion
// asset sheet has the real one (abc_thumb.mp4), now used.
const workItems = [
  { client: 'Aditya Birla Capital', category: 'UX Design', title: "Demystifying Finance: Crafting the UX for Aditya Birla Capital's Credit Score Tool", slug: 'demystifying-finance-crafting-the-ux-for-aditya-birla-capital-s-credit-score-tool', video: '/assets/work/aditya-birla-capital/abc-thumb.mp4' },
  { client: 'Axis Bank', category: 'Strategy, UX Design', title: 'The Architecture of Loyalty: Designing the Axis Bank Savings Account Platform', slug: 'the-architecture-of-loyalty-designing-the-axis-bank-savings-account-platform', video: '/assets/work/axis-bank/axis-thumb.mp4' },
  { client: 'METCRED', category: 'UX Design, Strategy', title: 'The Avant-Garde of Banking: Designing the METCRED Zero-Fee Mobile Experience', slug: 'the-avant-garde-of-banking-designing-the-metcred-zero-fee-mobile-experience', video: '/assets/work/metcred/metcred-thumb.mp4' },
  { client: 'Philip Morris International', category: 'UX Design', title: 'Redesigning Inkompass – Cultivating Global Talent for a Smoke-Free Future', slug: 'redesigning-inkompass-cultivating-global-talent-for-a-smoke-free-future', video: '/assets/work/inkompass/inkompass-thumb.mp4' },
  { client: 'Airtel', category: 'UX Design', title: 'Airtel Xsafe – Securing Homes with Intuitive Digital Experiences', slug: 'airtel-xsafe-securing-homes-with-intuitive-digital-experiences', video: '/assets/work/airtel-xsafe/xsafe-thumb.mp4' },
  { client: 'VisiONE', category: 'UX Design', title: 'VisiONE – Empowering Workforce Development with Competency-Based Assessments', slug: 'visione-empowering-workforce-development-with-competency-based-assessments', video: '/assets/work/visione/visione-thumb.mp4' },
  { client: 'IndusInd Bank', category: 'UX Design', title: 'IndusNinja – Your AI-Powered Financial Ninja', slug: 'indusninja-your-ai-powered-financial-ninja', video: '/assets/work/indusind-bank/indusninja-thumb.mp4' },
  { client: 'Sadhan', category: 'UX Design, Strategy', title: 'Sadhan – Streamlining Driver Onboarding & Lead Management', slug: 'sadhan-streamlining-driver-onboarding-lead-management', video: '/assets/work/sadhan/sadhan-thumb.mp4' },
];

// Client logos — still on Framer's CDN (framerusercontent.com), not
// migrated. These will break whenever Framer stops serving them. Real
// follow-up: re-upload as Sanity assets or drop into R2, then swap
// these src values. Using directly for now to get the section working.
const clientLogos = [
  { name: 'Adtech', src: 'https://framerusercontent.com/images/nc5UeWDPtjs9Ymj2mqK3OsFE.png' },
  { name: 'Acko', src: 'https://framerusercontent.com/images/7ZWZTC1heH7oAj2UEPk5WdmqgE.png' },
  { name: 'Tanishq', src: 'https://framerusercontent.com/images/RMGYiWyKTtfr6KxxFAgEP6B0s.png' },
  { name: 'ITC', src: 'https://framerusercontent.com/images/MNcVx0PTQNUOilSjr6j5zgy51u4.png' },
  { name: 'Airtel', src: 'https://framerusercontent.com/images/gYvQx01uxXUY8MKGB3kwJmqAQ.png' },
  { name: 'Amazon Ads', src: 'https://framerusercontent.com/images/vEyEWvs1Yb10Zww15nV4Db3E.png' },
  { name: 'Aditya Birla Capital', src: 'https://framerusercontent.com/images/F3H5mFd6YHEScmNRUFoy0ootKmQ.png' },
  { name: 'NTUC', src: 'https://framerusercontent.com/images/Xl4UZzHZx3eaDLzAtv1eQuxMac.png' },
  { name: 'LinkedIn Ads', src: 'https://framerusercontent.com/images/rhwTBbwxdPvvu180QCe16R0Ec.png' },
  { name: 'U Income', src: 'https://framerusercontent.com/images/9qQKBgCdUhU3Kv9lvj444xJXR4.png' },
  { name: 'SpiceJet', src: 'https://framerusercontent.com/images/iuPX9c0k6RRUKQwrtJlHCt4ymA.png' },
  { name: 'Cartier', src: 'https://framerusercontent.com/images/v3NYQBsmFqqlpLiBPnTSQgmgm9Q.png' },
  { name: 'IndusInd Bank', src: 'https://framerusercontent.com/images/OAJmygOGcSwLJKPhchwfcg95vg.png' },
];

const industries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
---

<BaseLayout title="Home" description="Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.">
  <!-- HERO -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline
      src="/assets/more/home/home.mp4"></video>
    <div class="hero-overlay"></div>

    <!-- Nav comes from the shared SiteHeader in BaseLayout, rendered in
         normal flow above this section — not overlaid transparently on
         the video like the original. Deliberate simplification: safer
         than absolute-positioning it with no way for me to visually
         verify the result. Worth revisiting once you can see it live. -->

    <div class="wrap hero-content">
      <p class="eyebrow" data-reveal>A world-class digital experience agency</p>
      <h1 class="hero-headline" data-headline>{headlineText}</h1>
      <div class="hero-ctas" data-reveal>
        <a href="#services-content" class="btn btn-ghost">Explore Wugweb</a>
        <a href="/contact-us" class="btn btn-solid">Get in Touch</a>
      </div>
    </div>

    <div class="scroll-cue" data-reveal aria-hidden="true"></div>
  </section>

  <!-- INTRO -->
  <section class="wrap intro">
    <h2 data-reveal>Wugweb is a tight team of thoughtful creatives, engineers, and strategists</h2>
    <div class="intro-body">
      <div class="intro-copy" data-reveal>
        {intro.map((p) => <p>{p}</p>)}
      </div>
      <ul class="intro-tags" data-reveal aria-hidden="true">
        <li>strategy</li>
        <li>technology</li>
        <li>design</li>
        <li>we are here</li>
      </ul>
    </div>
  </section>

  <!-- SERVICES TEASER -->
  <section class="wrap services" id="services-content">
    <p class="eyebrow" data-reveal>What we do</p>
    <h2 data-reveal>Crafting UI, UX, and Brand Systems that drive meaning</h2>
    <p class="services-lede" data-reveal>
      In a world where the unexpected is becoming the norm, we build custom digital solutions
      through user experience design, delivering UX design services that are prepared for what is
      possible and what is probable. As a UI UX design agency, we craft experiences that adapt,
      evolve, and perform.
    </p>

    <ol class="service-cards">
      {teaserServices.map((s) => (
        <li class="service-card" data-reveal>
          <div class="service-card-media">
            <video muted loop playsinline preload="none" src={s.video}></video>
          </div>
          <div class="service-card-foot">
            <div class="service-card-heads">
              <span class="service-n">{s.n}</span>
              <h3>{s.title}</h3>
            </div>
          </div>
          <!-- Sits outside the footer: the footer is hidden while open, and
               the toggle has to stay reachable to close the card again. -->
          <button
            type="button"
            class="service-card-toggle"
            aria-expanded="false"
            aria-label={`Read more about ${s.title}`}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M8 1.5v13M1.5 8h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
          <div class="service-card-back" hidden>
            <span class="service-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </div>
        </li>
      ))}
    </ol>

    <a href="/services" class="btn btn-ghost">View Services</a>
  </section>

  <!-- WORK -->
  <section class="wrap work">
    <div class="work-head">
      <h2 data-reveal>Work that Leads with Clarity and Delivers with Impact</h2>
      <a href="/work" class="btn btn-ghost">View case studies</a>
    </div>

    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal>
          <a href={`/work/${w.slug}`}>
            <video autoplay muted loop playsinline src={w.video}></video>
            <p class="work-client">{w.client} — {w.category}</p>
            <h3>{w.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- PILLARS — glass showcase -->
  <section class="pillars" id="pillars">
    <div class="pillars-backdrop" aria-hidden="true">
      {pillars.map((p, i) => (
        <video
          class:list={['pillars-bg', { 'is-active': i === 0 }]}
          data-bg={i}
          muted loop playsinline preload="none"
          src={p.video}
        ></video>
      ))}
      <div class="pillars-scrim"></div>
    </div>

    <div class="wrap pillars-inner">
      <p class="eyebrow" data-reveal>How we think</p>
      <h2 data-reveal>Six pillars. Six questions worth answering properly.</h2>

      <ul class="glass-panel">
        {pillars.map((p, i) => (
          <li class:list={['pillar', { 'is-active': i === 0 }]} data-pillar={i}>
            <button type="button" class="pillar-hit" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="pillar-thumb">
                <video muted loop playsinline preload="none" src={p.video}></video>
              </span>
              <span class="pillar-copy">
                <span class="pillar-title">{p.title}</span>
                <span class="pillar-q">{p.q}</span>
              </span>
              <span class="pillar-index">{p.n} / 06</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLIENT LOGOS -->
  <section class="wrap logos">
    <p class="eyebrow" data-reveal>Trusted by leading brands</p>
    <ul class="logo-grid" data-reveal>
      {clientLogos.map((l) => (
        <li><img src={l.src} alt={l.name} loading="lazy" /></li>
      ))}
    </ul>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.75) 0%, rgba(10, 10, 12, 0.5) 45%, var(--bg) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: 5rem;
  }

  .hero-headline {
    font-size: var(--t-display);
    font-weight: 400;
    margin-block: 1rem 2rem;
    max-width: 16ch;
  }

  .hero-headline .word {
    display: inline-block;
    filter: blur(0px);
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 2;
    width: 1px;
    height: 3rem;
    background: var(--line);
    transform: translateX(-50%);
  }

  .intro {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .intro h2 {
    font-size: var(--t-h3);
    max-width: 20ch;
  }

  .intro-body {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .intro-body {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .intro-copy p + p {
    margin-top: 1rem;
  }

  .intro-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-content: flex-start;
  }

  .intro-tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.5rem 1rem;
    height: fit-content;
    color: var(--fg-muted);
  }

  .services {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .services h2 {
    font-size: var(--t-h3);
    max-width: 18ch;
    margin-top: 0.75rem;
  }

  .services-lede {
    max-width: 55ch;
    margin-top: 1.25rem;
  }

  /* Polaroid-style service cards — light frames that flip to a dark
     detail face when opened, matching the live site's block. */
  .service-cards {
    list-style: none;
    margin: 3rem 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .service-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .service-cards { grid-template-columns: repeat(4, 1fr); } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #f4f4f4;
    border-radius: var(--r-lg);
    padding: 0.75rem 0.75rem 0.25rem;
    min-height: 420px;
    transition: background 0.35s ease, transform 0.35s ease;
  }
  .service-card:hover { transform: translateY(-4px); }
  .service-card.is-open { background: var(--surface-2); }

  .service-card-media {
    flex: 1;
    border-radius: var(--r-md);
    overflow: hidden;
    background: #e4e4e4;
    transition: opacity 0.3s ease;
  }
  .service-card-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .service-card.is-open .service-card-media { display: none; }

  .service-card-foot {
    display: flex;
    align-items: center;
    /* room for the absolutely-positioned toggle */
    padding: 1rem 3.25rem 1rem 0.5rem;
  }
  .service-card.is-open .service-card-foot { display: none; }
  .service-card-heads .service-n { font-family: var(--font-mono); font-size: 0.85rem; color: #6b6b6b; }
  .service-card-heads h3 { font-size: var(--t-h4); font-weight: 400; line-height: var(--lh-tight); color: #191919; margin-top: 0.35rem; }

  .service-card-toggle {
    position: absolute;
    bottom: 1.35rem;
    right: 1.15rem;
    width: 2.25rem; height: 2.25rem;
    display: grid; place-items: center;
    border-radius: var(--r-pill);
    border: 0;
    background: rgba(0, 0, 0, 0.07);
    color: #191919;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.25s ease;
  }
  .service-card-toggle svg { width: 0.9rem; height: 0.9rem; fill: none; }
  .service-card-toggle:hover { background: rgba(0, 0, 0, 0.14); }
  .service-card-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .service-card.is-open .service-card-toggle {
    top: 1.25rem; bottom: auto; right: 1.25rem;
    background: rgba(255, 255, 255, 0.12);
    color: var(--fg);
    transform: rotate(45deg);
  }
  .service-card.is-open .service-card-toggle:hover { background: rgba(255, 255, 255, 0.2); }

  .service-card-back { padding: 1.5rem 1.25rem 1.75rem; }
  .service-card-back[hidden] { display: none; }
  .service-card-back .service-n { font-family: var(--font-mono); font-size: 0.85rem; color: var(--fg-subtle); }
  .service-card-back h3 { font-size: var(--t-h4); font-weight: 400; line-height: var(--lh-tight); color: var(--fg); margin-top: 0.35rem; }
  .service-card-back p { margin-top: 1rem; font-size: 0.95rem; line-height: 1.6; color: var(--fg-muted); }

  /* ── Glass showcase: rows on a frosted panel, floating over a heavily
     blurred blow-up of whichever pillar is active. Hovering a row expands
     it into a light card with its question and index. ───────────────── */
  .pillars {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }
  .pillars-backdrop { position: absolute; inset: 0; z-index: -1; }
  .pillars-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Scaled up so the blur has no soft edge at the section bounds */
    transform: scale(1.2);
    filter: blur(64px) saturate(1.35);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
  }
  .pillars-bg.is-active { opacity: 0.85; visibility: visible; }
  .pillars-scrim { position: absolute; inset: 0; background: rgba(5, 5, 5, 0.5); }

  .pillars-inner h2 { font-size: var(--t-h3); margin-top: 0.75rem; max-width: 22ch; }

  .glass-panel {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-radius: var(--r-xl);
    background: rgba(15, 15, 15, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(26px) saturate(1.3);
    -webkit-backdrop-filter: blur(26px) saturate(1.3);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
  }

  .pillar-hit {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.65rem;
    border: 0;
    border-radius: var(--r-md);
    background: transparent;
    color: var(--fg);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: background 0.45s cubic-bezier(0.16, 1, 0.3, 1), color 0.45s ease;
  }
  .pillar-hit:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .pillar-thumb {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: var(--r-md);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }
  .pillar-thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pillar-copy { display: block; min-width: 0; }
  .pillar-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 400;
    line-height: var(--lh-tight);
  }
  .pillar-q {
    display: block;
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    overflow: hidden;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #4a4a4a;
    transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease, margin-top 0.5s ease;
  }
  .pillar-index {
    position: absolute;
    top: 1rem;
    right: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: #6b6b6b;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .pillar.is-active .pillar-hit { background: #f4f4f4; color: #191919; }
  .pillar.is-active .pillar-q { max-height: 6rem; margin-top: 0.4rem; opacity: 1; }
  .pillar.is-active .pillar-index { opacity: 1; }
  .pillar:not(.is-active) .pillar-hit:hover { background: rgba(255, 255, 255, 0.07); }

  @media (max-width: 700px) {
    .pillars { padding-block: 4rem; }
    .glass-panel { border-radius: var(--r-lg); }
    .pillar-thumb { width: 62px; height: 62px; border-radius: var(--r); }
    .pillar-hit { gap: 0.9rem; }
    .pillar-index { display: none; }
    .pillar-q { font-size: 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-hit, .pillar-q, .pillar-index, .pillars-bg { transition: none; }
  }

  .work {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .work-head h2 {
    font-size: var(--t-h3);
    max-width: 22ch;
  }

  .work-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .work-grid a {
    text-decoration: none;
    display: block;
  }

  .work-grid video {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r);
  }

  .work-client {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 1rem;
  }

  .work-grid h3 {
    font-size: 1.15rem;
    font-weight: 400;
    margin-top: 0.4rem;
  }

  .logos {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }

  .logo-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  .logo-grid img {
    height: 32px;
    width: auto;
    filter: grayscale(1) brightness(1.6);
    opacity: 0.7;
  }

  .industries {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .industries h2 {
    font-size: var(--t-h3);
    max-width: 18ch;
  }

  .industries p {
    margin-top: 1.25rem;
    max-width: 55ch;
  }

  .industries .btn {
    margin-top: 1.5rem;
  }

  .industry-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .industry-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .industry-grid li {
    background: var(--bg);
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .blog-teaser {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }

  .blog-teaser ul {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-teaser ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-teaser li {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .blog-teaser .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
  }

  .blog-teaser a {
    text-decoration: none;
    color: var(--fg);
    font-size: 1.1rem;
  }

  .closing-cta {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .closing-cta h2 {
    font-size: var(--t-h2);
  }

  .closing-cta p {
    margin-top: 1rem;
  }

  .closing-cta .btn {
    margin-top: 2rem;
  }
</style>

<script>
  import { animate, stagger, inView } from 'motion';

  // Hero headline: split into words, reveal with blur + upward drift
  const headline = document.querySelector('[data-headline]');
  if (headline) {
    const text = headline.textContent ?? '';
    headline.innerHTML = text
      .split(' ')
      .map((w) => `<span class="word">${w}</span>`)
      .join(' ');

    animate(
      headline.querySelectorAll('.word'),
      { opacity: [0, 1], y: [24, 0], filter: ['blur(10px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.08), easing: [0.16, 1, 0.3, 1] }
    );
  }

  // Hero eyebrow + CTA reveal
  animate('[data-reveal]', { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, delay: 0.3, easing: 'ease-out' });

  // Scroll-triggered reveals with stagger
  inView('.service-card', (el) => {
    animate(el, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
  });

  inView('.work-grid li', (el) => {
    animate(el, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: stagger(0.08), easing: 'ease-out' });
  });

  inView('.industry-grid li, .blog-teaser li, .logo-grid li, .culture-grid li, .team-grid li, .why-grid li, .caps-grid .cap-item, .approach-step', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });

  // Service cards: hover plays the clip, the +/× button flips to the detail face
  document.querySelectorAll<HTMLLIElement>('.service-card').forEach((card) => {
    const video = card.querySelector('video');
    const toggle = card.querySelector<HTMLButtonElement>('.service-card-toggle');
    const back = card.querySelector<HTMLElement>('.service-card-back');

    if (video) {
      card.addEventListener('mouseenter', () => {
        if (card.classList.contains('is-open')) return;
        if (video.preload === 'none') video.preload = 'auto';
        video.play().catch(() => {});
      });
      card.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
    }

    if (toggle && back) {
      toggle.addEventListener('click', () => {
        const open = card.classList.toggle('is-open');
        back.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', `${open ? 'Close' : 'Read more about'} ${card.querySelector('h3')?.textContent ?? ''}`.trim());
        if (open && video) { video.pause(); video.currentTime = 0; }
      });
    }
  });

  // Glass showcase: hovering (or focusing/tapping) a pillar makes it the
  // active row and swaps the blurred backdrop. Only the active clips play.
  {
    const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.pillar'));
    const bgs = Array.from(document.querySelectorAll<HTMLVideoElement>('.pillars-bg'));
    let active = 0;

    const setActive = (i: number) => {
      if (i === active || !rows[i]) return;
      active = i;
      rows.forEach((row, n) => {
        const on = n === i;
        row.classList.toggle('is-active', on);
        row.querySelector('.pillar-hit')?.setAttribute('aria-expanded', String(on));
        const thumb = row.querySelector('video');
        if (thumb) {
          if (on) { if (thumb.preload === 'none') thumb.preload = 'auto'; thumb.play().catch(() => {}); }
          else { thumb.pause(); }
        }
      });
      bgs.forEach((bg, n) => {
        const on = n === i;
        bg.classList.toggle('is-active', on);
        if (on) { if (bg.preload === 'none') bg.preload = 'auto'; bg.play().catch(() => {}); }
        else { bg.pause(); }
      });
    };

    rows.forEach((row, i) => {
      const hit = row.querySelector<HTMLButtonElement>('.pillar-hit');
      if (!hit) return;
      hit.addEventListener('mouseenter', () => setActive(i));
      hit.addEventListener('focus', () => setActive(i));
      hit.addEventListener('click', () => setActive(i));
    });

    // Don't start any playback until the section is actually on screen.
    const section = document.querySelector('.pillars');
    if (section) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const idx = active;
          const play = e.isIntersecting;
          [bgs[idx], rows[idx]?.querySelector('video')].forEach((v) => {
            if (!v) return;
            if (play) { if (v.preload === 'none') v.preload = 'auto'; v.play().catch(() => {}); }
            else { v.pause(); }
          });
        });
      }, { rootMargin: '10% 0px' });
      io.observe(section);
    }
  }

  // Work card tilt effect
  document.querySelectorAll('.work-grid a').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });
</script>
