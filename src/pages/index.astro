---
// Dynamic (default under output: 'server') — the personalization hook
// stays available for later, just not driving the primary headline
// (would fight the actual brand thesis statement below).
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { servicesListQuery, caseStudiesListQuery, postsListQuery, singletonPageQuery } from '../lib/queries';
import { SERVICE_TAGS } from '../lib/service-tags-data';

const services = await sanityClient.fetch(servicesListQuery).catch(() => []);

// Fetch Sanity data for homepage sections
const rawHomeCases = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const seenHomeCases = new Set();
const sanityCaseStudies = [];
for (const cs of (rawHomeCases || [])) {
  if (cs && cs.slug && !seenHomeCases.has(cs.slug)) {
    seenHomeCases.add(cs.slug);
    sanityCaseStudies.push(cs);
  }
}

const rawHomePosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const seenHomePosts = new Set();
const sanityPosts = [];
for (const p of (rawHomePosts || [])) {
  if (p && p.slug && !seenHomePosts.has(p.slug)) {
    seenHomePosts.add(p.slug);
    sanityPosts.push(p);
  }
}

// Hero headline + intro
const homePage = await sanityClient.fetch(singletonPageQuery, { pageId: 'home' }).catch(() => null);
const headlineText = homePage?.title ?? 'Where Vision Meets Velocity';
const introParas: string[] = (homePage?.body ?? [])
  .map((b: any) => b?.children?.[0]?.text)
  .filter(Boolean);
const fallbackIntro = [
  'Wugweb is a digital experience agency where design meets engineering to shape what is next. We deliver tailored UX design services, rooted in user-centered design and driven by a clear user experience strategy.',
  'Our experience design services and custom UX solutions help businesses craft impactful digital product design with precision. As a UI/UX-focused agency, we create digital experiences that not only look great but also perform with purpose.',
];
const intro = introParas.length ? introParas : fallbackIntro;
const homeTitle = homePage?.seoTitle || 'Wugweb — Digital Experience Agency';
const homeDescription =
  homePage?.seoDescription ||
  'Wugweb is a digital experience agency crafting brand strategy, UX design, martech, AI, and web development for ambitious teams.';


// Pillar questions + draggable-tag layout now live in
// src/lib/service-tags-data.ts (SERVICE_TAGS), shared with Storybook.

// Curated homepage case-study picks — prefer mapped thumbnailPath
const thumbAssets = await sanityClient.fetch(
  '*[_type == "asset" && usage == "Thumbnail"]{relativePath, sitePath, name}'
).catch(() => []);

function findThumb(slug: string, thumbnailPath?: string) {
  if (thumbnailPath) return thumbnailPath.startsWith('/') ? thumbnailPath : `/${thumbnailPath}`;
  const norm = slug?.toLowerCase().replace(/[^a-z0-9]/g, '') || '';
  for (const a of thumbAssets) {
    const p = (a.relativePath || a.sitePath || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    const n = (a.name || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    if (p.includes(norm) || n.includes(norm)) return a.sitePath || '/assets/' + a.relativePath;
  }
  return '';
}

const workItems = (sanityCaseStudies || []).slice(0, 8).map((cs: any) => ({
  client: cs.client || '',
  category: (cs.disciplines || []).join(', ') || '',
  title: cs.title,
  slug: cs.slug,
  video: findThumb(cs.slug, cs.thumbnailPath),
}));

// Local client logos copied from public/assets/framer/*/client-logo-*.
// Verified 19 available; 13 curated for the homepage grid. Now sourced
// from Sanity client.logoPath (fallback to the curated set if empty).
const curatedLogos = [
  { name: 'Aditya Birla Capital', src: '/assets/logos/client-logo-te1y.png' },
  { name: 'Airtel', src: '/assets/logos/client-logo-c6rj.png' },
  { name: 'Axis Bank', src: '/assets/logos/client-logo-d64b.png' },
  { name: 'Bankco', src: '/assets/logos/client-logo-qhmv.png' },
  { name: 'Cartier', src: '/assets/logos/client-logo-jrot.png' },
  { name: 'Gratifi', src: '/assets/logos/client-logo-5nzb.png' },
  { name: 'IndusInd Bank', src: '/assets/logos/client-logo-k5hy.png' },
  { name: 'Inkompass', src: '/assets/logos/client-logo-9fd5.png' },
  { name: 'Kia', src: '/assets/logos/client-logo-5nkj.png' },
  { name: 'NTUC', src: '/assets/logos/client-logo-grfk.png' },
  { name: 'Plufo', src: '/assets/logos/client-logo-6djh.png' },
  { name: 'RideEV', src: '/assets/logos/client-logo-1gbn.png' },
  { name: 'Valyu', src: '/assets/logos/client-logo-jj6k.png' },
];
const sanityLogos = await sanityClient
  .fetch('*[_type == "client" && defined(logoPath)]{name, logoPath} | order(name asc)')
  .catch(() => []);
const realLogos = (sanityLogos as any[]).length
  ? (sanityLogos as any[]).map((c: any) => ({ name: c.name, src: c.logoPath }))
  : curatedLogos;

// Padding to a full grid, the split-at-14 layout math, and mockup-repeat
// marking now live in ClientAssemblyGrid.astro — this only needs to hand it
// the real (unpadded) logo set.

// Industries — sourced from the Sanity industry master (Global Settings);
// fallback to the curated grid if the query comes back empty.
const curatedIndustries = [
  'Government', 'Insurtech', 'Travel', 'Logistics', 'Automotive',
  'Fintech', 'Edtech', 'Sports', 'E-commerce', 'Media', 'Energy', 'NGOs',
];
const sanityIndustries = (await sanityClient
  .fetch('*[_type == "industry"] | order(order asc) { name }[0..23]')
  .catch(() => [])).map((i: any) => i.name);
const industries = (sanityIndustries as string[]).length
  ? (sanityIndustries as string[])
  : curatedIndustries;
import InsightsBlock from '../components/InsightsBlock.astro';
import ClientAssemblyGrid from '../components/ClientAssemblyGrid.astro';
import ServiceTagField from '../components/ServiceTagField.astro';
---

{/* This page carries its own Insights and Industries blocks, so the global
    "Some of our recent thoughts" and "Industries We Empower" sections in
    BaseLayout would render as duplicates directly beneath them. */}
<BaseLayout
  title={homeTitle}
  description={homeDescription}
  hideGlobalBlog={true}
  hideGlobalIndustries={true}
>
  <!-- HERO -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="none"
      src="/assets/more/home/home.mp4"></video>
    <div class="hero-overlay"></div>

    <div class="wrap hero-content">
      <p class="eyebrow" data-reveal>A world-class digital experience agency</p>
      <h1 class="hero-headline t-display" data-headline>{headlineText}</h1>
      <div class="hero-ctas" data-reveal>
        <a href="#services-content" class="btn btn-ghost">Explore Wugweb</a>
        <a href="/contact-us" class="btn btn-solid">Get in Touch</a>
      </div>
    </div>

    <div class="scroll-cue" data-reveal aria-hidden="true"></div>
  </section>

  <!-- INTRO -->
  <section class="wrap intro" data-scroll="rise">
    <h2 data-reveal>Wugweb is a tight team of thoughtful creatives, engineers, and strategists</h2>
    <div class="intro-body">
      <div class="intro-copy" data-reveal>
        {intro.map((p) => <p>{p}</p>)}
      </div>
      <ul class="intro-tags" data-reveal aria-hidden="true">
        <li>strategy</li>
        <li>technology</li>
        <li>design</li>
        <li>we are here</li>
      </ul>
    </div>
  </section>

  <!-- SERVICES TEASER -->
  <section class="wrap services" id="services-content" data-scroll="rise">
    <p class="eyebrow" data-reveal>What we do</p>
    <h2 data-reveal>Crafting UI, UX, and Brand Systems that drive meaning</h2>
    <p class="services-lede" data-reveal>
      In a world where the unexpected is becoming the norm, we build custom digital solutions
      through user experience design, delivering UX design services that are prepared for what is
      possible and what is probable. As a UI UX design agency, we craft experiences that adapt,
      evolve, and perform.
    </p>

    {/* Draggable tag field — one tag per pillar. Fly in on scroll, drag freely
        with momentum, tap to expand. Now its own component: ServiceTagField.astro */}
    <ServiceTagField tags={SERVICE_TAGS} />

    <a href="/services" class="btn btn-ghost">View Services</a>
  </section>

  <!-- WORK -->
  <section class="wrap work" data-scroll="rise">
    <div class="work-head">
      <h2 data-reveal>Work that Leads with Clarity and Delivers with Impact</h2>
      <a href="/work" class="btn btn-ghost">View case studies</a>
    </div>

    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal>
          <a href={`/work/${w.slug}`}>
            <video autoplay muted loop playsinline preload="none" src={w.video}></video>
            <p class="work-client">{w.client} — {w.category}</p>
            <h3>{w.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>


  <!-- CLIENT LOGOS -->
  <ClientAssemblyGrid logos={realLogos} />

  <!-- INDUSTRIES WE EMPOWER -->
  <section class="industries-section" data-scroll="rise">
    <div class="wrap industries-head">
      <p class="eyebrow" data-reveal>Industries We Empower</p>
      <h2 data-reveal>We understand the context behind the product.</h2>
      <p data-reveal>From regulated sectors to fast-moving consumer markets, our experience spans industries that demand precision and creativity in equal measure.</p>
    </div>
    <div class="industries-marquee-wrap" aria-hidden="true">
      <div class="industries-marquee">
        {[...industries, ...industries].map((ind) => (
          <span class="ind-pill">{ind}</span>
        ))}
      </div>
    </div>
    <div class="wrap">
      <a href="/footer/industries" class="btn btn-ghost" data-reveal>Explore All Industries</a>
    </div>
  </section>

  <!-- BLOG TEASER -->
  {sanityPosts.length > 0 && (
    <InsightsBlock posts={sanityPosts} />
  )}

  <!-- CLOSING CTA -->
</BaseLayout>

<style>
  .hero {
    position: relative;
    /* The sticky header sits IN FLOW above this section, so a flat 100svh made
       the hero end one header-height below the fold - pushing both hero CTAs
       off the first screen (measured: buttons at 921px in an 891px viewport).
       Subtracting the header's own flow height is what makes "full screen"
       actually mean the screen. --nav-height + --gap-4 is the header's padding
       box; --safe-top is added to it under viewport-fit=cover. */
    min-height: calc(100svh - var(--nav-height) - var(--gap-4) - var(--safe-top));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--hero-overlay) 0%, var(--hero-overlay-mid) 45%, var(--bg) 100%);
    z-index: var(--z-overlay);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: var(--space-section-xl);
  }

  .hero-headline {
    font-weight: var(--font-weight-extrabold);
    margin-block: var(--gap-4) var(--gap-8);
    max-width: 16ch;
  }

  .hero-headline .word {
    display: inline-block;
    filter: blur(0px);
  }

  .hero-ctas {
    display: flex;
    gap: var(--gap-4);
    flex-wrap: wrap;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--gap-8);
    z-index: var(--z-overlay);
    width: 1px;
    height: var(--space-section-lg);
    background: var(--line);
    transform: translateX(-50%);
  }

  .intro {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }

  .intro h2 {
    font-size: var(--t-h3);
    max-width: 20ch;
  }

  .intro-body {
    display: grid;
    gap: var(--gap-10);
    margin-top: var(--gap-10);
  }

  @media (min-width: 900px) {
    .intro-body {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .intro-copy p + p {
    margin-top: var(--gap-4);
  }

  .intro-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
    align-content: flex-start;
  }

  .intro-tags li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--r-pill);
    padding: var(--gap-2) var(--gap-4);
    height: fit-content;
    color: var(--fg-muted);
  }

  .services {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }

  .services h2 {
    font-size: var(--t-h3);
    max-width: 18ch;
    margin-top: var(--gap-3);
  }

  .services-lede {
    max-width: 55ch;
    margin-top: var(--gap-5);
  }

  /* Kept from the removed pillar block: still applies to the remaining
     .glass-panel users on this page at small widths. */
  @media (max-width: 700px) { .glass-panel { border-radius: var(--radius-lg); } }

  .work {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-6);
  }

  .work-head h2 {
    font-size: var(--t-h3);
    max-width: 22ch;
  }

  .work-grid {
    list-style: none;
    margin: var(--gap-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--gap-8);
  }

  @media (min-width: 768px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  .work-grid a { text-decoration: none; display: block; }
  .work-grid video { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--r-2); }
  .work-client { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); margin-top: var(--gap-4); }
  .work-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); }

  /* .tag-field / .tag / .tag-* rules moved to ServiceTagField.astro's
     own scoped style (2026-09-16) — this page only renders
     <ServiceTagField> now. */


  /* .logos-band / .logo-grid / .logo-tile rules moved to
     ClientAssemblyGrid.astro's own scoped style (2026-09-16) — this
     page only renders <ClientAssemblyGrid> now. */


  /* ── Industries We Empower ── */
  .industries-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
    overflow: hidden;
  }
  .industries-head {
    margin-bottom: var(--gap-12);
  }
  .industries-head h2 { font-size: var(--t-h3); max-width: 20ch; margin-top: var(--gap-4); }
  .industries-head p { margin-top: var(--gap-5); max-width: 55ch; color: var(--fg-muted); }
  .industries-head .btn { margin-top: var(--gap-6); }

  .industries-marquee-wrap {
    position: relative;
    overflow: hidden;
    padding-block: var(--gap-6);
    margin-bottom: var(--gap-10);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .industries-marquee {
    display: flex;
    gap: var(--gap-4);
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .industries-marquee { animation: none; flex-wrap: wrap; width: auto; }
  }

  .ind-pill {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: var(--gap-3) var(--gap-6);
    border-radius: var(--r-pill);
    border: var(--stroke-thin) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--fg-muted);
    background: var(--neutral-1);
    transition: border-color 0.3s ease, color 0.3s ease;
    cursor: default;
  }

  .ind-pill:hover {
    border-color: var(--color-accent-primary);
    color: var(--fg);
  }

  /* ── Blog Teaser ── */

</style>

<script>
  import gsap from 'gsap';

  // Hero headline: split into words, reveal with blur + upward drift
  const headline = document.querySelector('[data-headline]');
  if (headline && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const text = headline.textContent ?? '';
    headline.innerHTML = text
      .split(' ')
      .map((w) => `<span class="word">${w}</span>`)
      .join(' ');

    gsap.fromTo(
      headline.querySelectorAll('.word'),
      { opacity: 0, y: 24, filter: 'blur(10px)' },
      { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.8, stagger: 0.08, ease: 'power3.out' }
    );
  }



  // Work card tilt effect
  document.querySelectorAll('.work-grid a').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });


  // Draggable service tags now init from ServiceTagField.astro's own script.
</script>
