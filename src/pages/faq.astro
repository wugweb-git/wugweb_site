---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery } from '../lib/queries';

const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'faq' }).catch(() => null);

const fallbackFaqs = [
  { q: "What services does Wugweb offer?", a: "Wugweb offers a comprehensive range of services including Brand & Strategy, Experience Design, Martech & Gen AI, Web Development, QA & Testing, and No-Code Development." },
  { q: "What makes your UI/UX design services stand out?", a: "Our UI/UX design services are rooted in user-centered design, combining human-centered design principles with strategic focus on customer experience and end-to-end user journey design." },
  { q: "Do you provide custom brand identity design and positioning?", a: "Yes, as a brand strategy consulting agency, we craft transformative brand experiences including brand identity design, brand narrative development, and comprehensive brand positioning and strategy." },
  { q: "What kind of platforms do you develop under web and app development?", a: "We build responsive websites, ecommerce platforms, and custom web applications using full-stack development, CMS integration, and mobile-first design." },
  { q: "How do you integrate MarTech and AI into your services?", a: "We blend digital experience strategy with AI-powered marketing and generative AI, helping brands automate, personalize, and optimize user journeys across channels." },
  { q: "Do you offer no-code development for fast launch?", a: "Yes, we empower businesses to launch digital products faster through no-code solutions including Webflow, Bubble, Outsystems, and Mendix development." },
  { q: "How do your QA and testing services ensure product quality?", a: "Our QA services safeguard digital products through rigorous functional testing, usability testing, and performance testing to ensure the highest standards of quality and reliability." },
  { q: "What is the typical timeline for a project?", a: "Timelines vary by scope. A typical brand strategy engagement runs 4-8 weeks, while web development projects range from 8-16 weeks depending on complexity." },
  { q: "How do you charge for your services?", a: "We offer project-based pricing for defined scopes and retainer-based partnerships for ongoing work. Contact us for a custom proposal tailored to your needs." },
  { q: "Do you work with startups?", a: "Yes, we work with companies of all sizes — from early-stage startups to enterprise organizations. Our Start Smart, Start Small approach is designed for growing businesses." },
];

const fromSanity = (page?.items || [])
  .map((f: any) => ({
    q: f.q || f.title,
    a: f.a || f.text,
  }))
  .filter((f: any) => f.q && f.a);
const faqItems = fromSanity.length ? fromSanity : fallbackFaqs;
const pageTitle = page?.seoTitle || page?.title || 'Frequently Asked Questions';
const pageDescription =
  page?.seoDescription ||
  'Frequently asked questions about working with Wugweb.';
const pageBody = page?.body?.[0]?.children?.[0]?.text || 'To help you get the information you need quickly, we\'ve compiled a list of frequently asked questions. If you don\'t find the answer you\'re looking for, please feel free to contact us directly.';
const displayH1 = page?.title?.replace(/\s*—\s*Wugweb$/i, '') || 'Frequently Asked Questions';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<BaseLayout noIndex={page?.noIndex} ogTitle={page?.ogTitle} ogDescription={page?.ogDescription} title={pageTitle} description={pageDescription}>
  <section class="wrap faq" id="faq" aria-labelledby="faq-title">
    
    <h1 class="page-title" data-reveal id="faq-title">{displayH1}</h1>
    <p class="faq-lede" data-reveal>{pageBody}</p>
    <p class="faq-updated" data-reveal>Updated on November 04, 2025</p>

    <div class="faq-accordion-wrap" data-reveal>
      <FaqAccordion items={faqItems} />
    </div>

  </section>
</BaseLayout>

<style>
  /* The 800px cap was on the section, so this page's title started 240px
     further in than every other page's. Measure belongs on the reading column,
     not on the whole page. */
  .faq { padding-block: var(--space-page-head) var(--space-section-xl); }
  .faq-lede, .faq-updated { max-width: 55ch; }
  .faq-accordion-wrap { max-width: 52rem; }
  .faq h1 { margin-block: var(--gap-3) var(--gap-5); max-width: 16ch; }
  .faq-lede { line-height: var(--core-line-height-relaxed); }
  .faq-updated { font-family: var(--font-mono); font-size: var(--t-sm); color: var(--fg-muted); margin-top: var(--gap-2); }
  .faq-accordion-wrap { margin-top: var(--gap-10); max-width: 52rem; }
</style>

