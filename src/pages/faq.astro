---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery } from '../lib/queries';

const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'faq' }).catch(() => null);
const faqs: { title: string; text: string }[] = page?.items ?? [];
---

<BaseLayout title="FAQs" description="Frequently asked questions about working with Wugweb.">
  <section class="wrap faq">
    <p class="eyebrow">FAQs</p>
    <h1>{page?.title ?? 'Frequently Asked Questions'}</h1>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.title}</summary>
          <p>{f.text?.trim() ? f.text : 'Answer coming soon.'}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    padding-block: 8rem;
  }
  .faq h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-block: 0.75rem 3rem;
    max-width: 20ch;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding-block: 1.25rem;
  }
  .faq-item summary {
    font-family: var(--font-display);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .faq-item p {
    margin-top: 0.75rem;
  }
</style>
