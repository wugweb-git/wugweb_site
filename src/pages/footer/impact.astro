---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Built from what you described (3 CSR activities + contact banner), NOT
// from the live /footer/impact page — that page is currently broken on
// the Framer site (duplicated homepage sections, all stats show
// placeholder "0+"/"0%"). Activity copy below is a placeholder — send
// the real 3 activities and I'll swap it in.
const activities = [
  { title: 'Activity one', copy: 'Placeholder — send the real detail for this.' },
  { title: 'Activity two', copy: 'Placeholder — send the real detail for this.' },
  { title: 'Activity three', copy: 'Placeholder — send the real detail for this.' },
];
---

<BaseLayout title="Impact">
  <section class="wrap impact">
    <p class="eyebrow">Impact</p>
    <h1>What we've done for society</h1>

    <ul class="activities">
      {activities.map((a, i) => (
        <li>
          <span class="activity-n">0{i + 1}</span>
          <h2>{a.title}</h2>
          <p>{a.copy}</p>
        </li>
      ))}
    </ul>

    <div class="cta-banner">
      <h2>Let's create something remarkable together.</h2>
      <a href="/contact-us" class="btn btn-solid">Contact Wugweb</a>
    </div>
  </section>
</BaseLayout>

<style>
  .impact {
    padding-block: 8rem;
  }
  .impact h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-block: 0.75rem 3rem;
    max-width: 20ch;
  }
  .activities {
    list-style: none;
    margin: 0 0 5rem;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .activities {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .activities li {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .activity-n {
    font-family: var(--font-mono);
    color: var(--accent-warm);
  }
  .activities h2 {
    font-size: 1.25rem;
    margin-top: 0.75rem;
    font-weight: 500;
  }
  .activities p {
    margin-top: 0.5rem;
  }
  .cta-banner {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta-banner h2 {
    font-size: 1.75rem;
    max-width: 20ch;
  }
</style>
