---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Built from what you described (3 CSR activities + contact banner), NOT
// from the live /footer/impact page — that page is currently broken on
// the Framer site (duplicated homepage sections, all stats show
// placeholder "0+"/"0%"). Activity copy below is a placeholder — send
// the real 3 activities and I'll swap it in.
// Impact/CSR activities — the live site currently shows generic brand
// content here (not actual impact data). When you have real CSR activity
// details, replace these entries.
const activities = [
  { title: 'Community Upskilling', copy: 'Empowering local communities through digital skills training and mentorship programs, bridging the technology gap for underrepresented groups.' },
  { title: 'Sustainable Design', copy: 'Promoting environmentally conscious design practices and reducing digital waste through efficient, sustainable development methodologies.' },
  { title: 'Social impact partnerships', copy: 'Collaborating with non-profits and social enterprises to provide pro-bono design and technology consulting for mission-driven organizations.' },
];
---

<BaseLayout title="Impact">
  <section class="wrap impact">
    <p class="eyebrow">Impact</p>
    <h1>What we've done for society</h1>

    <ul class="activities">
      {activities.map((a, i) => (
        <li>
          <span class="activity-n">0{i + 1}</span>
          <h2>{a.title}</h2>
          <p>{a.copy}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .impact {
    padding-block: 8rem;
  }
  .impact h1 {
    font-size: var(--t-h2);
    margin-block: 0.75rem 3rem;
    max-width: 20ch;
  }
  .activities {
    list-style: none;
    margin: 0 0 5rem;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .activities {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .activities li {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .activity-n {
    font-family: var(--font-mono);
    color: var(--accent-warm);
  }
  .activities h2 {
    font-size: var(--t-l);
    margin-top: 0.75rem;
    font-weight: 400;
  }
  .activities p {
    margin-top: 0.5rem;
  }
  .cta-banner {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta-banner h2 {
    font-size: var(--t-h4);
    max-width: 20ch;
  }
</style>
