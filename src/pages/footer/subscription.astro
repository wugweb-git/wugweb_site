    border-radius: var(--radius-2);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .btn-demo-trigger:hover {
    background-color: var(--color-accent-primary);
    color: var(--neutral-10);
  }

  .interactive-queue-box {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
  }

  .iq-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--p-3) var(--p-4);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-2);
    background-color: var(--color-surface-page);
    transition: all 0.3s ease;
  }

  .iq-status {
    width: 2ch;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
  }

  .iq-title {
    flex-grow: 1;
    font-size: var(--fluid-body-sm);
    color: var(--color-text-secondary);
  }

  .iq-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 2px 6px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.02);
    color: var(--color-text-muted);
  }

  .iq-row.completed {
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.01);
  }
  .iq-row.completed .iq-status { color: var(--color-text-muted); }
  .iq-row.completed .iq-title { color: var(--color-text-muted); text-decoration: line-through; }

  .iq-row.active {
    border-color: var(--color-accent-primary);
    background-color: rgba(255, 190, 26, 0.02);
  }
  .iq-row.active .iq-status { color: var(--color-accent-primary); }
  .iq-row.active .iq-title { color: var(--color-text-primary); font-weight: var(--font-weight-medium); }
  .iq-row.active .iq-tag { background-color: var(--color-accent-primary); color: var(--neutral-10); }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 4 — CAPABILITIES SELECTOR
     ───────────────────────────────────────────────────────────────────── */
  .capabilities-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .capabilities-interactive {
    display: flex;
    flex-direction: column;
    gap: var(--gap-8);
  }

  .capabilities-selector {
    display: flex;
    overflow-x: auto;
    border-bottom: var(--stroke-thin) solid var(--color-border-subtle);
    padding-bottom: var(--p-3);
    gap: var(--gap-6);
    scrollbar-width: none; /* Hide scrollbar for clean UI */
  }

  .capabilities-selector::-webkit-scrollbar {
    display: none;
  }

  .selector-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fluid-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    cursor: pointer;
    padding-bottom: var(--p-2);
    position: relative;
    white-space: nowrap;
    transition: color 0.3s;
  }

  .selector-btn:hover {
    color: var(--color-text-secondary);
  }

  .selector-btn.active {
    color: var(--color-accent-primary);
  }

  .selector-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent-primary);
  }

  .capabilities-viewport {
    position: relative;
  }

  .cap-content-pane {
    display: none;
    grid-template-columns: 1fr;
    gap: var(--gap-8);
    align-items: center;
  }

  .cap-content-pane.active {
    display: grid;
    animation: fadeIn 0.4s ease forwards;
  }

  @media (min-width: 1024px) {
    .cap-content-pane {
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-12);
    }
  }

  .pane-copy h3 {
    font-size: var(--fluid-h3);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--gap-4);
  }

  .pane-copy p {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    max-width: 45ch;
  }

  .pane-visual .visual-container {
    background-color: var(--neutral-8);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 5 — REQUEST EXPLORER
     ───────────────────────────────────────────────────────────────────── */
  .explorer-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .explorer-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3);
    margin-bottom: var(--gap-8);
  }

  .filter-btn {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    padding: var(--p-3) var(--p-5);
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    border-radius: var(--radius-2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-text-secondary);
  }

  .filter-btn.active {
    background-color: var(--color-accent-primary);
    color: var(--neutral-10);
    border-color: var(--color-accent-primary);
  }

  .explorer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-3);
  }

  @media (min-width: 640px) {
    .explorer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .explorer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .explorer-item {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    padding: var(--p-5) var(--p-6);
    border-radius: var(--radius-3);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--fluid-body-md);
    font-weight: var(--font-weight-medium);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.3s, transform 0.3s;
  }

  .explorer-item:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .item-arrow {
    color: var(--color-text-muted);
    transition: transform 0.2s;
  }

  .explorer-item:hover .item-arrow {
    transform: translateX(4px);
    color: var(--color-accent-primary);
  }

  /* Drawer CSS */
  .explorer-drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: none;
    justify-content: flex-end;
  }

  .explorer-drawer-overlay.active {
    display: flex;
  }

  .explorer-drawer {
    width: 100%;
    max-width: 500px;
    background-color: var(--neutral-9);
    border-left: var(--stroke-thin) solid var(--color-border-subtle);
    padding: var(--p-8);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    animation: slideIn 0.3s ease-out forwards;
  }

  @keyframes slideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: var(--stroke-thin) solid var(--color-border-subtle);
    padding-bottom: var(--p-5);
    margin-bottom: var(--p-6);
  }

  .drawer-header h3 {
    font-size: var(--fluid-h3);
    font-weight: var(--font-weight-bold);
  }

  .btn-close-drawer {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  .drawer-desc {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    margin-bottom: var(--gap-8);
  }

  .drawer-meta-section {
    margin-bottom: var(--gap-6);
  }

  .drawer-meta-section h4 {
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    color: var(--color-accent-primary);
    text-transform: uppercase;
    margin-bottom: var(--gap-2);
  }

  .drawer-meta-section p {
    font-size: var(--fluid-body-md);
    color: var(--color-text-primary);
  }

  .drawer-disclaimer {
    font-size: var(--fluid-caption);
    color: var(--color-text-muted);
    margin-top: auto;
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
    padding-top: var(--p-4);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 6 — SPEED TIMELINE
     ───────────────────────────────────────────────────────────────────── */
  .speed-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .speed-inner {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .speed-lede {
    font-size: var(--fluid-h3);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--gap-4);
  }

  .speed-body {
    font-size: var(--fluid-body-md);
    color: var(--color-text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--gap-10);
  }

  .timeline-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-4);
    margin-top: var(--gap-8);
  }

  @media (min-width: 768px) {
    .timeline-visual {
      flex-direction: row;
      justify-content: space-between;
      gap: 0;
    }
  }

  .timeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2);
    z-index: 2;
  }

  .node-bullet {
    width: 12px;
    height: 12px;
    background-color: var(--color-accent-primary);
    border-radius: var(--r-full);
  }

  .timeline-node h4 {
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-secondary);
  }

  .timeline-line {
    width: 2px;
    height: 24px;
    background-color: var(--color-border-subtle);
    z-index: 1;
  }

  @media (min-width: 768px) {
    .timeline-line {
      width: 100%;
      height: 2px;
      flex-grow: 1;
      margin-inline: -10px;
    }
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 7 — INCLUDED & CHECKLIST
     ───────────────────────────────────────────────────────────────────── */
  .included-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .included-grid {
    display: grid;
    gap: var(--gap-8);
  }

  @media (min-width: 1024px) {
    .included-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-12);
      align-items: center;
    }
  }

  .included-header h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--gap-4);
    margin-bottom: var(--gap-6);
  }

  .included-lede {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    max-width: 42ch;
  }

  .included-checklist ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--gap-4);
  }

  @media (min-width: 640px) {
    .included-checklist ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  .included-checklist li {
    font-size: var(--fluid-body-md);
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: var(--gap-3);
  }

  .check-mark {
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-bold);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 8 — BOUNDARIES ACCORDION
     ───────────────────────────────────────────────────────────────────── */
  .boundaries-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .boundaries-accordion, .faq-accordion {
    max-width: 800px;
    margin-inline: auto;
    margin-bottom: var(--gap-8);
  }

  .accordion-item, .faq-item {
    border-bottom: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .accordion-header, .faq-header {
    width: 100%;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--p-5) 0;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--fluid-body-lg);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    text-align: left;
  }

  .accordion-header:hover, .faq-header:hover {
    color: var(--color-accent-primary);
  }

  .accordion-icon, .faq-icon {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    transition: transform 0.3s;
  }

  .accordion-panel, .faq-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
  }

  .accordion-panel p, .faq-panel p {
    padding-bottom: var(--p-5);
    font-size: var(--fluid-body-md);
    line-height: var(--lh-body);
    color: var(--color-text-secondary);
    max-width: 70ch;
  }

  .accordion-item.active .accordion-panel, .faq-item.active .faq-panel {
    max-height: 1000px;
    transition: max-height 0.3s cubic-bezier(1, 0, 1, 0);
  }

  .accordion-item.active .accordion-icon, .faq-item.active .faq-icon {
    transform: rotate(45deg);
    color: var(--color-accent-primary);
  }

  .boundaries-footer {
    text-align: center;
    font-size: var(--fluid-body-sm);
    color: var(--color-text-muted);
    margin-top: var(--gap-6);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 9 — PRICING
     ───────────────────────────────────────────────────────────────────── */
  .pricing-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .pricing-card {
    background-color: var(--neutral-8);
    border: var(--stroke-regular) solid var(--color-border-subtle);
    border-radius: var(--radius-5);
    padding: var(--p-8);
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: border-color 0.3s ease;
  }

  .pricing-card:hover {
    border-color: var(--color-accent-primary);
  }

  .pricing-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-primary);
  }

  .pricing-row-main {
    margin-block: var(--gap-4) var(--gap-8);
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: var(--gap-1);
  }

  .pricing-card .price-val {
    font-size: clamp(3rem, 5vw + 1rem, 5rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.02em;
  }

  .pricing-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--gap-8);
    display: flex;
    flex-direction: column;
    gap: var(--gap-3);
    text-align: left;
    max-width: 320px;
    margin-inline: auto;
  }

  .pricing-benefits li {
    font-size: var(--fluid-body-md);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--gap-3);
  }

  .pricing-benefits li::before {
    content: '✓';
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-bold);
  }

  .pricing-cta-box {
    display: flex;
    justify-content: center;
    gap: var(--gap-4);
    margin-bottom: var(--gap-6);
  }

  .pricing-footer-link {
    font-size: var(--fluid-body-sm);
    color: var(--color-text-secondary);
  }

  .pricing-footer-link a {
    color: var(--color-accent-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 13 — PAUSE / CANCEL CONTROLS
     ───────────────────────────────────────────────────────────────────── */
  .pause-cancel-section {
    padding-block: var(--space-section-md);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .pc-inner {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-4);
    padding: var(--p-6) var(--p-8);
    display: flex;
    flex-direction: column;
    gap: var(--gap-4);
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .pc-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      flex-wrap: wrap;
    }
  }

  .pc-header h3 {
    font-size: var(--fluid-h4);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--gap-1);
  }

  .pc-header p {
    font-size: var(--fluid-body-sm);
    color: var(--color-text-muted);
  }

  .pc-status-display {
    display: flex;
    align-items: center;
    gap: var(--gap-2);
    font-family: var(--font-mono);
    font-size: var(--fluid-body-sm);
  }

  .status-badge {
    background-color: var(--color-accent-primary);
    color: var(--neutral-10);
    padding: 3px var(--gap-2);
    border-radius: var(--r-1);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
  }

  .pc-actions {
    display: flex;
    gap: var(--gap-3);
  }

  .pc-notice {
    width: 100%;
    font-size: var(--fluid-caption);
    color: var(--color-text-muted);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
    padding-top: var(--p-3);
    margin-top: var(--gap-1);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 14 — FAQ (ACCORDION)
     ───────────────────────────────────────────────────────────────────── */
  .faq-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 15 — FINAL CTA
     ───────────────────────────────────────────────────────────────────── */
  .final-cta {
    padding-top: var(--space-section-xl);
    padding-bottom: var(--space-section-md);
  }

  .final-inner {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-5);
    padding: var(--p-8) var(--p-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 768px) {
    .final-inner {
      padding: var(--p-12);
    }
  }

  .final-inner h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin-bottom: var(--gap-4);
    max-width: 25ch;
  }

  .final-inner p {
    font-size: var(--fluid-body-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--gap-8);
    max-width: 45ch;
    line-height: var(--lh-xl);
  }

  .final-actions {
    display: flex;
    gap: var(--gap-4);
  }

  /* ─────────────────────────────────────────────────────────────────────
     PAYMENT GATEWAY / CHECKOUT & ONBOARDING MODAL
     ───────────────────────────────────────────────────────────────────── */
  .checkout-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.85);
    z-index: 2000;
    display: none;
    justify-content: center;
    align-items: center;
    padding: var(--p-4);
  }

  .checkout-modal-overlay.active {
    display: flex;
  }

  .checkout-modal {
    background-color: var(--neutral-9);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-5);
    width: 100%;
    max-width: 520px;
    padding: var(--p-8);
    position: relative;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8);
    max-height: 90vh;
    overflow-y: auto;
  }

  .btn-close-modal {
    position: absolute;
    top: var(--p-6);
    right: var(--p-6);
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: 1.75rem;
    cursor: pointer;
    line-height: 1;
    z-index: 10;
  }

  .checkout-step {
    display: none;
  }

  .checkout-step.active {
    display: block;
    animation: fadeIn 0.3s ease forwards;
  }

  .checkout-step h3 {
    font-size: var(--fluid-h4);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--gap-6);
  }

  .checkout-plan-summary {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    padding: var(--p-6);
    border-radius: var(--radius-3);
    margin-bottom: var(--gap-6);
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
  }

  .plan-name {
    font-family: var(--font-mono);
