---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndustriesHero from '../../components/industries/IndustriesHero.astro';
import SectorRow from '../../components/industries/SectorRow.astro';
import { sanityClient } from '../../lib/sanity';
import { singletonPageQuery } from '../../lib/queries';
import { getDirectorySectors, getShowcaseSectors } from '../../lib/sectors';

/**
 * /footer/industries: a static showcase of every sector and its industries.
 * Sectors, sector lines, icons and industries all come from Sanity (Notion
 * Table 25 / Table 3, synced by Cowork); this page hardcodes none of them.
 * Spec: kits_design_system/docs/blocks/industries-directory.md
 */
const [page, sectors, heroSectors] = await Promise.all([
  sanityClient.fetch(singletonPageQuery, { pageId: 'industries' }).catch(() => null),
  getDirectorySectors(),
  // Same query and cache entry as the SectorShowcase cards, so the hero
  // diagram and the cards always show the same sectors in the same order.
  getShowcaseSectors(),
]);

// No sectors means Sanity failed or returned nothing. Never serve (or let a
// crawler index) an empty directory as a normal page: 503 so it is retried.
const unavailable = sectors.length === 0;
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}
const title = page?.seoTitle || page?.title || 'Industries';
const description = page?.seoDescription;

// Cross-industry diagram inputs: the first three showcase sectors, one arrow
// per input so the diagram never points from nothing.
const crossSectors = heroSectors.slice(0, 3);
const ARROWS: Record<number, string[]> = { 1: ['|'], 2: ['\\', '/'], 3: ['\\', '|', '/'] };
const crossArrows = ARROWS[crossSectors.length] || [];

const SITE = 'https://www.wugweb.com';
const PAGE_URL = `${SITE}/footer/industries`;
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${PAGE_URL}#page`,
    url: PAGE_URL,
    name: title,
    description,
    isPartOf: { '@id': `${SITE}/#website` },
    mainEntity: { '@id': `${PAGE_URL}#sectors` },
  },
  {
    '@type': 'ItemList',
    '@id': `${PAGE_URL}#sectors`,
    name: 'Sectors',
    numberOfItems: sectors.length,
    itemListElement: sectors.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'ItemList',
        name: s.name,
        url: `${PAGE_URL}#${s.slug}`,
        description: s.description,
        numberOfItems: s.industries.length,
        itemListElement: s.industries.map((ind, j) => ({ '@type': 'ListItem', position: j + 1, name: ind.name })),
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: PAGE_URL },
    ],
  },
];
---

<BaseLayout noIndex={unavailable || page?.noIndex} ogTitle={page?.ogTitle} ogDescription={page?.ogDescription} ogImagePath={page?.ogImagePath}
  title={title}
  description={description}
  hideGlobalSections={true}
  jsonLd={jsonLd}
>
  <div class="industries-page">

    <!-- 01 HERO -->
    <IndustriesHero
      title="We understand the context behind the product."
      lead="Every industry has different customers, constraints, regulations and ways of working. We bring cross-industry experience to build products and systems that fit the world they operate in."
      sectors={heroSectors}
    />

    <!-- 02 SECTOR DIRECTORY -->
    <section class="directory-section wrap" id="industries" aria-labelledby="directory-section-title">
      <div class="section-header">
        <h2 data-reveal id="directory-section-title">Explore our industries.</h2>
        <p class="section-lede" data-reveal>
          From highly regulated sectors to fast-moving consumer businesses, we adapt our approach to the context we're working in.
        </p>
      </div>
      <div class="directory-list">
        {sectors.map((s, i) => (
          <SectorRow
            slug={s.slug}
            index={i + 1}
            name={s.name}
            description={s.description}
            industries={s.industries}
            tone={i % 2 === 1 ? 'tint' : 'plain'}
          />
        ))}
      </div>
    </section>

    <!-- 03 CROSS-INDUSTRY EXPERIENCE -->
    <section class="cross-experience-section wrap" id="cross-experience-section" aria-labelledby="cross-experience-section-title">
      <div class="cross-grid">
        <div class="cross-copy" data-reveal>
          
          <h2 id="cross-experience-section-title">Different industries. Shared problems.</h2>
          <p>
            Customers still expect clarity. Teams still need better systems. Businesses still need products that work.
          </p>
          <p>
            Working across industries allows us to recognise patterns, transfer useful ideas and challenge assumptions, without ignoring the context that makes each business different.
          </p>
        </div>

        <div class="cross-visual" data-reveal>
          <div class="transfer-diagram" aria-hidden="true">
            {crossSectors.length > 0 && (
              <>
                <div class="diagram-inputs">
                  {crossSectors.map((s) => <div class="diag-node">{s.name}</div>)}
                </div>
                <div class="diagram-arrows">
                  {crossArrows.map((a) => <span>{a}</span>)}
                </div>
              </>
            )}
            <div class="diagram-center">
              <span>WUGWEB</span>
            </div>
            <div class="diagram-arrows">
              <span>|</span>
            </div>
            <div class="diagram-outputs">
              <div class="diag-node outline">Shared principles</div>
              <div class="diagram-arrows">
                <span>|</span>
              </div>
              <div class="diag-node active">Better digital systems</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 DON'T SEE YOUR INDUSTRY? -->
    <section class="missing-industry-section wrap" data-reveal id="no-industry" aria-labelledby="missing-industry-section-title">
      <div class="missing-inner">
        <h2 id="missing-industry-section-title">Don't see your industry?</h2>
        <p>
          Our experience spans different sectors, business models and operating environments. If your industry isn't listed, tell us what you're building and we'll explore where we can help.
        </p>
        <div class="missing-actions">
          <a href="/contact-us" class="btn btn-solid btn-light">Talk to us</a>
          <a href="/services" class="btn btn-ghost">View our services</a>
        </div>
      </div>
    </section>

    <!-- 05 FINAL CTA -->
    <section class="final-cta wrap" data-reveal id="final-cta" aria-labelledby="final-cta-title">
      <div class="final-inner">
        <h2 id="final-cta-title">Bring us the problem, not just the brief.</h2>
        <p>
          Tell us what you're trying to achieve. We'll bring the industry context, strategy, design and technology needed to move it forward.
        </p>
        <a href="/contact-us" class="btn btn-solid">Start a conversation</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────────────
     LAYOUT & THEME INTEGRATION
     ───────────────────────────────────────────────────────────────────── */
  .industries-page {
    padding-bottom: var(--space-section-xl);
    background-color: var(--color-surface-page);
    color: var(--color-text-primary);
    overflow-x: hidden;
  }

  .section-header {
    margin-bottom: var(--gap-12);
  }

  .section-header h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    max-width: 25ch;
    line-height: var(--lh-h2);
  }

  .section-lede {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    margin-top: var(--gap-4);
    max-width: 50ch;
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 02: SECTOR DIRECTORY (rows: SectorRow.astro)
     ───────────────────────────────────────────────────────────────────── */
  .directory-section {
    padding-block: var(--space-section-xl);
  }

  .directory-list {
    display: grid;
    gap: var(--gap-4);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 03: CROSS INDUSTRY EXPERIENCE
     ───────────────────────────────────────────────────────────────────── */
  .cross-experience-section {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .cross-grid {
    display: grid;
    gap: var(--gap-8);
    align-items: center;
  }

  .cross-grid > * { min-width: 0; }

  @media (min-width: 1024px) {
    .cross-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-12);
    }
  }

  .cross-copy h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin-top: var(--gap-4);
    margin-bottom: var(--gap-6);
  }

  .cross-copy p {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    margin-bottom: var(--gap-4);
    max-width: 48ch;
  }

  /* Diagram styles */
  .transfer-diagram {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    padding: var(--p-8);
    border-radius: var(--radius-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2);
  }

  .diagram-inputs, .diagram-outputs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-4);
    width: 100%;
  }

  .diag-node {
    background-color: var(--color-surface-page);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    padding: var(--p-3) var(--p-5);
    border-radius: var(--radius-2);
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    color: var(--color-text-primary);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .diag-node.outline {
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary);
  }

  .diag-node.active {
    background-color: var(--color-accent-primary);
    color: var(--neutral-10);
    border-color: var(--color-accent-primary);
    font-weight: var(--font-weight-bold);
  }

  .diagram-arrows {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: var(--t-h4);
    line-height: 1;
    display: flex;
    justify-content: space-around;
    width: 80%;
  }

  .diagram-center {
    background-color: var(--color-accent-primary);
    color: var(--neutral-10);
    font-family: var(--font-body);
    font-weight: var(--font-weight-bold);
    font-size: var(--fluid-body-sm);
    letter-spacing: var(--tracking-label);
    padding: var(--p-3) var(--p-6);
    border-radius: var(--radius-2);
    z-index: 2;
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 04: DON'T SEE YOUR INDUSTRY?
     ───────────────────────────────────────────────────────────────────── */
  .missing-industry-section {
    padding-block: var(--space-section-md);
    border-top: var(--stroke-thin) solid var(--color-border-subtle);
  }

  .missing-inner {
    background-color: var(--neutral-0);
    color: var(--neutral-10);
    border-radius: var(--radius-5);
    padding: var(--p-8);
    text-align: center;
    max-width: 800px;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .missing-inner {
      padding: var(--p-12);
    }
  }

  .missing-inner h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin-bottom: var(--gap-4);
  }

  .missing-inner p {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: rgba(0, 0, 0, 0.7);
    margin-bottom: var(--gap-8);
    max-width: 55ch;
    margin-inline: auto;
  }

  .btn.btn-light {
    background-color: var(--neutral-10);
    color: var(--neutral-0);
    border-color: var(--neutral-10);
  }

  .btn.btn-light:hover {
    background-color: var(--surface-2);
    border-color: var(--color-border-subtle);
  }

  .missing-actions {
    display: flex;
    justify-content: center;
    gap: var(--gap-4);
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 05: FINAL CTA
     ───────────────────────────────────────────────────────────────────── */
  .final-cta {
    padding-top: var(--space-section-xl);
    padding-bottom: var(--space-section-md);
  }

  .final-inner {
    background-color: var(--neutral-8);
    border: var(--stroke-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-5);
    padding: var(--p-8) var(--p-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 768px) {
    .final-inner {
      padding: var(--p-12);
    }
  }

  .final-inner h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin-bottom: var(--gap-4);
    max-width: 25ch;
  }

  .final-inner p {
    font-size: var(--fluid-body-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--gap-8);
    max-width: 45ch;
    line-height: var(--lh-xl);
  }
</style>
