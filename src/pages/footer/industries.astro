            <button class="sub-industry-btn" data-id="retail">Retail</button>
            <button class="sub-industry-btn" data-id="d2c">D2C</button>
            <button class="sub-industry-btn" data-id="brands">Consumer Brands</button>
          </div>
        </div>

        <!-- Group 4: Travel, Hospitality & Mobility -->
        <div class="group-row" data-group="travel" data-reveal>
          <div class="group-meta">
            <h3>Travel, Hospitality & Mobility</h3>
            <p>Live tracking mappings, booking journeys, and mobile experiences.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="travel">Travel</button>
            <button class="sub-industry-btn" data-id="hospitality">Hospitality</button>
            <button class="sub-industry-btn" data-id="aviation">Aviation</button>
            <button class="sub-industry-btn" data-id="automotive">Automotive</button>
            <button class="sub-industry-btn" data-id="logistics">Logistics & Mobility</button>
          </div>
        </div>

        <!-- Group 5: Technology & Digital -->
        <div class="group-row" data-group="technology" data-reveal>
          <div class="group-meta">
            <h3>Technology & Digital</h3>
            <p>SaaS portals, complex APIs mappings, and AI-driven workflow integrations.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="saas">SaaS</button>
            <button class="sub-industry-btn" data-id="ai">AI & Emerging Tech</button>
            <button class="sub-industry-btn" data-id="platforms">Platforms & Marketplaces</button>
          </div>
        </div>

        <!-- Group 6: Education & People -->
        <div class="group-row" data-group="education" data-reveal>
          <div class="group-meta">
            <h3>Education & People</h3>
            <p>Interactive knowledge panels, collaboration features, and learning flows.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="edtech">EdTech</button>
            <button class="sub-industry-btn" data-id="hr">HR & Workforce</button>
            <button class="sub-industry-btn" data-id="services">Professional Services</button>
          </div>
        </div>

        <!-- Group 7: Media, Entertainment & Culture -->
        <div class="group-row" data-group="media" data-reveal>
          <div class="group-meta">
            <h3>Media, Entertainment & Culture</h3>
            <p>Content delivery systems, streaming engines, and creator monetization loops.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="media">Media</button>
            <button class="sub-industry-btn" data-id="entertainment">Entertainment</button>
            <button class="sub-industry-btn" data-id="sports">Sports</button>
            <button class="sub-industry-btn" data-id="music">Music</button>
          </div>
        </div>

        <!-- Group 8: Public & Purpose -->
        <div class="group-row" data-group="public" data-reveal>
          <div class="group-meta">
            <h3>Public & Purpose</h3>
            <p>Civic accessibility compliance, open-data portals, and community-driven advocacy.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="government">Government</button>
            <button class="sub-industry-btn" data-id="ngos">NGOs & Non-profits</button>
            <button class="sub-industry-btn" data-id="impact">Social Impact</button>
          </div>
        </div>

        <!-- Group 9: Industrial & Infrastructure -->
        <div class="group-row" data-group="industrial" data-reveal>
          <div class="group-meta">
            <h3>Industrial & Infrastructure</h3>
            <p>Asset visualization tools, operational dashboards, and hardware integration maps.</p>
          </div>
          <div class="group-items">
            <button class="sub-industry-btn" data-id="energy">Energy</button>
            <button class="sub-industry-btn" data-id="manufacturing">Manufacturing</button>
            <button class="sub-industry-btn" data-id="realestate">Real Estate</button>
            <button class="sub-industry-btn" data-id="construction">Construction</button>
          </div>
        </div>

      </div>
    </section>

    <!-- 04 — INTERACTIVE INDUSTRY PREVIEW DRAWER -->
    <div class="preview-drawer-overlay" id="preview-drawer-overlay">
      <div class="preview-drawer" id="preview-drawer">
        <div class="drawer-header">
          <div class="header-meta">
            <span class="meta-eyebrow" id="prev-eyebrow">FINANCIAL SERVICES</span>
            <h3 id="prev-title">Fintech</h3>
          </div>
          <button class="btn-close-drawer" id="btn-close-preview">&times;</button>
        </div>
        
        <div class="drawer-body">
          <p class="prev-lead" id="prev-lead">Designing digital financial experiences people can trust.</p>
          <p class="prev-desc" id="prev-desc">Financial products need to balance usability, security, regulation and complex information.</p>
          
          <div class="prev-section">
            <h4>Relevant Wugweb capabilities</h4>
            <div class="caps-tags" id="prev-caps">
              <span class="tag">Strategy</span>
              <span class="tag">Experience</span>
              <span class="tag">Engineering</span>
              <span class="tag">Growth</span>
            </div>
          </div>

          <div class="prev-section">
            <h4>Typical work</h4>
            <ul class="work-list" id="prev-work">
              <li>Digital banking experiences</li>
              <li>Financial product UX</li>
              <li>Customer onboarding</li>
              <li>Dashboards</li>
              <li>Conversion journeys</li>
              <li>Platform development</li>
            </ul>
          </div>

          <div class="prev-visual-container">
            <div class="visual-container ratio-16-9">
              <div class="placeholder-graphic">
                <span class="placeholder-tag" id="prev-visual-tag">FINTECH MOCKUP</span>
                <span class="placeholder-desc" id="prev-visual-desc">Secure banking dashboard wireframes / transactional UI flows</span>
              </div>
            </div>
          </div>

          <div class="drawer-actions">
            <a href="/contact-us" class="btn btn-solid w-full text-center">Start a conversation &rarr;</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 05 — CROSS-INDUSTRY EXPERIENCE -->
    <section class="cross-experience-section wrap">
      <div class="cross-grid">
        <div class="cross-copy" data-reveal>
          
          <h2>Different industries. Shared problems.</h2>
          <p>
            Customers still expect clarity. Teams still need better systems. Businesses still need products that work.
          </p>
          <p>
            Working across industries allows us to recognise patterns, transfer useful ideas and challenge assumptions—without ignoring the context that makes each business different.
          </p>
        </div>

        <div class="cross-visual" data-reveal>
          <div class="transfer-diagram">
            <div class="diagram-inputs">
              <div class="diag-node">Healthcare</div>
              <div class="diag-node">Fintech</div>
              <div class="diag-node">Travel</div>
            </div>
            <div class="diagram-arrows">
              <span>\</span>
              <span>|</span>
              <span>/</span>
            </div>
            <div class="diagram-center">
              <span>WUGWEB</span>
            </div>
            <div class="diagram-arrows">
              <span>|</span>
            </div>
            <div class="diagram-outputs">
              <div class="diag-node outline">Shared principles</div>
              <div class="diagram-arrows">
                <span>|</span>
              </div>
              <div class="diag-node active">Better digital systems</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 — INDUSTRY + CAPABILITY MATRIX -->
    <section class="matrix-section wrap">
      <div class="section-header text-center">
        
        <h2 data-reveal>Industry context meets capability.</h2>
        <p class="section-lede" data-reveal>
          A visual representation of Wugweb's multidisciplinary approach. Click a row to see the capability intersection.
        </p>
      </div>

      <div class="matrix-container" data-reveal>
