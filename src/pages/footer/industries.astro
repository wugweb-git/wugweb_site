---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { singletonPageQuery } from '../../lib/queries';

const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'industries' }).catch(() => null);
const title = page?.seoTitle || page?.title || 'Industries';
const description = page?.seoDescription || 'Wugweb brings deep industry context across financial services, healthcare, consumer commerce, technology, mobility, education, and purpose-driven sectors.';

// Real case studies for the preview drawer. `caseStudy.industryRef` is set on
// 51 of 60 published docs and, until now, reached no page at all — the drawer's
// "typical work" list was six invented strings per industry. This joins the two.
//
// The drawer's sub-industry ids mostly equal the industry document slug
// (banking, fintech, ecommerce, edtech, entertainment, healthcare, …); these
// are the ones that do not. Anything unmapped simply finds no case studies and
// falls back to the hardcoded list below, so the page degrades rather than
// emptying out.
const INDUSTRY_ALIASES: Record<string, string[]> = {
  ai: ['ai-ml'],
  ngos: ['non-profit'],
  hr: ['hrtech'],
  realestate: ['real-estate'],
  insurtech: ['insurance'],
  wealth: ['financial-services'],
  brands: ['fmcg', 'luxury'],
  services: ['consulting'],
};

const caseStudiesByIndustry = await sanityClient
  // Legacy duplicate stubs carry the same title, the same industryRef and a
  // canonicalUrl pointing at the real case study — without this filter the
  // drawer listed METCRED twice, once under each slug. Reuses the canonicalUrl
  // field declared on caseStudy for exactly this stub/canonical distinction.
  .fetch(`*[_type == "caseStudy"
      && defined(industryRef) && defined(slug.current)
      && !(_id in path("drafts.**"))
      && (!defined(canonicalUrl) || canonicalUrl == "/work/" + slug.current)]{
    title, "slug": slug.current, "ind": industryRef->slug.current
  }`)
  .catch(() => []);

const workByIndustry: Record<string, { title: string; slug: string }[]> = {};
for (const cs of (caseStudiesByIndustry as any[])) {
  if (!cs?.ind) continue;
  (workByIndustry[cs.ind] ||= []).push({ title: cs.title, slug: cs.slug });
}
// Fold aliases in so the drawer can look up by its own sub-industry id.
for (const [subId, slugs] of Object.entries(INDUSTRY_ALIASES)) {
  const merged = slugs.flatMap((sl) => workByIndustry[sl] || []);
  if (merged.length) workByIndustry[subId] = [...(workByIndustry[subId] || []), ...merged];
}
---

<BaseLayout noIndex={page?.noIndex} ogTitle={page?.ogTitle} ogDescription={page?.ogDescription} 
  title={title} 
  description={description}
  hideGlobalSections={true}
>
  <div class="industries-page">

    <!-- 01 — HERO -->
    <section class="hero-section wrap">
      <div class="hero-content">
        
        <h1 class="page-title" data-reveal>We understand the context behind the product.</h1>
        <p class="hero-lead" data-reveal>
          Every industry has different customers, constraints, regulations and ways of working. We bring cross-industry experience to build products and systems that fit the world they operate in.
        </p>
      </div>

      <div class="hero-visual" data-reveal>
        <div class="ecosystem-diagram">
          {/* Inline SVG, so fill/stroke resolve against the page's custom
              properties exactly as CSS would. These were literal hexes —
              #FFBE1A, #050505, #191919, #2B2B2B, #F4F4F4 — which is 26 of the
              values audit finding 20 counted, and the largest genuine cluster
              of them in the codebase. Hardcoded here meant the diagram would
              quietly stop matching the site the first time a token moved. Font
              families were literal too, and are now tokens.

              The yellow node is --color-yellow, NOT --color-accent-primary:
              that token resolves to --neutral-2 (#DFDFDF), so the obvious
              substitution would have turned the WUGWEB node grey. The #FFBE1A
              fallbacks written beside --color-accent-primary elsewhere in the
              codebase describe a value it does not currently hold. */}
          <svg viewBox="0 0 400 300" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Central Node -->
            <rect x="140" y="125" width="120" height="50" rx="6" fill="var(--color-yellow)" />
            <text x="200" y="155" fill="var(--color-surface-page)" font-family="var(--font-body)" font-weight="700" font-size="14" text-anchor="middle">WUGWEB</text>

            <!-- Satellite Nodes -->
            <!-- Healthcare -->
            <rect x="20" y="30" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="70" y="52" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">Healthcare</text>
            <path d="M120 48 C160 48, 160 135, 140 145" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Fintech -->
            <rect x="20" y="132" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="70" y="154" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">Fintech</text>
            <path d="M120 150 L140 150" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Travel -->
            <rect x="20" y="234" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="70" y="256" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">Travel</text>
            <path d="M120 252 C160 252, 160 165, 140 155" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Energy -->
            <rect x="280" y="30" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="330" y="52" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">Energy</text>
            <path d="M280 48 C240 48, 240 135, 260 145" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Education -->
            <rect x="280" y="132" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="330" y="154" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">Education</text>
            <path d="M280 150 L260 150" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- NGO -->
            <rect x="280" y="234" width="100" height="36" rx="4" fill="var(--color-surface-elevated)" stroke="var(--color-border-subtle)" />
            <text x="330" y="256" fill="var(--color-text-primary)" font-family="var(--font-mono)" font-size="10" text-anchor="middle">NGO</text>
            <path d="M280 252 C240 252, 240 165, 260 155" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-dasharray="4 4" />
          </svg>
        </div>
      </div>
