<style>
  /* ─────────────────────────────────────────────────────────────────────
     LAYOUT & THEME INTEGRATION
     ───────────────────────────────────────────────────────────────────── */
  .industries-page {
    padding-bottom: var(--space-section-xl);
    background-color: var(--color-surface-page);
    color: var(--color-text-primary);
    overflow-x: hidden;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fluid-caption);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-primary);
    text-transform: uppercase;
    margin-bottom: var(--gap-4);
  }

  .section-header {
    margin-bottom: var(--gap-12);
  }

  .section-header h2 {
    font-size: var(--fluid-h2);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    max-width: 25ch;
    line-height: var(--lh-h2);
  }

  .section-lede {
    font-size: var(--fluid-body-lg);
    line-height: var(--lh-xl);
    color: var(--color-text-secondary);
    margin-top: var(--gap-4);
    max-width: 50ch;
  }

  .text-center {
    text-align: center;
  }

  .text-center .section-lede {
    margin-inline: auto;
  }

  .w-full {
    width: 100% !important;
  }

  /* ─────────────────────────────────────────────────────────────────────
     SECTION 1 — HERO
     ───────────────────────────────────────────────────────────────────── */
  .hero-section {
    padding-top: calc(var(--space-section-xl) * 1.5);
    padding-bottom: var(--space-section-lg);
    display: grid;
    gap: var(--gap-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-section {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--gap-12);
    }
  }

  .hero-content h1 {
    font-size: var(--fluid-display);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--lh-display);
    letter-spacing: -0.03em;
    margin-bottom: var(--gap-6);
  }

  .hero-lead {
    font-size: var(--fluid-body-lg);
