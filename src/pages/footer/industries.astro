            <div class="matrix-cell label">SaaS</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
          </div>

          <div class="matrix-row interactive-row" data-industry="ngos">
            <div class="matrix-cell label">NGOs</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
            <div class="matrix-cell dot active">●</div>
