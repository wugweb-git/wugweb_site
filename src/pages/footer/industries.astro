  // 1. SEARCH & CATEGORY FILTER LOGIC
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const catFilters = document.getElementById('cat-filters');
  const groupsList = document.getElementById('groups-list');

  const filterRows = () => {
    if (!groupsList) return;
    const rows = groupsList.querySelectorAll('.group-row');
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const activeFilterBtn = catFilters ? catFilters.querySelector('.filter-btn.active') : null;
    const selectedGroup = activeFilterBtn ? activeFilterBtn.getAttribute('data-group') : 'all';

    rows.forEach(row => {
      const groupName = row.getAttribute('data-group');
      const subButtons = row.querySelectorAll('.sub-industry-btn');
      
      let matchesSearch = false;
      let visibleButtonsCount = 0;

      subButtons.forEach(btn => {
        const text = btn.textContent ? btn.textContent.toLowerCase() : '';
        const btnElement = btn as HTMLButtonElement;
        
        if (query === '' || text.includes(query)) {
          btnElement.style.display = 'inline-block';
          matchesSearch = true;
          visibleButtonsCount++;
        } else {
          btnElement.style.display = 'none';
        }
      });

      const rowElement = row as HTMLDivElement;
      
      const matchesCategory = (selectedGroup === 'all' || groupName === selectedGroup);

      if (matchesCategory && matchesSearch && visibleButtonsCount > 0) {
        rowElement.style.display = 'grid';
      } else {
        rowElement.style.display = 'none';
      }
    });
  };

  if (searchInput && catFilters && groupsList) {
    searchInput.addEventListener('input', filterRows);

    const filterButtons = catFilters.querySelectorAll('.filter-btn');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterRows();
      });
    });
  }

  // 2. INTERACTIVE PREVIEW DRAWER LOGIC
  const prevDrawerOverlay = document.getElementById('preview-drawer-overlay');
  const prevTitle = document.getElementById('prev-title');
  const prevEyebrow = document.getElementById('prev-eyebrow');
  const prevLead = document.getElementById('prev-lead');
  const prevDesc = document.getElementById('prev-desc');
  const prevCaps = document.getElementById('prev-caps');
  const prevWork = document.getElementById('prev-work');
  const prevVisualTag = document.getElementById('prev-visual-tag');
  const prevVisualDesc = document.getElementById('prev-visual-desc');
  const btnClosePreview = document.getElementById('btn-close-preview');

  const openPreview = (subId: string) => {
    const data = industryPreviews[subId];
    if (!data || !prevDrawerOverlay || !prevTitle || !prevEyebrow || !prevLead || !prevDesc || !prevCaps || !prevWork || !prevVisualTag || !prevVisualDesc) return;

    prevTitle.textContent = data.title;
    prevEyebrow.textContent = data.eyebrow;
    prevLead.textContent = data.lead;
    prevDesc.textContent = data.desc;

    // Render Capabilities
    prevCaps.innerHTML = '';
    data.caps.forEach((cap: string) => {
      const span = document.createElement('span');
      span.className = 'tag';
      span.textContent = cap;
      prevCaps.appendChild(span);
    });

    // Render Typical Work. Real case studies joined on caseStudy.industryRef
    // win; the hardcoded `data.work` strings are the fallback for industries
    // we have not published work in yet, so the drawer never renders empty.
    prevWork.innerHTML = '';
    const realWork = (window as any).__wugwebWorkByIndustry?.[subId] || [];
    if (realWork.length > 0) {
      realWork.slice(0, 6).forEach((cs: { title: string; slug: string }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/work/${cs.slug}`;
        a.textContent = cs.title;
        li.appendChild(a);
        prevWork.appendChild(li);
      });
    } else {
      data.work.forEach((item: string) => {
        const li = document.createElement('li');
        li.textContent = item;
        prevWork.appendChild(li);
      });
    }

    // Render Visual Details
    prevVisualTag.textContent = data.vTag;
    prevVisualDesc.textContent = data.vDesc;

    prevDrawerOverlay.classList.add('active');
  };

  const closePreview = () => {
    if (prevDrawerOverlay) prevDrawerOverlay.classList.remove('active');
  };

  if (groupsList) {
    const subButtons = groupsList.querySelectorAll('.sub-industry-btn');
    subButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) openPreview(id);
      });
    });
  }

  if (btnClosePreview && prevDrawerOverlay) {
    btnClosePreview.addEventListener('click', closePreview);
    prevDrawerOverlay.addEventListener('click', (e) => {
      if (e.target === prevDrawerOverlay) closePreview();
    });
  }

  // 3. MATRIX CLICK BEHAVIORS
  const matrixRows = document.querySelectorAll('.matrix-row.interactive-row');
  matrixRows.forEach(row => {
    row.addEventListener('click', () => {
      const isActive = row.classList.contains('active-selection');
      matrixRows.forEach(r => r.classList.remove('active-selection'));
      if (!isActive) {
        row.classList.add('active-selection');
      }
    });
  });
</script>
