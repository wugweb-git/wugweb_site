          <button class="filter-btn" data-group="consumer">CONSUMER & COMMERCE</button>
          <button class="filter-btn" data-group="travel">TRAVEL, HOSPITALITY & MOBILITY</button>
          <button class="filter-btn" data-group="technology">TECHNOLOGY & DIGITAL</button>
          <button class="filter-btn" data-group="education">EDUCATION & PEOPLE</button>
          <button class="filter-btn" data-group="media">MEDIA, ENTERTAINMENT & CULTURE</button>
          <button class="filter-btn" data-group="public">PUBLIC & PURPOSE</button>
          <button class="filter-btn" data-group="industrial">INDUSTRIAL & INFRASTRUCTURE</button>
