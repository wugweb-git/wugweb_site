---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { assetUrl } from '../../lib/assets';
import { singletonPageQuery } from '../../lib/queries';

const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'reviews' }).catch(() => null);

// Client testimonials, Wugweb only.
//
// subject is the governance line, not a display preference. The 14 testimonial
// documents in Sanity today are all subject: 'vedanshu' — personal LinkedIn
// recommendations — and they are deliberately NOT rendered here. This page is
// headed "What people say about working with us" and "Agency reviews"; showing
// personal recommendations under that framing would present them as client
// feedback about the company. They belong to vedanshu's own site and are pushed
// there via Neon. governance.md keeps the two entities separate and the
// `subject` field exists to encode exactly this.
//
// So this query returns 0 rows right now, and the section below does not render.
// That is correct, not a bug. Wugweb reviews arrive through the agency's own
// Clutch / DesignRush / GoodFirms accounts (see testimonial.source) and will
// appear here automatically once they carry subject: wugweb or both.
const clientTestimonials = await sanityClient
  .fetch(`*[_type == "testimonial" && subject in ["wugweb", "both"] && !(_id in path("drafts.**"))]
    | order(order asc, name asc){ name, role, company, quote, photoPath, source }`)
  .catch(() => []);
const title = page?.seoTitle || page?.title || 'Reviews';
const description = page?.seoDescription || "What clients and the team say about working with Wugweb, collected from the platforms that host it.";

// Sourced from the same verified registry TrustBadges.astro uses — real
// profile URLs, not guessed. GoodFirms is confirmed live; Clutch and
// DesignRush are pending verification per that component's own comment.
// Ratings/review counts are deliberately NOT shown here — none have been
// verified against the live platforms, and a wrong number on a review
// page is worse than an honest "visit the profile" link.
const agencyPlatforms = [
  { name: 'Clutch', href: 'https://clutch.co/profile/wugweb', logo: '/brand/trust/clutch.svg' },
  { name: 'DesignRush', href: 'https://www.designrush.com/agency/profile/wugweb', logo: '/brand/trust/designrush.svg' },
  { name: 'GoodFirms', href: 'https://www.goodfirms.co/company/wugweb', logo: '/brand/trust/goodfirms.svg' },
];
---

<BaseLayout noIndex={page?.noIndex} ogTitle={page?.ogTitle} ogDescription={page?.ogDescription} title={title} description={description}>
  <div class="reviews-page">
    <!-- HERO -->
    <section class="hero-section wrap" id="hero-section" aria-labelledby="hero-section-title">
      
      <h1 class="page-title" data-reveal id="hero-section-title">What people say about working with us.</h1>
      <p class="hero-lead" data-reveal>
        Client feedback lives on the platforms that host it — we link straight there instead of quoting numbers we can't keep current. Team feedback gets the same treatment.
      </p>
    </section>

    <!-- AGENCY REVIEWS -->
    <section class="wrap reviews-section" id="reviews-section" aria-labelledby="reviews-section-title">
      <div class="section-header">
        
        <h2 data-reveal id="reviews-section-title">Agency reviews</h2>
        <p class="section-lead" data-reveal>Verified review platforms Wugweb is listed on. Ratings and counts live on each platform directly — visit the profile for the current number.</p>
      </div>
      <div class="platform-grid">
        {agencyPlatforms.map((p) => (
          <a href={p.href} target="_blank" rel="noopener noreferrer" class="platform-card glass-panel" data-reveal>
            <img src={p.logo} alt="" width="120" height="26" loading="lazy" class="platform-logo" />
            <span class="platform-name">{p.name}</span>
            <span class="platform-cta">View profile</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CLIENT TESTIMONIALS — renders only when Wugweb-subject reviews exist -->
    {clientTestimonials.length > 0 && (
      <section class="wrap reviews-section" id="reviews-section-2" aria-labelledby="reviews-section-2-title">
        <div class="section-header">
          <h2 data-reveal id="reviews-section-2-title">In their words</h2>
          <p class="section-lead" data-reveal>Feedback from clients we've worked with, collected through Wugweb's own profiles on the platforms above.</p>
        </div>
        <div class="platform-grid">
          {clientTestimonials.map((t: any) => (
            <figure class="platform-card glass-panel" data-reveal>
              <blockquote class="testimonial-quote">{t.quote}</blockquote>
              <figcaption class="testimonial-attrib">
                {t.photoPath && <img src={assetUrl(t.photoPath)} alt="" width="40" height="40" loading="lazy" class="testimonial-photo" />}
                <span class="testimonial-name">{t.name}</span>
                {(t.role || t.company) && (
                  <span class="testimonial-role">{[t.role, t.company].filter(Boolean).join(', ')}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- EMPLOYEE REVIEWS -->
    <section class="wrap reviews-section" id="reviews-section-3" aria-labelledby="reviews-section-3-title">
      <div class="section-header">
        
        <h2 data-reveal id="reviews-section-3-title">Employee reviews</h2>
        <p class="section-lead" data-reveal>
          No verified employer-review platform profile (Glassdoor, AmbitionBox, etc.) is on record for Wugweb yet — this section is ready to go the moment there's a real, confirmed profile link to point at. Nothing is linked here to avoid guessing at a URL for a page like this.
        </p>
      </div>
    </section>

    <!-- OTHER RECOGNITION -->
    <section class="wrap reviews-section" id="reviews-section-4" aria-labelledby="reviews-section-4-title">
      <div class="section-header">
        
        <h2 data-reveal id="reviews-section-4-title">Other recognition</h2>
      </div>
      <div class="platform-grid">
        <a href="https://www.startupindia.gov.in/" target="_blank" rel="noopener noreferrer" class="platform-card glass-panel" data-reveal>
          <span class="platform-name">DPIIT Recognised Startup</span>
          <span class="platform-sub">Department for Promotion of Industry and Internal Trade, Government of India</span>
          <span class="platform-cta">View registry</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .reviews-page { padding-block: var(--space-page-head) 0; }
  /* Full-width section with a 48rem content column carved by padding (was a
     48rem cap on the section itself, so the section was not full width). */
  .hero-section { padding-block: var(--space-section-lg) var(--space-section-md); padding-inline: max(var(--shell-gutter), calc((100% - 48rem) / 2)); }
  .hero-section h1 { margin-top: var(--gap-4); }
  .hero-lead { margin-top: var(--gap-5); color: var(--fg-muted); font-size: var(--fluid-body-lg); line-height: var(--core-line-height-relaxed); }

  .reviews-section { padding-block: var(--space-section-md); border-top: var(--stroke-thin) solid var(--line); }
  .section-header { max-width: 48rem; }
  .section-header h2 { margin-top: var(--gap-3); }
  .section-lead { margin-top: var(--gap-4); color: var(--fg-muted); }

  .platform-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4);
    margin-top: var(--gap-8);
  }
  @media (min-width: 640px) {
    .platform-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .glass-panel {
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-lg);
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-3);
    padding: var(--gap-6);
    text-decoration: none;
    transition: box-shadow var(--duration-normal) var(--easing-out), transform var(--duration-normal) var(--easing-out);
  }
  .platform-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .platform-logo { filter: brightness(0) invert(1); opacity: var(--opacity-80); }
  .platform-name { font-weight: var(--font-weight-semibold); color: var(--fg); font-size: var(--fluid-body-md); }
  .platform-sub { color: var(--fg-muted); font-size: var(--fluid-body-sm); }
  .platform-cta {
    margin-top: auto;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--fluid-label);
  }
  .platform-card:hover .platform-cta { color: var(--fg); }

  /* Client testimonials. Reuses .platform-card so the cards match the platform
     grid above; only the inner typography differs. Tokens only.
     figure carries a default UA margin (~40px each side) that .platform-card
     never reset, because every other card on this page is an <a> — without this
     the testimonial card rendered 291px inside a 370px grid column. */
  figure.platform-card { margin: 0; }
  .testimonial-quote {
    margin: 0;
    color: var(--fg);
    font-size: var(--fluid-body-md);
    line-height: var(--core-line-height-relaxed);
  }
  .testimonial-attrib {
    margin-top: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-2);
  }
  .testimonial-photo { border-radius: var(--radius-full); object-fit: cover; }
  .testimonial-name { font-weight: var(--font-weight-semibold); color: var(--fg); font-size: var(--fluid-body-sm); }
  .testimonial-role { color: var(--fg-muted); font-family: var(--font-mono); font-size: var(--fluid-label); }
</style>
