---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import { postsListQuery, singletonPageQuery } from '../../lib/queries';

const blogPage = await sanityClient.fetch(singletonPageQuery, { pageId: 'blog' }).catch(() => null);
const blogTitle = blogPage?.seoTitle || 'Wugweb | Insights on UI/UX Design & Digital Strategy';
const blogDescription =
  blogPage?.seoDescription ||
  'Stay updated with Wugweb’s blog featuring expert insights on UI/UX design, user experience trends, and digital product strategy.';

const CATEGORY_COLORS: Record<string, string> = {
  'Experience Design': '#ED219A',
  'Brand & Strategy': '#2368D7',
  'MarTech': '#E6309F',
  'AI & Automation': '#7A4DFF',
  'Web & App Development': '#7A4DFF',
  'Digital Transformation': '#09E2C0',
  'Data & Analytics': '#09E2C0',
  'Performance Marketing': '#E6309F',
  'SEO': '#FA4108',
  'Content': '#2368D7',
  'Consulting': '#09E2C0',
  'Operations': '#FA4108',
  'Infrastructure & DevOps': '#FA4108',
  'Development / Server': '#7A4DFF',
  Misc: '#2B2B2B',
};

function coverUrl(coverImage: any, coverPath?: string): string {
  if (coverPath) return coverPath.startsWith('/') || coverPath.startsWith('http') ? coverPath : `/${coverPath}`;
  if (!coverImage) return '';
  try {
    if (typeof coverImage === 'string') return coverImage;
    if (coverImage.asset || coverImage._ref || coverImage._type === 'image') {
      return urlFor(coverImage).width(800).height(500).url();
    }
  } catch {
    return '';
  }
  return '';
}

function initials(title: string): string {
  const words = (title || '').replace(/[^\w\s]/g, '').trim().split(/\s+/).filter(Boolean);
  if (!words.length) return 'Ww';
  return words.slice(0, 2).map((w) => w[0]?.toUpperCase() || '').join('');
}

const queryPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const seenPostSlugs = new Set();
const rawPosts = [];
for (const p of (queryPosts || [])) {
  if (p && p.slug && !seenPostSlugs.has(p.slug)) {
    seenPostSlugs.add(p.slug);
    rawPosts.push(p);
  }
}

// Top-level filters map to the six service pillars — never a large tag system.
const PILLARS = ['Strategy', 'Brand', 'Experience', 'Engineering', 'Growth', 'Operations'];
const CATEGORY_PILLAR: Record<string, string> = {
  'Strategy': 'Strategy', 'Business Strategy': 'Strategy', 'Consulting': 'Strategy',
  'Brand & Strategy': 'Brand', 'Brand': 'Brand', 'Content': 'Brand',
  'Experience Design': 'Experience', 'UX Design': 'Experience', 'UI Design': 'Experience',
  'Web & App Development': 'Engineering', 'Development / Server': 'Engineering',
  'Infrastructure & DevOps': 'Engineering',
  'MarTech': 'Growth', 'Performance Marketing': 'Growth', 'SEO': 'Growth',
  'AI & Automation': 'Growth', 'Data & Analytics': 'Growth',
  'Operations': 'Operations', 'Digital Transformation': 'Operations',
};
function postPillar(category: string): string {
  return CATEGORY_PILLAR[category] || PILLARS.find((p) => (category || '').toLowerCase().includes(p.toLowerCase())) || 'Experience';
}

const posts = (rawPosts || []).map((p: any) => ({
  ...p,
  coverUrl: coverUrl(p.coverImage, p.coverPath),
  accent: CATEGORY_COLORS[p.category] || '#2B2B2B',
  pillar: postPillar(p.category),
  initials: initials(p.title),
}));
const categories = ['All', ...PILLARS];
---

<BaseLayout title={blogTitle} description={blogDescription}>
  <section class="blog-hero">
    <div class="wrap blog-hero-content">
      <p class="eyebrow" data-reveal>Insights</p>
      <h1 data-reveal>Articles</h1>
      <p data-reveal>Insights on design, product, and digital strategy from the Wugweb team.</p>
    </div>
  </section>

  <section class="wrap blog-filters" data-reveal>
    {categories.map((c) => (
      <button class="filter-chip" data-category={c}>{c}</button>
    ))}
  </section>

  <section class="wrap blog-grid-section">
    <ul class="blog-grid">
      {posts.map((p: any) => (
        <li data-reveal data-category={p.pillar}>
          <a href={`/blog/${p.slug}`}>
            <div class="post-thumb-wrap">
              {p.coverUrl ? (
                <img src={p.coverUrl} alt={p.title} loading="lazy" class="post-thumb" />
              ) : (
                <div class="post-thumb post-thumb-fallback" style={`--cover-accent: ${p.accent}`}>
                  <span class="post-thumb-grid" aria-hidden="true"></span>
                  <span class="post-thumb-cat">{p.category || 'Insight'}</span>
                  <span class="post-thumb-initials" aria-hidden="true">{p.initials}</span>
                  <span class="post-thumb-foot">
                    <span class="post-thumb-read">{p.readingTime ? `${p.readingTime} min read` : 'Wugweb Insight'}</span>
                    <span class="post-thumb-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              )}
            </div>
            <div class="post-content">
              <span class="post-category">{p.category}</span>
              <h3>{p.title}</h3>
              <p class="post-excerpt">{p.excerpt}</p>
              <div class="post-meta">
                {p.author?.name && <span class="blog-author">{p.author.name}</span>}
                {p.readingTime && <span class="reading-time">{p.readingTime} min read</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>

<style>
  .blog-hero { padding-block: var(--space-section-xl) var(--space-section-md); }
  .blog-hero-content h1 { font-size: var(--t-h2); font-weight: var(--font-weight-bold); max-width: 28ch; margin-bottom: var(--gap-4); }
  .blog-hero-content p { font-size: var(--t-body); color: var(--fg-muted); max-width: 50ch; }
  .blog-filters { display: flex; gap: var(--gap-2); flex-wrap: wrap; padding-block: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  .filter-chip { font-family: var(--font-mono); font-size: var(--t-sm); padding: var(--gap-2) var(--gap-4); border: var(--stroke-thin) solid var(--line); border-radius: var(--r-pill); background: transparent; color: var(--fg-muted); cursor: pointer; transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out); }
  .filter-chip:hover { border-color: var(--fg); color: var(--fg); }
  .filter-chip.active { border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--color-yellow) 10%, transparent); }
  .blog-grid-section { border-top: var(--stroke-thin) solid var(--line); padding-block: var(--space-section-md) var(--space-section-xl); }
  .blog-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
  .blog-grid a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    background: var(--neutral-1);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .blog-grid a:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 45%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.2);
  }
  .post-thumb-wrap { overflow: hidden; aspect-ratio: 16/10; flex-shrink: 0; }
  .post-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .blog-grid a:hover .post-thumb { transform: scale(1.05); }
  .post-content { padding: var(--gap-5) var(--gap-6) var(--gap-6); display: flex; flex-direction: column; flex: 1; }

  .post-thumb-fallback {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--gap-5);
    min-height: var(--thumb-min);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--cover-accent) 45%, transparent), transparent 55%),
      radial-gradient(80% 60% at 0% 100%, color-mix(in srgb, var(--cover-accent) 18%, transparent), transparent 60%),
      linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%);
    border: var(--stroke-thin) solid var(--line);
    transition: border-color var(--duration-fast) var(--easing-out);
  }
  .blog-grid a:hover .post-thumb-fallback { border-color: color-mix(in srgb, var(--cover-accent) 40%, var(--line)); }
  .post-thumb-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--cover-accent) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--cover-accent) 8%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: var(--opacity-50);
    pointer-events: none;
  }
  .post-thumb-fallback > *:not(.post-thumb-grid) { position: relative; z-index: var(--z-overlay); }
  .post-thumb-initials {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--core-line-height-none);
    color: var(--fg);
    opacity: var(--opacity-strong);
    margin-top: auto;
  }
  .post-thumb-cat {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: var(--gap-1) var(--gap-2);
    border: var(--stroke-thin) solid color-mix(in srgb, var(--cover-accent) 35%, var(--line));
    border-radius: var(--radius-full);
    color: color-mix(in srgb, var(--cover-accent) 80%, var(--neutral-1));
  }
  .post-thumb-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--gap-3);
  }
  .post-thumb-read {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--fg-subtle);
  }
  .post-thumb-arrow {
    font-size: var(--t-body);
    color: var(--cover-accent, var(--accent));
    transition: transform var(--duration-fast) var(--easing-out);
  }
  .blog-grid a:hover .post-thumb-arrow { transform: translateX(4px); }
  .post-category { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--accent-warm); }
  .blog-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); line-height: var(--lh-h5); }
  .post-excerpt { font-size: var(--t-sm); color: var(--fg-muted); margin-top: var(--gap-2); line-height: var(--lh-s); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-meta { display: flex; gap: var(--gap-4); margin-top: var(--gap-3); }
  .blog-author { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .reading-time { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .blog-grid li.hidden { display: none; }
</style>

<script>
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('.blog-grid li').forEach(item => {
        if (cat === 'All' || item.dataset.category === cat) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
