---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import { postsListQuery, singletonPageQuery } from '../../lib/queries';
import { loadAssetAlts, altFor } from '../../lib/asset-alt';
import { assetUrl } from '../../lib/assets';

const blogPage = await sanityClient.fetch(singletonPageQuery, { pageId: 'blog' }).catch(() => null);
const blogTitle = blogPage?.seoTitle || 'Wugweb | Insights on UI/UX Design & Digital Strategy';
const blogDescription =
  blogPage?.seoDescription ||
  'Stay updated with Wugweb’s blog featuring expert insights on UI/UX design, user experience trends, and digital product strategy.';

function coverUrl(coverImage: any, coverPath?: string): string {
  if (coverPath) return assetUrl(coverPath);
  if (!coverImage) return '';
  try {
    if (typeof coverImage === 'string') return coverImage;
    if (coverImage.asset || coverImage._ref || coverImage._type === 'image') {
      return urlFor(coverImage).width(800).height(600).url();
    }
  } catch {
    return '';
  }
  return '';
}

function initials(title: string): string {
  const words = (title || '').replace(/[^\w\s]/g, '').trim().split(/\s+/).filter(Boolean);
  if (!words.length) return 'Ww';
  return words.slice(0, 2).map((w) => w[0]?.toUpperCase() || '').join('');
}

const queryPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const seenPostSlugs = new Set();
const rawPosts = [];
for (const p of (queryPosts || [])) {
  if (p && p.slug && !seenPostSlugs.has(p.slug)) {
    seenPostSlugs.add(p.slug);
    rawPosts.push(p);
  }
}

// Top-level filters map to the six service pillars, each locked to its own
// brand accent token (--svc-*) — one consistent color language for
// "what kind of work is this" across the whole site, not a one-off hex map.
const PILLARS = ['Strategy', 'Brand', 'Experience', 'Engineering', 'Growth', 'Operations'];
const PILLAR_ACCENT: Record<string, string> = {
  Strategy: 'var(--svc-strategy)',
  Brand: 'var(--svc-brand)',
  Experience: 'var(--svc-experience)',
  Engineering: 'var(--svc-engineering)',
  Growth: 'var(--svc-growth)',
  Operations: 'var(--svc-operations)',
};
const CATEGORY_PILLAR: Record<string, string> = {
  'Strategy': 'Strategy', 'Business Strategy': 'Strategy', 'Consulting': 'Strategy',
  'Brand & Strategy': 'Brand', 'Brand': 'Brand', 'Content': 'Brand',
  'Experience Design': 'Experience', 'UX Design': 'Experience', 'UI Design': 'Experience',
  'Web & App Development': 'Engineering', 'Development / Server': 'Engineering',
  'Infrastructure & DevOps': 'Engineering',
  'MarTech': 'Growth', 'Performance Marketing': 'Growth', 'SEO': 'Growth',
  'AI & Automation': 'Growth', 'Data & Analytics': 'Growth',
  'Operations': 'Operations', 'Digital Transformation': 'Operations',
};
function postPillar(category: string): string {
  return CATEGORY_PILLAR[category] || PILLARS.find((p) => (category || '').toLowerCase().includes(p.toLowerCase())) || 'Experience';
}

const altMap = await loadAssetAlts();
const posts = (rawPosts || []).map((p: any) => {
  const pillar = postPillar(p.category);
  return {
    ...p,
    coverUrl: coverUrl(p.coverImage, p.coverPath),
    coverAlt: altFor(altMap, p.coverPath, p.title),
    accent: PILLAR_ACCENT[pillar],
    pillar,
    initials: initials(p.title),
  };
});
const categories = ['All', ...PILLARS];

// The query already orders featured-first, then newest — so the first post
// is the correct "one bold thing" for a large feature card; the rest form
// the regular grid. Two genuinely distinct card states, not decoration.
const [heroPost, ...restPosts] = posts;

function fmtDate(d?: string): string {
  return d ? new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
}
---

<BaseLayout noIndex={blogPage?.noIndex} ogTitle={blogPage?.ogTitle} ogDescription={blogPage?.ogDescription} ogImagePath={blogPage?.ogImagePath} title={blogTitle} description={blogDescription}>
  <section class="blog-hero" id="blog-hero" aria-labelledby="blog-hero-title">
    <div class="wrap blog-hero-content">
      
      <h1 class="page-title" data-reveal id="blog-hero-title">Notes on design, product, and growth.</h1>
      <p data-reveal>Field notes from Wugweb's design, engineering, and strategy work: what we're learning, testing, and shipping.</p>
    </div>
  </section>

  {heroPost && (
    <section class="wrap blog-featured" data-reveal id="blog-featured" aria-labelledby="blog-featured-title">
      <a href={`/blog/${heroPost.slug}`} class="featured-card" style={`--card-accent: ${heroPost.accent}`}>
        <div class="featured-visual">
          {heroPost.coverUrl ? (
            <img src={heroPost.coverUrl} alt={heroPost.coverAlt} loading="eager" />
          ) : (
            <div class="featured-visual-fallback" aria-hidden="true">
              <span class="fvf-grid"></span>
              <span class="fvf-initials">{heroPost.initials}</span>
            </div>
          )}
        </div>
        <div class="featured-content">
          <span class="pillar-tag"><i></i>{heroPost.pillar}</span>
          <h2 id="blog-featured-title">{heroPost.title}</h2>
          <p class="featured-excerpt">{heroPost.excerpt}</p>
          <div class="post-meta">
            {heroPost.author?.name && <span>{heroPost.author.name}</span>}
            {heroPost.publishedAt && <span>{fmtDate(heroPost.publishedAt)}</span>}
            {heroPost.readingTime && <span>{heroPost.readingTime} min read</span>}
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="wrap blog-grid-section" id="blog-grid-section" aria-label="All articles">
    {/* Filters are part of the content body, not a section of their own —
        they live inside the grid they filter. role="toolbar" names them for
        assistive tech now that they are no longer a labelled section. */}
    <div class="blog-filters" role="toolbar" aria-label="Filter articles" data-reveal>
    {categories.map((c) => (
      <button class="filter-chip" data-category={c}>{c}</button>
    ))}
    </div>
    <ul class="blog-grid">
      {restPosts.map((p: any, i: number) => (
        <li data-reveal data-reveal-delay={(Math.min(i % 6, 5) * 0.05).toFixed(2)} data-category={p.pillar}>
          <a href={`/blog/${p.slug}`} style={`--card-accent: ${p.accent}`}>
            <div class="post-thumb-wrap">
              {p.coverUrl ? (
                <img src={p.coverUrl} alt={p.coverAlt} loading="lazy" class="post-thumb" />
              ) : (
                <div class="post-thumb post-thumb-fallback" aria-hidden="true">
                  <span class="post-thumb-grid"></span>
                  <span class="post-thumb-initials">{p.initials}</span>
                </div>
              )}
              <span class="thumb-dot" aria-hidden="true"></span>
              <span class="thumb-arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="9 5 19 5 19 15"></polyline></svg>
              </span>
            </div>
            <div class="post-content">
              <span class="post-category">{p.pillar}</span>
              <h3>{p.title}</h3>
              <p class="post-excerpt">{p.excerpt}</p>
              <div class="post-meta">
                {p.author?.name && <span>{p.author.name}</span>}
                {p.readingTime && <span>{p.readingTime} min read</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>

<style>
  .blog-hero { padding-block: var(--space-page-head) var(--space-section-sm); }
  .blog-hero-content h1 { max-width: 16ch; margin-bottom: var(--gap-5); font-size: var(--fluid-h1); }
  .blog-hero-content p { font-size: var(--t-body); color: var(--fg-muted); max-width: 50ch; }

  /* ── Featured card: state 1 — the one bold thing on the page ── */
  .blog-featured { padding-bottom: var(--space-section-sm); }
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-6);
    text-decoration: none;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-surface-elevated);
    border: 0;
    transition: border-color 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);  }
  @media (min-width: 768px) {
    .featured-card { grid-template-columns: 1.1fr 1fr; gap: 0; }
  }
  .featured-card:hover { }
  .featured-visual { aspect-ratio: 16/10; overflow: hidden; position: relative; }
  @media (min-width: 768px) { .featured-visual { aspect-ratio: auto; height: 100%; min-height: 420px; } }
  .featured-visual img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .featured-card:hover .featured-visual img { transform: scale(1.035); }
  .featured-visual-fallback {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(120% 100% at 0% 0%, color-mix(in srgb, var(--card-accent) 30%, transparent), transparent 60%),
      linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%);
  }
  .fvf-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--card-accent) 10%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--card-accent) 10%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .fvf-initials {
    position: relative; font-family: var(--font-display); font-weight: var(--font-weight-extrabold);
    font-size: clamp(3rem, 8vw, 5.5rem); color: var(--fg); opacity: var(--opacity-strong); line-height: 1;
  }
  .featured-content { padding: var(--gap-8); display: flex; flex-direction: column; justify-content: center; gap: var(--gap-4); }
  .pillar-tag { display: inline-flex; align-items: center; gap: var(--gap-2); align-self: flex-start; font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--card-accent); }
  .pillar-tag i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--card-accent); font-style: normal; }
  .featured-content h2 { font-size: var(--fluid-h2); line-height: var(--core-line-height-tight); color: var(--fg); max-width: 22ch; }
  .featured-excerpt { color: var(--fg-muted); font-size: var(--fluid-body-md); line-height: 1.65; max-width: 56ch; }

  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-3); font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .post-meta span:not(:last-child)::after {
    content: ''; display: inline-block; width: 1px; height: 0.85em; background: var(--line-strong); margin-left: var(--gap-3); vertical-align: -0.1em;
  }

  /* ── Filters ── */
  .blog-filters { display: flex; gap: var(--gap-2); flex-wrap: wrap; margin-bottom: var(--gap-8); } /* top space comes from the section now */
  .filter-chip { font-family: var(--font-mono); font-size: var(--t-sm); padding: var(--gap-2) var(--gap-4); border: 0; border-radius: var(--r-pill); background: transparent; color: var(--fg-muted); cursor: pointer; transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .filter-chip:hover { color: var(--fg); }
  .filter-chip.active { color: var(--fg); background: color-mix(in srgb, var(--neutral-0) 10%, transparent); }

  /* ── Grid: state 2 — the quiet, repeatable card ── */
  .blog-grid-section { border-top: var(--stroke-thin) solid var(--line); padding-block: var(--space-section-md) var(--space-section-xl); }
  .blog-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
  .blog-grid a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);  }
  .blog-grid a:hover { transform: translateY(-3px); }
  .post-thumb-wrap { position: relative; overflow: hidden; aspect-ratio: 4/3; flex-shrink: 0; border-radius: var(--radius-lg); }
  .post-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .blog-grid a:hover .post-thumb { transform: scale(1.06); }
  .thumb-dot {
    position: absolute; top: var(--gap-3); left: var(--gap-3); width: 9px; height: 9px; border-radius: 50%;
    background: var(--card-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-surface-page) 55%, transparent);
  }
  .thumb-arrow {
    position: absolute; top: var(--gap-3); right: var(--gap-3); width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; color: var(--color-surface-page);
    background: var(--fg); opacity: 0; transform: scale(0.7) translateY(4px);
    transition: opacity var(--duration-normal) ease, transform var(--duration-normal) cubic-bezier(0.16, 1, 0.3, 1);  }
  .blog-grid a:hover .thumb-arrow { opacity: 1; transform: scale(1) translateY(0); }

  .post-content { padding: var(--gap-5) var(--gap-1) 0; display: flex; flex-direction: column; flex: 1; gap: var(--gap-2); }
  .post-category { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: 0.04em; text-transform: uppercase; color: var(--card-accent); }
  .blog-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); line-height: var(--lh-h5); color: var(--fg); }
  .post-excerpt { font-size: var(--t-sm); color: var(--fg-muted); line-height: var(--lh-s); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .blog-grid .post-meta { margin-top: var(--gap-1); }

  /* Fallback (no-cover) thumb — its own visual state, not a broken image */
  .post-thumb-fallback {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: var(--gap-4);
    width: 100%; height: 100%;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--card-accent) 32%, transparent), transparent 55%),
      linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%);
  }
  .post-thumb-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--card-accent) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--card-accent) 8%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .post-thumb-initials {
    position: relative; font-family: var(--font-display); font-size: var(--fluid-h1); font-weight: var(--font-weight-extrabold);
    line-height: 1; color: var(--fg); opacity: var(--opacity-strong);
  }

  .blog-grid li.hidden { display: none; }
</style>

<script>
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = (chip as HTMLElement).dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('.blog-grid li').forEach(item => {
        const el = item as HTMLElement;
        if (cat === 'All' || el.dataset.category === cat) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
