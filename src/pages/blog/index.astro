---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { postsListQuery } from '../../lib/queries';

const posts = await sanityClient.fetch(postsListQuery).catch(() => []);
const allCategories = [...new Set(posts.map((p: any) => p.category).filter(Boolean))];
const categories = ['All', ...allCategories];
---

<BaseLayout title="Blog" description="Wugweb | Insights on UI/UX Design & Digital Strategy">
  <section class="blog-hero">
    <div class="wrap blog-hero-content">
      <p class="eyebrow" data-reveal>Articles</p>
      <h1 data-reveal>Insights on design, product, and digital strategy from the Wugweb team.</h1>
    </div>
  </section>

  <section class="wrap blog-filters" data-reveal>
    {categories.map((c) => (
      <button class="filter-chip" data-category={c}>{c}</button>
    ))}
  </section>

  <section class="wrap blog-grid-section">
    <ul class="blog-grid">
      {posts.map((p: any) => (
        <li data-reveal data-category={p.category || ''}>
          <a href={`/blog/${p.slug}`}>
            <span class="post-category">{p.category}</span>
            <h3>{p.title}</h3>
            {p.author?.name && <p class="blog-author">{p.author.name}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .blog-hero { padding-block: 8rem 4rem; }
  .blog-hero-content h1 { font-size: var(--t-h2); font-weight: 400; max-width: 28ch; margin-top: 1rem; }
  .blog-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; padding-bottom: 2rem; }
  .filter-chip { font-family: var(--font-mono); font-size: 0.8rem; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: var(--r-pill); background: transparent; color: var(--fg-muted); cursor: pointer; transition: border-color 0.2s, color 0.2s; }
  .filter-chip:hover { border-color: var(--fg); color: var(--fg); }
  .filter-chip.active { border-color: var(--accent); color: var(--accent); background: rgba(255, 190, 26, 0.1); }
  .blog-grid-section { border-top: 1px solid var(--line); padding-block: 4rem 6rem; }
  .blog-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
  .blog-grid a { text-decoration: none; display: block; border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .post-category { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-warm); text-transform: uppercase; }
  .blog-grid h3 { font-size: 1.1rem; font-weight: 400; margin-top: 0.5rem; }
  .blog-author { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); margin-top: 0.25rem; }
  .blog-grid li.hidden { display: none; }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.blog-grid li', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('.blog-grid li').forEach(item => {
        if (cat === 'All' || item.dataset.category === cat) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
