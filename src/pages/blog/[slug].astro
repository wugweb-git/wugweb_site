---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { postBySlugQuery, postsListQuery } from '../../lib/queries';

export async function getStaticPaths() {
  const list = await sanityClient.fetch(postsListQuery).catch(() => []);
  return list.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(postBySlugQuery, { slug }).catch(() => null);

if (!post) {
  return Astro.redirect('/404');
}

const readTime = post.readingTime ? `${post.readingTime} min read` : '';
const authorName = post.author?.name || '';
const pubDate = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<BaseLayout title={`${post.title} — Wugweb Insights`} description={(post.excerpt || '').slice(0, 160)}>
  <section class="wrap article">
    <p class="eyebrow"><a href="/blog">Blog</a></p>
    <h1>{post.title}</h1>
    <div class="article-meta">
      {post.category && <span class="article-category">{post.category}</span>}
      {authorName && <span>{authorName}</span>}
      {readTime && <span>{readTime}</span>}
      {pubDate && <span>{pubDate}</span>}
    </div>
    {post.excerpt && <p class="article-intro">{post.excerpt}</p>}

    {post.body && post.body.length > 0 && (
      <div class="article-body" set:html={post.body.map((block: any) => {
        const text = block.children?.map((c: any) => c.text).join('') || '';
        if (block.style === 'h2') return `<h2>${text}</h2>`;
        return `<p>${text}</p>`;
      }).filter(Boolean).join('')}>
      </div>
    )}

    {post.tags && post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map((t: string) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .article { padding-block: 8rem; max-width: 720px; }
  .article .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .article .eyebrow a:hover { color: var(--fg); }
  .article h1 { font-size: var(--t-h2); margin-top: 1rem; line-height: 1.1; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-muted); }
  .article-category { color: var(--accent-warm); }
  .article-intro { font-size: 1.2rem; line-height: 1.6; margin-top: 2rem; color: var(--fg); border-left: 2px solid var(--accent-warm); padding-left: 1.5rem; }
  .article-body { margin-top: 3rem; }
  .article-body h2 { font-size: 1.35rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .article-body p { line-height: 1.8; color: var(--fg-muted); margin-top: 0.5rem; }
  .article-tags { display: flex; gap: 0.5rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .tag { font-family: var(--font-mono); font-size: 0.75rem; padding: 0.35rem 0.85rem; border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--fg-muted); }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.article-body h2, .article-body p', (el) => {
    animate(el, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
