---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor, getPreviewClient } from '../../lib/sanity';
import { postBySlugQuery, postsListQuery } from '../../lib/queries';



const { slug } = Astro.params;

// Preview mode: when the /api/preview cookie is set, fetch draft content
// with the request-scoped token so Sanity Studio preview links work.
const previewToken = (Astro.locals as any)?.previewToken as string | undefined;
const client = previewToken ? getPreviewClient(previewToken) : sanityClient;
const post = await client.fetch(postBySlugQuery, { slug }).catch(() => null);

if (!post) {
  return Astro.redirect('/404');
}

const readTime = post.readingTime ? `${post.readingTime} min read` : '';
const authorName = post.author?.name || '';
const authorPhoto = post.author?.photo ? urlFor(post.author.photo).width(120).height(120).url() : '';
const pubDate = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const updatedAt = post._updatedAt ? new Date(post._updatedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const isUpdated = updatedAt && updatedAt !== pubDate;
const coverImageUrl = post.coverPath
  ? (post.coverPath.startsWith('/') || post.coverPath.startsWith('http') ? post.coverPath : `/${post.coverPath}`)
  : (post.coverImage ? urlFor(post.coverImage).width(1280).height(720).url() : '');
const ogImageUrl = post.ogImage
  ? urlFor(post.ogImage).width(1200).height(630).url()
  : coverImageUrl;
const pageTitle = post.seoTitle || post.title;
const pageDescription = (post.seoDescription || post.excerpt || '').slice(0, 160);

// Table of contents — derived from the body's h2/h3 blocks.
function slugify(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
const toc = (post.body || [])
  .map((b: any) => ({ style: b.style, text: b.children?.map((c: any) => c.text).join('') || '' }))
  .filter((b: any) => (b.style === 'h2' || b.style === 'h3') && b.text);

// Fetch featured case studies for recommendations instead of more post blocks.
const caseStudies = await sanityClient.fetch(`*[_type == "caseStudy"]{ title, "slug": slug.current, client, disciplines, coverPath, thumbnailPath }`).catch(() => []);
const featuredCases = caseStudies.slice(0, 2);
const allPosts = await sanityClient.fetch(postsListQuery).catch(() => []);

// Prev / next by publishedAt.
const sorted = [...(allPosts as any[])]
  .filter((p: any) => p.publishedAt)
  .sort((a: any, b: any) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime());
const idx = sorted.findIndex((p: any) => p.slug === slug);
const prevPost = idx > 0 ? sorted[idx - 1] : null;
const nextPost = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;

// Share links (absolute URL for social cards).
const shareUrl = new URL(`/blog/${slug}`, Astro.site || 'https://wugweb.com').toString();
const shareText = encodeURIComponent(post.title || '');
const shareLinks = [
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareText}`, icon: 'X' },
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`, icon: 'Li' },
  { label: 'Share on WhatsApp', href: `https://wa.me/?text=${shareText}%20${encodeURIComponent(shareUrl)}`, icon: 'Wa' },
  { label: 'Copy link', href: shareUrl, icon: '#' },
];
---

<BaseLayout title={`${post.title} — Wugweb Insights`} description={pageDescription} seoTitle={pageTitle} ogImage={ogImageUrl}>
  <section class="wrap article">
    <p class="eyebrow"><a href="/blog">Blog</a></p>
    <h1>{post.title}</h1>
    <div class="article-meta">
      {post.category && <span class="article-category">{post.category}</span>}
      {authorName && <span>{authorName}</span>}
      {readTime && <span>{readTime}</span>}
      {pubDate && <span>{pubDate}</span>}
      {isUpdated && <span class="article-updated">Updated {updatedAt}</span>}
    </div>
    {post.excerpt && <p class="article-intro">{post.excerpt}</p>}

    {coverImageUrl && (
      <figure class="article-cover">
        <img src={coverImageUrl} alt={`Cover image for ${post.title}`} loading="eager" decoding="async" />
      </figure>
    )}

    {toc.length > 0 && (
      <nav class="article-toc" aria-label="Table of contents">
        <p class="toc-title">In this article</p>
        <ol>
          {toc.map((t: any) => (
            <li class:list={['toc-item', { 'toc-h3': t.style === 'h3' }]}>
              <a href={`#${slugify(t.text)}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {post.body && post.body.length > 0 ? (
      <div class="article-body" set:html={post.body.map((block: any) => {
        const text = block.children?.map((c: any) => c.text).join('') || '';
        if (block.style === 'h2') return `<h2 id="${slugify(text)}">${text}</h2>`;
        if (block.style === 'h3') return `<h3 id="${slugify(text)}">${text}</h3>`;
        return `<p>${text}</p>`;
      }).filter(Boolean).join('')}>
      </div>
    ) : (
      <div class="article-empty">
        <p>Full article coming soon. Browse more <a href="/blog">insights</a>.</p>
      </div>
    )}

    {post.author && (
      <aside class="glass-panel article-author">
        <div class="card-glow"></div>
        {authorPhoto && <img src={authorPhoto} alt={authorName} class="author-photo" />}
        <div class="author-info">
          {authorName && <p class="author-name">{authorName}</p>}
          {post.author.role && <p class="author-role">{post.author.role}</p>}
          {post.author.bio && <p class="author-bio">{post.author.bio}</p>}
        </div>
      </aside>
    )}

    {post.tags && post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map((t: string) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )}

    <div class="article-share">
      <span class="share-label">Share</span>
      <div class="share-links">
        {shareLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="share-link" aria-label={s.label} data-copy={s.icon === '#' ? shareUrl : undefined}>{s.icon}</a>
        ))}
      </div>
    </div>

    <aside class="glass-panel article-newsletter">
      <div class="card-glow"></div>
      <p class="eyebrow">Newsletter</p>
      <h2>Get insights like this in your inbox</h2>
      <p>Design, product, and digital strategy — no spam, just thoughtful content.</p>
      <form class="nl-form" method="POST" action="/api/subscribe">
        <input type="email" name="email" placeholder="you@company.com" required autocomplete="email" class="nl-input" />
        <button type="submit" class="btn btn-solid">Subscribe</button>
      </form>
    </aside>

    {(prevPost || nextPost) && (
      <nav class="article-prevnext" aria-label="More articles">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="glass-panel pn-link pn-prev">
            <div class="card-glow"></div>
            <span class="pn-dir">← Previous</span>
            <span class="pn-title">{prevPost.title}</span>
          </a>
        ) : <span class="pn-link pn-placeholder"></span>}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="glass-panel pn-link pn-next">
            <div class="card-glow"></div>
            <span class="pn-dir">Next →</span>
            <span class="pn-title">{nextPost.title}</span>
          </a>
        ) : <span class="pn-link pn-placeholder"></span>}
      </nav>
    )}

    {featuredCases.length > 0 && (
      <section class="article-related">
        <div class="related-cases-head">
          <h2>Featured Case Studies</h2>
          <a href="/work" class="btn btn-ghost">View all work</a>
        </div>
        <div class="related-cases-grid">
          {featuredCases.map((c: any) => {
            const assetUrl = (path: string) => {
              if (!path) return '';
              return path.startsWith('/') || path.startsWith('http') ? path : `/${path}`;
            };
            const cCover = c.coverPath ? assetUrl(c.coverPath) : (c.thumbnailPath ? assetUrl(c.thumbnailPath) : '');
            return (
              <a href={`/work/${c.slug || ''}`} class="glass-panel related-case-card">
                <div class="card-glow"></div>
                {cCover && (
                  <div class="related-case-visual">
                    {cCover.endsWith('.mp4') || cCover.endsWith('.webm')
                      ? <video src={cCover} muted loop playsinline autoplay preload="none"></video>
                      : <img src={cCover} alt="" loading="lazy" />}
                  </div>
                )}
                <div class="related-case-content">
                  <span class="related-case-client">{c.client}</span>
                  <h3>{c.title}</h3>
                  {c.disciplines?.length > 0 && <span class="related-case-discipline">{c.disciplines.join(', ')}</span>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  /* Glass panels and effects */
  .glass-panel {
    background: color-mix(in srgb, var(--neutral-8) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--neutral-0) 12%, transparent);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 200px at var(--mouse-x, 50%) var(--mouse-y, 50%), color-mix(in srgb, var(--color-accent-primary) 8%, transparent) 0%, transparent 85%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    pointer-events: none;
  }

  .glass-panel:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }
  .glass-panel:hover .card-glow {
    opacity: 1;
  }

  .article { padding-block: var(--space-section-xl); max-width: 720px; }
  .article .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .article .eyebrow a:hover { color: var(--fg); }
  .article h1 { font-size: var(--t-h2); margin-top: var(--gap-3); line-height: var(--core-line-height-tight); color: var(--fg); }
  .article-meta { display: flex; flex-wrap: wrap; gap: var(--gap-3) var(--gap-6); margin-top: var(--gap-5); font-family: var(--font-mono); font-size: var(--t-sm); color: var(--fg-muted); }
  .article-category { color: var(--color-accent-primary); }
  .article-intro { font-size: var(--t-lead); line-height: var(--core-line-height-relaxed); margin-top: var(--gap-7); color: var(--fg); border-left: 2px solid var(--color-accent-primary); padding-left: var(--gap-6); }
  
  .article-cover { margin: var(--gap-10) 0 0; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--line); transition: transform 0.4s ease; }
  .article-cover:hover { transform: scale(1.01); }
  .article-cover img { width: 100%; height: auto; display: block; transition: transform 0.6s ease; }
  .article-cover:hover img { transform: scale(1.03); }

  .article-body { margin-top: var(--gap-10); }
  .article-body h2 { font-size: var(--t-h4); margin-top: var(--gap-10); margin-bottom: var(--gap-3); color: var(--fg); border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-6); }
  .article-body h3 { font-size: var(--t-lead); margin-top: var(--gap-7); margin-bottom: var(--gap-2); color: var(--fg); }
  .article-body p { line-height: var(--core-line-height-relaxed); color: var(--fg-muted); margin-top: var(--gap-3); font-size: var(--fluid-body-md); }
  .article-empty { margin-top: var(--gap-10); padding: var(--gap-6); border: 1px dashed var(--line); border-radius: var(--r-3); color: var(--fg-muted); }
  .article-empty a { color: var(--color-accent-primary); text-decoration: underline; }
  
  .article-author { display: flex; align-items: center; gap: var(--gap-6); margin-top: var(--gap-10); padding: var(--gap-6); }
  .author-photo { width: 80px; height: 80px; border-radius: var(--radius-full); object-fit: cover; border: 1px solid var(--line); z-index: 1; position: relative; }
  .author-info { z-index: 1; position: relative; }
  .author-name { font-weight: var(--font-weight-medium); color: var(--fg); font-size: var(--fluid-body-lg); }
  .author-role { font-size: var(--t-sm); color: var(--fg-muted); }
  .author-bio { font-size: var(--fluid-body-sm); color: var(--fg-muted); margin-top: var(--gap-2); line-height: var(--lh-body); }
  
  .article-tags { display: flex; flex-wrap: wrap; gap: var(--gap-2); margin-top: var(--gap-8); }
  .tag { font-family: var(--font-mono); font-size: var(--t-micro); padding: var(--gap-1) var(--gap-3); border: var(--stroke-thin) solid var(--line); border-radius: var(--r-pill); color: var(--fg-muted); }
  .article-updated { opacity: var(--opacity-soft); }

  .article-toc { margin-top: var(--gap-10); padding: var(--gap-6); border: var(--stroke-thin) solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .toc-title { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .06em; color: var(--color-accent-primary); margin-bottom: var(--gap-4); }
  .article-toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-2); }
  .toc-item a { color: var(--fg-muted); text-decoration: none; font-size: var(--fluid-body-sm); line-height: var(--core-line-height-normal); }
  .toc-item a:hover { color: var(--color-accent-primary); }
  .toc-h3 { padding-left: var(--gap-4); }
  .toc-h3 a { font-size: var(--fluid-body-sm); }

  .article-share { display: flex; align-items: center; gap: var(--gap-4); margin-top: var(--gap-10); padding-top: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  .share-label { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .06em; color: var(--fg-muted); }
  .share-links { display: flex; gap: var(--gap-2); }
  .share-link { display: inline-flex; align-items: center; justify-content: center; width: var(--share-btn); height: var(--share-btn); border-radius: var(--radius-full); border: var(--stroke-thin) solid var(--line); color: var(--fg-muted); text-decoration: none; font-family: var(--font-mono); font-size: var(--t-sm); transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .share-link:hover { border-color: var(--color-accent-primary); color: var(--color-accent-primary); background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent); }

  .article-newsletter { margin-top: var(--gap-10); padding: var(--gap-8); text-align: center; }
  .article-newsletter * { position: relative; z-index: 1; }
  .article-newsletter .eyebrow { display: block; margin-bottom: var(--gap-3); }
  .article-newsletter h2 { font-size: var(--t-h4); max-width: 24ch; margin-inline: auto; color: var(--fg); }
  .article-newsletter p:not(.eyebrow) { margin-top: var(--gap-2); color: var(--fg-muted); }
  .nl-form { display: flex; gap: var(--gap-3); margin-top: var(--gap-6); max-width: 420px; margin-inline: auto; }
  .nl-input { flex: 1; padding: var(--gap-3) var(--gap-4); border: var(--stroke-thin) solid var(--line); border-radius: var(--radius-sm); background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: var(--fluid-body-md); transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .nl-input:focus { border-color: var(--color-accent-primary); outline: none; box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-primary) 20%, transparent); }

  .article-prevnext { display: grid; gap: var(--gap-4); margin-top: var(--gap-10); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .article-prevnext { grid-template-columns: 1fr 1fr; } }
  .pn-link { display: flex; flex-direction: column; gap: var(--gap-1); padding: var(--gap-5); text-decoration: none; }
  .pn-link * { position: relative; z-index: 1; }
  .pn-link:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); }
  .pn-next { text-align: right; }
  .pn-dir { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--color-accent-primary); }
  .pn-title { color: var(--fg); font-weight: var(--font-weight-medium); font-size: var(--fluid-body-md); line-height: var(--core-line-height-normal); }
  .pn-placeholder { visibility: hidden; }

  .article-related { margin-top: var(--gap-12); padding-top: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  .related-cases-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--gap-6); }
  .related-cases-head h2 { font-size: var(--t-h3); margin: 0; color: var(--fg); }
  .related-cases-grid { display: grid; gap: var(--gap-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .related-cases-grid { grid-template-columns: repeat(2, 1fr); } }
  .related-case-card { text-decoration: none; display: flex; flex-direction: column; height: 100%; border-radius: var(--radius-xl); overflow: hidden; }
  .related-case-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2); }
  .related-case-visual { width: 100%; height: 200px; overflow: hidden; position: relative; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--neutral-10) 20%, transparent); }
  .related-case-visual img, .related-case-visual video { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .related-case-card:hover .related-case-visual img, .related-case-card:hover .related-case-visual video { transform: scale(1.04); }
  .related-case-content { padding: var(--gap-5) var(--gap-6) var(--gap-6); display: flex; flex-direction: column; gap: var(--gap-2); position: relative; z-index: 1; }
  .related-case-client { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent-primary); }
  .related-case-card h3 { font-size: var(--t-h4); font-weight: var(--font-weight-bold); color: var(--fg); margin: 0; line-height: var(--core-line-height-tight); }
  .related-case-discipline { font-size: var(--fluid-body-sm); color: var(--fg-muted); margin-top: var(--gap-1); }
</style>

<script>
  // Copy-link share button.
  document.querySelectorAll('[data-copy]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const url = el.getAttribute('data-copy') || '';
      navigator.clipboard?.writeText(url).then(() => {
        el.textContent = '✓';
        setTimeout(() => { el.textContent = '#'; }, 1200);
      }).catch(() => {});
    });
  });

  // Mouse tracking card glow animation
  const initGlows = () => {
    const cards = document.querySelectorAll('.glass-panel');
    cards.forEach((card) => {
      const glow = card.querySelector('.card-glow') as HTMLElement | null;
      if (!glow) return;
      
      card.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = me.clientX - rect.left;
        const y = me.clientY - rect.top;
        glow.style.setProperty('--mouse-x', `${x}px`);
        glow.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  };

  initGlows();
  document.addEventListener('astro:page-load', initGlows);
</script>
