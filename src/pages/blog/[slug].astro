---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityClient, urlFor, getPreviewClient } from '../../lib/sanity';
import { postBySlugQuery, postsListQuery } from '../../lib/queries';
import { assetUrl, posterFor } from '../../lib/assets';
import { loadAssetAlts, altFor } from '../../lib/asset-alt';

const { slug } = Astro.params;

const previewToken = (Astro.locals as any)?.previewToken as string | undefined;
const client = previewToken ? getPreviewClient(previewToken) : sanityClient;
const post = await client.fetch(postBySlugQuery, { slug }).catch(() => null);

if (!post) {
  return Astro.rewrite('/404');
}

// One fixed site accent for every blog post — per-category pillar colors
// (teal/pink/orange per post) read as arbitrary rather than intentional
// on an article page. Single accent, used consistently sitewide.
const accent = 'var(--color-accent-primary)';

const readTime = post.readingTime ? `${post.readingTime} min read` : '';
const authorName = post.author?.name || '';
const authorPhoto = post.author?.photoPath
  ? assetUrl(post.author.photoPath)
  : post.author?.photo ? urlFor(post.author.photo).width(120).height(120).url() : '';
const authorLinks = (post.author?.socialLinks || []).filter((l: any) => l?.url);
const pubDate = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const coverImageUrl = post.coverPath
  ? assetUrl(post.coverPath)
  : (post.coverImage ? urlFor(post.coverImage).width(1600).height(900).url() : '');
const coverAlt = altFor(await loadAssetAlts(), post.coverPath, `Cover image for ${post.title}`);
const ogImageUrl = post.ogImagePath
  ? assetUrl(post.ogImagePath)
  : post.ogImage
    ? urlFor(post.ogImage).width(1200).height(630).url()
    : coverImageUrl;
const pageTitle = post.seoTitle || post.title;
const pageDescription = (post.seoDescription || post.excerpt || '').slice(0, 160);

// 25 of 100 posts carry a WordPress-import publishedAt like
// "2023-03-17 12:00:11" — a space instead of T and no timezone, which is not
// valid ISO 8601 and therefore not a valid schema.org Date. Normalised at
// render rather than mutated in Sanity: the stored value is what WordPress
// actually recorded, and rewriting 25 documents to satisfy a serialiser is the
// wrong direction. Returns undefined rather than an invalid date if it cannot
// be parsed, so JsonLd prunes it.
const isoDate = (value: unknown): string | undefined => {
  if (typeof value !== 'string' || !value) return undefined;
  const parsed = new Date(value.includes('T') ? value : value.replace(' ', 'T') + 'Z');
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
};

const SITE = 'https://www.wugweb.com';
const canonicalHref = post.canonicalUrl
  ? new URL(post.canonicalUrl, SITE).toString()
  : `${SITE}/blog/${slug}`;
const authorSameAs = (post.author?.socialLinks || [])
  .map((l: any) => (typeof l === 'string' ? l : l?.url))
  .filter((u: any) => typeof u === 'string' && /^https?:\/\//.test(u));

// BlogPosting for answer engines. author is a real person reference, which is
// the EEAT signal that matters most on editorial content; publisher points at
// the sitewide Organization node rather than restating it.
const blogPostingNode = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: pageDescription,
  image: ogImageUrl || undefined,
  datePublished: isoDate(post.publishedAt),
  // No "last updated" on posts (owner decision 2026-10-13): dateModified = datePublished.
  dateModified: isoDate(post.publishedAt),
  // The founder already exists as a Person node in BaseLayout's graph; point at it
  // instead of restating him, so his sameAs carries over.
  // "Wugweb Design" is the studio byline, not a person: point it at the Organization node.
  author: post.author?.name === 'Vedanshu Srivastava'
    ? { '@id': `${SITE}/#founder` }
    : /^wugweb\b/i.test(post.author?.name || '')
    ? { '@id': `${SITE}/#organization` }
    : post.author?.name
    ? {
        '@type': 'Person',
        name: post.author.name,
        jobTitle: post.author.role,
        url: `${SITE}/about`,
        sameAs: authorSameAs.length ? authorSameAs : undefined,
      }
    : undefined,
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalHref },
  keywords: post.tags?.length ? post.tags.join(', ') : undefined,
};

const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonicalHref },
  ],
};

function slugify(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
const toc = (post.body || [])
  .map((b: any) => ({ style: b.style, text: b.children?.map((c: any) => c.text).join('') || '' }))
  .filter((b: any) => (b.style === 'h2' || b.style === 'h3') && b.text);

// Migration artifact: the excerpt field and the body's first paragraph are
// byte-identical on most posts (confirmed on 70/100) — the intro line
// already shown under the title gets repeated verbatim as the first line
// of the article body. Drop that one duplicate block, nothing else.
const firstBlockText = post.body?.[0]?.children?.map((c: any) => c.text).join('').trim();
const bodyBlocks = (post.excerpt && firstBlockText === post.excerpt.trim())
  ? post.body.slice(1)
  : post.body;

const rawCaseStudies = await sanityClient.fetch(`*[_type == "caseStudy"]{ title, "slug": slug.current, client, disciplines, coverPath, thumbnailPath }`).catch(() => []);
const seenCases = new Set();
const caseStudies = [];
for (const cs of (rawCaseStudies || [])) {
  if (cs && cs.slug && !seenCases.has(cs.slug)) {
    seenCases.add(cs.slug);
    caseStudies.push(cs);
  }
}
const featuredCases = caseStudies.slice(0, 2);

const rawAllPosts = await sanityClient.fetch(postsListQuery).catch(() => []);
const seenAllPosts = new Set();
const allPosts = [];
for (const p of (rawAllPosts || [])) {
  if (p && p.slug && !seenAllPosts.has(p.slug)) {
    seenAllPosts.add(p.slug);
    allPosts.push(p);
  }
}

const sorted = [...(allPosts as any[])]
  .filter((p: any) => p.publishedAt)
  .sort((a: any, b: any) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime());
const idx = sorted.findIndex((p: any) => p.slug === slug);
const prevPost = idx > 0 ? sorted[idx - 1] : null;
const nextPost = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;

// Related posts: the editor's picks (post.relatedPosts) first, then the same
// category, then the latest — three cards, never the post itself.
const coverFor = (p: any) => p?.coverPath
  ? assetUrl(p.coverPath)
  : (p?.coverImage ? urlFor(p.coverImage).width(800).height(500).url() : '');
const relatedPosts: any[] = [];
const seenRelated = new Set([slug]);
for (const p of [
  ...(post.relatedPosts || []),
  ...allPosts.filter((p: any) => post.category && p.category === post.category),
  ...allPosts,
]) {
  if (relatedPosts.length >= 3) break;
  if (p?.slug && !seenRelated.has(p.slug)) { seenRelated.add(p.slug); relatedPosts.push(p); }
}

const shareUrl = new URL(`/blog/${slug}`, SITE).toString();
const shareText = encodeURIComponent(post.title || '');
const shareLinks = [
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareText}`, icon: 'X' },
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`, icon: 'Li' },
  { label: 'Share on WhatsApp', href: `https://wa.me/?text=${shareText}%20${encodeURIComponent(shareUrl)}`, icon: 'Wa' },
  { label: 'Copy link', href: shareUrl, icon: '#' },
];
---

<BaseLayout title={`${post.title} | Wugweb Insights`} description={pageDescription} seoTitle={pageTitle} ogImage={ogImageUrl} ogTitle={post.ogTitle} ogDescription={post.ogDescription} noIndex={post.noIndex} canonicalPath={post.canonicalUrl} jsonLd={[blogPostingNode, breadcrumbNode]}>
  <div id="reading-progress" class="reading-progress-bar" style={`--bar-accent: ${accent}`} aria-hidden="true"></div>

  {/* Same order and widths as a case study: title block at the 1200 content
      width, the cover below it at 1200, then a 720 reading column. */}
  <section class="article-hero" id="article-hero" aria-labelledby="article-hero-title" style={`--accent: ${accent}`}>
    <div class="wrap" lang={post.language || undefined}>
      <h1 id="article-hero-title" data-reveal>{post.title}</h1>
      {post.excerpt && <p class="article-intro" data-reveal>{post.excerpt}</p>}
      {post.tags?.length > 0 && (
        <ul class="article-tags" aria-label="Tags" data-reveal>
          {post.tags.map((t: string) => <li class="u-tag">{t}</li>)}
        </ul>
      )}
      <dl class="article-meta" data-reveal>
        {authorName && (
          <div>
            <dt class="meta-label">Author</dt>
            <dd class="meta-author">{authorPhoto && <img src={authorPhoto} alt="" class="meta-avatar" />}{authorName}</dd>
          </div>
        )}
        {pubDate && <div><dt class="meta-label">Published</dt><dd><time datetime={isoDate(post.publishedAt)}>{pubDate}</time></dd></div>}
        {readTime && <div><dt class="meta-label">Reading time</dt><dd>{readTime}</dd></div>}
        {post.category && <div><dt class="meta-label">Category</dt><dd>{post.category}</dd></div>}
      </dl>
    </div>
  </section>

  {coverImageUrl && (
    <section class="wrap article-cover" id="article-cover" aria-label="Cover image" data-reveal>
      <figure class="article-cover-media">
        <img src={coverImageUrl} alt={coverAlt} loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </section>
  )}

  <section class="wrap article" style={`--accent: ${accent}`} id="article" aria-label="Article" lang={post.language || undefined}>
    {toc.length > 0 && (
      <nav class="article-toc" aria-label="Table of contents">
        <p class="toc-title">Contents</p>
        <ol>
          {toc.map((t: any) => (
            <li class:list={['toc-item', { 'toc-h3': t.style === 'h3' }]}>
              <a href={`#${slugify(t.text)}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {bodyBlocks && bodyBlocks.length > 0 ? (
      <PortableTextRenderer value={bodyBlocks} class="article-body" />
    ) : (
      <div class="article-empty">
        <p>Full article coming soon. Browse more <a href="/blog">insights</a>.</p>
      </div>
    )}

    {post.syndicatedTo?.length > 0 && (
      <p class="article-syndicated">Also published on {post.syndicatedTo.join(', ')}.</p>
    )}

    {post.author?.bio && (
      <aside class="article-author" aria-label="About the author">
        {authorPhoto && <img src={authorPhoto} alt={authorName} class="author-photo" />}
        <div class="author-info">
          {authorName && <p class="author-name">{authorName}</p>}
          {post.author.role && <p class="author-role">{post.author.role}</p>}
          <p class="author-bio">{post.author.bio}</p>
          {authorLinks.length > 0 && (
            <ul class="author-links" aria-label={`${authorName} elsewhere`}>
              {authorLinks.map((l: any) => <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.platform || 'Profile'}</a></li>)}
            </ul>
          )}
        </div>
      </aside>
    )}

    <div class="article-share" role="group" aria-label="Share this article">
      <span class="share-label">Share</span>
      <div class="share-links">
        {shareLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="share-link" aria-label={s.label} data-copy={s.icon === '#' ? shareUrl : undefined}>{s.icon}</a>
        ))}
      </div>
    </div>

    <aside class="article-newsletter" aria-labelledby="newsletter-title">
      <h2 id="newsletter-title">Get insights like this in your inbox</h2>
      <p>Design, product, and digital strategy. No spam, just thoughtful content.</p>
      <form class="nl-form" method="POST" action="/api/subscribe">
        <input type="email" name="email" aria-label="Email address" placeholder="you@company.com" required autocomplete="email" class="nl-input" />
        <button type="submit" class="btn btn-solid">Subscribe</button>
      </form>
    </aside>

    {(prevPost || nextPost) && (
      <nav class="article-prevnext" aria-label="Previous and next articles">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="pn-link pn-prev">
            <span class="pn-dir">Previous</span>
            <span class="pn-title">{prevPost.title}</span>
          </a>
        ) : <span class="pn-link pn-placeholder"></span>}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="pn-link pn-next">
            <span class="pn-dir">Next</span>
            <span class="pn-title">{nextPost.title}</span>
          </a>
        ) : <span class="pn-link pn-placeholder"></span>}
      </nav>
    )}
  </section>

  {relatedPosts.length > 0 && (
    <section class="wrap article-related" id="related-posts" aria-labelledby="related-posts-title">
      <div class="related-head">
        <h2 id="related-posts-title">More insights</h2>
        <a href="/blog" class="btn btn-ghost">All insights</a>
      </div>
      <ul class="related-grid is-posts">
        {relatedPosts.map((p: any) => {
          const pCover = coverFor(p);
          return (
            <li>
              <a href={`/blog/${p.slug}`} class="related-card">
                <div class="related-visual">
                  {pCover ? <img src={pCover} alt="" loading="lazy" /> : <span class="related-visual-empty" aria-hidden="true"></span>}
                </div>
                <div class="related-content">
                  {p.category && <span class="related-kicker">{p.category}</span>}
                  <h3>{p.title}</h3>
                  {p.readingTime && <span class="related-sub">{p.readingTime} min read</span>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {featuredCases.length > 0 && (
    <section class="wrap article-related" id="related-cases" aria-labelledby="related-cases-title">
      <div class="related-head">
        <h2 id="related-cases-title">Featured case studies</h2>
        <a href="/work" class="btn btn-ghost">View all work</a>
      </div>
      <ul class="related-grid">
        {featuredCases.map((c: any) => {
          const toPath = (path: string) => (!path ? '' : assetUrl(path));
          const cCover = c.coverPath ? toPath(c.coverPath) : (c.thumbnailPath ? toPath(c.thumbnailPath) : '');
          return (
            <li>
              <a href={`/work/${c.slug || ''}`} class="related-card">
                {cCover && (
                  <div class="related-visual">
                    {cCover.endsWith('.mp4') || cCover.endsWith('.webm')
                      ? <video aria-hidden="true" data-src={cCover} poster={posterFor(cCover)} muted loop playsinline preload="none"></video>
                      : <img src={cCover} alt="" loading="lazy" />}
                  </div>
                )}
                <div class="related-content">
                  <span class="related-kicker">{c.client}</span>
                  <h3>{c.title}</h3>
                  {c.disciplines?.length > 0 && <span class="related-sub">{c.disciplines.join(', ')}</span>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* Hero — title block at the 1200 content width, as on a case study. */
  .article-hero h1 { font-size: var(--t-display); font-weight: var(--font-weight-extrabold); line-height: var(--core-line-height-tight); color: var(--fg); max-width: 22ch; overflow-wrap: break-word; }
  .article-intro { font-size: var(--fluid-h5); line-height: 1.4; margin-top: var(--gap-4); color: var(--fg-muted); max-width: 56ch; }
  .article-tags { list-style: none; margin: var(--gap-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .article-meta { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-4) var(--gap-8); margin: var(--gap-10) 0 0; border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-6); }
  @media (min-width: 768px) { .article-meta { grid-template-columns: repeat(5, max-content); } }
  .article-meta > div { display: flex; flex-direction: column; gap: var(--gap-1); }
  .article-meta dd { margin: 0; font-size: var(--fluid-body-md); color: var(--fg); font-weight: var(--font-weight-medium); }
  .meta-label { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg-muted); }
  .meta-author { display: flex; align-items: center; gap: var(--gap-2); }
  .meta-avatar { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }

  /* Cover — below the title, full content width. */
  .article-cover-media { margin: 0; border-radius: var(--radius-xl); overflow: hidden; }
  .article-cover-media img { width: 100%; height: auto; max-height: 720px; aspect-ratio: 16 / 9; display: block; object-fit: cover; }

  /* Reading column: full-width section, 720 carved by padding. */
  .article { padding-inline: max(var(--shell-gutter), calc((100% - 720px) / 2)); }
  .article-syndicated { margin-top: var(--gap-8); font-size: var(--fluid-body-sm); color: var(--fg-muted); }
  .author-links { list-style: none; margin: var(--gap-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-4); }
  .author-links a { font-size: var(--fluid-body-sm); color: var(--fg); }

  .article-body { max-width: 72ch; }
  .article-body h2 { font-size: var(--t-h4); font-weight: var(--font-weight-semibold); margin-top: var(--gap-12); margin-bottom: var(--gap-4); color: var(--fg); border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-7); line-height: var(--lh-tight); }
  .article-body h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-8); margin-bottom: var(--gap-3); color: var(--fg); }
  .article-body p { line-height: 1.8; color: var(--fg-muted); margin-top: var(--gap-5); font-size: var(--fluid-body-md); }
  .article-body p:first-child { margin-top: 0; }
  .article-body ul, .article-body ol { margin-top: var(--gap-4); padding-left: var(--gap-6); color: var(--fg-muted); line-height: 1.75; }
  .article-body li { margin-top: var(--gap-2); }
  .article-body blockquote { margin: var(--gap-8) 0; padding: var(--gap-5) var(--gap-7); border-left: var(--stroke-medium) solid var(--accent); background: var(--color-surface-elevated); border-radius: 0 var(--radius-md) var(--radius-md) 0; font-style: italic; color: var(--fg); }
  .article-body strong { color: var(--fg); font-weight: var(--font-weight-semibold); }
  /* --neutral-1 is a LIGHT surface (#F4F4F4). Neither rule set a colour, so
     text inherited the near-white --fg and would have been invisible the
     moment anyone published a code block. No post contains one today, which
     is why this was never seen — latent, not live. The border was also
     --line (white at 5% alpha), invisible on a light surface. */
  .article-body code { font-family: var(--font-mono); font-size: 0.85em; background: var(--neutral-1); color: var(--color-ash); padding: 0.15em 0.4em; border-radius: var(--r-1); border: var(--stroke-thin) solid color-mix(in srgb, var(--color-ash) 15%, transparent); }
  .article-body pre { margin: var(--gap-6) 0; padding: var(--gap-6); background: var(--neutral-1); color: var(--color-ash); border: var(--stroke-thin) solid color-mix(in srgb, var(--color-ash) 15%, transparent); border-radius: var(--radius-md); overflow-x: auto; }
  .article-body pre code { background: none; padding: 0; border: none; font-size: var(--t-sm); }
  .article-empty { margin-top: var(--gap-10); padding: var(--gap-6); border: var(--stroke-thin) dashed var(--line); border-radius: var(--r-3); color: var(--fg-muted); }
  .article-empty a { color: var(--accent); text-decoration: underline; }

  .article-author { display: flex; align-items: center; gap: var(--gap-6); margin-top: var(--gap-10); padding: var(--gap-6); background: var(--color-surface-elevated); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .author-photo { width: 80px; height: 80px; border-radius: var(--radius-full); object-fit: cover; border: var(--stroke-thin) solid var(--line); z-index: 1; position: relative; }
  .author-info { z-index: 1; position: relative; }
  .author-name { font-weight: var(--font-weight-medium); color: var(--fg); font-size: var(--fluid-body-lg); }
  .author-role { font-size: var(--t-sm); color: var(--fg-muted); }
  .author-bio { font-size: var(--fluid-body-sm); color: var(--fg-muted); margin-top: var(--gap-2); line-height: var(--lh-body); }


  /* ── TOC: light marginalia, not a boxed component ── */
  .article-toc { margin-bottom: var(--gap-9); }
  .toc-title { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .06em; color: var(--fg-muted); margin-bottom: var(--gap-3); display: block; }
  .article-toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--gap-1); }
  .toc-item a { color: var(--fg-muted); text-decoration: none; font-size: var(--fluid-body-sm); line-height: var(--core-line-height-normal); padding: var(--gap-1) 0 var(--gap-1) var(--gap-3); border-left: var(--stroke-thin) solid var(--line); transition: color 0.2s ease, border-color 0.2s ease; display: block; }
  .toc-item a:hover { color: var(--fg); border-color: var(--accent); }
  .toc-h3 a { padding-left: var(--gap-6); font-size: var(--fluid-body-sm); }

  .article-share { display: flex; align-items: center; gap: var(--gap-4); margin-top: var(--gap-10); padding-top: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  .share-label { font-family: var(--font-mono); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .06em; color: var(--fg-muted); }
  .share-links { display: flex; gap: var(--gap-2); }
  .share-link { display: inline-flex; align-items: center; justify-content: center; width: var(--share-btn); height: var(--share-btn); border-radius: var(--radius-full); border: var(--stroke-thin) solid var(--line); color: var(--fg-muted); text-decoration: none; font-family: var(--font-mono); font-size: var(--t-sm); transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .share-link:hover { border-color: var(--accent); color: var(--fg); }

  .article-newsletter { margin-top: var(--gap-10); padding: var(--gap-8); text-align: center; background: var(--color-surface-elevated); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .article-newsletter * { position: relative; z-index: 1; }
  .article-newsletter .eyebrow { display: block; margin-bottom: var(--gap-3); color: var(--accent); }
  .article-newsletter h2 { font-size: var(--t-h4); max-width: 24ch; margin-inline: auto; color: var(--fg); }
