---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import { postBySlugQuery, postsListQuery } from '../../lib/queries';

export async function getStaticPaths() {
  const list = await sanityClient.fetch(postsListQuery).catch(() => []);
  return list.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(postBySlugQuery, { slug }).catch(() => null);

if (!post) {
  return Astro.redirect('/404');
}

const readTime = post.readingTime ? `${post.readingTime} min read` : '';
const authorName = post.author?.name || '';
const authorPhoto = post.author?.photo ? urlFor(post.author.photo).width(120).height(120).url() : '';
const pubDate = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const coverImageUrl = post.coverImage ? urlFor(post.coverImage).width(1280).height(720).url() : '';
const ogImageUrl = post.ogImage
  ? urlFor(post.ogImage).width(1200).height(630).url()
  : coverImageUrl;
const pageTitle = post.seoTitle || post.title;
const pageDescription = (post.seoDescription || post.excerpt || '').slice(0, 160);
---

<BaseLayout title={`${post.title} — Wugweb Insights`} description={pageDescription} seoTitle={pageTitle} ogImage={ogImageUrl}>
  <section class="wrap article">
    <p class="eyebrow"><a href="/blog">Blog</a></p>
    <h1>{post.title}</h1>
    <div class="article-meta">
      {post.category && <span class="article-category">{post.category}</span>}
      {authorName && <span>{authorName}</span>}
      {readTime && <span>{readTime}</span>}
      {pubDate && <span>{pubDate}</span>}
    </div>
    {post.excerpt && <p class="article-intro">{post.excerpt}</p>}

    {coverImageUrl && (
      <figure class="article-cover">
        <img src={coverImageUrl} alt={`Cover image for ${post.title}`} loading="eager" decoding="async" />
      </figure>
    )}

    {post.body && post.body.length > 0 ? (
      <div class="article-body" set:html={post.body.map((block: any) => {
        const text = block.children?.map((c: any) => c.text).join('') || '';
        if (block.style === 'h2') return `<h2>${text}</h2>`;
        if (block.style === 'h3') return `<h3>${text}</h3>`;
        return `<p>${text}</p>`;
      }).filter(Boolean).join('')}>
      </div>
    ) : (
      <div class="article-empty">
        <p>Full article coming soon. Browse more <a href="/blog">insights</a>.</p>
      </div>
    )}

    {post.author && (
      <aside class="article-author">
        {authorPhoto && <img src={authorPhoto} alt={authorName} class="author-photo" />}
        <div>
          {authorName && <p class="author-name">{authorName}</p>}
          {post.author.role && <p class="author-role">{post.author.role}</p>}
        </div>
      </aside>
    )}

    {post.tags && post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map((t: string) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .article { padding-block: var(--space-section-xl); max-width: 720px; }
  .article .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .article .eyebrow a:hover { color: var(--fg); }
  .article h1 { font-size: var(--t-h2); margin-top: var(--gap-3); line-height: 1.1; }
  .article-meta { display: flex; flex-wrap: wrap; gap: var(--gap-3) var(--gap-6); margin-top: var(--gap-5); font-family: var(--font-mono); font-size: var(--t-sm); color: var(--fg-muted); }
  .article-category { color: var(--accent-warm); }
  .article-intro { font-size: var(--t-lead); line-height: var(--core-line-height-relaxed); margin-top: var(--gap-7); color: var(--fg); border-left: 2px solid var(--accent-warm); padding-left: var(--gap-6); }
  .article-cover { margin: var(--gap-10) 0 0; border-radius: var(--r-4); overflow: hidden; }
  .article-cover img { width: 100%; height: auto; display: block; }
  .article-body { margin-top: var(--gap-10); }
  .article-body h2 { font-size: var(--t-h4); margin-top: var(--gap-10); margin-bottom: var(--gap-3); }
  .article-body h3 { font-size: var(--t-lead); margin-top: var(--gap-7); margin-bottom: var(--gap-2); color: var(--fg); }
  .article-body p { line-height: var(--core-line-height-relaxed); color: var(--fg-muted); margin-top: var(--gap-3); }
  .article-empty { margin-top: var(--gap-10); padding: var(--gap-6); border: 1px dashed var(--line); border-radius: var(--r-3); color: var(--fg-muted); }
  .article-empty a { color: var(--accent-warm); text-decoration: underline; }
  .article-author { display: flex; align-items: center; gap: var(--gap-4); margin-top: var(--gap-10); padding-top: var(--gap-8); border-top: 1px solid var(--line); }
  .author-photo { width: 56px; height: 56px; border-radius: var(--r-full); object-fit: cover; }
  .author-name { font-weight: var(--font-weight-medium); color: var(--fg); }
  .author-role { font-size: var(--t-sm); color: var(--fg-muted); }
  .article-tags { display: flex; gap: var(--gap-2); margin-top: var(--gap-8); padding-top: var(--gap-8); border-top: 1px solid var(--line); }
  .tag { font-family: var(--font-mono); font-size: var(--t-sm); padding: var(--gap-2) var(--gap-3); border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--fg-muted); }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.article-body h2, .article-body p', (el) => {
    animate(el, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
