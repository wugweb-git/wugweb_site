  .related-visual-empty { position: absolute; inset: 0; background: radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--color-yellow) 18%, transparent), transparent 55%), linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%); }
  .related-card:hover .related-visual img, .related-card:hover .related-visual video { transform: scale(1.04); }
  .related-content { padding: var(--gap-5) var(--gap-6) var(--gap-6); display: flex; flex-direction: column; gap: var(--gap-2); }
