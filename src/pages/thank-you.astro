---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You — Wugweb" description="Your message has been sent. We'll be in touch soon.">
  <section class="wrap thank-you" id="thank-you" aria-labelledby="thank-you-title">
    
    <h1 id="thank-you-title">Thanks, we'll be in touch.</h1>
    <p>
      A member of our team will review your message and get back to you within one business day.
    </p>
    <div class="thank-you-actions">
      <a href="/" class="btn btn-solid">Back to Home</a>
    </div>
  </section>
</BaseLayout>
<style>
  .thank-you {
    padding-block: var(--space-section-xl) var(--space-section-lg);
    text-align: center;
  }
  .thank-you .eyebrow { color: var(--accent); }
  .thank-you h1 {
    margin-top: var(--gap-4);
    font-size: var(--fluid-h2);
    max-width: 18ch;
    margin-inline: auto;
  }
  .thank-you p {
    margin-top: var(--gap-5);
    max-width: 45ch;
    margin-inline: auto;
    color: var(--fg-muted);
  }
  .thank-you-actions {
    display: flex;
    gap: var(--gap-4);
    justify-content: center;
    margin-top: var(--gap-10);
  }
</style>
