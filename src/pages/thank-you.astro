---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You — Wugweb" description="Your message has been sent. We'll be in touch soon.">
  <section class="wrap thank-you" style="padding-block: 8rem 6rem; text-align: center;">
    <p class="eyebrow">Message Sent</p>
    <h1 style="margin-top: 1rem; font-size: var(--t-h2); max-width: 18ch; margin-inline: auto;">Thanks, we'll be in touch.</h1>
    <p style="margin-top: 1.25rem; max-width: 45ch; margin-inline: auto;">
      A member of our team will review your message and get back to you within one business day.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2.5rem;">
      <a href="/" class="btn btn-solid">Back to Home</a>
    </div>
  </section>
</BaseLayout>
<style>
  .thank-you .eyebrow { color: var(--accent); }
  .thank-you p { color: var(--fg-muted); }
</style>
