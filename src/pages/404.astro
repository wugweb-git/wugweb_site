---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>Seems this page is not available.</h1>
    <p>Would like to play a game with us till then?</p>
    <div class="game" id="game">
      <span class="cell" data-cell></span><span class="cell" data-cell></span><span class="cell" data-cell></span>
      <span class="cell" data-cell></span><span class="cell" data-cell></span><span class="cell" data-cell></span>
      <span class="cell" data-cell></span><span class="cell" data-cell></span><span class="cell" data-cell></span>
    </div>
    <a href="/" class="btn btn-solid">Back to Home</a>
  </section>
</BaseLayout>

<style>
  .not-found { padding-block: var(--space-section-xl); text-align: center; }
  .not-found h1 { font-size: var(--t-h2); margin-block: var(--gap-3); }
  .not-found p { margin-bottom: var(--gap-8); }
  .game { display: grid; grid-template-columns: repeat(3, var(--control-size)); gap: var(--gap-1); justify-content: center; margin-bottom: var(--gap-12); }
  .cell { width: var(--control-size); height: var(--control-size); background: var(--bg-elevated); border: var(--stroke-thin) solid var(--line); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: var(--fluid-h3); cursor: pointer; font-family: var(--font-display); transition: background var(--duration-fast) var(--easing-out); }
  .cell:hover { background: var(--line); }
</style>

<script>
  const cells = document.querySelectorAll('[data-cell]');
  let turn = 'X';
  let board = Array(9).fill(null);

  function checkWinner() {
    const wins = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    for (const [a,b,c] of wins) {
      if (board[a] && board[a] === board[b] && board[a] === board[c]) return board[a];
    }
    return board.every(Boolean) ? 'draw' : null;
  }

  cells.forEach((cell, i) => {
    cell.addEventListener('click', () => {
      if (board[i] || checkWinner()) return;
      board[i] = turn;
      cell.textContent = turn;
      const winner = checkWinner();
      if (winner) {
        setTimeout(() => alert(winner === 'draw' ? "It's a draw!" : `${winner} wins!`), 50);
      }
      turn = turn === 'X' ? 'O' : 'X';
    });
  });
</script>
