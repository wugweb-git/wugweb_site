---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudyBySlugQuery, caseStudiesListQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';

export async function getStaticPaths() {
  const list = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
  return list.map((cs: any) => ({ params: { slug: cs.slug } }));
}

const { slug } = Astro.params;
const work = await sanityClient.fetch(caseStudyBySlugQuery, { slug }).catch(() => null);

if (!work) {
  return Astro.redirect('/404');
}

const coverSrc = work.coverPath ? assetUrl(work.coverPath) : '';
const gallery = (work.galleryPaths || []).map((p: string) => assetUrl(p));

const allSlugs = await sanityClient.fetch(`*[_type == "caseStudy"]{"slug": slug.current}`).catch(() => []);
const others = allSlugs.filter((s: any) => s.slug !== slug).slice(0, 2);
const otherCases = await Promise.all(others.map((s: any) =>
  sanityClient.fetch(`*[_type == "caseStudy" && slug.current == $slug][0]{ title, "slug": slug.current, client, disciplines }`, { slug: s.slug }).catch(() => null)
)).then(r => r.filter(Boolean));
---

<BaseLayout title={`${work.title} — Wugweb Work`} description={(work.about || work.summary || '').slice(0, 160)}>
  <section class="work-detail-hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/work">Work</a></p>
      <h1>{work.title}</h1>
      <div class="work-meta">
        <div><span class="meta-label">Client</span><span>{work.client}</span></div>
        {work.disciplines?.length > 0 && <div><span class="meta-label">Disciplines</span><span>{work.disciplines.join(', ')}</span></div>}
        {work.industry && <div><span class="meta-label">Industry</span><span>{work.industry}</span></div>}
        {work.timeline && <div><span class="meta-label">Timeline</span><span>{work.timeline}</span></div>}
      </div>
    </div>
  </section>

  {coverSrc && (
    <section class="wrap section work-cover">
      <img src={coverSrc} alt="" loading="eager" decoding="async" />
    </section>
  )}

  {(work.about || work.summary) && (
    <section class="wrap section">
      <h2>About</h2>
      <p>{work.about || work.summary}</p>
    </section>
  )}

  {work.challenges?.length > 0 && (
    <section class="wrap section">
      <h2>Challenges</h2>
      <div class="grid">
        {work.challenges.map((c: any) => (
          <div class="card"><h3>{c.title}</h3><p>{c.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {work.solutions?.length > 0 && (
    <section class="wrap section">
      <h2>Solutions</h2>
      <div class="grid">
        {work.solutions.map((s: any) => (
          <div class="card"><h3>{s.title}</h3><p>{s.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="wrap section">
      <h2>Gallery</h2>
      <div class="gallery-grid">
        {gallery.map((src: string) => (
          src.endsWith('.mp4') || src.endsWith('.webm')
            ? <video src={src} muted loop playsinline controls preload="none"></video>
            : <img src={src} alt="" loading="lazy" decoding="async" />
        ))}
      </div>
    </section>
  )}

  {work.impact?.length > 0 && (
    <section class="wrap section">
      <h2>Impact</h2>
      <div class="grid">
        {work.impact.map((i: any) => (
          <div class="card"><h3>{i.title}</h3><p>{i.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {otherCases.length > 0 && (
    <section class="wrap section">
      <h2>More Case Studies</h2>
      <div class="more-grid">
        {otherCases.map((c: any) => (
          <a href={`/work/${c.slug || ''}`} class="more-card">
            <h3>{c.title}</h3>
            <p>{c.client}{c.disciplines?.length > 0 ? ` — ${c.disciplines.join(', ')}` : ''}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .work-detail-hero { padding-block: var(--space-section-xl) var(--space-section-md); border-bottom: var(--stroke-thin) solid var(--line); }
  .work-detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .work-detail-hero h1 { font-size: var(--t-h2); margin-top: var(--gap-4); max-width: 20ch; }
  .work-meta { display: grid; grid-template-columns: 1fr; gap: var(--gap-5) var(--gap-6); margin-top: var(--gap-12); max-width: 600px; }
  @media (min-width: 640px) { .work-meta { grid-template-columns: repeat(2, 1fr); } }
  .meta-label { display: block; font-family: var(--font-mono); font-size: var(--fluid-caption); color: var(--accent-warm); text-transform: uppercase; margin-bottom: var(--gap-1); }
  .section { padding-block: var(--space-section-md); border-bottom: var(--stroke-thin) solid var(--line); }
  .section h2 { font-size: var(--t-h3); margin-bottom: var(--gap-6); }
  .section p { max-width: 60ch; line-height: var(--core-line-height-relaxed); color: var(--fg-muted); }
  .work-cover img { width: 100%; height: auto; border-radius: var(--r-2); display: block; }
  .gallery-grid { display: grid; gap: var(--gap-4); margin-top: var(--gap-4); }
  @media (min-width: 768px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  .gallery-grid img, .gallery-grid video { width: 100%; height: auto; border-radius: var(--r-2); display: block; background: var(--surface-2); }
  .grid { display: grid; gap: var(--gap-6); margin-top: var(--gap-4); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .card { border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-4); }
  .card h3 { font-size: var(--fluid-h4); font-weight: var(--font-weight-semibold); margin-bottom: var(--gap-2); }
  .card p { font-size: var(--fluid-body-sm); }
  .more-grid { display: grid; gap: var(--gap-6); margin-top: var(--gap-6); }
  @media (min-width: 768px) { .more-grid { grid-template-columns: repeat(2, 1fr); } }
  .more-card { text-decoration: none; border-top: var(--stroke-thin) solid var(--line); padding-top: var(--gap-4); display: block; }
  .more-card h3 { font-size: var(--fluid-h4); font-weight: var(--font-weight-semibold); color: var(--fg); }
  .more-card p { color: var(--fg-muted); margin-top: var(--gap-1); font-size: var(--fluid-label); }
</style>

