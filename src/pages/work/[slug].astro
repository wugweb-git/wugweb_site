---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudyBySlugQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';
import { getRunningCaseStudyExperiment, pickVariant } from '../../lib/experiments';

const { slug } = Astro.params;
const work = await sanityClient.fetch(caseStudyBySlugQuery, { slug }).catch(() => null);

if (!work) {
  return Astro.redirect('/404');
}

// Legacy/duplicate docs carry canonicalUrl pointing at the real case
// study — this stub's own slug should never render, just hand off.
if (work.canonicalUrl && work.canonicalUrl !== `/work/${slug}`) {
  return Astro.redirect(work.canonicalUrl, 301);
}

const coverSrc = work.coverPath ? assetUrl(work.coverPath) : '';
const bodyContent = Array.isArray(work.bodyContent) ? work.bodyContent : [];
const challenges = Array.isArray(work.challenges) ? work.challenges : [];
const solutions = Array.isArray(work.solutions) ? work.solutions : [];
const impactItems = Array.isArray(work.impact) ? work.impact : [];
const galleryPaths = Array.isArray(work.galleryPaths) ? work.galleryPaths : [];
const results = Array.isArray(work.results) ? work.results : [];

// ── A/B experiment: case-study template redesign ──
const experiment = await getRunningCaseStudyExperiment(String(slug)).catch(() => null);
let variant = 'control';
if (experiment) {
  const cookieName = `exp_${experiment._id}`;
  const queryOverride = Astro.url.searchParams.get('variant');
  if (queryOverride && experiment.variants.some((v) => v.id === queryOverride)) {
    variant = queryOverride;
  } else {
    const existing = Astro.cookies.get(cookieName)?.value;
    variant = pickVariant(experiment, existing);
    if (existing !== variant) {
      Astro.cookies.set(cookieName, variant, { path: '/', maxAge: 60 * 60 * 24 * 30 });
    }
  }
}

// ── v2 (treatment) section index — order is the actual narrative arc, so
// numbering it is earning its keep rather than decorating a non-sequence.
const accentMap: Record<string, string> = {
  yellow: 'var(--color-accent-primary)',
  orange: 'var(--svc-strategy)',
  blue: 'var(--color-accent-blue)',
  green: 'var(--color-feedback-success)',
};
const sectionDefsRaw = [
  { id: 'about', label: 'About', accentKey: 'yellow', show: !!(work.about || work.summary) },
  { id: 'problem', label: 'The problem', accentKey: 'orange', show: challenges.length > 0 },
  { id: 'approach', label: 'The approach', accentKey: 'blue', show: solutions.length > 0 },
  { id: 'outcome', label: 'The outcome', accentKey: 'green', show: impactItems.length > 0 || results.length > 0 },
  { id: 'thesis', label: 'Design thesis', accentKey: 'yellow', show: !!work.designPhilosophy },
];
const sectionDefs = sectionDefsRaw
  .filter((s) => s.show)
  .map((s, i) => ({ ...s, num: String(i + 1).padStart(2, '0'), accent: accentMap[s.accentKey] }));
const numFor = (id: string) => sectionDefs.find((s) => s.id === id)?.num || '';

const allSlugsRaw = await sanityClient.fetch(`*[_type == "caseStudy" && !(_id in path("drafts.**"))]{"slug": slug.current}`).catch(() => []);
const seenSlugs = new Set();
const allSlugs = [];
for (const s of (allSlugsRaw || [])) {
  if (s && s.slug && !seenSlugs.has(s.slug)) {
    seenSlugs.add(s.slug);
    allSlugs.push(s);
  }
}
const others = allSlugs.filter((s: any) => s.slug !== slug).slice(0, 2);
const otherCases = await Promise.all(others.map((s: any) =>
  sanityClient.fetch(`*[_type == "caseStudy" && slug.current == $slug && !(_id in path("drafts.**"))][0]{ title, "slug": slug.current, client, disciplines, coverPath, thumbnailPath }`, { slug: s.slug }).catch(() => null)
)).then(r => r.filter(Boolean));
---

<BaseLayout title={`${work.title} — Wugweb Work`} description={(work.summary || work.about || '').slice(0, 160)}>
  <section class="work-detail-hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/work">Work</a></p>
      <h1>{work.title}</h1>
      {work.subtitle && <p class="work-subtitle">{work.subtitle}</p>}
      <div class="work-meta">
        <div><span class="meta-label">Client</span><span>{work.clientRef?.name || work.client || '—'}</span></div>
        {work.disciplines?.length > 0 && <div><span class="meta-label">Disciplines</span><span>{work.disciplines.join(', ')}</span></div>}
        {work.industry && <div><span class="meta-label">Industry</span><span>{work.industry}</span></div>}
        {work.timeline && <div><span class="meta-label">Timeline</span><span>{work.timeline}</span></div>}
      </div>
    </div>
  </section>

  {coverSrc && (
    <section class="wrap section work-cover" data-reveal>
      {coverSrc.endsWith('.mp4') || coverSrc.endsWith('.webm') ? (
        <video src={coverSrc} muted loop playsinline autoplay preload="metadata" class="work-cover-media" />
      ) : (
        <img src={coverSrc} alt={work.title} loading="eager" decoding="async" class="work-cover-media" />
      )}
    </section>
  )}

  {variant === 'control' && (
  <div class="wrap case-body-content">
    {/* 1. About / Overview */}
    {(work.about || work.summary) && (
      <article class="case-section text-block" data-reveal>
        <h2>About the Project</h2>
        <p class="lead-text">{work.about || work.summary}</p>
      </article>
    )}

    {/* 2. Challenges & Strategic Solutions Grid */}
    {(challenges.length > 0 || solutions.length > 0) && (
      <section class="case-bento-grid" data-reveal>
        {challenges.length > 0 && (
          <div class="bento-col glass-panel challenge-panel">
            <div class="card-glow"></div>
            <div class="panel-header">
              <span class="badge-pill badge-challenge">CHALLENGES</span>
              <h3>The Problem Space</h3>
            </div>
            <ul class="item-list">
              {challenges.map((ch: any) => (
                <li class="item-card">
                  <strong>{ch.title}</strong>
                  {ch.body && <p>{ch.body}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {solutions.length > 0 && (
          <div class="bento-col glass-panel solution-panel">
            <div class="card-glow"></div>
            <div class="panel-header">
              <span class="badge-pill badge-solution">SOLUTIONS</span>
              <h3>Strategic Execution</h3>
            </div>
            <ul class="item-list">
              {solutions.map((sol: any) => (
                <li class="item-card">
                  <strong>{sol.title}</strong>
                  {sol.body && <p>{sol.body}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    {/* 3. Design Philosophy */}
    {work.designPhilosophy && (
      <aside class="philosophy-card glass-panel" data-reveal>
        <div class="card-glow"></div>
        <span class="badge-pill badge-gold">CORE PHILOSOPHY</span>
        <blockquote class="philosophy-quote">
          {work.designPhilosophy.split('\n').map((line: string) => (
            <p>{line}</p>
          ))}
        </blockquote>
      </aside>
    )}

    {/* 4. Business Impact & Outcomes */}
    {impactItems.length > 0 && (
      <section class="case-section text-block" data-reveal>
        <h2>Business Impact & Outcomes</h2>
        <div class="impact-grid">
          {impactItems.map((imp: any) => (
            <div class="impact-card glass-panel">
              <div class="card-glow"></div>
              <strong class="impact-title">{imp.title}</strong>
              {imp.body && <p class="impact-desc">{imp.body}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {/* 5. Results & Metrics */}
    {results.length > 0 && (
      <section class="results-grid" data-reveal>
        {results.map((res: any) => (
          <div class="result-card glass-panel">
            <div class="card-glow"></div>
            <span class="result-metric">{res.metric}</span>
            {res.label && <span class="result-label">{res.label}</span>}
          </div>
        ))}
      </section>
    )}

    {/* 6. Gallery Paths */}
    {galleryPaths.length > 0 && (
      <section class="gallery-section" data-reveal>
        <h2>Visual Narrative & Artifacts</h2>
        <div class="gallery-grid">
          {galleryPaths.map((path: string) => {
            const src = assetUrl(path);
            const isVideo = path.endsWith('.mp4') || path.endsWith('.webm') || path.endsWith('.mov');
            return (
              <figure class="gallery-item glass-panel">
                {isVideo ? (
                  <video src={src} muted loop playsinline autoplay preload="metadata" class="gallery-media" />
                ) : (
                  <img src={src} alt={work.title} loading="lazy" class="gallery-media" />
                )}
              </figure>
            );
          })}
        </div>
      </section>
    )}

    {/* 7. Modular Portable Text Content */}
    {bodyContent && bodyContent.length > 0 && (
      <article class="case-section text-block" data-reveal>
        <PortableTextRenderer value={bodyContent} />
      </article>
    )}
  </div>
  )}

  {variant === 'treatment' && (
  <div class="cs2-shell wrap">
    {sectionDefs.length > 0 && (
      <nav class="cs2-rail" aria-label="Case study sections">
        <ol>
          {sectionDefs.map((s) => (
            <li>
              <a href={`#${s.id}`} data-rail-link={s.id} style={`--rail-accent: ${s.accent}`}>
                <span class="cs2-rail-num">{s.num}</span>
                <span class="cs2-rail-label">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="cs2-content">
      {(work.about || work.summary) && (
        <section id="about" class="cs2-section" data-reveal>
          <h2 class="cs2-heading"><span class="cs2-num" style={`color: ${accentMap.yellow}`}>{numFor('about')}</span>About</h2>
          <p class="cs2-lead">{work.about || work.summary}</p>
        </section>
      )}

      {challenges.length > 0 && (
        <section id="problem" class="cs2-section" data-reveal>
          <h2 class="cs2-heading"><span class="cs2-num" style={`color: ${accentMap.orange}`}>{numFor('problem')}</span>The problem</h2>
          <ul class="cs2-list" style={`--rule-color: ${accentMap.orange}`}>
            {challenges.map((ch: any) => (
              <li><strong>{ch.title}</strong>{ch.body && <p>{ch.body}</p>}</li>
            ))}
          </ul>
        </section>
      )}

      {solutions.length > 0 && (
        <section id="approach" class="cs2-section" data-reveal>
          <h2 class="cs2-heading"><span class="cs2-num" style={`color: ${accentMap.blue}`}>{numFor('approach')}</span>The approach</h2>
          <ul class="cs2-list" style={`--rule-color: ${accentMap.blue}`}>
            {solutions.map((sol: any) => (
              <li><strong>{sol.title}</strong>{sol.body && <p>{sol.body}</p>}</li>
            ))}
          </ul>
        </section>
      )}

      {(impactItems.length > 0 || results.length > 0) && (
        <section id="outcome" class="cs2-section" data-reveal>
          <h2 class="cs2-heading"><span class="cs2-num" style={`color: ${accentMap.green}`}>{numFor('outcome')}</span>The outcome</h2>
          {results.length > 0 && (
            <div class="cs2-stat-row">
              {results.map((res: any) => (
                <div class="cs2-stat">
                  <span class="cs2-stat-num">{res.metric}</span>
                  {res.label && <span class="cs2-stat-label">{res.label}</span>}
                </div>
              ))}
            </div>
          )}
          {impactItems.length > 0 && (
            <ul class="cs2-list" style={`--rule-color: ${accentMap.green}`}>
              {impactItems.map((imp: any) => (
                <li><strong>{imp.title}</strong>{imp.body && <p>{imp.body}</p>}</li>
              ))}
            </ul>
          )}
        </section>
      )}

      {work.designPhilosophy && (
        <section id="thesis" class="cs2-section" data-reveal>
          <h2 class="cs2-heading"><span class="cs2-num" style={`color: ${accentMap.yellow}`}>{numFor('thesis')}</span>Design thesis</h2>
          <div class="cs2-thesis" style={`--rule-color: ${accentMap.yellow}`}>
            {work.designPhilosophy.split('\n').filter(Boolean).map((line: string) => {
              const idx = line.indexOf(':');
              const head = idx > -1 ? line.slice(0, idx).trim() : '';
              const body = idx > -1 ? line.slice(idx + 1).trim() : '';
              return (
                <blockquote>
                  <p>{body ? <><strong>{head}.</strong> {body}</> : line}</p>
                </blockquote>
              );
            })}
          </div>
        </section>
      )}

      {galleryPaths.length > 0 && (
        <section class="cs2-section cs2-gallery" data-reveal>
          <h2 class="cs2-heading-plain">Gallery</h2>
          <div class="cs2-gallery-grid">
            {galleryPaths.map((path: string) => {
              const src = assetUrl(path);
              const isVideo = path.endsWith('.mp4') || path.endsWith('.webm') || path.endsWith('.mov');
              return (
                <figure class="cs2-gallery-item">
                  {isVideo ? (
                    <video src={src} muted loop playsinline autoplay preload="metadata" />
                  ) : (
                    <img src={src} alt={work.title} loading="lazy" />
                  )}
                </figure>
              );
            })}
          </div>
        </section>
      )}

      {bodyContent && bodyContent.length > 0 && (
        <section class="cs2-section" data-reveal>
          <PortableTextRenderer value={bodyContent} />
        </section>
      )}
    </div>
  </div>
  )}

  {otherCases.length > 0 && (
    <section class="wrap section more-cases-section">
      <div class="more-cases-head">
        <h2>More Case Studies</h2>
        <a href="/work" class="btn btn-ghost">View all work</a>
      </div>
      <div class="more-grid">
        {otherCases.map((c: any) => {
          const cCover = c.coverPath ? assetUrl(c.coverPath) : (c.thumbnailPath ? assetUrl(c.thumbnailPath) : '');
          return (
            <a href={`/work/${c.slug || ''}`} class="glass-panel more-card">
              <div class="card-glow"></div>
              {cCover && (
                <div class="more-card-visual">
                  {cCover.endsWith('.mp4') || cCover.endsWith('.webm')
                    ? <video src={cCover} muted loop playsinline autoplay preload="none"></video>
                    : <img src={cCover} alt="" loading="lazy" />}
                </div>
              )}
              <div class="more-card-content">
                <span class="more-card-client">{c.client}</span>
                <h3>{c.title}</h3>
                {c.disciplines?.length > 0 && <span class="more-card-discipline">{c.disciplines.join(', ')}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .glass-panel {
    background: color-mix(in srgb, var(--neutral-8) 60%, transparent);
    border: var(--stroke-thin) solid color-mix(in srgb, var(--neutral-0) 12%, transparent);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 240px at var(--mouse-x, 50%) var(--mouse-y, 50%), color-mix(in srgb, var(--color-accent-primary) 10%, transparent) 0%, transparent 85%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    pointer-events: none;
  }

  .glass-panel:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }
  .glass-panel:hover .card-glow {
    opacity: 1;
  }

  /* Hero design */
  .work-detail-hero {
    padding-top: var(--space-section-xl);
    padding-bottom: var(--space-section-md);
    position: relative;
  }
  .work-detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .work-detail-hero .eyebrow a:hover { color: var(--fg); }
  .work-detail-hero h1 {
    font-size: var(--t-display);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--core-line-height-tight);
    margin-top: var(--gap-4);
    color: var(--fg);
    max-width: 22ch;
  }
  .work-subtitle {
    font-size: var(--fluid-body-lg);
    color: var(--fg-muted);
    margin-top: var(--gap-3);
    max-width: 60ch;
  }

  .work-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4) var(--gap-8);
    margin-top: var(--gap-10);
    border-top: var(--stroke-thin) solid var(--line);
    padding-top: var(--gap-6);
  }
  @media (min-width: 768px) {
    .work-meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .work-meta > div {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .work-meta span:not(.meta-label) {
    font-size: var(--fluid-body-md);
    color: var(--fg);
    font-weight: var(--font-weight-medium);
  }

  .work-cover {
    padding-block: var(--space-section-sm);
  }
  .work-cover-media {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: var(--stroke-thin) solid var(--line);
    display: block;
  }

  /* Single-column adaptive UX content */
  .case-body-content {
    max-width: 960px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-section-lg);
    padding-block: var(--space-section-md) var(--space-section-lg);
  }

  .case-section {
    width: 100%;
  }

  .text-block h2 {
    font-size: var(--t-h3);
    font-weight: var(--font-weight-bold);
    color: var(--fg);
    margin-bottom: var(--gap-6);
    border-bottom: var(--stroke-thin) solid var(--line);
    padding-bottom: var(--gap-3);
  }

  .lead-text {
    font-size: var(--fluid-body-lg);
    line-height: var(--core-line-height-relaxed);
    color: var(--color-text-secondary, #bababa);
  }

  /* Bento Comparison Grid */
  .case-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-6);
  }
  @media (min-width: 768px) {
    .case-bento-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-8);
    }
  }

  .bento-col {
    padding: var(--gap-7);
    display: flex;
    flex-direction: column;
    gap: var(--gap-5);
  }
  .panel-header h3 {
    font-size: var(--t-h4);
    color: var(--fg);
    margin: var(--gap-2) 0 0 0;
  }

  .badge-pill {
    font-family: var(--core-font-family-mono, monospace);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold, 700);
    letter-spacing: 0.08em;
    padding: 3px var(--gap-2);
    border-radius: var(--radius-xs, 4px);
    display: inline-block;
  }
  .badge-challenge { background: rgba(250, 65, 8, 0.15); color: var(--svc-strategy); border: var(--stroke-thin) solid rgba(250, 65, 8, 0.3); }
  .badge-solution { background: rgba(62, 210, 25, 0.15); color: var(--color-feedback-success); border: var(--stroke-thin) solid rgba(62, 210, 25, 0.3); }
  .badge-gold {
    background: color-mix(in srgb, var(--color-accent-primary) 15%, transparent);
    color: var(--color-accent-primary);
    border: var(--stroke-thin) solid color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }

  .item-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-4);
  }
  .item-card {
    padding: var(--gap-4) var(--gap-4);
    border-radius: var(--radius-sm, 6px);
    background: rgba(255, 255, 255, 0.02);
    border: var(--stroke-thin) solid rgba(255, 255, 255, 0.04);
  }
  .item-card strong {
    color: var(--fg);
    font-size: var(--fluid-body-md);
    display: block;
    margin-bottom: var(--gap-1);
  }
  .item-card p {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--fluid-body-sm);
    line-height: 1.55;
  }

  /* Philosophy Card */
  .philosophy-card {
    padding: var(--gap-8);
    border-left: var(--stroke-thick) solid var(--color-accent-primary);
    display: flex;
    flex-direction: column;
    gap: var(--gap-4);
  }
  .philosophy-quote {
    margin: 0;
    padding: 0;
    font-size: var(--fluid-h3, 1.375rem);
    font-weight: var(--font-weight-medium, 500);
    line-height: 1.5;
    color: var(--fg);
  }
  .philosophy-quote p {
    margin: 0;
  }

  /* Impact Grid */
  .impact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4);
  }
  @media (min-width: 640px) {
    .impact-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-6);
    }
  }
  .impact-card {
    padding: var(--gap-6);
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
  }
  .impact-title {
    font-size: var(--fluid-body-lg);
    color: var(--color-accent-primary);
  }
  .impact-desc {
    margin: 0;
    font-size: var(--fluid-body-md);
    color: var(--fg-muted);
    line-height: 1.6;
  }

  /* Results / Stats */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--gap-4);
  }
  .result-card {
    padding: var(--gap-6);
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
    text-align: center;
  }
  .result-metric {
    font-size: var(--fluid-h2, 2.25rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-primary);
  }
  .result-label {
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
  }

  /* Gallery Grid */
  .gallery-section h2 {
    font-size: var(--t-h3);
    color: var(--fg);
    margin-bottom: var(--gap-6);
    border-bottom: var(--stroke-thin) solid var(--line);
    padding-bottom: var(--gap-3);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-6);
  }
  .gallery-item {
    border-radius: var(--radius-xl);
    overflow: hidden;
