---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudyBySlugQuery, caseStudiesListQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';


const { slug } = Astro.params;
const work = await sanityClient.fetch(caseStudyBySlugQuery, { slug }).catch(() => null);

if (!work) {
  return Astro.redirect('/404');
}

const coverSrc = work.coverPath ? assetUrl(work.coverPath) : '';
const gallery = (work.galleryPaths || []).map((p: string) => assetUrl(p));

const allSlugsRaw = await sanityClient.fetch(`*[_type == "caseStudy"]{"slug": slug.current}`).catch(() => []);
const seenSlugs = new Set();
const allSlugs = [];
for (const s of (allSlugsRaw || [])) {
  if (s && s.slug && !seenSlugs.has(s.slug)) {
    seenSlugs.add(s.slug);
    allSlugs.push(s);
  }
}
const others = allSlugs.filter((s: any) => s.slug !== slug).slice(0, 2);
const otherCases = await Promise.all(others.map((s: any) =>
  sanityClient.fetch(`*[_type == "caseStudy" && slug.current == $slug][0]{ title, "slug": slug.current, client, disciplines, coverPath, thumbnailPath }`, { slug: s.slug }).catch(() => null)
)).then(r => r.filter(Boolean));
---

<BaseLayout title={`${work.title} — Wugweb Work`} description={(work.about || work.summary || '').slice(0, 160)}>
  <section class="work-detail-hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/work">Work</a></p>
      <h1>{work.title}</h1>
      <div class="work-meta">
        <div><span class="meta-label">Client</span><span>{work.client}</span></div>
        {work.disciplines?.length > 0 && <div><span class="meta-label">Disciplines</span><span>{work.disciplines.join(', ')}</span></div>}
        {work.industry && <div><span class="meta-label">Industry</span><span>{work.industry}</span></div>}
        {work.timeline && <div><span class="meta-label">Timeline</span><span>{work.timeline}</span></div>}
      </div>
    </div>
  </section>

  {coverSrc && (
    <section class="wrap section work-cover">
      <img src={coverSrc} alt="" loading="eager" decoding="async" />
    </section>
  )}

  <!-- SINGLE-COLUMN ADAPTIVE UX BODY CONTENT -->
  <div class="wrap case-body-content">
    
    <!-- About Section -->
    {(work.about || work.summary) && (
      <article class="case-section text-block" data-reveal>
        <h2>About the Project</h2>
        <p class="lead-text">{work.about || work.summary}</p>
      </article>
    )}

    <!-- Challenges Section -->
    {work.challenges?.length > 0 && (
      <article class="case-section text-block" data-reveal>
        <h2>Challenges</h2>
        <div class="flat-list">
          {work.challenges.map((c: any) => (
            <div class="flat-item">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))}
        </div>
      </article>
    )}

    <!-- Solutions Section -->
    {work.solutions?.length > 0 && (
      <article class="case-section text-block" data-reveal>
        <h2>Solutions</h2>
        <div class="flat-list">
          {work.solutions.map((s: any) => (
            <div class="flat-item">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </article>
    )}

    <!-- Full Body Content (Sanity blocks) -->
    {work.body && work.body.length > 0 && (
      <article class="case-section text-block" data-reveal>
        <h2>Project Narrative</h2>
        <div class="portable-text" set:html={work.body.map((block: any) => {
          const text = block.children?.map((c: any) => c.text).join('') || '';
          if (block.style === 'h3') return `<h3>${text}</h3>`;
          return `<p>${text}</p>`;
        }).filter(Boolean).join('')}></div>
      </article>
    )}

    <!-- Immersive Gallery (Media expands to fill width) -->
    {gallery.length > 0 && (
      <div class="case-section media-full-width" data-reveal>
        {gallery.map((src: string) => (
          <div class="media-container">
            {src.endsWith('.mp4') || src.endsWith('.webm')
              ? <video src={src} muted loop playsinline controls preload="none"></video>
              : <img src={src} alt="" loading="lazy" decoding="async" />}
          </div>
        ))}
      </div>
    )}

    <!-- Impact Section -->
    {work.impact?.length > 0 && (
      <article class="case-section text-block" data-reveal>
        <h2>Impact</h2>
        <div class="flat-list impact-list">
          {work.impact.map((i: any) => (
            <div class="flat-item metric-item">
              <span class="metric-val">{i.title}</span>
              <p>{i.body}</p>
            </div>
          ))}
        </div>
      </article>
    )}

  </div>

  {otherCases.length > 0 && (
    <section class="wrap section more-cases-section">
      <div class="more-cases-head">
        <h2>More Case Studies</h2>
        <a href="/work" class="btn btn-ghost">View all work</a>
      </div>
      <div class="more-grid">
        {otherCases.map((c: any) => {
          const cCover = c.coverPath ? assetUrl(c.coverPath) : (c.thumbnailPath ? assetUrl(c.thumbnailPath) : '');
          return (
            <a href={`/work/${c.slug || ''}`} class="glass-panel more-card">
              <div class="card-glow"></div>
              {cCover && (
                <div class="more-card-visual">
                  {cCover.endsWith('.mp4') || cCover.endsWith('.webm')
                    ? <video src={cCover} muted loop playsinline autoplay preload="none"></video>
                    : <img src={cCover} alt="" loading="lazy" />}
                </div>
              )}
              <div class="more-card-content">
                <span class="more-card-client">{c.client}</span>
                <h3>{c.title}</h3>
                {c.disciplines?.length > 0 && <span class="more-card-discipline">{c.disciplines.join(', ')}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Glass panels and animations */
  .glass-panel {
    background: color-mix(in srgb, var(--neutral-8) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--neutral-0) 12%, transparent);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 220px at var(--mouse-x, 50%) var(--mouse-y, 50%), color-mix(in srgb, var(--color-accent-primary) 10%, transparent) 0%, transparent 85%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    pointer-events: none;
  }

  .glass-panel:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }
  .glass-panel:hover .card-glow {
    opacity: 1;
  }

  /* Hero design */
  .work-detail-hero {
    padding-top: var(--space-section-xl);
    padding-bottom: var(--space-section-md);
    position: relative;
  }
  .work-detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .work-detail-hero .eyebrow a:hover { color: var(--fg); }
  .work-detail-hero h1 {
    font-size: var(--t-display);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--core-line-height-tight);
    margin-top: var(--gap-4);
    color: var(--fg);
    max-width: 20ch;
  }

  .work-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4) var(--gap-8);
    margin-top: var(--gap-10);
    border-top: var(--stroke-thin) solid var(--line);
    padding-top: var(--gap-6);
  }
  @media (min-width: 768px) {
    .work-meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .work-meta > div {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .work-meta span:not(.meta-label) {
    font-size: var(--fluid-body-md);
    color: var(--fg);
    font-weight: var(--font-weight-medium);
  }

  .work-cover {
    padding-block: var(--space-section-sm);
  }
  .work-cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
    display: block;
  }

  /* Single-column adaptive UX content */
  .case-body-content {
    max-width: 960px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-section-md);
    padding-block: var(--space-section-md) var(--space-section-lg);
  }

  .case-section {
    width: 100%;
  }

  .text-block h2 {
    font-size: var(--t-h3);
    font-weight: var(--font-weight-bold);
    color: var(--fg);
    margin-bottom: var(--gap-6);
    border-bottom: var(--stroke-thin) solid var(--line);
    padding-bottom: var(--gap-3);
  }

  .lead-text {
    font-size: var(--t-l);
    line-height: var(--lh-l);
    color: var(--fg-muted);
  }

  .flat-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-8);
  }

  .flat-item {
    border-left: 2px solid var(--color-accent-primary);
    padding-left: var(--gap-6);
  }

  .flat-item h3 {
    font-size: var(--t-h4);
    font-weight: var(--font-weight-semibold);
    color: var(--fg);
    margin-bottom: var(--gap-2);
  }

  .flat-item p {
    font-size: var(--fluid-body-md);
    line-height: var(--core-line-height-relaxed);
    color: var(--fg-muted);
  }

  .portable-text p {
    font-size: var(--fluid-body-md);
    line-height: 1.8;
    color: var(--fg-muted);
    margin-bottom: var(--gap-5);
  }
  .portable-text h2 { font-size: var(--t-h4); font-weight: var(--font-weight-semibold); color: var(--fg); margin-top: var(--gap-10); margin-bottom: var(--gap-4); }
  .portable-text h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); color: var(--fg); margin-top: var(--gap-7); margin-bottom: var(--gap-3); }
  .portable-text ul, .portable-text ol { margin-top: var(--gap-4); padding-left: var(--gap-6); color: var(--fg-muted); line-height: 1.75; }
  .portable-text li { margin-top: var(--gap-2); }

  /* Media fills layout width */
  .media-full-width {
    display: flex;
    flex-direction: column;
    gap: var(--gap-8);
  }

  .media-container {
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--neutral-10) 20%, transparent);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .media-container:hover {
    transform: scale(1.015);
  }

  .media-container img, .media-container video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Impact outcome statistics formatting */
  .impact-list {
    gap: var(--gap-6);
  }

  .metric-item {
    border-left: 2px solid var(--color-accent-primary);
    padding-left: var(--gap-6);
  }

  .metric-val {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-h2);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-primary);
    margin-bottom: var(--gap-1);
  }

  /* More cases Redesign */
  .more-cases-section {
    border-top: var(--stroke-thin) solid var(--line);
    padding-top: var(--space-section-lg);
  }
  .more-cases-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--gap-8);
  }
  .more-cases-head h2 {
    font-size: var(--t-h3);
    margin: 0;
    color: var(--fg);
  }
  .more-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-8);
  }
  @media (min-width: 768px) {
    .more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .more-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: var(--stroke-thin) solid var(--line);
    background: var(--neutral-1);
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .more-card:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
    transform: translateY(-5px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.25);
  }
  .more-card-visual {
    width: 100%;
    height: 240px;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--neutral-10) 20%, transparent);
  }
  .more-card-visual img, .more-card-visual video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .more-card:hover .more-card-visual img, .more-card:hover .more-card-visual video {
    transform: scale(1.04);
  }
  .more-card-content {
    padding: var(--gap-6) var(--gap-8) var(--gap-8);
    display: flex;
    flex-direction: column;
    gap: var(--gap-2);
    position: relative;
    z-index: 1;
  }
  .more-card-client {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary);
  }
  .more-card h3 {
    font-size: var(--t-h4);
    font-weight: var(--font-weight-bold);
    color: var(--fg);
    margin: 0;
    line-height: var(--core-line-height-tight);
  }
  .more-card-discipline {
    font-size: var(--fluid-body-sm);
    color: var(--fg-muted);
    margin-top: var(--gap-1);
  }
</style>

<script>
  // Mouse tracking card glow animation
  const initGlows = () => {
    const cards = document.querySelectorAll('.glass-panel');
    cards.forEach((card) => {
      const glow = card.querySelector('.card-glow') as HTMLElement | null;
      if (!glow) return;
      
      card.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = me.clientX - rect.left;
        const y = me.clientY - rect.top;
        glow.style.setProperty('--mouse-x', `${x}px`);
        glow.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  };

  initGlows();
  document.addEventListener('astro:page-load', initGlows);
</script>

