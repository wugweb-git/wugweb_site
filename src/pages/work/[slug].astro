---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityClient, urlFor, getPreviewClient } from '../../lib/sanity';
import { caseStudyBySlugQuery } from '../../lib/queries';
import { assetUrl, posterFor } from '../../lib/assets';
import { loadAssetAlts, altFor } from '../../lib/asset-alt';
import { parseCaseBody, inline } from '../../lib/case-body';

const { slug } = Astro.params;

// Draft preview, matching blog/[slug].astro:9-11. Without this, /api/preview
// set a cookie that did nothing for case studies — editors could only preview
// posts.
const previewToken = (Astro.locals as any)?.previewToken as string | undefined;
const client = previewToken ? getPreviewClient(previewToken) : sanityClient;
const work = await client.fetch(caseStudyBySlugQuery, { slug }).catch(() => null);

if (!work) {
  // One slug per case study (Notion is the source). No legacy slugs, no
  // short-URL redirects: anything that is not an exact slug is a 404.
  return Astro.rewrite('/404');
}

// Legacy/duplicate docs carry canonicalUrl pointing at the real case
// study — this stub's own slug should never render, just hand off.
if (work.canonicalUrl && work.canonicalUrl !== `/work/${slug}`) {
  return Astro.redirect(work.canonicalUrl, 301);
}

const altMap = await loadAssetAlts();
const coverSrc = work.coverPath ? assetUrl(work.coverPath) : '';

// SEO. caseStudyBySlugQuery has always selected seoTitle/seoDescription/ogImage
// (queries.ts:43) but this template ignored all three and hardcoded work.title /
// work.summary into BaseLayout — so 54 of 60 published case studies carried a
// seoTitle and seoDescription that never reached the page, and 19 an ogImage that
// never rendered. Mirrors the blog pattern at blog/[slug].astro:31-35.
// coverSrc may be a relative path; BaseLayout absolutises any non-http value.
const pageTitle = work.seoTitle || work.title;
const pageDescription = (work.seoDescription || work.summary || work.about || '').slice(0, 160);

// og:image resolution is deliberately not the blog's. Measured across all 60
// published case studies: every one of the 19 populated `ogImage` values is a
// plain Framer CDN URL string, not a Sanity image object — so urlFor() would
// throw ("Malformed asset _ref"), and a first pass at this did exactly that,
// 500-ing the page. The object branch is kept only for docs authored later
// through the Studio image picker.
//
// The path fallback must also reject video: thumbnailPath is .mp4 on 33 of 33
// docs that have one, and coverPath on 4 of 33 — an .mp4 in og:image renders
// nothing in any scraper. Anything not an image falls through to the sitewide
// default in BaseLayout.
// Framer-hosted OG URLs are Known Technical Debt #3 (CLAUDE.md); they work
// today and beat having no preview, but they keep the Framer CDN dependency.
const IMAGE_EXT = /\.(jpe?g|png|webp|avif|gif)$/i;
const ogFromPath = work.coverPath && IMAGE_EXT.test(work.coverPath) ? coverSrc : '';

// ogImagePath wins: it is the R2/local convention the rest of the content
// model uses, and it is the migration path off the Framer CDN URLs that every
// populated ogImage currently holds (Known Technical Debt #3).
const ogImageUrl = work.ogImagePath
  ? assetUrl(work.ogImagePath)
  : typeof work.ogImage === 'string' && work.ogImage
    ? work.ogImage
    : work.ogImage?.asset
      ? urlFor(work.ogImage).width(1200).height(630).url()
      : ogFromPath;
// CreativeWork, not Article: a case study is a portfolio piece Wugweb created,
// not a news or editorial item. `about` carries the industry so the piece is
// connected to a subject rather than floating free.
const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.wugweb.com/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://www.wugweb.com/work' },
    { '@type': 'ListItem', position: 3, name: work.shortTitle ? `${work.shortTitle}: ${work.title}` : work.title, item: `https://www.wugweb.com/work/${slug}` },
  ],
};
const caseStudyNode = {
  '@type': 'CreativeWork',
  name: work.title,
  headline: work.seoTitle || work.title,
  description: (work.seoDescription || work.summary || work.about || '').slice(0, 300),
  image: ogImageUrl || undefined,
  author: { '@id': 'https://www.wugweb.com/#founder' },
  creator: { '@id': 'https://www.wugweb.com/#organization' },
  publisher: { '@id': 'https://www.wugweb.com/#organization' },
  about: work.industry || undefined,
  datePublished: work.publishedAt,
  keywords: work.tags?.length ? work.tags.join(', ') : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://www.wugweb.com/work/${slug}` },
};
const clientLogoSrc = work.clientRef?.logoPath ? assetUrl(work.clientRef.logoPath) : '';
// Notion is the source (2026-10-13): Title is what was built with no brand,
// Short Title is the brand, shown as the label above the H1.
const brandLabel = work.shortTitle || work.clientRef?.name || work.client || '';
// Notion Body Content (synced as bodyMarkdown) is the case study. When it is
// present the page renders it free-form — sections as tiles, media rows after
// the section their label names — and the old fixed blocks below are skipped.
const body = parseCaseBody(work.bodyMarkdown);
const heroSubtitle = body?.subtitle || work.subtitle;
const heroTags: string[] = body?.tags.length ? body.tags : (work.tags || []);
const heroCover = body?.cover?.url || coverSrc;
const heroCoverIsVideo = /\.(mp4|webm|mov)(\?|$)/i.test(heroCover);
// Unused files from the case study's own R2 folder (set by the sync), shown
// as a swipeable carousel — mostly app screens, kept at their natural shape.
const extraMedia: string[] = Array.isArray(work.extraMedia) ? work.extraMedia : [];
const cols = (items: { video: boolean }[]) => Math.min(items.filter((m) => !m.video).length || 1, 3);
const bodyContent = Array.isArray(work.bodyContent) ? work.bodyContent : [];
const challenges = Array.isArray(work.challenges) ? work.challenges : [];
const solutions = Array.isArray(work.solutions) ? work.solutions : [];
const impactItems = Array.isArray(work.impact) ? work.impact : [];
const galleryPaths = Array.isArray(work.galleryPaths) ? work.galleryPaths : [];
const results = Array.isArray(work.results) ? work.results : [];
// One real gallery image woven into "The approach" bento — proof next to
// the claim, not decoration. Held to one so it stays the exception, not
// a pattern repeated in every section.
const approachMediaPath = galleryPaths[0];
const approachMedia = approachMediaPath ? assetUrl(approachMediaPath) : '';
const approachMediaIsVideo = /\.(mp4|webm|mov)$/.test(approachMediaPath || '');

// bodyContent is migration-era duplicate text of challenges/solutions/
// impact (same points, reworded) on most docs — confirmed by comparing
// headings across several case studies. Only show it as a fallback when
// there's no structured content to say the same thing twice.
const hasStructuredContent = challenges.length > 0 || solutions.length > 0 || impactItems.length > 0 || !!work.designPhilosophy;
const showBodyContent = bodyContent.length > 0 && !hasStructuredContent;

// Color marks narrative stage (problem/approach/outcome rule colors).
const accentMap: Record<string, string> = {
  yellow: 'var(--color-accent-primary)',
  orange: 'var(--svc-strategy)',
  blue: 'var(--color-accent-blue)',
  green: 'var(--color-feedback-success)',
};

const allSlugsRaw = await sanityClient.fetch(`*[_type == "caseStudy" && !(_id in path("drafts.**"))]{"slug": slug.current}`).catch(() => []);
const seenSlugs = new Set();
const allSlugs = [];
for (const s of (allSlugsRaw || [])) {
  if (s && s.slug && !seenSlugs.has(s.slug)) {
    seenSlugs.add(s.slug);
    allSlugs.push(s);
  }
}
const others = allSlugs.filter((s: any) => s.slug !== slug).slice(0, 2);
const otherCases = await Promise.all(others.map((s: any) =>
  sanityClient.fetch(`*[_type == "caseStudy" && slug.current == $slug && !(_id in path("drafts.**"))][0]{ title, "slug": slug.current, client, disciplines, coverPath, thumbnailPath }`, { slug: s.slug }).catch(() => null)
)).then(r => r.filter(Boolean));
---

<BaseLayout title={`${work.title} — Wugweb Work`} description={pageDescription} seoTitle={pageTitle} ogImage={ogImageUrl} ogTitle={work.ogTitle} ogDescription={work.ogDescription} noIndex={work.noIndex} jsonLd={[caseStudyNode, breadcrumbNode]}>
  <section class="work-detail-hero" id="work-detail-hero" aria-labelledby="work-detail-hero-title">
    <div class="wrap">
      {brandLabel && <p class="eyebrow">{brandLabel}</p>}
      <h1 id="work-detail-hero-title">{work.title}</h1>
      {heroSubtitle && <p class="work-subtitle">{heroSubtitle}</p>}
      {heroTags.length > 0 && (
        <div class="work-tags">
          {heroTags.map((tag: string) => <span class="u-tag">{tag}</span>)}
        </div>
      )}
      {body ? (
        <dl class="work-meta">
          {body.meta.map((m) => (
            <div>
              <dt class="meta-label">{m.key}</dt>
              <dd class={m.key === 'Client' ? 'work-meta-client' : ''}>
                {m.key === 'Client' && clientLogoSrc && <img src={clientLogoSrc} alt="" class="work-client-logo" loading="eager" />}
                {m.value}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
      <div class="work-meta">
        <div>
          <span class="meta-label">Client / Brand</span>
          <span class="work-meta-client">
            {clientLogoSrc && <img src={clientLogoSrc} alt="" class="work-client-logo" loading="eager" />}
            {work.clientRef?.name || work.client || '—'}
          </span>
        </div>
        {work.partner && work.partner !== 'None' && <div><span class="meta-label">Partnered by</span><span>{work.partner}</span></div>}
        {work.timeline && <div><span class="meta-label">Timeline</span><span>{work.timeline}</span></div>}
        {work.disciplines?.length > 0 && <div><span class="meta-label">Disciplines</span><span>{work.disciplines.join(', ')}</span></div>}
        {work.industry && <div><span class="meta-label">Industry</span><span>{work.industry}</span></div>}
        {work.team && (Array.isArray(work.team) ? work.team.length > 0 : true) && <div><span class="meta-label">Team</span><span>{Array.isArray(work.team) ? work.team.join(', ') : work.team}</span></div>}
      </div>
      )}
    </div>
  </section>

  {heroCover && (
    <section class="wrap section work-cover" data-reveal id="work-cover" aria-label="Work cover">
      {heroCoverIsVideo ? (
        <video aria-hidden="true" src={heroCover} muted loop playsinline autoplay preload="metadata" class="work-cover-media" />
      ) : (
        <img src={heroCover} alt={body ? `${brandLabel || work.title} case study cover` : altFor(altMap, work.coverPath, work.title)} loading="eager" decoding="async" class="work-cover-media" />
      )}
    </section>
  )}

  {body && (
    <div class="bento-body wrap" id="case-study">
      {body.sections.map((s, si) => {
        // One composition per section: heading tile, then media and points
        // interleaved (media, point, point, media, …) so text and imagery share
        // the grid. Tile sizes come from the content, not from slots.
        const items: any[] = [];
        const media = s.media.filter((m) => !m.video);
        const videos = s.media.filter((m) => m.video);
        let mi = 0;
        s.tiles.forEach((t, ti) => {
          if (ti % 2 === 0 && mi < media.length) items.push({ kind: 'media', m: media[mi++] });
          items.push({ kind: 'point', t });
        });
        while (mi < media.length) items.push({ kind: 'media', m: media[mi++] });
        return (
          <section class="bento" aria-labelledby={`b-h-${si}`}>
            <div class={`b-head${items.length === 0 ? ' b-head--solo' : ''}`}>
              <h2 id={`b-h-${si}`}>{s.title}</h2>
              {s.lead && <p set:html={inline(s.lead)} />}
              {s.paras.map((p) => <p set:html={inline(p)} />)}
            </div>
            {s.styles.length > 0 && (
              <div class="b-styles">
                {s.styles.map((m) => (
                  <figure><img src={m.url} alt={`${brandLabel}: ${m.label}`} loading="lazy" decoding="async" /></figure>
                ))}
              </div>
            )}
            {items.map((it) => it.kind === 'media' ? (
              <figure class="b-media" data-shape="landscape">
                <img src={it.m.url} alt={it.m.label ? `${brandLabel}: ${it.m.label}` : `${brandLabel} case study image`} loading="lazy" decoding="async" />
              </figure>
            ) : (
              <div class={`b-point${(it.t.text || '').length > 170 ? ' b-point--long' : ''}`}>
                {it.t.group && <span class="b-group">{it.t.group}</span>}
                {it.t.title && <h3 set:html={inline(it.t.title)} />}
                <p set:html={inline(it.t.text)} />
              </div>
            ))}
            {videos.map((v) => (
              <figure class="b-media b-video"><video aria-hidden="true" data-src={v.url} muted loop playsinline preload="none" /></figure>
            ))}
          </section>
        );
      })}
      {body.closing.length > 0 && (
        <section class="bento" aria-label="More from the project">
          {body.closing.map((m) => m.video ? (
            <figure class="b-media b-video"><video aria-hidden="true" data-src={m.url} muted loop playsinline preload="none" /></figure>
          ) : (
            <figure class="b-media" data-shape="landscape"><img src={m.url} alt={`${brandLabel} case study image`} loading="lazy" decoding="async" /></figure>
          ))}
        </section>
      )}
      {extraMedia.length > 0 && (
        <section class="b-carousel-wrap" aria-label={`${brandLabel} screens`}>
          <div class="b-carousel" tabindex="0">
            {extraMedia.map((u) => /\.(mp4|webm|mov)$/i.test(u) ? (
              <figure><video aria-hidden="true" data-src={u} muted loop playsinline preload="none" /></figure>
            ) : (
              <figure><img src={u} alt={`${brandLabel} screen`} loading="lazy" decoding="async" /></figure>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
  <script>
    // Tile shape follows the asset: phone screens get a tall tile, wide shots
    // a wide one, so nothing is cropped into the wrong frame.
    const shape = (img: HTMLImageElement) => {
      const r = img.naturalWidth / img.naturalHeight;
      const fig = img.closest('.b-media') as HTMLElement | null;
      if (!fig || !r) return;
      fig.dataset.shape = r < 0.8 ? 'portrait' : r < 1.25 ? 'square' : 'landscape';
    };
    document.querySelectorAll<HTMLImageElement>('.b-media img').forEach((img) => {
      if (img.complete && img.naturalWidth) shape(img);
      else img.addEventListener('load', () => shape(img), { once: true });
    });
  </script>

  {!body && (
  <section class="case-shell wrap" id="case-study" aria-label="Case study">
    <div class="case-content">
      {(work.about || work.summary) && (
        <section id="about" class="case-section" data-reveal aria-labelledby="about-title">
          <h2 class="case-heading" id="about-title">About</h2>
          <p class="case-lead">{work.about || work.summary}</p>
        </section>
      )}

      {challenges.length > 0 && (
        <section id="problem" class="case-section" data-reveal aria-labelledby="problem-title">
          <h2 class="case-heading" id="problem-title">The problem</h2>
          <ul class="case-list" style={`--rule-color: ${accentMap.orange}`}>
            {challenges.map((ch: any) => (
              <li><strong>{ch.title}</strong>{ch.body && <p>{ch.body}</p>}</li>
            ))}
          </ul>
        </section>
      )}

      {solutions.length > 0 && (
        <section id="approach" class="case-section" data-reveal aria-labelledby="approach-title">
          <h2 class="case-heading" id="approach-title">The approach</h2>
          <div class="case-bento">
            {solutions.map((sol: any, i: number) => (
              <>
                <div class="bento-tile bento-text">
                  <strong>{sol.title}</strong>
                  {sol.body && <p>{sol.body}</p>}
                </div>
                {i === 1 && approachMedia && (
                  <figure class="bento-tile bento-image">
                    {approachMediaIsVideo ? (
                      <video aria-hidden="true" data-src={approachMedia} poster={posterFor(approachMedia)} muted loop playsinline preload="none" />
                    ) : (
                      <img src={approachMedia} alt="" loading="lazy" />
                    )}
                  </figure>
                )}
              </>
            ))}
          </div>
        </section>
      )}

      {(impactItems.length > 0 || results.length > 0) && (
        <section id="outcome" class="case-section" data-reveal aria-labelledby="outcome-title">
          <h2 class="case-heading" id="outcome-title">The outcome</h2>
          {results.length > 0 && (
            <div class="case-stat-row">
              {results.map((res: any) => (
                <div class="case-stat">
                  <span class="case-stat-num">{res.metric}</span>
                  {res.label && <span class="case-stat-label">{res.label}</span>}
                </div>
              ))}
            </div>
          )}
          {impactItems.length > 0 && (
            <ul class="case-list" style={`--rule-color: ${accentMap.green}`}>
              {impactItems.map((imp: any) => (
                <li><strong>{imp.title}</strong>{imp.body && <p>{imp.body}</p>}</li>
              ))}
            </ul>
          )}
        </section>
      )}

      {work.designPhilosophy && (
        <section id="thesis" class="case-section" data-reveal aria-labelledby="thesis-title">
          <h2 class="case-heading" id="thesis-title">Design thesis</h2>
          <div class="case-thesis">
            {work.designPhilosophy.split('\n').filter(Boolean).map((line: string) => {
              const idx = line.indexOf(':');
              const head = idx > -1 ? line.slice(0, idx).trim() : '';
              const body = idx > -1 ? line.slice(idx + 1).trim() : '';
              return (
                <blockquote>
                  <p>{body ? <><strong>{head}.</strong> {body}</> : line}</p>
                </blockquote>
              );
            })}
          </div>
        </section>
      )}

      {showBodyContent && (
        <section id="details" class="case-section" data-reveal aria-labelledby="details-title">
          <h2 class="case-heading" id="details-title">In depth</h2>
          <PortableTextRenderer value={bodyContent} />
        </section>
      )}
    </div>
  </section>

  )}

  {!body && galleryPaths.length > 0 && (
    <section id="gallery" class="wrap case-gallery-section" data-reveal aria-labelledby="gallery-title">
      <h2 class="case-heading" id="gallery-title">Gallery</h2>
      <div class="case-gallery-grid">
        {galleryPaths.map((path: string) => {
          const src = assetUrl(path);
          const isVideo = path.endsWith('.mp4') || path.endsWith('.webm') || path.endsWith('.mov');
          return (
            <figure class="case-gallery-item">
              {isVideo ? (
                <video aria-hidden="true" data-src={src} poster={posterFor(src)} muted loop playsinline preload="none" />
              ) : (
                <img src={src} alt={altFor(altMap, path, work.title)} loading="lazy" />
              )}
            </figure>
          );
        })}
      </div>
    </section>
  )}

  {otherCases.length > 0 && (
    <section class="wrap section more-cases-section" id="more-cases-section" aria-labelledby="more-cases-section-title">
      <div class="more-cases-head">
        <h2 id="more-cases-section-title">More Case Studies</h2>
        <a href="/work" class="btn btn-ghost">View all work</a>
      </div>
      <div class="more-grid">
        {otherCases.map((c: any) => {
          const cCover = c.coverPath ? assetUrl(c.coverPath) : (c.thumbnailPath ? assetUrl(c.thumbnailPath) : '');
          return (
            <a href={`/work/${c.slug || ''}`} class="more-card">
              {cCover && (
                <div class="more-card-visual">
                  {cCover.endsWith('.mp4') || cCover.endsWith('.webm')
                    ? <video aria-hidden="true" data-src={cCover} poster={posterFor(cCover)} muted loop playsinline preload="none"></video>
                    : <img src={cCover} alt="" loading="lazy" />}
                </div>
              )}
              <div class="more-card-content">
                <span class="more-card-client">{c.client}</span>
                <h3>{c.title}</h3>
                {c.disciplines?.length > 0 && <span class="more-card-discipline">{c.disciplines.join(', ')}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Hero */
  .work-detail-hero {
    padding-top: var(--space-section-xl);
    padding-bottom: var(--space-section-md);
    position: relative;
  }
  .work-detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .work-detail-hero .eyebrow a:hover { color: var(--fg); }
  .work-detail-hero h1 {
    font-size: var(--t-display);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--core-line-height-tight);
    margin-top: var(--gap-4);
    color: var(--fg);
    max-width: 22ch;
    overflow-wrap: break-word;
  }
  .work-subtitle {
    font-size: var(--fluid-h5);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    color: var(--fg-muted);
    margin-top: var(--gap-4);
    max-width: 56ch;
  }

  .work-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4) var(--gap-8);
    margin-top: var(--gap-10);
    border-top: var(--stroke-thin) solid var(--line);
    padding-top: var(--gap-6);
  }
  @media (min-width: 768px) {
    .work-meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .work-meta > div {
    display: flex;
    flex-direction: column;
    gap: var(--gap-1);
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .work-meta span:not(.meta-label) {
    font-size: var(--fluid-body-md);
    color: var(--fg);
    font-weight: var(--font-weight-medium);
  }
  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
    margin-top: var(--gap-6);
  }
  .work-meta-client {
    display: flex;
    align-items: center;
    gap: var(--gap-2);
  }
  .work-client-logo {
    height: 20px;
    width: auto;
    max-width: 88px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.9);
  }

  /* Full-bleed cinematic cover — the one photography-led moment on the
     page, fading into the surface color rather than stopping at a hard
     edge, so the narrative body below feels like a continuation. */
  .work-cover {
    padding-block: var(--space-section-sm);
  }
  .work-cover-media {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    display: block;
  }

  /* ═══════════════════════════════════════════════════════════════
     Editorial narrative body. No cards, no glow, no badge-pills —
     color marks narrative stage, not decoration. The section rail
     numbers a real sequence (about → problem → approach → outcome →
     thesis → gallery), so the numbering earns its keep.
     ═══════════════════════════════════════════════════════════════ */
  .case-shell {
    padding-block: var(--space-section-md) var(--space-section-lg);
  }

  .case-content {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
    max-width: 720px;
    margin-inline: auto;
  }

  /* Every case-section carries an id (about/problem/approach/...) as a
     deep-link target - without this, #approach etc. lands flush under
     the sticky header instead of clear of it. */
  .case-section {
    scroll-margin-top: calc(var(--header-height) + var(--gap-lg));
  }

  .case-heading {
    font-size: var(--t-h3);
