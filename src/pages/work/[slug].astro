---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudyBySlugQuery, caseStudiesListQuery } from '../../lib/queries';

export async function getStaticPaths() {
  const list = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
  return list.map((cs: any) => ({ params: { slug: cs.slug } }));
}

const { slug } = Astro.params;
const work = await sanityClient.fetch(caseStudyBySlugQuery, { slug }).catch(() => null);

if (!work) {
  return Astro.redirect('/404');
}

// Fetch 2 random other case studies for "More" section
const allSlugs = await sanityClient.fetch(`*[_type == "caseStudy"]{"slug": slug.current}`).catch(() => []);
const others = allSlugs.filter((s: any) => s.slug !== slug).slice(0, 2);
const otherCases = await Promise.all(others.map((s: any) =>
  sanityClient.fetch(`*[_type == "caseStudy" && slug.current == $slug][0]{ title, client, disciplines }`, { slug: s.slug }).catch(() => null)
)).then(r => r.filter(Boolean));
---

<BaseLayout title={`${work.title} — Wugweb Work`} description={(work.about || work.summary || '').slice(0, 160)}>
  <section class="work-detail-hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/work">Work</a></p>
      <h1>{work.title}</h1>
      <div class="work-meta">
        <div><span class="meta-label">Client</span><span>{work.client}</span></div>
        {work.disciplines?.length > 0 && <div><span class="meta-label">Disciplines</span><span>{work.disciplines.join(', ')}</span></div>}
        {work.industry && <div><span class="meta-label">Industry</span><span>{work.industry}</span></div>}
        {work.timeline && <div><span class="meta-label">Timeline</span><span>{work.timeline}</span></div>}
      </div>
    </div>
  </section>

  {(work.about || work.summary) && (
    <section class="wrap section">
      <h2>About</h2>
      <p>{work.about || work.summary}</p>
    </section>
  )}

  {work.challenges?.length > 0 && (
    <section class="wrap section">
      <h2>Challenges</h2>
      <div class="grid">
        {work.challenges.map((c: any) => (
          <div class="card"><h3>{c.title}</h3><p>{c.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {work.solutions?.length > 0 && (
    <section class="wrap section">
      <h2>Solutions</h2>
      <div class="grid">
        {work.solutions.map((s: any) => (
          <div class="card"><h3>{s.title}</h3><p>{s.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {work.impact?.length > 0 && (
    <section class="wrap section">
      <h2>Impact</h2>
      <div class="grid">
        {work.impact.map((i: any) => (
          <div class="card"><h3>{i.title}</h3><p>{i.body}</p></div>
        ))}
      </div>
    </section>
  )}

  {otherCases.length > 0 && (
    <section class="wrap section">
      <h2>More Case Studies</h2>
      <div class="more-grid">
        {otherCases.map((c: any) => (
          <a href={`/work/${c.slug || ''}`} class="more-card">
            <h3>{c.title}</h3>
            <p>{c.client}{c.disciplines?.length > 0 ? ` — ${c.disciplines.join(', ')}` : ''}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .work-detail-hero { padding-block: 8rem 4rem; border-bottom: 1px solid var(--line); }
  .work-detail-hero .eyebrow a { color: var(--fg-muted); text-decoration: none; }
  .work-detail-hero h1 { font-size: var(--t-h2); margin-top: 1rem; max-width: 20ch; }
  .work-meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 3rem; max-width: 600px; }
  .meta-label { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-warm); text-transform: uppercase; margin-bottom: 0.25rem; }
  .section { padding-block: 4rem; border-bottom: 1px solid var(--line); }
  .section h2 { font-size: var(--t-h3); margin-bottom: 1.5rem; }
  .section p { max-width: 60ch; line-height: 1.7; color: var(--fg-muted); }
  .grid { display: grid; gap: 1.5rem; margin-top: 1rem; }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .card { border-top: 1px solid var(--line); padding-top: 1rem; }
  .card h3 { font-size: 1.15rem; font-weight: 400; margin-bottom: 0.5rem; }
  .card p { font-size: 0.95rem; }
  .more-grid { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 768px) { .more-grid { grid-template-columns: repeat(2, 1fr); } }
  .more-card { text-decoration: none; border-top: 1px solid var(--line); padding-top: 1rem; display: block; }
  .more-card h3 { font-size: 1.1rem; font-weight: 400; color: var(--fg); }
  .more-card p { color: var(--fg-muted); margin-top: 0.25rem; font-size: 0.85rem; }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.card, .more-card, .section', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
