---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudiesListQuery, singletonPageQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';

const workPage = await sanityClient.fetch(singletonPageQuery, { pageId: 'work' }).catch(() => null);
const rawCaseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const seenCases = new Set();
const caseStudies = [];
for (const cs of (rawCaseStudies || [])) {
  if (cs && cs.slug && !seenCases.has(cs.slug)) {
    seenCases.add(cs.slug);
    caseStudies.push(cs);
  }
}
const workTitle = workPage?.seoTitle || 'Clients – Wugweb | Trusted by Innovative Brands';
const workDescription =
  workPage?.seoDescription ||
  'Explore the diverse brands and businesses that trust Wugweb for UI/UX design, web development, and digital experience solutions.';

// Top-level filters map to the six service pillars — never a large tag system.
const PILLARS = ['Strategy', 'Brand', 'Experience', 'Engineering', 'Growth', 'Operations'];
const PILLAR_KEYWORDS: Record<string, string[]> = {
  'Strategy': ['strategy', 'consulting', 'research', 'branding-strategy'],
  'Brand': ['brand', 'identity', 'naming'],
  'Experience': ['ux', 'ui', 'design', 'experience', 'product'],
  'Engineering': ['development', 'engineering', 'web', 'app', 'tech', 'saas', 'platform'],
  'Growth': ['marketing', 'growth', 'seo', 'martech', 'lead'],
  'Operations': ['operations', 'qa', 'automation', 'devops', 'support'],
};
const categories = ['All', ...PILLARS];

// Fallback when caseStudy.thumbnailPath is empty
const thumbAssets = await sanityClient.fetch(
  '*[_type == "asset" && usage == "Thumbnail"]{relativePath, sitePath, name, ownerId}'
).catch(() => []);

function normalize(str: string) {
  return str.toLowerCase().replace(/[^a-z0-9]/g, '');
}

function findThumbFallback(slug: string, client: string) {
  const slugNorm = normalize(slug);
  const clientNorm = normalize(client);

  for (const asset of thumbAssets) {
    const pathNorm = normalize(asset.relativePath || asset.sitePath || '');
    const nameNorm = normalize(asset.name || '');
    if (pathNorm.includes(slugNorm) || nameNorm.includes(slugNorm)) {
      return asset.sitePath || '/assets/' + asset.relativePath;
    }
    if (pathNorm.includes(clientNorm) || nameNorm.includes(clientNorm)) {
      return asset.sitePath || '/assets/' + asset.relativePath;
    }
  }

  return '';
}

function mapToPillar(cs: any): string {
  const haystack = [
    ...(cs.disciplines || []),
    ...(cs.tags || []),
    cs.industry || '',
    cs.client || '',
  ].join(' ').toLowerCase();
  for (const p of PILLARS) {
    if (PILLAR_KEYWORDS[p].some((k) => haystack.includes(k))) return p;
  }
  // Default: design/experience work
  return 'Experience';
}

const workItems = caseStudies.map((cs: any) => {
  // Resolve the raw thumb path first; only pass non-empty values to
  // assetUrl (which maps '' → '/assets/' and would render a broken video).
  const rawThumb = cs.thumbnailPath || findThumbFallback(cs.slug, cs.client || '');
  return {
    client: cs.client || '',
    category: (cs.disciplines || []).join(', ') || 'UX Design',
    pillar: mapToPillar(cs),
    title: cs.title,
    slug: cs.slug,
    video: rawThumb ? assetUrl(rawThumb) : '',
    initials: (cs.client || 'Ww').replace(/[^a-zA-Z0-9\s]/g, '').trim().split(/\s+/).slice(0, 2).map((w: string) => w[0]?.toUpperCase() || '').join(''),
  };
});
---

<BaseLayout title={workTitle} description={workDescription}>
  <section class="work-hero">
    <div class="wrap work-hero-content">
      <p class="eyebrow" data-reveal>Case Studies</p>
      <h1 class="page-title" data-reveal>What We've Built</h1>
      <p data-reveal>We create digital solutions that are as functional as they are beautiful.</p>
    </div>
  </section>

  <section class="wrap work-filters" data-reveal>
    {categories.map((c) => (
      <button class="filter-chip" data-category={c}>{c}</button>
    ))}
  </section>

  <section class="wrap work-grid-section">
    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal data-categories={w.pillar}>
          <a href={`/work/${w.slug}`}>
            {w.video ? <video autoplay muted loop playsinline src={w.video}></video> : <div class="work-placeholder"><span class="work-placeholder-initials" aria-hidden="true">{w.initials}</span><span class="work-placeholder-cat">{w.pillar}</span></div>}
            <div class="work-content">
              <p class="work-client">{w.client}</p>
              <h3>{w.title}</h3>
              <span class="work-category">{w.category}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .work-hero { padding-block: var(--space-page-head) var(--space-section-md); }
  .work-hero-content h1 { max-width: 18ch; margin-bottom: var(--gap-5); }
  .work-hero-content p { font-size: var(--t-body); color: var(--fg-muted); max-width: 50ch; }
  .work-grid-section { padding-block: var(--space-section-md) var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .work-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }

  .work-grid a {
    text-decoration: none;
    display: block;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--stroke-thin) solid var(--line);
    background: var(--color-surface-elevated);
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .work-grid a:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0,0,0,0.25);
  }

  .work-grid video {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-grid a:hover video { transform: scale(1.04); }

  .work-placeholder {
    width: 100%;
    aspect-ratio: 16/10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--gap-5);
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--color-yellow) 22%, transparent), transparent 55%),
      linear-gradient(160deg, var(--color-surface-elevated) 0%, var(--color-surface-page) 100%);
  }
  .work-placeholder-initials { font-family: var(--font-display); font-size: var(--t-h2); font-weight: var(--font-weight-extrabold); line-height: var(--core-line-height-none); color: var(--fg); opacity: var(--opacity-strong); }
  .work-placeholder-cat { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-muted); }

  .work-content {
    padding: var(--gap-4) var(--gap-6) var(--gap-6);
    background: var(--color-surface-elevated);
    transition: background 0.3s ease;
  }
  .work-client { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .work-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-2); line-height: var(--lh-h5); color: var(--fg); }
  .work-category {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--color-accent-primary);
    display: inline-block;
    margin-top: var(--gap-3);
    padding: var(--gap-1) var(--gap-3);
    border: var(--stroke-thin) solid color-mix(in srgb, var(--color-accent-primary) 40%, transparent);
    border-radius: var(--r-pill);
  }

  .work-filters { display: flex; gap: var(--gap-2); flex-wrap: wrap; padding-block: var(--gap-8); border-top: var(--stroke-thin) solid var(--line); }
  .filter-chip {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    padding: var(--gap-2) var(--gap-5);
    border-radius: var(--r-pill);
    border: var(--stroke-thin) solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
  }
  .filter-chip:hover { border-color: var(--fg); color: var(--fg); }
  .filter-chip.active {
    border-color: var(--color-accent-primary);
    color: var(--neutral-0);
    background: var(--color-accent-primary);
  }
  .work-grid li.hidden { display: none; }

</style>

<script>
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('.work-grid li').forEach(item => {
        if (cat === 'All' || item.dataset.categories?.includes(cat)) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
