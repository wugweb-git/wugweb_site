---
export const prerender = true;
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { caseStudiesListQuery, singletonPageQuery } from '../../lib/queries';
import { assetUrl } from '../../lib/assets';

const workPage = await sanityClient.fetch(singletonPageQuery, { pageId: 'work' }).catch(() => null);
const caseStudies = await sanityClient.fetch(caseStudiesListQuery).catch(() => []);
const workTitle = workPage?.seoTitle || 'Clients – Wugweb | Trusted by Innovative Brands';
const workDescription =
  workPage?.seoDescription ||
  'Explore the diverse brands and businesses that trust Wugweb for UI/UX design, web development, and digital experience solutions.';
const allCategories = [...new Set(caseStudies.flatMap((cs: any) => cs.disciplines || []).filter(Boolean))];
const categories = ['All', ...allCategories];

// Fallback when caseStudy.thumbnailPath is empty
const thumbAssets = await sanityClient.fetch(
  '*[_type == "asset" && usage == "Thumbnail"]{relativePath, sitePath, name, ownerId}'
).catch(() => []);

function normalize(str: string) {
  return str.toLowerCase().replace(/[^a-z0-9]/g, '');
}

function findThumbFallback(slug: string, client: string) {
  const slugNorm = normalize(slug);
  const clientNorm = normalize(client);

  for (const asset of thumbAssets) {
    const pathNorm = normalize(asset.relativePath || asset.sitePath || '');
    const nameNorm = normalize(asset.name || '');
    if (pathNorm.includes(slugNorm) || nameNorm.includes(slugNorm)) {
      return asset.sitePath || '/assets/' + asset.relativePath;
    }
    if (pathNorm.includes(clientNorm) || nameNorm.includes(clientNorm)) {
      return asset.sitePath || '/assets/' + asset.relativePath;
    }
  }

  // Only return the guessed local path if the file actually exists —
  // otherwise the <video> renders a broken/blank tile.
  const localSlug = client.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  const guessed = path.join(process.cwd(), 'public', 'assets', 'work', localSlug, `${localSlug}-thumb.mp4`);
  if (fs.existsSync(guessed)) {
    return `/assets/work/${localSlug}/${localSlug}-thumb.mp4`;
  }
  return '';
}

const workItems = caseStudies.map((cs: any) => {
  // Resolve the raw thumb path first; only pass non-empty values to
  // assetUrl (which maps '' → '/assets/' and would render a broken video).
  const rawThumb = cs.thumbnailPath || findThumbFallback(cs.slug, cs.client || '');
  return {
    client: cs.client || '',
    category: (cs.disciplines || []).join(', ') || 'UX Design',
    title: cs.title,
    slug: cs.slug,
    video: rawThumb ? assetUrl(rawThumb) : '',
    initials: (cs.client || 'Ww').replace(/[^a-zA-Z0-9\s]/g, '').trim().split(/\s+/).slice(0, 2).map((w: string) => w[0]?.toUpperCase() || '').join(''),
  };
});
---

<BaseLayout title={workTitle} description={workDescription}>
  <section class="work-hero">
    <div class="wrap work-hero-content">
      <p class="eyebrow" data-reveal>Case Studies</p>
      <h1 data-reveal>What We've Built</h1>
      <p data-reveal>We create digital solutions that are as functional as they are beautiful.</p>
    </div>
  </section>

  <section class="wrap work-filters" data-reveal>
    {categories.map((c) => (
      <button class="filter-chip" data-category={c}>{c}</button>
    ))}
  </section>

  <section class="wrap work-grid-section">
    <ul class="work-grid">
      {workItems.map((w) => (
        <li data-reveal data-categories={w.category}>
          <a href={`/work/${w.slug}`}>
            {w.video ? <video autoplay muted loop playsinline src={w.video}></video> : <div class="work-placeholder"><span class="work-placeholder-initials" aria-hidden="true">{w.initials}</span><span class="work-placeholder-cat">{w.category}</span></div>}
            <div class="work-content">
              <p class="work-client">{w.client}</p>
              <h3>{w.title}</h3>
              <span class="work-category">{w.category}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .work-hero { padding-block: var(--space-section-xl) var(--space-section-md); }
  .work-hero-content h1 { font-size: var(--t-h2); font-weight: var(--font-weight-bold); max-width: 28ch; margin-bottom: var(--gap-4); }
  .work-hero-content p { font-size: var(--t-body); color: var(--fg-muted); max-width: 50ch; }
  .work-grid-section { padding-block: var(--space-section-md) var(--space-section-xl); border-top: 1px solid var(--line); }
  .work-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-8); }
  @media (min-width: 768px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  .work-grid a { text-decoration: none; display: block; }
  .work-grid video { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--r-2); }
  .work-placeholder {
    width: 100%;
    aspect-ratio: 16/10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--gap-5);
    border-radius: var(--r-2);
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(255, 190, 26, 0.22), transparent 55%),
      linear-gradient(160deg, #191919 0%, #050505 100%);
    border: 1px solid var(--line);
  }
  .work-placeholder-initials { font-family: var(--font-display); font-size: var(--t-h2); font-weight: var(--font-weight-extrabold); line-height: 1; color: var(--fg); opacity: 0.92; }
  .work-placeholder-cat { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-muted); }
  .work-content { margin-top: var(--gap-4); }
  .work-client { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); }
  .work-grid h3 { font-size: var(--t-h5); font-weight: var(--font-weight-semibold); margin-top: var(--gap-1); line-height: var(--lh-h5); }
  .work-category { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--accent-warm); display: inline-block; margin-top: var(--gap-2); padding: var(--gap-1) var(--gap-2); border: 1px solid var(--line); border-radius: var(--r-pill); }
  .work-filters { display: flex; gap: var(--gap-2); flex-wrap: wrap; padding-block: var(--gap-8); border-top: 1px solid var(--line); }
  .filter-chip { font-family: var(--font-mono); font-size: var(--t-micro); padding: var(--gap-2) var(--gap-4); border-radius: var(--r-pill); border: 1px solid var(--line); background: transparent; color: var(--fg-muted); cursor: pointer; transition: border-color var(--duration-fast) var(--easing-out), color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .filter-chip:hover { border-color: var(--fg); color: var(--fg); }
  .filter-chip.active { border-color: var(--accent); color: var(--accent); background: rgba(255,190,26,.1); }
  .work-grid li.hidden { display: none; }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.work-grid li', (el) => {
    animate(el, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, easing: 'ease-out' });
  });
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.category;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      document.querySelectorAll('.work-grid li').forEach(item => {
        if (cat === 'All' || item.dataset.categories?.includes(cat)) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });
  document.querySelector('.filter-chip')?.classList.add('active');
</script>
