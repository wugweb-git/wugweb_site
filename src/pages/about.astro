---
import BaseLayout from '../layouts/BaseLayout.astro';
// TrustBadges import removed with its render call below — see that comment.
import BentoBlock, { type BentoTile } from '../components/BentoBlock.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { singletonPageQuery, teamListQuery, siteSettingsQuery } from '../lib/queries';
import { assetUrl } from '../lib/assets';

// Hero title/intro now Sanity-editable. 
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'about' }).catch(() => null);

// Team fetched from Sanity (person docs)
const sanityTeam = await sanityClient.fetch(teamListQuery).catch(() => []);

/**
 * Only people with an actual photograph appear in the grid — a card whose photo
 * is a placeholder reads as a gap in the team, not a member of it. Wugweb
 * Design is the house account, not a person, and shows the logo mark. Drop a
 * real portrait in and it returns on its own.
 */
const PORTRAIT_STAND_INS = ['avatar-generic.svg', 'team-wugweb-design.png'];
const hasRealPortrait = (t: any) =>
  Boolean(t?.photoPath) && !PORTRAIT_STAND_INS.some((f) => String(t.photoPath).endsWith(f));

const featuredToolNames = [
  'Figma',
  'Notion',
  'Slack',
  'Webflow',
  'Framer',
  'Shopify',
  'Zapier',
  'HubSpot',
];
const techTools = await sanityClient
  .fetch(`*[_type=="taxonomy" && vocabulary=="tech-stack"]{name, iconPath}`)
  .catch(() => []);
const toolByName = new Map((techTools || []).map((t) => [String(t.name).toLowerCase(), t]));
const stackTools = featuredToolNames.map((name) => {
  const hit = toolByName.get(name.toLowerCase());
  return { name, iconPath: hit?.iconPath ? assetUrl(hit.iconPath) : null };
});

/**
 * BentoBlock — "Why Wugweb?".
 *
 * Six tiles across three columns of two. Four always carry a reason; the other
 * two are flexible slots (CTA, toolkit) that a variation can swap for media or
 * another reason. Column, size and tone are data, so reshuffling the block does
 * not touch the CSS.
 *
 * Sizes mirror the live section's proportions at a 1196px container:
 *   tall 519 · mid 343 · short 250 · slim 172 · strip 90
 */
const whyReasons = [
  {
    title: 'Strategic Brand Vision',
    body: 'Resonant brand foundations are architected through the synthesis of strategic insight and creative brilliance, driving measurable business growth.',
  },
  {
    title: 'Data-Driven Brand Evolution',
    body: 'Data and analytics inform brand strategy, optimizing brand performance and fueling sustainable brand evolution.',
  },
  {
    title: 'Authentic Brand Storytelling',
    body: "Brand's core essence is unearthed, crafting authentic narratives that forge emotional connections and inspire unwavering loyalty.",
  },
  {
    title: 'Holistic Brand Experience Design',
    body: 'Cohesive brand experiences are engineered across all touchpoints, ensuring consistency, impact, and a seamless customer journey.',
  },
];

// Media goes through assetUrl() so it resolves to R2 in production instead of
// hardcoding /assets/… — the same bypass that still exists on the homepage.
const bentoTiles: BentoTile[] = [
  { col: 0, span: 'tall',  ...whyReasons[0], tone: 'light', image: assetUrl('more/service/service_benefit_6.webp'), fit: 'cover' },
  { col: 0, span: 'strip', kind: 'cta', href: '/contact-us', linkLabel: "Let's talk" },
  { col: 1, span: 'short', ...whyReasons[1] },
  { col: 1, span: 'mid',   ...whyReasons[2], video: assetUrl('more/about/about_7.mp4'), fit: 'inset' },
  { col: 2, span: 'slim',  kind: 'stack', items: stackTools },
  { col: 2, span: 'tall',  ...whyReasons[3], image: assetUrl('more/about/about_5.webp'), fit: 'cover' },
];

const heroText =
  (typeof page?.title === 'string' && page.title.length > 40 ? page.title : null) ||
  page?.body?.[0]?.children?.[0]?.text ||
  "Wugweb is evolving in the digital landscape and has rapidly moved forward, with our services expanding to digital marketing, emerging tech innovation & production.";

const pageTitle = page?.seoTitle || 'About Wugweb - UI/UX Design & Digital Experience Experts';
const pageDescription =
  page?.seoDescription ||
  'Get to know Wugweb – a UI/UX design agency dedicated to crafting seamless digital experiences that elevate brands.';

const [caseCount, clientCount, industryCount, settings] = await Promise.all([
  sanityClient.fetch(`count(*[_type == "caseStudy"])`).catch(() => 0),
  sanityClient.fetch(`count(*[_type == "client"])`).catch(() => 0),
  // Distinct industries the work actually touches, not the size of the industry
  // master (66 rows) — that would count sectors we have never shipped into.
  sanityClient
    .fetch(`count(array::unique(*[_type == "caseStudy" && defined(industry)].industry))`)
    .catch(() => 0),
  sanityClient.fetch(siteSettingsQuery).catch(() => null),
]);

// Real founding year from the copyright line ("© 2020–2026 Wugweb").
// Years of experience = current year − founding year (no invented figures).
const copyright = typeof settings?.copyright === 'string' ? settings.copyright : '';
const foundedMatch = copyright.match(/(?:©|&copy;)\s*(\d{4})/);
const foundedYear = foundedMatch ? Number(foundedMatch[1]) : 2020;
const yearsOfExperience = Math.max(0, new Date().getFullYear() - foundedYear);

const fromSanityStats = (page?.items || [])
  .map((it: any) => ({
    n: it.title || it.n,
    label: it.text || it.label,
    copy: it.copy || '',
  }))
  .filter((s: any) => s.n && s.label);

const fallbackStats = [
  {
    n: fromSanityStats[0]?.n || (yearsOfExperience ? `${yearsOfExperience}+` : '—'),
    label: 'Years of experience',
    copy: 'Expertise that drives meaningful results.',
  },
  {
    n: caseCount ? `${caseCount}+` : '—',
    label: 'Projects delivered',
    copy: 'Creative solutions built with purpose.',
  },
  {
    // Was "Client Retention Rate", which had no source and rendered as an em
    // dash — a blank card in a row of counters. A retention rate is a claim
    // about the business that only the business can supply, so rather than
    // invent one this slot now carries a figure the content itself proves.
    // An editor can still override it from Studio `items`.
    n: fromSanityStats[2]?.n || (industryCount ? `${industryCount}+` : '—'),
    label: 'Industries served',
    copy: 'Sector fluency built case by case.',
  },
  {
    n: clientCount ? `${clientCount}+` : '—',
    label: 'Brands transformed',
    copy: 'From strategy to standout visuals.',
  },
];

const stats =
  fromSanityStats.length >= 4
    ? fromSanityStats.slice(0, 4).map((s: any, i: number) => ({
        ...fallbackStats[i],
        n: s.n,
        label: s.label,
        copy: s.copy || fallbackStats[i].copy,
      }))
    : fallbackStats;

const defaultValues = [
  { n: '01', title: 'Bold', copy: 'We balance distinctive expression with measurable results.' },
  { n: '02', title: 'Adaptive', copy: 'We build flexible solutions without sacrificing creative vision.' },
  { n: '03', title: 'Distinct', copy: 'We reject sameness, crafting experiences with unique identities.' },
  { n: '04', title: 'Start Smart, Start Small', copy: 'We start focused, prove value early, and scale what works.' },
];

// Prefer values listed in Sanity subtitle (Bold · Adaptive · …) when present
const subtitleTitles = String(page?.subtitle || '')
  .split(/\s*·\s*/)
  .map((s) => s.trim())
  .filter(Boolean);
const values =
  subtitleTitles.length >= 3
    ? subtitleTitles.map((title, i) => {
        const hit = defaultValues.find((v) => v.title.toLowerCase() === title.toLowerCase());
        return { n: String(i + 1).padStart(2, '0'), title, copy: hit?.copy || '' };
      })
    : defaultValues;

const culture = [
  'We Create Trust', 'We listen closely', 'We define your value', 'We pivot',
  'We hustle', 'We form connections', 'We get cosy', 'We get our hands dirty',
];
import TeamGrid from '../components/TeamGrid.astro';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO -->
  <section class="about-hero">
    <div class="wrap about-hero-content">
      <h1 class="page-title" data-reveal>About Us</h1>
      <!-- PLACEHOLDER COPY — replace before launch. Sits under the page title
           and is not sourced from Sanity yet. -->
      <p class="about-hero-lede" data-reveal>
        A product and experience architecture studio. We work across strategy,
        brand, experience, engineering, growth and operations — one team, six
        disciplines, and a single view of the thing being built.
      </p>
    </div>
    <!-- The film is still its own block rather than a page backdrop. The two
         statements sit on it in `difference` blend, so each inverts against
         whatever frame is behind it and stays legible without dimming the
         footage. -->
    <div class="wrap about-hero-media" data-reveal>
      <div class="about-hero-frame">
        <video autoplay muted loop playsinline
          src="/assets/more/about/about-message.mp4"
          poster="/assets/about/about-section.jpg"></video>
        <p class="about-hero-statement is-lead">{heroText}</p>
        <!-- PLACEHOLDER COPY — replace before launch. -->
        <p class="about-hero-statement is-sub">
          Built in Delhi and Dubai, shipping worldwide since {foundedYear}.
        </p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats" data-scroll="rise">
    <ul data-counters>
      {stats.map((s) => {
        // Split "57+" into the number to count and whatever trails it, so the
        // suffix is never animated and a non-numeric value ("—") is left alone.
        const m = String(s.n).match(/^(\d[\d,.]*)(.*)$/);
        return (
          <li data-reveal>
            <div class="stat-card">
              <span class="stat-n">
                {m ? (
                  <>
                    <span class="stat-num" data-count-to={m[1].replace(/,/g, '')}>{m[1]}</span>
                    <span class="stat-suffix">{m[2]}</span>
                  </>
                ) : (
                  <span class="stat-num is-blank">{s.n}</span>
                )}
              </span>
              <p class="stat-label">{s.label}</p>
              <p class="stat-copy">{s.copy}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  {/* TRUST & RECOGNITION — removed for now (2026-09-23, user request). */}

  <!-- VALUES -->
  <section class="wrap values" data-scroll="rise">
    <p class="eyebrow" data-reveal>Our values</p>
    <p class="values-lede" data-reveal>
      Creating projects at the nexus of design and technology, bringing the future into the
      present. We develop comprehensive strategies, looking from a hybrid and more coherent
      perspective. Then we give it a life of its own by equipping it with cutting-edge systems
      that allow it to adapt to and live in the wild, ever-evolving environment.
    </p>
    <ol class="values-list">
      {values.map((v) => (
        <li data-reveal>
          <div class="value-card">
            <span class="value-n">{v.n}</span>
            <h3>{v.title}</h3>
            {v.copy && <p>{v.copy}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CULTURE -->
  <section class="wrap culture" data-scroll="rise">
    <div class="culture-head">
      <div>
        <h2 data-reveal>Culture Reigns Supreme</h2>
        <p data-reveal>
          Establishing a robust foundational culture within our organisation is vital to Wugweb's
          long-term vision, growth, and success. We are driven by four core values: intimacy,
          transparency, urgency, and pivoting.
        </p>
      </div>
      <img class="culture-visual" src="/assets/about/about-section-2.jpg" alt="Wugweb team culture" loading="lazy" />
    </div>
    <ul class="culture-grid">
      {culture.map((c) => <li data-reveal>{c}</li>)}
    </ul>
  </section>

  <!-- TEAM -->
  <TeamGrid
    members={sanityTeam.filter(hasRealPortrait).map((t: any) => ({
      name: t.name,
      role: t.role,
      slug: t.slug,
      photo: t.photoPath
        ? assetUrl(t.photoPath)
        : (t.photo ? urlFor(t.photo).width(600).height(800).url() : undefined),
    }))}
    eyebrow="The people behind the work"
    heading="The faces behind the work."
    headingLead={2}
  />

  <!-- REVIEWS -->
  <section class="wrap reviews">
    <h2 data-reveal>Engage visitors and convert them into loyal customers.</h2>
    <div class="reviews-grid">
      <div class="review-card" data-reveal>
        <span class="review-score">4.98/5</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">98/100</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">Best Startup in Year</span>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-source">Another Review Site</span>
      </div>
    </div>
  </section>

  {/* BentoBlock — every axis (column, order, weight, kind, tone, media, fit,
      interaction) is data, so a variation is a reordered array. The component
      refuses to build if the weights are all equal or the columns match,
      because a bento must never read as an even grid. */}
  <BentoBlock
    heading="Why Wugweb?"
    lede="In a world clamoring for attention, your brand deserves more than fleeting visibility. It requires a strategic partner that architects compelling narratives, cultivates authentic connections, and engineers brand experiences designed to stand the test of time."
    tiles={bentoTiles}
  />

</BaseLayout>

<style>
  /* Display type from our own scale — `--t-display` (40→80px), the largest
     size the system has. The reference sets its page title at 148px, which is
     nearly twice that; matching it would have meant a bespoke clamp on one
     page and a heading larger than anything else on the site. The reference's
     *proportions* are kept instead: line-height just under 1, and a tight
     optical tracking, both of which a display size needs and the body scale
     does not. */
  .about-hero { padding-block: var(--space-page-head) 0; }
  .about-hero-content h1 { max-width: 16ch; }

  /* The reference leaves ~347px between the title block and the film at
     1380px — a quarter of the viewport. Held as a vw clamp so the interval
     scales with the type rather than being a fixed gap that reads tight on a
     large screen and enormous on a small one. */
  /* --gap-12 is 48px, so the previous clamp's max sat below its own preferred
     value and collapsed the interval to 48. Section spacing is the right scale
     here: this is the break between the title block and the film, not a gap
     between two elements. */
  .about-hero-media { margin-top: var(--space-section-lg); }
  @media (min-width: 1024px) { .about-hero-media { margin-top: var(--space-section-xl); } }
  /* Ratio fixed at every breakpoint — the film is cropped to fit, never
     stretched (governance §8). 2:1 matches the reference's 2.08. */
  .about-hero-frame {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
  }
  .about-hero-media video {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    background: color-mix(in srgb, var(--neutral-8) 60%, transparent);
  }
  /* A light scrim still runs under the foot of the frame. It is not doing the
     legibility work — `difference` handles that — it steadies the base so the
     two statements do not flicker between light and dark as the film cuts. */
  .about-hero-frame::after {
    content: '';
    position: absolute; inset: auto 0 0 0; height: 58%;
    background: linear-gradient(to top,
      color-mix(in srgb, var(--neutral-10) 55%, transparent) 8%,
      transparent);
    pointer-events: none;
  }
  /* `difference` inverts each line against whatever frame is behind it, so it
     reads on a bright cut and a black one alike without dimming the footage.
     It must stay white to invert cleanly — any other colour tints the result —
     and the frame must not set `isolation`, or the blend has nothing to mix
     against. */
  .about-hero-statement {
    position: absolute; left: 0; right: 0;
    z-index: var(--layer-base);
    margin: 0;
    padding-inline: var(--gap-6);
    color: var(--neutral-0);
    mix-blend-mode: difference;
    letter-spacing: -0.02em;
    text-wrap: balance;
    pointer-events: none;
  }
  /* 2×: the clamp's floor, slope and cap are all doubled, so it scales the
     same way it did — 34px on a phone up to 56px, from 17/27.
     Measure drops with it: 34ch was set for 27px type and would run to roughly
     the full frame at 56px, so it tightens to 22ch and keeps a readable line. */
  .about-hero-statement.is-lead {
    bottom: calc(var(--gap-6) + 3rem);
    font-size: clamp(2.125rem, 2.2vw + 1.5rem, 3.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .about-hero-statement.is-sub {
    bottom: var(--gap-6);
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 0.2vw + 0.875rem, 1.125rem);
    font-weight: var(--font-weight-medium);
    opacity: var(--opacity-70);
  }
  @media (min-width: 768px) {
    .about-hero-statement { padding-inline: var(--gap-8); }
    .about-hero-statement.is-lead { bottom: calc(var(--gap-8) + 3.25rem); }
    .about-hero-statement.is-sub { bottom: var(--gap-8); }
  }

  .about-hero-lede {
    margin-top: var(--gap-6);
    max-width: 52ch;
    font-size: clamp(1rem, 0.45vw + 0.9rem, 1.25rem);
    line-height: var(--core-line-height-relaxed);
    color: var(--fg-muted);
  }

  /* Stats */
  .stats {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }
  .stats ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--gap-6);
  }
  @media (min-width: 768px) { .stats ul { grid-template-columns: repeat(4, 1fr); } }
  .stats li { list-style: none; }
  /* Counters sit on the page's own dark surface. They were a light
     #F4F4F4 card inheriting --fg (#f4f4f4) for its text — the label and copy
     were white on white at 1.00 contrast and had never been readable. Same bug
     the insights cards had. */
  .stat-card {
    position: relative;
    z-index: var(--layer-base);
    height: 100%;
    display: flex; flex-direction: column;
    background: color-mix(in srgb, var(--neutral-8) 55%, transparent);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--gap-6);
    /* No transform: `data-reveal` is a GSAP tween on the <li> and owns it. */
    transition: border-color var(--duration-normal) var(--easing-smooth),
                background-color var(--duration-normal) var(--easing-smooth),
                box-shadow var(--duration-normal) var(--easing-smooth),
                filter var(--duration-normal) var(--easing-smooth);
  }
  .stats ul:hover .stat-card { filter: brightness(0.7); }
  .stats ul:hover .stat-card:hover { filter: none; }
  .stat-card:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 22%, transparent);
    background: color-mix(in srgb, var(--neutral-8) 80%, transparent);
    box-shadow: var(--shadow-md);
    z-index: var(--layer-card);
  }
  .stat-n {
    display: flex; align-items: baseline; gap: 0.02em;
    font-family: var(--font-mono);
    font-size: var(--fluid-h1);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--fg);
    /* Tabular figures so the number does not jitter horizontally while it
       counts — the whole reason a counter can look cheap. */
    font-variant-numeric: tabular-nums;
  }
  .stat-suffix { color: var(--fg-muted); font-size: 0.55em; font-weight: var(--font-weight-semibold); }
  .stat-num.is-blank { color: var(--fg-subtle); }
  .stat-label {
    margin-top: var(--gap-4);
    padding-top: var(--gap-4);
    border-top: var(--stroke-thin) solid color-mix(in srgb, var(--line) 80%, transparent);
    color: var(--fg);
    font-size: var(--fluid-body-md);
    font-weight: var(--font-weight-semibold);
  }
  .stat-copy { margin-top: var(--gap-2); font-size: var(--fluid-body-sm); color: var(--fg-muted); line-height: var(--core-line-height-relaxed); }

  /* Values */
  .values { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .values-lede { margin-top: var(--gap-5); max-width: 65ch; color: var(--fg-muted); }
  .values-list { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .values-list { grid-template-columns: repeat(4, 1fr); } }
  .values-list li { list-style: none; }
  /* Same fix as the counters: this was a light #F4F4F4 card whose h3
     inherited --fg (#f4f4f4), so every value title — Bold, Adaptive, Distinct,
     Start Smart — sat white on white at 1.00 contrast and had never once been
     visible on the page. */
  .value-card {
    position: relative;
    z-index: var(--layer-base);
    background: color-mix(in srgb, var(--neutral-8) 55%, transparent);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--gap-6);
    height: 100%;
    transition: border-color var(--duration-normal) var(--easing-smooth),
                background-color var(--duration-normal) var(--easing-smooth),
                box-shadow var(--duration-normal) var(--easing-smooth),
                filter var(--duration-normal) var(--easing-smooth);
  }
  .values-list:hover .value-card { filter: brightness(0.7); }
  .values-list:hover .value-card:hover { filter: none; }
  .value-card:hover {
    border-color: color-mix(in srgb, var(--neutral-0) 22%, transparent);
    background: color-mix(in srgb, var(--neutral-8) 80%, transparent);
    box-shadow: var(--shadow-md);
    z-index: var(--layer-card);
  }
  .value-n { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--fg-muted); display: block; margin-bottom: var(--gap-4); letter-spacing: 0.06em; }
  .value-card h3 { font-size: var(--fluid-h4); font-weight: var(--font-weight-semibold); color: var(--fg); }
  .value-card p { margin-top: var(--gap-3); font-size: var(--fluid-body-sm); color: var(--fg-muted); line-height: var(--core-line-height-relaxed); }

  /* Culture */
  .culture { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .culture-head { display: flex; gap: var(--gap-8); align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
  .culture-head h2 { font-size: var(--t-h3); }
  .culture-head p { margin-top: var(--gap-5); max-width: 60ch; color: var(--fg-muted); }
  .culture-visual { width: min(var(--culture-visual), 100%); aspect-ratio: 1/1.1; object-fit: cover; border-radius: var(--r-3); border: var(--stroke-thin) solid var(--line); }
  .culture-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-3); }
  .culture-grid li {
    background: var(--neutral-1);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--r-pill);
    padding: var(--gap-3) var(--gap-6);
    font-family: var(--font-mono);
    font-size: var(--fluid-label);
    color: var(--fg-muted);
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .culture-grid li:hover { border-color: var(--line-strong); color: var(--fg); }

  /* Team */

  .reviews { padding-block: var(--space-section-lg); }
  .reviews h2 { font-size: var(--t-h3); max-width: 20ch; }
  .reviews-grid { display: grid; gap: 1px; background: var(--line); border: var(--stroke-thin) solid var(--line); margin-top: var(--gap-8); }
  @media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(4, 1fr); } }
  .review-card { background: var(--bg); padding: var(--gap-8) var(--gap-6); display: flex; flex-direction: column; gap: var(--gap-1); }
  .review-score { font-family: var(--font-display); font-size: var(--fluid-h3); font-weight: var(--font-weight-bold); }
  .review-source { font-family: var(--font-mono); font-size: var(--fluid-caption); color: var(--fg-muted); }
</style>

<script>
  /**
   * Counters. Each number counts from zero to its own value once its list
   * scrolls in, then never again — a figure that re-rolls every time you pass
   * it reads as decoration rather than a fact.
   *
   * Only the digits animate; any suffix ("+", "%") is a separate span, and a
   * non-numeric value is left exactly as authored. `tabular-nums` on the parent
   * keeps the width steady so nothing jitters while it runs.
   */
  function initCounters() {
    const groups = document.querySelectorAll<HTMLElement>('[data-counters]');
    if (groups.length === 0) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo);
      if (!Number.isFinite(target)) return;
      if (reduced) { el.textContent = String(target); return; }
      const dur = 1100;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        // ease-out cubic: fast off the mark, settles onto the figure
        const v = Math.round(target * (1 - Math.pow(1 - t, 3)));
        el.textContent = String(v);
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = String(target);
      };
      requestAnimationFrame(step);
    };

    groups.forEach((group) => {
      if (group.dataset.countBound === '1') return;
      group.dataset.countBound = '1';
      const nums = Array.from(group.querySelectorAll<HTMLElement>('[data-count-to]'));
      if (nums.length === 0) return;
      nums.forEach((n) => { if (!reduced) n.textContent = '0'; });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          nums.forEach((n, i) => setTimeout(() => run(n), i * 90));
        });
      }, { threshold: 0.4 });
      io.observe(group);
    });
  }

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>
