---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery } from '../lib/queries';

// Hero title/intro now Sanity-editable. Stats/values/culture/team stay
// hardcoded on purpose — more structural than day-to-day editorial copy,
// and migrating the team roster into this generic items shape would lose
// the photo field. Falls back to the known real copy if Sanity is empty.
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'about' }).catch(() => null);
const heroText =
  page?.body?.[0]?.children?.[0]?.text ??
  "Wugweb is evolving in the digital landscape and has rapidly moved forward, with our services expanding to digital marketing, emerging tech innovation & production.";

// Stats show as "0+" / "0%" on the live site — genuinely placeholder
// there too, not something I'm inventing numbers for.
const stats = [
  { n: '01', label: 'Years of experience', copy: 'Expertise that drives meaningful results.' },
  { n: '02', label: 'Projects delivered', copy: 'Creative solutions built with purpose.' },
  { n: '03', label: 'Client Retention Rate', copy: 'Long-term partnerships built on real results.' },
  { n: '04', label: 'Brands transformed', copy: 'From strategy to standout visuals.' },
];

const values = [
  { n: '01', title: 'Bold', copy: 'We balance distinctive expression with measurable results.' },
  { n: '02', title: 'Adaptive', copy: 'We build flexible solutions without sacrificing creative vision.' },
  { n: '03', title: 'Distinct', copy: 'We reject sameness, crafting experiences with unique identities.' },
  { n: '04', title: 'Start Smart, Start Small', copy: '' }, // no description on the live page either
];

const culture = [
  'We Create Trust', 'We listen closely', 'We define your value', 'We pivot',
  'We hustle', 'We form connections', 'We get cosy', 'We get our hands dirty',
];

// Real team, real roles — one flagged anomaly noted in chat, not silently
// fixed: the "Legal Head" entry's displayed name on the live site is
// "Product", which isn't a name. Kept as-is rather than guessing.
const team = [
  { name: 'Vedanshu Srivastava', role: 'Founder', photo: 'https://framerusercontent.com/images/BgQ15qJouVb8OyXweOeBmrm2KA.jpeg' },
  { name: 'Product', role: 'Legal Head', photo: 'https://framerusercontent.com/images/8ev8ygLeu2ojG6tRryEb6t8qwI.jpeg' },
  { name: 'Praneet Verma', role: 'Business', photo: 'https://framerusercontent.com/images/2aHoqbNbSXp1qV0XuLVNvhtZ5I.jpeg' },
  { name: 'Vaibhav Shukla', role: 'System Architect', photo: 'https://framerusercontent.com/images/Z2OizAAaP2HGW4fDIo1Saciw90.jpeg' },
  { name: 'Shreya Khot', role: 'MarTech', photo: 'https://framerusercontent.com/images/8LsgwgmI0RS1Xns2zst8UT7iYM.jpeg' },
  { name: 'Satish Kumar', role: 'UI Engineer', photo: 'https://framerusercontent.com/images/0wjWTAp6HbNf1u8pHJqtAXgpGXU.jpeg' },
  { name: 'Kartik Chaturvedi', role: 'Business Operations', photo: 'https://framerusercontent.com/images/FpvDZYy1Fjdd0KJbr0Swb0qbfg.jpeg' },
  { name: 'Swarndeep Singh', role: 'Business Operations', photo: 'https://framerusercontent.com/images/lZQoeLMysDMreHVIrEWrlsKFl4.jpg' },
  { name: 'Sunil Thapa', role: 'Design', photo: 'https://framerusercontent.com/images/HThPZqxWcvwjUAN0LOXob521FBU.jpg' },
  { name: 'Divyanshu Pundir', role: 'UX/UI', photo: 'https://framerusercontent.com/images/M40J606Z8by806Gb2rXEuikUE.jpeg' },
  { name: 'Ojaswa Verma', role: 'Project Manager', photo: 'https://framerusercontent.com/images/7wKMAd2vIQBzsCkPiApcF7lxeo.png' },
];
---

<BaseLayout title="About" description="Get to know Wugweb – a UI/UX design agency dedicated to crafting seamless digital experiences that elevate brands.">
  <!-- HERO -->
  <section class="about-hero">
    <video class="about-hero-video" autoplay muted loop playsinline
      src="https://wugweb.online/assets/more/about/about_message.mp4"></video>
    <div class="about-hero-overlay"></div>
    <div class="wrap about-hero-content">
      <p class="eyebrow" data-reveal>About Us</p>
      <h1 data-reveal>
        {heroText}
      </h1>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats">
    <ul>
      {stats.map((s) => (
        <li data-reveal>
          <span class="stat-n">{s.n}</span>
          <p class="stat-label">{s.label}</p>
          <p class="stat-copy">{s.copy}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- VALUES -->
  <section class="wrap values">
    <p class="eyebrow" data-reveal>Bringing intuitive and beautiful innovations to life.</p>
    <p class="values-lede" data-reveal>
      Creating projects at the nexus of design and technology, bringing the future into the
      present. We develop comprehensive strategies, looking from a hybrid and more coherent
      perspective. Then we give it a life of its own by equipping it with cutting-edge systems
      that allow it to adapt to and live in the wild, ever-evolving environment.
    </p>
    <ol class="values-list">
      {values.map((v) => (
        <li data-reveal>
          <span class="stat-n">{v.n}</span>
          <h3>{v.title}</h3>
          {v.copy && <p>{v.copy}</p>}
        </li>
      ))}
    </ol>
  </section>

  <!-- CULTURE -->
  <section class="wrap culture">
    <h2 data-reveal>Culture Reigns Supreme</h2>
    <p data-reveal>
      Establishing a robust foundational culture within our organisation is vital to Wugweb's
      long-term vision, growth, and success. We are driven by four core values: intimacy,
      transparency, urgency, and pivoting.
    </p>
    <ul class="culture-grid">
      {culture.map((c) => <li data-reveal>{c}</li>)}
    </ul>
  </section>

  <!-- TEAM -->
  <section class="wrap team">
    <h2 data-reveal>Meet our team</h2>
    <ul class="team-grid">
      {team.map((t) => (
        <li data-reveal>
          <img src={t.photo} alt={t.name} loading="lazy" />
          <p class="team-role">{t.role} at wugweb</p>
          <h3>{t.name}</h3>
        </li>
      ))}
    </ul>
  </section>

  <!-- REVIEWS -->
  <section class="wrap reviews">
    <h2 data-reveal>Engage visitors and convert them into loyal customers.</h2>
    <div class="reviews-grid">
      <div class="review-card" data-reveal>
        <span class="review-score">4.98/5</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">98/100</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">Best Startup in Year</span>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-source">Another Review Site</span>
      </div>
    </div>
  </section>

  <!-- WHY WUGWEB — bento -->
  <section class="wrap why-bento">
    <h2 data-reveal>Why Wugweb?</h2>
    <p class="why-bento-lede" data-reveal>
      In a world clamoring for attention, your brand deserves more than fleeting visibility. It
      requires a strategic partner that architects compelling narratives, cultivates authentic
      connections, and engineers brand experiences designed to stand the test of time.
    </p>

    <div class="bento">
      <article class="bento-tile tile-vision" data-reveal>
        <div class="bento-body">
          <h3>Strategic Brand Vision</h3>
          <p>Resonant brand foundations are architected through the synthesis of strategic insight and creative brilliance, driving measurable business growth.</p>
        </div>
      </article>

      <a href="/contact-us" class="bento-tile tile-cta" data-reveal>
        <img src="/brand/wugweb-mark.png" alt="" width="388" height="295" />
        <span>Let's talk</span>
      </a>

      <article class="bento-tile tile-data" data-reveal>
        <div class="bento-body">
          <h3>Data-Driven Brand Evolution</h3>
          <p>Data and analytics inform brand strategy, optimizing brand performance and fueling sustainable brand evolution.</p>
        </div>
      </article>

      <article class="bento-tile tile-story" data-reveal>
        <div class="bento-body">
          <h3>Authentic Brand Storytelling</h3>
          <p>Brand's core essence is unearthed, crafting authentic narratives that forge emotional connections and inspire unwavering loyalty.</p>
        </div>
      </article>

      <article class="bento-tile tile-stack" data-reveal>
        <ul class="bento-stack">
          {['Figma', 'Notion', 'Slack', 'Webflow', 'Zapier', 'HubSpot'].map((t) => <li>{t}</li>)}
        </ul>
      </article>

      <article class="bento-tile tile-holistic" data-reveal>
        <div class="bento-body">
          <h3>Holistic Brand Experience Design</h3>
          <p>Cohesive brand experiences are engineered across all touchpoints, ensuring consistency, impact, and a seamless customer journey.</p>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.7) 0%, rgba(10, 10, 12, 0.55) 45%, var(--bg) 100%);
    z-index: 1;
  }
  .about-hero-content {
    position: relative;
    z-index: 2;
    padding-block: 5rem;
  }
  .about-hero-content h1 {
    font-size: var(--t-h2);
    font-weight: 400;
    max-width: 26ch;
    margin-top: 1rem;
  }

  .stats {
    padding-block: 5rem;
    border-top: 1px solid var(--line);
  }
  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .stats ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats li {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .stat-n {
    font-family: var(--font-mono);
    color: var(--accent-warm);
  }
  .stat-label {
    color: var(--fg);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }
  .stat-copy {
    margin-top: 0.4rem;
  }

  .values {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }
  .values-lede {
    margin-top: 1.25rem;
    max-width: 65ch;
  }
  .values-list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .values-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .values-list li {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .values-list h3 {
    font-size: 1.15rem;
    font-weight: 400;
    margin-top: 0.5rem;
  }
  .values-list p {
    margin-top: 0.5rem;
  }

  .culture {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }
  .culture h2 {
    font-size: var(--t-h3);
  }
  .culture p {
    margin-top: 1.25rem;
    max-width: 60ch;
  }
  .culture-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .culture-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .culture-grid li {
    background: var(--bg);
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .team {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
  }
  .team h2 {
    font-size: var(--t-h3);
  }
  .team-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .team-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r);
  }
  .team-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 0.75rem;
  }
  .team-grid h3 {
    font-size: 1rem;
    font-weight: 400;
    margin-top: 0.3rem;
  }

  /* Why Wugweb — bento grid.
     NOTE: the live site's tiles carry decorative mockup imagery (phone chat,
     notification card, tool logos, stairwell photo) hosted on Framer's CDN.
     Those source assets weren't provided, so the tiles are built structurally
     with the real copy — drop images into the tiles when the assets land. */
  .why-bento { padding-block: 6rem; border-top: 1px solid var(--line); }
  .why-bento h2 { font-size: var(--t-h2); }
  .why-bento-lede { margin-top: 1.25rem; max-width: 75ch; }

  .bento { display: grid; gap: 1rem; margin-top: 3rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) {
    .bento { grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(180px, auto); }
    .tile-vision   { grid-column: 1; grid-row: 1 / span 2; }
    .tile-cta      { grid-column: 1; grid-row: 3; }
    .tile-data     { grid-column: 2; grid-row: 1; }
    .tile-story    { grid-column: 2; grid-row: 2 / span 2; }
    .tile-stack    { grid-column: 3; grid-row: 1; }
    .tile-holistic { grid-column: 3; grid-row: 2 / span 2; }
  }

  .bento-tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 180px;
  }
  .bento-tile h3 { font-size: var(--t-h4); font-weight: 400; line-height: var(--lh-tight); }
  .bento-tile p { margin-top: 0.65rem; font-size: 0.95rem; line-height: 1.6; }

  /* The one light tile, mirroring the live layout's contrast anchor */
  .tile-vision { background: #f4f4f4; border-color: transparent; }
  .tile-vision h3 { color: #191919; }
  .tile-vision p { color: #4a4a4a; }

  .tile-cta {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0.85rem;
    min-height: 0;
    text-decoration: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .tile-cta:hover { background: var(--surface-2); border-color: var(--line-strong); }
  .tile-cta img { height: 1.75rem; width: auto; }

  .tile-stack { justify-content: center; }
  .bento-stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .bento-stack li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    color: var(--fg-muted);
  }

  .closing-cta {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .closing-cta h2 {
    font-size: var(--t-h2);
    margin-top: 0.75rem;
  }
  .closing-cta p {
    margin: 1rem auto 0;
    max-width: 50ch;
  }
  .closing-cta .btn {
    margin-top: 2rem;
  }

  .reviews { padding-block: 6rem; }
  .reviews h2 { font-size: var(--t-h3); max-width: 20ch; }
  .reviews-grid { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 2rem; }
  @media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(4, 1fr); } }
  .review-card { background: var(--bg); padding: 2rem 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .review-score { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; }
  .review-source { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.stats li, .values-list li, .culture-grid li, .team-grid li, .bento-tile', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
