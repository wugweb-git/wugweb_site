---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { singletonPageQuery, teamListQuery } from '../lib/queries';

// Hero title/intro now Sanity-editable. 
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'about' }).catch(() => null);

// Team fetched from Sanity (person docs)
const sanityTeam = await sanityClient.fetch(teamListQuery).catch(() => []);
const heroText =
  page?.body?.[0]?.children?.[0]?.text ??
  "Wugweb is evolving in the digital landscape and has rapidly moved forward, with our services expanding to digital marketing, emerging tech innovation & production.";

const stats = [
  { n: '0+', label: 'Years of experience', copy: 'Expertise that drives meaningful results.' },
  { n: '0+', label: 'Projects delivered', copy: 'Creative solutions built with purpose.' },
  { n: '0%', label: 'Client Retention Rate', copy: 'Long-term partnerships built on real results.' },
  { n: '0+', label: 'Brands transformed', copy: 'From strategy to standout visuals.' },
];

const values = [
  { n: '01', title: 'Bold', copy: 'We balance distinctive expression with measurable results.' },
  { n: '02', title: 'Adaptive', copy: 'We build flexible solutions without sacrificing creative vision.' },
  { n: '03', title: 'Distinct', copy: 'We reject sameness, crafting experiences with unique identities.' },
  { n: '04', title: 'Start Smart, Start Small', copy: '' },
];

const culture = [
  'We Create Trust', 'We listen closely', 'We define your value', 'We pivot',
  'We hustle', 'We form connections', 'We get cosy', 'We get our hands dirty',
];
---

<BaseLayout title="About" description="Get to know Wugweb – a UI/UX design agency dedicated to crafting seamless digital experiences that elevate brands.">
  <!-- HERO -->
  <section class="about-hero">
    <video class="about-hero-video" autoplay muted loop playsinline
      src="/assets/more/about/about-message.mp4"></video>
    <div class="about-hero-overlay"></div>
    <div class="wrap about-hero-content">
      <h1 data-reveal>About Us</h1>
      <p data-reveal>
        {heroText}
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats">
    <ul>
      {stats.map((s) => (
        <li data-reveal>
          <span class="stat-n">{s.n}</span>
          <p class="stat-label">{s.label}</p>
          <p class="stat-copy">{s.copy}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- VALUES -->
  <section class="wrap values">
    <p class="eyebrow" data-reveal>Bringing intuitive and beautiful innovations to life.</p>
    <p class="values-lede" data-reveal>
      Creating projects at the nexus of design and technology, bringing the future into the
      present. We develop comprehensive strategies, looking from a hybrid and more coherent
      perspective. Then we give it a life of its own by equipping it with cutting-edge systems
      that allow it to adapt to and live in the wild, ever-evolving environment.
    </p>
    <ol class="values-list">
      {values.map((v) => (
        <li data-reveal>
          <span class="stat-n">{v.n}</span>
          <h3>{v.title}</h3>
          {v.copy && <p>{v.copy}</p>}
        </li>
      ))}
    </ol>
  </section>

  <!-- CULTURE -->
  <section class="wrap culture">
    <h2 data-reveal>Culture Reigns Supreme</h2>
    <p data-reveal>
      Establishing a robust foundational culture within our organisation is vital to Wugweb's
      long-term vision, growth, and success. We are driven by four core values: intimacy,
      transparency, urgency, and pivoting.
    </p>
    <ul class="culture-grid">
      {culture.map((c) => <li data-reveal>{c}</li>)}
    </ul>
  </section>

  <!-- TEAM -->
  <section class="wrap team">
    <h2 data-reveal>Meet our team</h2>
    <ul class="team-grid">
      {sanityTeam.map((t: any) => (
        <li data-reveal>
          {t.photo ? <img src={t.photo} alt={t.name} loading="lazy" /> : <div class="team-placeholder" style="width:100%;aspect-ratio:1;background:var(--surface-2);border-radius:var(--r-2);"></div>}
          <p class="team-role">{t.role} at wugweb</p>
          <h3>{t.name}</h3>
        </li>
      ))}
    </ul>
  </section>

  <!-- REVIEWS -->
  <section class="wrap reviews">
    <h2 data-reveal>Engage visitors and convert them into loyal customers.</h2>
    <div class="reviews-grid">
      <div class="review-card" data-reveal>
        <span class="review-score">4.98/5</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">98/100</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">Best Startup in Year</span>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-source">Another Review Site</span>
      </div>
    </div>
  </section>

  <!-- WHY WUGWEB — bento -->
  <section class="wrap why-bento">
    <h2 data-reveal>Why Wugweb?</h2>
    <p class="why-bento-lede" data-reveal>
      In a world clamoring for attention, your brand deserves more than fleeting visibility. It
      requires a strategic partner that architects compelling narratives, cultivates authentic
      connections, and engineers brand experiences designed to stand the test of time.
    </p>

    <div class="bento">
      <article class="bento-tile tile-vision" data-reveal>
        <div class="bento-body">
          <h3>Strategic Brand Vision</h3>
          <p>Resonant brand foundations are architected through the synthesis of strategic insight and creative brilliance, driving measurable business growth.</p>
        </div>
      </article>

      <a href="/contact-us" class="bento-tile tile-cta" data-reveal>
        <img src="/brand/wugweb-mark.png" alt="" width="388" height="295" />
        <span>Let's talk</span>
      </a>

      <article class="bento-tile tile-data" data-reveal>
        <div class="bento-body">
          <h3>Data-Driven Brand Evolution</h3>
          <p>Data and analytics inform brand strategy, optimizing brand performance and fueling sustainable brand evolution.</p>
        </div>
      </article>

      <article class="bento-tile tile-story" data-reveal>
        <div class="bento-body">
          <h3>Authentic Brand Storytelling</h3>
          <p>Brand's core essence is unearthed, crafting authentic narratives that forge emotional connections and inspire unwavering loyalty.</p>
        </div>
      </article>

      <article class="bento-tile tile-stack" data-reveal>
        <ul class="bento-stack">
          {['Figma', 'Notion', 'Slack', 'Webflow', 'Zapier', 'HubSpot'].map((t) => <li>{t}</li>)}
        </ul>
      </article>

      <article class="bento-tile tile-holistic" data-reveal>
        <div class="bento-body">
          <h3>Holistic Brand Experience Design</h3>
          <p>Cohesive brand experiences are engineered across all touchpoints, ensuring consistency, impact, and a seamless customer journey.</p>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.7) 0%, rgba(10, 10, 12, 0.55) 45%, var(--bg) 100%);
    z-index: 1;
  }
  .about-hero-content {
    position: relative;
    z-index: 2;
    padding-block: 5rem;
  }
  .about-hero-content h1 {
    font-size: var(--t-h2);
    font-weight: 400;
    max-width: 26ch;
    margin-bottom: 1rem;
  }
  .about-hero-content p {
    font-size: var(--t-body);
    color: var(--fg-muted);
    max-width: 50ch;
  }

  .stats {
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }
  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap-8);
  }
  @media (min-width: 768px) { .stats ul { grid-template-columns: repeat(4, 1fr); } }
  .stats li { border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .stat-n { font-family: var(--font-mono); color: var(--accent-warm); }
  .stat-label { color: var(--fg); font-size: 1.1rem; margin-top: var(--gap-2); }
  .stat-copy { margin-top: var(--gap-1); }

  .values {
    padding-block: var(--space-section-xl);
    border-top: 1px solid var(--line);
  }
  .values-lede { margin-top: var(--gap-5); max-width: 65ch; }
  .values-list { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-8); }
  @media (min-width: 768px) { .values-list { grid-template-columns: repeat(4, 1fr); } }
  .values-list li { border-top: 1px solid var(--line); padding-top: var(--gap-5); }
  .values-list h3 { font-size: 1.15rem; font-weight: 400; margin-top: var(--gap-2); }
  .values-list p { margin-top: var(--gap-2); }

  .culture { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .culture h2 { font-size: var(--t-h3); }
  .culture p { margin-top: var(--gap-5); max-width: 60ch; }
  .culture-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 640px) { .culture-grid { grid-template-columns: repeat(4, 1fr); } }
  .culture-grid li { background: var(--bg); padding: var(--gap-6); font-family: var(--font-mono); font-size: .8rem; }

  .team { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .team h2 { font-size: var(--t-h3); }
  .team-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap-8); }
  @media (min-width: 640px) { .team-grid { grid-template-columns: repeat(4, 1fr); } }
  .team-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-2); }
  .team-role { font-family: var(--font-mono); font-size: .75rem; color: var(--fg-muted); margin-top: var(--gap-3); }
  .team-grid h3 { font-size: 1rem; font-weight: 400; margin-top: var(--gap-1); }

  .why-bento { padding-block: var(--space-section-xl); border-top: 1px solid var(--line); }
  .why-bento h2 { font-size: var(--t-h2); }
  .why-bento-lede { margin-top: var(--gap-5); max-width: 75ch; }
  .bento { display: grid; gap: var(--gap-4); margin-top: var(--gap-12); grid-template-columns: 1fr; }
  @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .bento { grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(180px, auto); } }
  .bento-tile { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-4); padding: var(--gap-6); display: flex; flex-direction: column; justify-content: flex-end; min-height: 180px; }
  .bento-tile h3 { font-size: var(--t-h4); font-weight: 400; line-height: var(--lh-tight); }
  .bento-tile p { margin-top: var(--gap-2); font-size: .95rem; line-height: 1.6; }
  .tile-vision { background: var(--neutral-1); border-color: transparent; }
  .tile-vision h3 { color: var(--color-ash); }
  .tile-vision p { color: var(--fg); opacity: .7; }
  .tile-cta { flex-direction: row; align-items: center; justify-content: flex-start; gap: var(--gap-2); min-height: 0; text-decoration: none; color: var(--fg); font-family: var(--font-mono); font-size: .85rem; letter-spacing: .04em; text-transform: uppercase; transition: border-color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .tile-cta:hover { background: var(--surface-2); border-color: var(--line-strong); }
  .tile-cta img { height: 1.75rem; width: auto; }
  .tile-stack { justify-content: center; }
  .bento-stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .bento-stack li { font-family: var(--font-mono); font-size: .78rem; padding: .45rem .9rem; border: 1px solid var(--line-strong); border-radius: var(--r-pill); color: var(--fg-muted); }

  .closing-cta {
    padding-block: 6rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .closing-cta h2 {
    font-size: var(--t-h2);
    margin-top: 0.75rem;
  }
  .closing-cta p {
    margin: 1rem auto 0;
    max-width: 50ch;
  }
  .closing-cta .btn {
    margin-top: 2rem;
  }

  .reviews { padding-block: 6rem; }
  .reviews h2 { font-size: var(--t-h3); max-width: 20ch; }
  .reviews-grid { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 2rem; }
  @media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(4, 1fr); } }
  .review-card { background: var(--bg); padding: 2rem 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .review-score { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; }
  .review-source { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
</style>

<script>
  import { animate, inView } from 'motion';
  animate('[data-reveal]', { opacity: [0, 1] }, { duration: 0.6, delay: 0.2 });
  inView('.stats li, .values-list li, .culture-grid li, .team-grid li, .bento-tile', (el) => {
    animate(el, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, easing: 'ease-out' });
  });
</script>
