---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { singletonPageQuery, teamListQuery, siteSettingsQuery } from '../lib/queries';
import { assetUrl } from '../lib/assets';

// Hero title/intro now Sanity-editable. 
const page = await sanityClient.fetch(singletonPageQuery, { pageId: 'about' }).catch(() => null);

// Team fetched from Sanity (person docs)
const sanityTeam = await sanityClient.fetch(teamListQuery).catch(() => []);

const featuredToolNames = [
  'Figma',
  'Notion',
  'Slack',
  'Webflow',
  'Framer',
  'Shopify',
  'Zapier',
  'HubSpot',
];
const techTools = await sanityClient
  .fetch(`*[_type=="taxonomy" && vocabulary=="tech-stack"]{name, iconPath}`)
  .catch(() => []);
const toolByName = new Map((techTools || []).map((t) => [String(t.name).toLowerCase(), t]));
const stackTools = featuredToolNames.map((name) => {
  const hit = toolByName.get(name.toLowerCase());
  return { name, iconPath: hit?.iconPath ? assetUrl(hit.iconPath) : null };
});

const heroText =
  (typeof page?.title === 'string' && page.title.length > 40 ? page.title : null) ||
  page?.body?.[0]?.children?.[0]?.text ||
  "Wugweb is evolving in the digital landscape and has rapidly moved forward, with our services expanding to digital marketing, emerging tech innovation & production.";

const pageTitle = page?.seoTitle || 'About Wugweb - UI/UX Design & Digital Experience Experts';
const pageDescription =
  page?.seoDescription ||
  'Get to know Wugweb – a UI/UX design agency dedicated to crafting seamless digital experiences that elevate brands.';

const [caseCount, clientCount, settings] = await Promise.all([
  sanityClient.fetch(`count(*[_type == "caseStudy"])`).catch(() => 0),
  sanityClient.fetch(`count(*[_type == "client"])`).catch(() => 0),
  sanityClient.fetch(siteSettingsQuery).catch(() => null),
]);

// Real founding year from the copyright line ("© 2020–2026 Wugweb").
// Years of experience = current year − founding year (no invented figures).
const copyright = typeof settings?.copyright === 'string' ? settings.copyright : '';
const foundedMatch = copyright.match(/(?:©|&copy;)\s*(\d{4})/);
const foundedYear = foundedMatch ? Number(foundedMatch[1]) : 2020;
const yearsOfExperience = Math.max(0, new Date().getFullYear() - foundedYear);

const fromSanityStats = (page?.items || [])
  .map((it: any) => ({
    n: it.title || it.n,
    label: it.text || it.label,
    copy: it.copy || '',
  }))
  .filter((s: any) => s.n && s.label);

const fallbackStats = [
  {
    n: fromSanityStats[0]?.n || (yearsOfExperience ? `${yearsOfExperience}+` : '—'),
    label: 'Years of experience',
    copy: 'Expertise that drives meaningful results.',
  },
  {
    n: caseCount ? `${caseCount}+` : '—',
    label: 'Projects delivered',
    copy: 'Creative solutions built with purpose.',
  },
  {
    // No invented figures: retention is editor-provided via Studio `items`,
    // or falls back to a neutral placeholder rather than a fake number.
    n: fromSanityStats[2]?.n || '—',
    label: 'Client Retention Rate',
    copy: 'Long-term partnerships built on real results.',
  },
  {
    n: clientCount ? `${clientCount}+` : '—',
    label: 'Brands transformed',
    copy: 'From strategy to standout visuals.',
  },
];

const stats =
  fromSanityStats.length >= 4
    ? fromSanityStats.slice(0, 4).map((s: any, i: number) => ({
        ...fallbackStats[i],
        n: s.n,
        label: s.label,
        copy: s.copy || fallbackStats[i].copy,
      }))
    : fallbackStats;

const defaultValues = [
  { n: '01', title: 'Bold', copy: 'We balance distinctive expression with measurable results.' },
  { n: '02', title: 'Adaptive', copy: 'We build flexible solutions without sacrificing creative vision.' },
  { n: '03', title: 'Distinct', copy: 'We reject sameness, crafting experiences with unique identities.' },
  { n: '04', title: 'Start Smart, Start Small', copy: 'We start focused, prove value early, and scale what works.' },
];

// Prefer values listed in Sanity subtitle (Bold · Adaptive · …) when present
const subtitleTitles = String(page?.subtitle || '')
  .split(/\s*·\s*/)
  .map((s) => s.trim())
  .filter(Boolean);
const values =
  subtitleTitles.length >= 3
    ? subtitleTitles.map((title, i) => {
        const hit = defaultValues.find((v) => v.title.toLowerCase() === title.toLowerCase());
        return { n: String(i + 1).padStart(2, '0'), title, copy: hit?.copy || '' };
      })
    : defaultValues;

const culture = [
  'We Create Trust', 'We listen closely', 'We define your value', 'We pivot',
  'We hustle', 'We form connections', 'We get cosy', 'We get our hands dirty',
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO -->
  <section class="about-hero">
    <video class="about-hero-video" autoplay muted loop playsinline
      src="/assets/more/about/about-message.mp4" poster="/assets/about/about-section.jpg"></video>
    <div class="about-hero-overlay"></div>
    <div class="wrap about-hero-content">
      <h1 data-reveal>About Us</h1>
      <p data-reveal>
        {heroText}
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats" data-scroll="rise">
    <ul>
      {stats.map((s) => (
        <li data-reveal>
          <div class="stat-card">
            <span class="stat-n">{s.n}</span>
            <p class="stat-label">{s.label}</p>
            <p class="stat-copy">{s.copy}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- TRUST & RECOGNITION -->
  <section class="wrap" data-scroll="rise">
    <TrustBadges />
  </section>

  <!-- VALUES -->
  <section class="wrap values" data-scroll="rise">
    <p class="eyebrow" data-reveal>Bringing intuitive and beautiful innovations to life.</p>
    <p class="values-lede" data-reveal>
      Creating projects at the nexus of design and technology, bringing the future into the
      present. We develop comprehensive strategies, looking from a hybrid and more coherent
      perspective. Then we give it a life of its own by equipping it with cutting-edge systems
      that allow it to adapt to and live in the wild, ever-evolving environment.
    </p>
    <ol class="values-list">
      {values.map((v) => (
        <li data-reveal>
          <div class="value-card">
            <span class="value-n">{v.n}</span>
            <h3>{v.title}</h3>
            {v.copy && <p>{v.copy}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CULTURE -->
  <section class="wrap culture" data-scroll="rise">
    <div class="culture-head">
      <div>
        <h2 data-reveal>Culture Reigns Supreme</h2>
        <p data-reveal>
          Establishing a robust foundational culture within our organisation is vital to Wugweb's
          long-term vision, growth, and success. We are driven by four core values: intimacy,
          transparency, urgency, and pivoting.
        </p>
      </div>
      <img class="culture-visual" src="/assets/about/about-section-2.jpg" alt="Wugweb team culture" loading="lazy" />
    </div>
    <ul class="culture-grid">
      {culture.map((c) => <li data-reveal>{c}</li>)}
    </ul>
  </section>

  <!-- TEAM -->
  <section class="wrap team" data-scroll="rise">
    <p class="eyebrow" data-reveal>The people behind the work</p>
    <h2 data-reveal>Meet our team</h2>
    <ul class="team-grid">
      {sanityTeam.map((t: any) => (
        <li data-reveal class="team-member">
          <div class="team-media">
            {t.photoPath
              ? <img src={assetUrl(t.photoPath)} alt={t.name} loading="lazy" />
              : (t.photo
                ? <img src={urlFor(t.photo).width(400).height(400).url()} alt={t.name} loading="lazy" />
                : <div class="team-placeholder"></div>)
            }
            <div class="team-overlay">
              <p class="team-role">{t.role}</p>
              <h3>{t.name}</h3>
            </div>
          </div>
          <div class="team-info">
            <h3>{t.name}</h3>
            <p class="team-role">{t.role} at wugweb</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- REVIEWS -->
  <section class="wrap reviews">
    <h2 data-reveal>Engage visitors and convert them into loyal customers.</h2>
    <div class="reviews-grid">
      <div class="review-card" data-reveal>
        <span class="review-score">4.98/5</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">98/100</span>
        <p class="review-source">from 500+ reviews</p>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-score">Best Startup in Year</span>
      </div>
      <div class="review-card" data-reveal>
        <span class="review-source">Another Review Site</span>
      </div>
    </div>
  </section>

  <!-- WHY WUGWEB — bento -->
  <section class="wrap why-bento">
    <h2 data-reveal>Why Wugweb?</h2>
    <p class="why-bento-lede" data-reveal>
      In a world clamoring for attention, your brand deserves more than fleeting visibility. It
      requires a strategic partner that architects compelling narratives, cultivates authentic
      connections, and engineers brand experiences designed to stand the test of time.
    </p>

    <div class="bento">
      <article class="bento-tile tile-vision" data-reveal>
        <div class="bento-body">
          <h3>Strategic Brand Vision</h3>
          <p>Resonant brand foundations are architected through the synthesis of strategic insight and creative brilliance, driving measurable business growth.</p>
        </div>
      </article>

      <a href="/contact-us" class="bento-tile tile-cta" data-reveal>
        <img src="/brand/logo-large.svg" alt="wugweb" width="149" height="54" />
        <span>Let's talk</span>
      </a>

      <article class="bento-tile tile-data" data-reveal>
        <div class="bento-body">
          <h3>Data-Driven Brand Evolution</h3>
          <p>Data and analytics inform brand strategy, optimizing brand performance and fueling sustainable brand evolution.</p>
        </div>
      </article>

      <article class="bento-tile tile-story" data-reveal>
        <div class="bento-body">
          <h3>Authentic Brand Storytelling</h3>
          <p>Brand's core essence is unearthed, crafting authentic narratives that forge emotional connections and inspire unwavering loyalty.</p>
        </div>
      </article>

      <article class="bento-tile tile-stack" data-reveal>
        <ul class="bento-stack">
          {stackTools.map((t) => (
            <li>
              {t.iconPath ? <img src={t.iconPath} alt="" width="18" height="18" loading="lazy" /> : null}
              {t.name}
            </li>
          ))}
        </ul>
      </article>

      <article class="bento-tile tile-holistic" data-reveal>
        <div class="bento-body">
          <h3>Holistic Brand Experience Design</h3>
          <p>Cohesive brand experiences are engineered across all touchpoints, ensuring consistency, impact, and a seamless customer journey.</p>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--hero-overlay) 0%, var(--hero-overlay-mid) 45%, var(--bg) 100%);
    z-index: var(--z-overlay);
  }
  .about-hero-content {
    position: relative;
    z-index: var(--z-overlay);
    padding-block: var(--space-section-lg);
  }
  .about-hero-content h1 {
    font-size: var(--t-h2);
    font-weight: var(--font-weight-semibold);
    max-width: 26ch;
    margin-bottom: var(--gap-4);
  }
  .about-hero-content p {
    font-size: var(--t-body);
    color: var(--fg-muted);
    max-width: 50ch;
  }

  /* Stats */
  .stats {
    padding-block: var(--space-section-xl);
    border-top: var(--stroke-thin) solid var(--line);
  }
  .stats ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--gap-6);
  }
  @media (min-width: 768px) { .stats ul { grid-template-columns: repeat(4, 1fr); } }
  .stats li { list-style: none; }
  .stat-card {
    background: var(--neutral-1);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--gap-8);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .stat-card:hover { border-color: var(--color-accent-primary); transform: translateY(-2px); }
  .stat-n { font-family: var(--font-mono); font-size: var(--fluid-h2); font-weight: var(--font-weight-bold); color: var(--accent-warm); display: block; }
  .stat-label { color: var(--fg); font-size: var(--fluid-body-md); font-weight: var(--font-weight-medium); margin-top: var(--gap-3); display: block; }
  .stat-copy { margin-top: var(--gap-2); font-size: var(--fluid-body-sm); color: var(--fg-muted); line-height: var(--core-line-height-relaxed); }

  /* Values */
  .values { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .values-lede { margin-top: var(--gap-5); max-width: 65ch; color: var(--fg-muted); }
  .values-list { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; gap: var(--gap-6); }
  @media (min-width: 768px) { .values-list { grid-template-columns: repeat(4, 1fr); } }
  .values-list li { list-style: none; }
  .value-card {
    background: var(--neutral-1);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--gap-8);
    height: 100%;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .value-card:hover { border-color: color-mix(in srgb, var(--color-accent-primary) 40%, transparent); }
  .value-n { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--color-accent-primary); display: block; margin-bottom: var(--gap-4); letter-spacing: 0.06em; }
  .value-card h3 { font-size: var(--fluid-h4); font-weight: var(--font-weight-semibold); color: var(--fg); }
  .value-card p { margin-top: var(--gap-3); font-size: var(--fluid-body-sm); color: var(--fg-muted); line-height: var(--core-line-height-relaxed); }

  /* Culture */
  .culture { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .culture-head { display: flex; gap: var(--gap-8); align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
  .culture-head h2 { font-size: var(--t-h3); }
  .culture-head p { margin-top: var(--gap-5); max-width: 60ch; color: var(--fg-muted); }
  .culture-visual { width: min(var(--culture-visual), 100%); aspect-ratio: 1/1.1; object-fit: cover; border-radius: var(--r-3); border: var(--stroke-thin) solid var(--line); }
  .culture-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-3); }
  .culture-grid li {
    background: var(--neutral-1);
    border: var(--stroke-thin) solid var(--line);
    border-radius: var(--r-pill);
    padding: var(--gap-3) var(--gap-6);
    font-family: var(--font-mono);
    font-size: var(--fluid-label);
    color: var(--fg-muted);
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .culture-grid li:hover { border-color: var(--color-accent-primary); color: var(--fg); }

  /* Team */
  .team { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .team h2 { font-size: var(--t-h3); margin-top: var(--gap-4); }
  .team-grid { list-style: none; margin: var(--gap-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap-6); }
  @media (min-width: 640px) { .team-grid { grid-template-columns: repeat(4, 1fr); } }
  .team-member { list-style: none; }
  .team-media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .team-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .team-member:hover .team-media img { transform: scale(1.06); }
  .team-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--gap-5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .team-member:hover .team-overlay { opacity: 1; }
  .team-overlay h3 { color: #fff; font-size: var(--fluid-body-md); font-weight: var(--font-weight-semibold); }
  .team-overlay .team-role { color: rgba(255,255,255,0.75); margin-top: var(--gap-1); }
  .team-info { margin-top: var(--gap-4); }
  .team-info h3 { font-size: var(--fluid-body-md); font-weight: var(--font-weight-semibold); }
  .team-role { font-family: var(--font-mono); font-size: var(--fluid-caption); color: var(--fg-muted); margin-top: var(--gap-1); display: block; }
  .team-placeholder { width: 100%; aspect-ratio: 3/4; background: var(--neutral-2); border-radius: var(--radius-lg); }

  .why-bento { padding-block: var(--space-section-xl); border-top: var(--stroke-thin) solid var(--line); }
  .why-bento h2 { font-size: var(--t-h2); }
  .why-bento-lede { margin-top: var(--gap-5); max-width: 75ch; }
  .bento { display: grid; gap: var(--gap-4); margin-top: var(--gap-12); grid-template-columns: 1fr; }
  @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .bento { grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(180px, auto); } }
  .bento-tile { background: var(--surface); border: var(--stroke-thin) solid var(--line); border-radius: var(--radius-lg); padding: var(--gap-6); display: flex; flex-direction: column; justify-content: flex-end; min-height: var(--bento-min); }
  .bento-tile h3 { font-size: var(--t-h4); font-weight: var(--font-weight-semibold); line-height: var(--lh-tight); }
  .bento-tile p { margin-top: var(--gap-2); font-size: var(--fluid-body-sm); line-height: var(--core-line-height-relaxed); }
  .tile-vision { background: var(--neutral-1); border-color: transparent; }
  .tile-vision h3 { color: var(--color-ash); }
  .tile-vision p { color: var(--fg); opacity: var(--opacity-soft); }
  .tile-cta { flex-direction: row; align-items: center; justify-content: flex-start; gap: var(--gap-2); min-height: 0; text-decoration: none; color: var(--fg); font-family: var(--font-mono); font-size: var(--fluid-label); letter-spacing: .04em; text-transform: uppercase; transition: border-color var(--duration-fast) var(--easing-out), background var(--duration-fast) var(--easing-out); }
  .tile-cta:hover { background: var(--surface-2); border-color: var(--line-strong); }
  .tile-cta img { height: var(--gap-8); width: auto; }
  .tile-stack { justify-content: center; }
  .bento-stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--gap-2); }
  .bento-stack li { font-family: var(--font-mono); font-size: var(--fluid-caption); padding: var(--gap-2) var(--gap-3); border: var(--stroke-thin) solid var(--line-strong); border-radius: var(--r-pill); color: var(--fg-muted); display: inline-flex; align-items: center; gap: var(--gap-2); }
  .bento-stack li img { width: var(--gap-5); height: var(--gap-5); object-fit: contain; flex-shrink: 0; }

  .closing-cta {
    padding-block: var(--space-section-lg);
    border-top: var(--stroke-thin) solid var(--line);
    text-align: center;
  }
  .closing-cta h2 {
    font-size: var(--t-h2);
    margin-top: var(--gap-3);
  }
  .closing-cta p {
    margin: var(--gap-4) auto 0;
    max-width: 50ch;
  }
  .closing-cta .btn {
    margin-top: var(--gap-8);
  }

  .reviews { padding-block: var(--space-section-lg); }
  .reviews h2 { font-size: var(--t-h3); max-width: 20ch; }
  .reviews-grid { display: grid; gap: 1px; background: var(--line); border: var(--stroke-thin) solid var(--line); margin-top: var(--gap-8); }
  @media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(4, 1fr); } }
  .review-card { background: var(--bg); padding: var(--gap-8) var(--gap-6); display: flex; flex-direction: column; gap: var(--gap-1); }
  .review-score { font-family: var(--font-display); font-size: var(--fluid-h3); font-weight: var(--font-weight-bold); }
  .review-source { font-family: var(--font-mono); font-size: var(--fluid-caption); color: var(--fg-muted); }
</style>

